                                <!-- PROVEEDORES -> GATE OUT/IN -->
                <div class="tab-pane fade" id="prov-gate">
                    @{
                        // Una línea por tarifa. Las tarifas desglosadas (CMA CGM: Gate Out +
                        // Control Sello + BL Fee) vienen en varias filas de TarifasGate y aquí se
                        // juntan en una sola línea, con un checkbox por componente.
                        var gateTodas = Model.TarifasGate.Concat(Model.ComponentesGateInactivos).ToList();
                        var gateLineas = gateTodas
                            .GroupBy(g => string.IsNullOrEmpty(g.Componente)
                                ? "T" + g.Id
                                : $"C|{g.IdNaviera}|{g.IdDeposito}|{(g.TipoMovimiento ?? "").ToUpper()}|{(g.TipoContenedor ?? "").ToUpper()}")
                            .Select(grp =>
                            {
                                var lista = grp.ToList();
                                var baseG = lista.Where(x => string.IsNullOrEmpty(x.Componente) || x.Componente == "GATE_OUT" || x.Componente == "GATE_IN")
                                    .OrderByDescending(x => x.EsActiva).ThenByDescending(x => x.Id).FirstOrDefault();
                                var sello = lista.Where(x => x.Componente == "CONTROL_SELLO").OrderByDescending(x => x.EsActiva).ThenByDescending(x => x.Id).FirstOrDefault();
                                var blf = lista.Where(x => x.Componente == "BL_FEE").OrderByDescending(x => x.EsActiva).ThenByDescending(x => x.Id).FirstOrDefault();
                                int? idNav = baseG?.IdNaviera;
                                string nav = (idNav.HasValue && Model.NombresNavieras.TryGetValue(idNav.Value, out var nn)) ? nn : "";
                                string dep = baseG?.IdDepositoNavigation?.NombreDeposito ?? "";
                                decimal total = (baseG?.ValorNeto ?? 0m)
                                    + (sello != null && sello.EsActiva ? (sello.ValorNeto ?? 0m) : 0m)
                                    + (blf != null && blf.EsActiva ? (blf.ValorNeto ?? 0m) : 0m);
                                return new
                                {
                                    G = baseG,
                                    Sello = sello,
                                    Blf = blf,
                                    Desglosada = lista.Any(x => !string.IsNullOrEmpty(x.Componente)),
                                    Nav = nav,
                                    Dep = dep,
                                    Mov = (baseG?.TipoMovimiento ?? "").ToUpper(),
                                    C = ContenedorGate(baseG?.TipoContenedor),
                                    Total = total
                                };
                            })
                            .Where(x => x.G != null && x.G.EsActiva && x.C.Codigos != "")
                            .OrderBy(x => string.IsNullOrWhiteSpace(x.Dep) ? "~" + x.Nav : x.Dep, StringComparer.OrdinalIgnoreCase)
                            .ThenBy(x => x.Nav, StringComparer.OrdinalIgnoreCase)
                            .ThenBy(x => x.Mov == "OUT" ? 0 : 1)
                            .ThenBy(x => x.C.Orden)
                            .ToList();
                        var navierasConGate = gateLineas.Where(x => x.G!.IdNaviera.HasValue && !string.IsNullOrWhiteSpace(x.Nav))
                            .Select(x => new { Id = x.G!.IdNaviera!.Value, x.Nav }).GroupBy(x => x.Id).Select(g => g.First())
                            .OrderBy(x => x.Nav, StringComparer.OrdinalIgnoreCase).ToList();
                    }
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded border shadow-sm filtro-toolbar flex-wrap gap-2">
                        <div class="gate-filtros" data-gate-filtros="prov">
                            <select class="form-select-xs no-select2" data-gate-filtro="dep" title="Depósito">
                                <option value="">Todos los depósitos</option>
                                @foreach (var depF in Model.ListaDepositos)
                                {
                                    <option value="@depF.Id">@depF.NombreDeposito.ToUpper()</option>
                                }
                                <option value="NAV">Tarifa de naviera (sin depósito)</option>
                            </select>
                            <select class="form-select-xs no-select2" data-gate-filtro="nav" title="Naviera">
                                <option value="">Todas las navieras</option>
                                @foreach (var navF in navierasConGate)
                                {
                                    <option value="@navF.Id">@navF.Nav.ToUpper()</option>
                                }
                            </select>
                            <select class="form-select-xs no-select2" data-gate-filtro="cont" title="Contenedor">
                                <option value="">Todos los contenedores</option>
                                <option value="20DRY">20' Dry</option>
                                <option value="40DRY">40' Dry</option>
                                <option value="40RF">40' Reefer</option>
                            </select>
                            <select class="form-select-xs no-select2" data-gate-filtro="mov" title="Movimiento">
                                <option value="">Gate Out e In</option>
                                <option value="OUT">Gate Out</option>
                                <option value="IN">Gate In</option>
                            </select>
                        </div>
                        <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm" onclick="toggleNuevaTarifaForm('form-prov-gate')">
                            <i class="bi bi-plus-lg me-1"></i> NUEVO COSTO GATE
                        </button>
                    </div>
                    <div id="form-prov-gate" class="d-none faf-card mb-3">
                        <form method="post" asp-page-handler="CrearTarifaGate" onsubmit="var d=this.querySelector('[name=&quot;NuevaTarifaGate.IdDeposito&quot;]'), n=this.querySelector('[name=&quot;NuevaTarifaGate.IdNaviera&quot;]'); if (!d.value &amp;&amp; !n.value) { alert('Indica el depósito o la naviera de la tarifa.'); return false; } return true;">
                            <div class="faf-grid">
                                <div class="faf-g" style="grid-column: span 2;">
                                    <label>Depósito</label>
                                    <select asp-for="NuevaTarifaGate.IdDeposito" class="form-select-xs">
                                        <option value="">- Sin depósito (tarifa de naviera) -</option>
                                        @foreach (var depF in Model.ListaDepositos)
                                        {
                                            <option value="@depF.Id">@depF.NombreDeposito.ToUpper()</option>
                                        }
                                    </select>
                                </div>
                                <div class="faf-g"><label>Naviera</label><select asp-for="NuevaTarifaGate.IdNaviera" asp-items="Model.ListaNavieras" class="form-select-xs"><option value="">- Todas -</option></select></div>
                                <div class="faf-g">
                                    <label>Movimiento</label>
                                    <select name="NuevaTarifaGate.TipoMovimiento" class="form-select-xs fw-bold" required>
                                        <option value="OUT" selected>Gate Out</option>
                                        <option value="IN">Gate In</option>
                                        <option value="AMBOS">Out e In (mismo valor)</option>
                                    </select>
                                </div>
                                <div class="faf-g">
                                    <label>Contenedor</label>
                                    <select asp-for="NuevaTarifaGate.TipoContenedor" class="form-select-xs fw-bold" required>
                                        <option value="">- Contenedor -</option>
                                        <option value="20DRY">20' Dry</option>
                                        <option value="40DRY">40' Dry</option>
                                        <option value="DRY">20' y 40' Dry</option>
                                        <option value="40RF">40' Reefer</option>
                                    </select>
                                </div>
                                <div class="faf-g"><label>Tarifa Gate (neto)</label><div class="faf-money"><select asp-for="NuevaTarifaGate.Moneda" class="form-select-xs"><option value="CLP">CLP</option><option value="USD">USD</option></select><input asp-for="NuevaTarifaGate.ValorNeto" type="number" step="0.01" min="0" class="form-control-xs fw-bold text-danger" required value="" placeholder="0"></div></div>
                                <div class="faf-g"><label>Control Sello <span class="text-muted fw-normal">(CMA)</span></label><input name="GateControlSello" type="number" step="0.01" min="0" class="form-control-xs" placeholder="Opcional" data-suma-total="1"></div>
                                <div class="faf-g"><label>BL Fee <span class="text-muted fw-normal">(CMA)</span></label><input name="GateBlFee" type="number" step="0.01" min="0" class="form-control-xs" placeholder="Opcional" data-suma-total="1"></div>
                                <div class="faf-g"><label>Total + IVA (19%)</label><div class="faf-total-iva">—</div></div>
                                <div class="faf-g"><label>Sin costo</label><label class="d-flex align-items-center gap-1" style="font-weight:600;text-transform:none;" title="El depósito o la naviera no cobra este Gate: queda en $0 «sin costo», no «por asignar»"><input type="checkbox" name="GateSinCosto" value="true" onchange="var v=this.closest('form').querySelector('[name=&quot;NuevaTarifaGate.ValorNeto&quot;]'); if(this.checked){ v.value='0'; v.readOnly=true; v.required=false; } else { v.readOnly=false; v.required=true; }"> No cobra ($0)</label></div>
