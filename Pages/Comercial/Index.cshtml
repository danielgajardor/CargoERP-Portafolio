                        </div>
                        <!-- VENTA TARIFA PLANA (vista unificada, las 3 clasificaciones juntas) -->
                        <div class="tab-pane fade" id="cli-doc-tarifaplana">
                            <div class="table-container">
                                <table class="table table-erp searchable-table">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">Cliente</th>
                                            <th class="text-end pe-4">Tarifa Plana</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!Model.ClientesTarifaPlanaVista.Any())
                                        {
                                            <tr>
                                                <td colspan="2" class="text-center text-muted p-4" style="font-size:11px;">
                                                    @if (Model.FiltroIdCliente.HasValue)
                                                    {
                                                        <text>Cliente no encontrado.</text>
                                                    }
                                                    else
                                                    {
                                                        <text>Ningún cliente tiene Tarifa Plana activa todavía. Usa <strong>"Filtro CLIENTE..."</strong> arriba para buscar uno y activarla.</text>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        @foreach (var clienteTp in Model.ClientesTarifaPlanaVista)
                                        {
                                            var tarifasCliTp = Model.TarifasClientes.Where(t => t.IdCliente == clienteTp.Id && t.GrupoCobro == "Documental").ToList();
                                            int gratisTp = tarifasCliTp.Count(t => t.EsServicioGratuito);
                                            <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#tp-row-@clienteTp.Id" style="cursor:pointer;">
                                                <td class="ps-4 fw-bold text-uppercase" style="color: var(--atilson-dark); font-size:13px;"><i class="bi bi-building me-2 text-primary"></i>@clienteTp.RazonSocial</td>
                                                <td class="text-end pe-4">
                                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                                        @if (clienteTp.EsClienteEspecial)
                                                        {
                                                            <span class="badge-status badge-status--success"><i class="bi bi-box-seam-fill"></i> Activa@(gratisTp > 0 ? $" — {gratisTp} gratis" : "")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted" style="font-size:10px;">Inactiva</span>
                                                        }
                                                        <i class="bi bi-chevron-down text-muted"></i>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr id="tp-row-@clienteTp.Id" class="collapse detail-row">
                                                <td colspan="2" class="p-0">
                                                    <div class="p-3 bg-light border-bottom">
                                                        <div class="d-flex align-items-center gap-3 mb-2">
                                                            <div class="form-check form-switch d-flex align-items-center gap-2 m-0">
                                                                <input class="form-check-input" type="checkbox" role="switch" id="chk-tp-@clienteTp.Id"
                                                                       checked="@(clienteTp.EsClienteEspecial ? "checked" : null)"
                                                                       data-id-cliente="@clienteTp.Id"
                                                                       onchange="toggleClienteEspecial(this)">
                                                                <label class="fw-bold text-uppercase" style="font-size:10.5px;" for="chk-tp-@clienteTp.Id">Tarifa Plana activa</label>
                                                            </div>
                                                            @if (clienteTp.EsClienteEspecial)
                                                            {
                                                                <button type="button" class="btn btn-sm btn-link p-0 tp-editar-btn" data-id-cliente="@clienteTp.Id" style="font-size:10px;" onclick="toggleEditarTarifaPlana(@clienteTp.Id)">
                                                                    <i class="bi bi-pencil-square me-1"></i>Editar
                                                                </button>
                                                            }
                                                        </div>
                                                        @if (!clienteTp.EsClienteEspecial)
                                                        {
                                                            <span class="text-muted" style="font-size:10.5px;">Se cobra normal. Activa el switch de arriba para elegir qué certificados van gratis.</span>
                                                        }
                                                        else
                                                        {
                                                            // "Tarifa Plana Paquetizada" (o cualquier concepto cuyo nombre sea la tarifa
                                                            // plana en sí, no un certificado documental puntual) se muestra aparte, junto
                                                            // al switch — no mezclada en SAG/SERNAPESCA/COMUNES, porque conceptualmente no
                                                            // es un certificado de ninguna de las 3 clasificaciones.
                                                            var paqueteTp = tarifasCliTp
                                                                .Where(t => t.EsActiva && !string.IsNullOrEmpty(t.Concepto) && t.Concepto!.ToUpper().Contains("TARIFA PLANA"))
                                                                .OrderBy(t => t.Concepto)
                                                                .ToList();
                                                            foreach (var pTp in paqueteTp)
                                                            {
                                                                var nombreCortoTp = System.Text.RegularExpressions.Regex.Replace(pTp.Concepto!, @"\s*\([^)]*\)", "").Trim();
                                                                <div class="d-flex align-items-center gap-2 mb-2 p-2 rounded" style="background:#f3e8ff; border:1px solid #e9d8fd; width:fit-content;">
                                                                    <input type="checkbox" class="form-check-input m-0" checked="@(pTp.EsServicioGratuito ? "checked" : null)"
                                                                           data-id-cliente="@clienteTp.Id" data-clasificacion="@pTp.Clasificacion" data-concepto="@pTp.Concepto"
                                                                           onchange="toggleCertificadoGratuito(this)">
                                                                    <span class="fw-bold text-uppercase" style="font-size:10.5px; color:var(--brand);">@nombreCortoTp</span>
                                                                    @if (pTp.PrecioPactado > 0)
                                                                    {
                                                                        <span class="text-muted" style="font-size:10px; font-weight:600;">(@pTp.Moneda @pTp.PrecioPactado.ToString("N0")@(pTp.AplicaIva ? " + IVA" : " exento"))</span>
                                                                    }
                                                                </div>
                                                            }
                                                            var gruposTp = new (string Clasif, string Label, List<string> Catalogo)[] {
                                                                ("SAG", "SAG", Model.ConceptosDocSag.Where(c => !c.ToUpper().Contains("TARIFA PLANA")).ToList()),
                                                                ("SERNAPESCA", "SERNAPESCA", Model.ConceptosDocSerna.Where(c => !c.ToUpper().Contains("TARIFA PLANA")).ToList()),
                                                                ("COMUN", "COMUNES", Model.ConceptosDocComun.Where(c => !c.ToUpper().Contains("TARIFA PLANA")).ToList())
                                                            };
                                                            if (!gruposTp.Any(g => g.Catalogo.Any()) && !paqueteTp.Any())
                                                            {
                                                                <span class="text-muted" style="font-size:10.5px;">Todavía no hay certificados en uso en ninguna clasificación — agrega el primero con "+ NUEVA VENTA DOCUMENTAL".</span>
                                                            }
                                                            foreach (var grupoTp in gruposTp)
                                                            {
                                                                // Solo se muestran como chip los certificados que el cliente YA tiene
                                                                // (activos) en esta clasificación — no el catálogo completo (que incluye
                                                                // todo lo que cualquier agencia tiene tarifado como costo, aunque nunca
                                                                // se le haya vendido a este cliente). Para agregar uno nuevo está el "+".
                                                                var existentesTp = tarifasCliTp
                                                                    .Where(t => t.Clasificacion == grupoTp.Clasif && t.EsActiva && !string.IsNullOrEmpty(t.Concepto) && !t.Concepto!.ToUpper().Contains("TARIFA PLANA"))
                                                                    .OrderBy(t => t.Concepto)
                                                                    .ToList();
                                                                var disponiblesTp = grupoTp.Catalogo
                                                                    .Where(c => !existentesTp.Any(e => e.Concepto!.ToUpper() == c.ToUpper()))
                                                                    .OrderBy(c => c)
                                                                    .ToList();
                                                                if (!existentesTp.Any() && !disponiblesTp.Any()) { continue; }
                                                                <div class="d-flex align-items-start gap-2 mb-1">
                                                                    <span class="fw-bold text-uppercase" style="font-size:9.5px; color:var(--brand); min-width:78px; padding-top:4px;">@grupoTp.Label</span>
                                                                    <div class="d-flex flex-wrap align-items-center gap-1">
                                                                        @foreach (var tcTp in existentesTp)
                                                                        {
                                                                            <label class="d-flex align-items-center gap-1 px-2 py-1 rounded-pill" style="background:#fff; border:1px solid #e9d8fd; font-size:10px; cursor:pointer;">
                                                                                <input type="checkbox" class="form-check-input m-0" checked="@(tcTp.EsServicioGratuito ? "checked" : null)"
                                                                                       data-id-cliente="@clienteTp.Id" data-clasificacion="@grupoTp.Clasif" data-concepto="@tcTp.Concepto"
                                                                                       onchange="toggleCertificadoGratuito(this)">
                                                                                <span class="text-uppercase fw-bold">@tcTp.Concepto</span>
                                                                                @if (tcTp.PrecioPactado > 0)
                                                                                {
                                                                                    <span class="text-muted" style="font-weight:600;">(@tcTp.Moneda @tcTp.PrecioPactado.ToString("N0")@(tcTp.AplicaIva ? " + IVA" : " exento"))</span>
                                                                                }
                                                                            </label>
                                                                        }
                                                                        @if (disponiblesTp.Any())
                                                                        {
                                                                            <select class="form-select form-select-sm d-inline-block w-auto tp-add-field d-none"
                                                                                    style="font-size:10px; border:1px dashed #cbd5e1; color:var(--brand); border-radius:999px; padding:2px 10px; background-color:#fff;"
                                                                                    data-id-cliente="@clienteTp.Id" data-clasificacion="@grupoTp.Clasif"
                                                                                    onchange="agregarPendienteTarifaPlana(this)">
                                                                                <option value="">+ Agregar</option>
                                                                                @foreach (var conceptoDisponibleTp in disponiblesTp)
                                                                                {
                                                                                    <option value="@conceptoDisponibleTp">@conceptoDisponibleTp</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                            <div class="tp-guardar-wrap d-none mt-2" data-id-cliente="@clienteTp.Id">
                                                                <button type="button" class="btn btn-sm btn-dark fw-bold px-3" onclick="guardarPendientesTarifaPlana(this, @clienteTp.Id)">
                                                                    <i class="bi bi-check-lg me-1"></i>Guardar
                                                                </button>
                                                                <button type="button" class="btn btn-sm btn-link text-muted" onclick="cancelarEdicionTarifaPlana(@clienteTp.Id)">Cancelar</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- CLIENTES -> GATE OUT/IN -->
                <div class="tab-pane fade" id="cli-gate">
                    @{
                        // Ventas Gate (TarifasClientes, GrupoCobro "Gate"): depósito en Pol,
                        // movimiento en el Concepto ("GATE OUT" / "GATE IN"). Finanzas las usa
                        // para el Ingreso de Gate Out/In del booking (VentaClienteHelper.ElegirGate).
                        var ventasGate = Model.TarifasClientes
                            .Where(t => t.GrupoCobro == "Gate")
                            .Select(t =>
                            {
                                string movV = (t.Concepto ?? "").ToUpper().Replace(" ", "").Contains("GATEIN") ? "IN" : "OUT";
                                string navV = (t.IdNaviera.HasValue && Model.NombresNavieras.TryGetValue(t.IdNaviera.Value, out var nnV)) ? nnV : "";
                                var depV = Model.ListaDepositos.FirstOrDefault(d => string.Equals((d.NombreDeposito ?? "").Trim(), (t.Pol ?? "").Trim(), StringComparison.OrdinalIgnoreCase));
                                return new { T = t, Mov = movV, Nav = navV, DepId = depV?.Id.ToString() ?? (string.IsNullOrWhiteSpace(t.Pol) ? "TODOS" : ""), C = ContenedorGate(t.TipoContenedor) };
                            })
                            .OrderBy(x => x.T.IdClienteNavigation?.RazonSocial ?? "", StringComparer.OrdinalIgnoreCase)
                            .ThenBy(x => x.T.Pol ?? "", StringComparer.OrdinalIgnoreCase)
                            .ThenBy(x => x.Mov == "OUT" ? 0 : 1)
                            .ThenBy(x => x.C.Orden)
                            .ToList();
