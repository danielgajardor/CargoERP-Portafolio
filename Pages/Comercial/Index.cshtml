                                                                <div class="faf-g"><label>Ciudad Retiro</label><select asp-for="NuevoCostoTerrestre.IdCiudadOrigen" asp-items="Model.ListaCiudades" class="form-select-xs" required><option value="">Retiro</option></select></div>
