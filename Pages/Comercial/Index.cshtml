                                                                                <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteRutaMenor50.HasValue ? tt.FalsoFleteRutaMenor50.Value.ToString("N0") : (tt.ValorNeto * 0.70m)?.ToString("N0") ?? "-")</td>
