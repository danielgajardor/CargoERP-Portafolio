    /* FILTROS SUPERIORES: se agrandan y dejan de ser aplastados por el flex */
    select.filtro-select + .select2-container {
        width: auto !important;
        min-width: 190px !important;
        flex: 0 0 auto;
    }
        select.filtro-select + .select2-select .select2-selection--single,
        select.filtro-select + .select2-container .select2-selection--single {
            width: auto !important;
            min-width: 190px !important;
        }
    /* Botón "x" para limpiar un filtro rápidamente sin abrir el desplegable */
