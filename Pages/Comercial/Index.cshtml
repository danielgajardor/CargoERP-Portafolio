    /* En pantallas muy angostas (celular), cada filtro ocupa el ancho completo
           de su línea en vez de forzar scroll horizontal en toda la barra. */
    @@media (max-width: 576px) {
        select.filtro-select + .select2-container {
            min-width: 100% !important;
