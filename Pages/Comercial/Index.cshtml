                                                                <div class="faf-money">
                                                                    <select asp-for="NuevaTarifaMaritimoExtra.EventoReferencia" class="form-select-xs" style="flex: 0 0 70px;"><option value="">- N/A -</option><option value="ETD">ETD</option></select>
