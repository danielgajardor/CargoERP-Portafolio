                                        <td class="fw-bold text-dark text-nowrap" style="font-size:11px;">@x.C.Etiqueta</td>
                                        <td class="text-end font-monospace fw-bold text-danger text-nowrap">@MonedaFmt(mon, gate.ValorNeto ?? 0m)</td>
