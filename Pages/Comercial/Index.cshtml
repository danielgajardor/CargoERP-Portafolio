                                    <thead><tr><th class="ps-4">Cliente</th><th>Concepto / Zona</th><th class="text-end">Tarifa Venta</th><th class="text-center">Vigencia</th><th>Comentarios</th><th class="text-end pe-4">Acción</th></tr></thead>
                                    <tbody>
                                        @foreach (var tc in Model.TarifasClientes.Where(t => t.GrupoCobro == "Courier" && t.Concepto.ToUpper().Contains("INTERNACIONAL")))
                                        {
                                            <tr>
                                                <td class="ps-4 fw-bold" style="color: #0284c7;">@(tc.IdClienteNavigation?.RazonSocial ?? "N/A")</td>
                                                <td class="text-uppercase fw-bold text-dark">@tc.Concepto</td>
                                                <td class="text-end fw-bold font-monospace">@tc.Moneda $@tc.PrecioPactado.ToString("N0")</td>
                                                <td class="text-center font-monospace text-muted">@tc.FechaFinVigencia.ToString("dd/MM/yyyy")</td>
                                                <td><span class="text-muted small">@(tc.Comentarios ?? "-")</span></td>
                                                <td class="text-end pe-4">
                                                    <div class="d-flex justify-content-end gap-1">
                                                        <i class="bi bi-info-circle info-mod-icon @(TieneModificacion(tc.FechaModificacion) ? "" : "d-none")" tabindex="0" data-bs-toggle="tooltip" data-bs-trigger="hover focus" title="@InfoModTitulo(tc.UsuarioModificador, tc.FechaModificacion)" style="cursor:pointer;" onclick="abrirModalHistorial('Cliente', @tc.Id)"></i>
                                                        <button type="button" class="btn btn-sm text-primary border-0" style="background: transparent; padding: 4px 8px; font-size: 13px;" onclick="abrirModalUniversal(@tc.Id, '@tc.PrecioPactado', '@tc.FechaFinVigencia.ToString("yyyy-MM-dd")', 'Cliente')" title="Editar Tarifa"><i class="bi bi-pencil"></i></button>
                                                        <form method="post" asp-page-handler="EliminarTarifaCliente" onsubmit="return confirm('¿Archivar Venta Courier?');"><input type="hidden" name="idTarifa" value="@tc.Id" /><button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button></form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @if (!Model.TarifasClientes.Where(t => t.GrupoCobro == "Courier" && t.Concepto.ToUpper().Contains("INTERNACIONAL")).Any())
                                        {
                                            <tr><td colspan="6" class="text-center text-muted py-4">No hay ventas Courier Internacional configuradas.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="cli-otros">
                    <div class="p-4 text-center text-muted">Otros recargos y ventas...</div>
                </div>
            </div>
        </div>
    </div>
</div>

