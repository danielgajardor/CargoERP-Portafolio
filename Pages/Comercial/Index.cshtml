                                                                                    <i class="bi bi-pencil"></i>
                                                                                </button>
                                                                                <form method="post" asp-page-handler="EliminarTarifaMaritimoExtra" onsubmit="return confirm('¿Archivar este concepto?');"><input type="hidden" name="idTarifa" value="@itemMarExtra.Id" /><button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button></form>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @if (!Model.TarifasMaestrasMaritimo.Any())
                                        {
                                            <tr><td colspan="3" class="text-center text-muted py-4">No hay extracostos marítimos configurados.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
