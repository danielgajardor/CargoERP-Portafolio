                                            </tr>
                                            <tr id="doc-serna-@grupoCli.Key" class="collapse detail-row">
                                                <td colspan="2" class="p-0">
                                                    <div class="p-3 bg-light border-bottom" style="overflow-x: auto;">
                                                        <table class="table table-sm table-borderless m-0">
                                                            <thead class="text-muted" style="font-size: 9px; text-transform: uppercase;">
                                                                <tr>
                                                                    <th>Concepto / Servicio (SERNAPESCA)</th>
                                                                    <th class="text-end">Tarifa Venta</th>
                                                                    <th class="text-center">Vigencia</th>
                                                                    <th class="text-end">Acción</th>
