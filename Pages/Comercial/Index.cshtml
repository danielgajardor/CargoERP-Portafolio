                                    <tr style="border-bottom: 1px dashed #e2e8f0;" data-dep="@(gate.IdDeposito?.ToString() ?? "NAV")" data-nav="@(gate.IdNaviera?.ToString() ?? "")" data-cont="@x.C.Codigos" data-mov="@x.Mov">
                                        <td class="ps-4 fw-bold text-nowrap" style="color: var(--atilson-dark); font-size:12px;">@(!string.IsNullOrWhiteSpace(x.Dep) ? x.Dep.ToUpper() : (string.IsNullOrWhiteSpace(x.Nav) ? "SIN DEPÓSITO NI NAVIERA" : "— (naviera)"))</td>
