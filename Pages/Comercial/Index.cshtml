                                                            </thead>
                                                            <tbody>
                                                                @foreach (var tc in grupoCli)
                                                                {
                                                                    <tr style="border-bottom: 1px dashed #e2e8f0;">
                                                                        <td class="text-uppercase fw-bold text-dark" style="font-size: 11px;">@tc.Concepto</td>
                                                                        <td class="text-end fw-bold font-monospace">
                                                                            @if (tc.EsServicioGratuito)
                                                                            {
                                                                                <span class="badge-status badge-status--danger">GRATIS (Tarifa Plana)</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <text>@tc.Moneda $@tc.PrecioPactado.ToString("N0")</text>
                                                                                <span class="d-block fw-normal" style="font-size:9.5px; color:@(tc.AplicaIva ? "#dc2626" : "#64748b");">@(tc.AplicaIva ? "+ IVA" : "exento")</span>
                                                                            }
                                                                        </td>
                                                                        <td class="text-center font-monospace text-muted" style="font-size: 11px;">@tc.FechaFinVigencia.ToString("dd/MM/yyyy")</td>
                                                                        <td class="text-end">
                                                                            <div class="d-flex justify-content-end gap-1">
                                                                                <i class="bi bi-info-circle info-mod-icon align-self-center @(TieneModificacion(tc.FechaModificacion) ? "" : "d-none")" tabindex="0" data-bs-toggle="tooltip" data-bs-trigger="hover focus" title="@InfoModTitulo(tc.UsuarioModificador, tc.FechaModificacion)" style="cursor:pointer;" onclick="abrirModalHistorial('Cliente', @tc.Id)"></i>
                                                                                <button type="button" class="btn btn-sm text-primary border-0" style="background: transparent; padding: 4px 8px; font-size: 13px;" onclick="abrirModalUniversal(@tc.Id, '@tc.PrecioPactado', '@tc.FechaFinVigencia.ToString("yyyy-MM-dd")', 'Cliente', '', @(tc.EsServicioGratuito ? "true" : "false"))" title="Editar Tarifa">
                                                                                    <i class="bi bi-pencil"></i>
                                                                                </button>
                                                                                <form method="post" asp-page-handler="EliminarTarifaCliente" onsubmit="return confirm('¿Archivar Venta?');"><input type="hidden" name="idTarifa" value="@tc.Id" /><button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button></form>
