                                                    <div class="faf-g"><label>Nombre (si es Otro)</label><input asp-for="NuevaTarifaBl.TipoEmisionOtro" class="form-control-xs text-uppercase" placeholder="Nombre del tipo" list="tiposBlOtrosExistentes" maxlength="60" /></div>
                                                    <datalist id="tiposBlOtrosExistentes">
                                                        @foreach (var nombreOtroBl in Model.TarifasBl.Where(t => t.TipoEmision == "OTRO" && !string.IsNullOrWhiteSpace(t.TipoEmisionOtro)).Select(t => t.TipoEmisionOtro!.Trim().ToUpper()).Distinct().OrderBy(x => x))
                                                        {
                                                            <option value="@nombreOtroBl"></option>
                                                        }
                                                    </datalist>
                                                    <div class="faf-g"><label>Tarifa</label><div class="faf-money"><select asp-for="NuevaTarifaBl.Moneda" class="form-select-xs"><option value="USD">USD</option><option value="CLP">CLP</option></select><input asp-for="NuevaTarifaBl.ValorNeto" type="number" step="0.01" class="form-control-xs fw-bold text-danger" required value="" placeholder="0"></div></div>
                                                    <div class="faf-g"><label>¿Aplica IVA?</label><select asp-for="NuevaTarifaBl.AplicaIva" class="form-select-xs fw-bold text-center"><option value="true">SÍ (+19%)</option><option value="false">EXENTO (0%)</option></select></div>
