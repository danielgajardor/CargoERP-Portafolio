                                                {
                                                    <label class="gate-comp @(comp.EsActiva ? "" : "gate-comp-off")" title="Desmarca para no cobrar este componente">
                                                        <input type="checkbox" class="form-check-input m-0" checked="@comp.EsActiva" onchange="toggleComponenteGate(this, @comp.Id)" />
                                                        <span class="font-monospace">@MonedaFmt(comp.Moneda, comp.ValorNeto ?? 0m)</span>
                                                    </label>
                                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" title="Editar valor" onclick="abrirModalUniversal(@comp.Id, '@(comp.ValorNeto?.ToString(System.Globalization.CultureInfo.InvariantCulture))', '@(comp.FechaFinVigencia?.ToString("yyyy-MM-dd") ?? "")', 'Gate')"><i class="bi bi-pencil" style="font-size:10px;"></i></button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        }
                                        <td class="text-end font-monospace fw-bold text-dark text-nowrap">@MonedaFmt(mon, x.Total)</td>
                                        <td class="text-end font-monospace text-muted text-nowrap">@MonedaFmt(mon, totalIva)</td>
                                        <td class="text-center font-monospace text-muted text-nowrap" style="font-size:11px;" title="@(gate.FechaFinVigencia.HasValue ? "" : "Sin fecha de vencimiento")">@(gate.FechaFinVigencia?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex justify-content-end gap-1">
                                                <button type="button" class="btn btn-sm border-0 text-secondary" style="background: transparent; padding: 4px 6px; font-size: 13px;" title="Historial de cambios" onclick="abrirModalHistorial('Gate', @gate.Id)"><i class="bi bi-clock-history"></i></button>
                                                <button type="button" class="btn btn-sm text-primary border-0" style="background: transparent; padding: 4px 8px; font-size: 13px;" onclick="abrirModalUniversal(@gate.Id, '@(gate.ValorNeto?.ToString(System.Globalization.CultureInfo.InvariantCulture))', '@(gate.FechaFinVigencia?.ToString("yyyy-MM-dd") ?? "")', 'Gate')" title="Editar Tarifa">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form method="post" asp-page-handler="EliminarTarifaGate" onsubmit="return confirm('¿Archivar costo Gate?');"><input type="hidden" name="idTarifa" value="@gate.Id" /><button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button></form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                <tr class="gate-sin-filas @(gateLineas.Any() ? "d-none" : "")"><td colspan="11" class="text-center text-muted py-4">No hay tarifas Gate para este filtro.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                                <!-- PROVEEDORES -> EMISIÓN BL -->
