                                                            <span class="badge-status badge-status--success" title="Cliente con Tarifa Plana Paquetizada"><i class="bi bi-box-seam-fill"></i> Tarifa Plana</span>
                                                        }
                                                        @if (gratuitosDoc > 0)
                                                        {
                                                            <span class="badge-status badge-status--danger">@gratuitosDoc gratis de @totalDoc</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted" style="font-size:10px;">@totalDoc concepto(s)</span>
                                                        }
                                                        <i class="bi bi-chevron-down text-muted"></i>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr id="doc-sag-@grupoCli.Key" class="collapse detail-row">
                                                <td colspan="2" class="p-0">
                                                    <div class="p-3 bg-light border-bottom" style="overflow-x: auto;">
                                                        <table class="table table-sm table-borderless m-0">
                                                            <thead class="text-muted" style="font-size: 9px; text-transform: uppercase;">
                                                                <tr>
                                                                    <th>Concepto / Servicio (SAG)</th>
                                                                    <th class="text-end">Tarifa Venta</th>
                                                                    <th class="text-center">Vigencia</th>
                                                                    <th class="text-end">Acción</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var tc in grupoCli)
                                                                {
                                                                    <tr style="border-bottom: 1px dashed #e2e8f0;">
                                                                        <td class="text-uppercase fw-bold text-dark" style="font-size: 11px;">@tc.Concepto</td>
                                                                        <td class="text-end fw-bold font-monospace">
                                                                            @if (tc.EsServicioGratuito)
                                                                            {
                                                                                <span class="badge-status badge-status--danger">GRATIS (Tarifa Plana)</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <text>@tc.Moneda $@tc.PrecioPactado.ToString("N0")</text>
                                                                                <span class="d-block fw-normal" style="font-size:9.5px; color:@(tc.AplicaIva ? "#dc2626" : "#64748b");">@(tc.AplicaIva ? "+ IVA" : "exento")</span>
                                                                            }
                                                                        </td>
                                                                        <td class="text-center font-monospace text-muted" style="font-size: 11px;">@tc.FechaFinVigencia.ToString("dd/MM/yyyy")</td>
                                                                        <td class="text-end">
                                                                            <div class="d-flex justify-content-end gap-1">
                                                                                <i class="bi bi-info-circle info-mod-icon align-self-center @(TieneModificacion(tc.FechaModificacion) ? "" : "d-none")" tabindex="0" data-bs-toggle="tooltip" data-bs-trigger="hover focus" title="@InfoModTitulo(tc.UsuarioModificador, tc.FechaModificacion)" style="cursor:pointer;" onclick="abrirModalHistorial('Cliente', @tc.Id)"></i>
                                                                                <button type="button" class="btn btn-sm text-primary border-0" style="background: transparent; padding: 4px 8px; font-size: 13px;" onclick="abrirModalUniversal(@tc.Id, '@tc.PrecioPactado', '@tc.FechaFinVigencia.ToString("yyyy-MM-dd")', 'Cliente', '', @(tc.EsServicioGratuito ? "true" : "false"))" title="Editar Tarifa">
                                                                                    <i class="bi bi-pencil"></i>
                                                                                </button>
                                                                                <form method="post" asp-page-handler="EliminarTarifaCliente" onsubmit="return confirm('¿Archivar Venta?');"><input type="hidden" name="idTarifa" value="@tc.Id" /><button type="submit" class="btn btn-delete"><i class="bi bi-trash"></i></button></form>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- VENTA SERNAPESCA -->
                        <div class="tab-pane fade" id="cli-doc-serna">
                            <div class="table-container">
                                <table class="table table-erp searchable-table">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">Cliente</th>
                                            <th class="text-end pe-4">Resumen</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var grupoCli in Model.TarifasClientes.Where(t => t.GrupoCobro == "Documental" && t.Clasificacion == "SERNAPESCA").GroupBy(t => t.IdCliente))
                                        {
                                            var clienteDoc = grupoCli.First().IdClienteNavigation;
                                            var totalDoc = grupoCli.Count();
                                            var gratuitosDoc = grupoCli.Count(t => t.EsServicioGratuito);
                                            <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#doc-serna-@grupoCli.Key" style="cursor: pointer;">
                                                <td class="ps-4 fw-bold text-uppercase" style="color: var(--atilson-dark); font-size:13px;"><i class="bi bi-building me-2 text-primary"></i> @(clienteDoc?.RazonSocial ?? "N/A")</td>
                                                <td class="text-end pe-4">
                                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                                        @if (clienteDoc?.EsClienteEspecial == true)
                                                        {
                                                            <span class="badge-status badge-status--success" title="Cliente con Tarifa Plana Paquetizada"><i class="bi bi-box-seam-fill"></i> Tarifa Plana</span>
