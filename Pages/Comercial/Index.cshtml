                                                                    <th>Código / Tipo</th>
                                                                    <th>Condición de Aplicación</th>
                                                                    <th>Vigencia</th>
                                                                    <th class="text-end">Tarifa</th>
                                                                    <th class="text-center">Impuesto</th>
                                                                    <th class="text-end pe-2">Acción</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var itemMarExtra in grupoMarExtra.OrderBy(x => x.Concepto))
                                                                {
                                                                    <tr style="border-bottom: 1px dashed #e2e8f0;">
                                                                        <td class="fw-bold text-dark" style="font-size: 11px;">
                                                                            @itemMarExtra.Concepto
                                                                            @if (!string.IsNullOrWhiteSpace(itemMarExtra.Unidad)) { <div class="text-muted fw-normal" style="font-size:9px;">@itemMarExtra.Unidad</div> }
                                                                        </td>
                                                                        <td style="font-size: 10px;">
                                                                            @(string.IsNullOrWhiteSpace(itemMarExtra.Codigo) ? "—" : itemMarExtra.Codigo)
                                                                            @if (!string.IsNullOrWhiteSpace(itemMarExtra.TipoContenedor)) { <span class="text-muted"> · @itemMarExtra.TipoContenedor</span> }
                                                                        </td>
                                                                        <td style="font-size: 10px; max-width: 220px;">
                                                                            @if (!string.IsNullOrWhiteSpace(itemMarExtra.CondicionAplicacion))
                                                                            {
                                                                                @itemMarExtra.CondicionAplicacion
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-muted">Sin condición — tarifa única</span>
                                                                            }
                                                                            @if (itemMarExtra.EventoReferencia != null && (itemMarExtra.HorasDesdeEvento != null || itemMarExtra.HorasHastaEvento != null))
                                                                            {
                                                                                <div><span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25" style="font-size:8.5px;" title="Calculable automáticamente contra @itemMarExtra.EventoReferencia">
                                                                                    <i class="bi bi-lightning-charge-fill"></i> @(itemMarExtra.HorasDesdeEvento?.ToString() ?? "–")h a @(itemMarExtra.HorasHastaEvento?.ToString() ?? "–")h desde @itemMarExtra.EventoReferencia
                                                                                </span></div>
                                                                            }
                                                                        </td>
                                                                        <td style="font-size: 10px;" class="text-muted">
                                                                            @(itemMarExtra.FechaVigenciaDesde?.ToString("dd/MM/yyyy") ?? "—")
                                                                        </td>
                                                                        <td class="text-end font-monospace fw-bold text-danger" style="font-size: 12px;">@itemMarExtra.Moneda @itemMarExtra.ValorNeto.ToString(itemMarExtra.Moneda == "CLP" ? "N0" : "N2")</td>
                                                                        <td class="text-center">
                                                                            @(itemMarExtra.AplicaIva ? Html.Raw("<span class='badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25' style='font-size:9px;'>SÍ (+19%)</span>") : Html.Raw("<span class='badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25' style='font-size:9px;'>EXENTO</span>"))
                                                                        </td>
                                                                        <td class="text-end pe-2">
                                                                            <div class="d-flex justify-content-end gap-1">
