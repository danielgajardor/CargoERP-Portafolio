                        <span class="text-muted" style="font-size:10.5px;">Agrupado por cliente: despliega uno para ver/editar SAG o SERNAPESCA (Honorarios + IVA y DUS sin IVA). La pestaña <strong>TARIFA PLANA</strong> decide si aplica y qué va gratis — AcuerdosOperativos solo lo refleja, se edita aquí.</span>
                    </div>
                    <div id="form-cli-doc" class="d-none faf-card mb-3">
                        <form method="post" asp-page-handler="CrearVentaDocumental" onsubmit="return validarVentaDocumental(this)">
                            <div class="faf-grid">
                                <div class="faf-g"><label>Cliente   </label><select asp-for="NuevaVentaMaritima.IdCliente" asp-items="Model.ListaClientes" class="form-select-xs" required><option value="">- CLIENTE -</option></select></div>
                                <div class="faf-g"><label class="text-success">Servicio</label><select asp-for="NuevaVentaMaritima.Clasificacion" class="form-select-xs fw-bold border-success" required><option value="">- SAG o Sernapesca -</option><option value="SAG">SAG (Agrícola)</option><option value="SERNAPESCA">SERNAPESCA</option></select></div>
                                <div class="faf-g"><label>Moneda</label><select asp-for="NuevaVentaMaritima.Moneda" class="form-select-xs" data-doc-moneda="1"><option>CLP</option><option>USD</option><option>UF</option></select></div>
                                <div class="faf-g"><label>Honorarios <span class="text-danger fw-bold">+ IVA</span></label><input name="VentaDocHonorarios" type="number" step="0.01" min="0" class="form-control-xs fw-bold" placeholder="Neto (opcional)" data-doc-honorarios="1"><span class="faf-doc-hint" data-doc-honorarios-iva="1">por contenedor</span></div>
                                <div class="faf-g"><label>DUS <span class="text-muted fw-bold">sin IVA</span></label><input name="VentaDocDus" type="number" step="0.01" min="0" class="form-control-xs fw-bold" placeholder="Monto (opcional)"><span class="faf-doc-hint">exento · por contenedor</span></div>
                                <div class="faf-g"><label>Expiración</label><input asp-for="NuevaVentaMaritima.FechaFinVigencia" type="date" class="form-control-xs" required></div>
                                <div class="faf-actions">
                                    <button type="submit" class="btn btn-sm btn-primary fw-bold"><i class="bi bi-check2 me-1"></i> AGREGAR VENTA</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="tab-content">
                        <!-- VENTA SAG -->
                        <div class="tab-pane fade show active" id="cli-doc-sag">
                            <div class="table-container">
                                <table class="table table-erp searchable-table">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">Cliente</th>
                                            <th class="text-end pe-4">Resumen</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var grupoCli in Model.TarifasClientes.Where(t => t.GrupoCobro == "Documental" && t.Clasificacion == "SAG").GroupBy(t => t.IdCliente))
                                        {
                                            var clienteDoc = grupoCli.First().IdClienteNavigation;
                                            var totalDoc = grupoCli.Count();
                                            var gratuitosDoc = grupoCli.Count(t => t.EsServicioGratuito);
