                                <!-- PROVEEDORES -> GATE OUT/IN -->
                <div class="tab-pane fade" id="prov-gate">
                    @{
                        var gateFilas = Model.TarifasGate.Select(g =>
                        {
                            var c = ClasificarContenedorGate(g.TipoContenedor);
                            int? idNav = g.IdNaviera;
                            string nav = (idNav.HasValue && Model.NombresNavieras.TryGetValue(idNav.Value, out var nn)) ? nn : "";
                            string dep = g.IdDepositoNavigation?.NombreDeposito ?? "";
                            return new
                            {
                                G = g,
                                Nav = nav,
                                Dep = dep,
                                // Se ordena por depósito; si la tarifa es de naviera (sin depósito), por naviera
                                Prov = string.IsNullOrWhiteSpace(dep) ? nav : dep,
                                Mov = (g.TipoMovimiento ?? "").ToUpper(),
                                Comp = g.Componente ?? "",
                                C = c
                            };
                        })
                        .Where(x => x.C.Mostrar)
                        .OrderBy(x => x.Prov)
                        .ThenBy(x => x.Nav)
                        .ThenBy(x => x.Mov == "OUT" ? 0 : 1)
                        .ThenBy(x => x.C.Orden)
                        .ThenBy(x => x.Comp)
                        .ToList();
                    }
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded border shadow-sm filtro-toolbar">
                        <ul class="nav nav-pills sub-tabs" id="pills-prov-gate" role="tablist">
                            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#prov-gate-dry" type="button">Dry</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#prov-gate-rf" type="button">Reefer</button></li>
                        </ul>
                        <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm" onclick="toggleNuevaTarifaForm('form-prov-gate')">
                            <i class="bi bi-plus-lg me-1"></i> NUEVO COSTO GATE
                        </button>
                    </div>
                    <div id="form-prov-gate" class="d-none faf-card mb-3 text-center text-muted">Formulario pendiente de enlazar...</div>

                    <div class="tab-content">
                        @foreach (var esRf in new[] { false, true })
                        {
                            var filas = gateFilas.Where(x => x.C.Tab == 2 || (x.C.Tab == 1) == esRf).ToList();
                            <div class="tab-pane fade @(!esRf ? "show active" : "")" id="@(esRf ? "prov-gate-rf" : "prov-gate-dry")">
                                <div class="table-container">
                                    <table class="table table-erp searchable-table">
                                        <thead>
                                            <tr>
                                                <th class="ps-4">Naviera</th>
                                                <th>Depósito</th>
                                                <th class="text-center">Movimiento</th>
                                                <th>Contenedor</th>
                                                <th>Componente</th>
                                                <th class="text-end">Tarifa Neta</th>
                                                <th class="text-end">+ IVA (19%)</th>
                                                <th class="text-end">Total (Base + IVA)</th>
                                                <th class="text-center">Vigencia</th>
                                                <th class="text-end pe-4">Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var x in filas)
                                            {
                                                var gate = x.G;
                                                bool esClp = (gate.Moneda ?? "CLP").ToUpper() == "CLP";
                                                string simbolo = esClp ? "$" : (gate.Moneda ?? "USD").ToUpper();
                                                string fmt = esClp ? "N0" : "N2";
                                                decimal neto = gate.ValorNeto ?? 0m;
                                                decimal iva = Math.Round(neto * 0.19m, esClp ? 0 : 2);
                                                decimal total = neto + iva;
                                                <tr style="border-bottom: 1px dashed #e2e8f0;">
                                                    <td class="ps-4 fw-bold" style="color: #0284c7; font-size:12px;">@(string.IsNullOrWhiteSpace(x.Nav) ? "—" : x.Nav)</td>
                                                    <td class="fw-bold" style="color: var(--atilson-dark); font-size:12px;">@(string.IsNullOrWhiteSpace(x.Dep) ? "—" : x.Dep)</td>
                                                    <td class="text-center"><span class="@(x.Mov == "OUT" ? "badge-dry" : "badge-reefer")">GATE @x.Mov</span></td>
                                                    <td class="fw-bold text-dark" style="font-size:11px;">@x.C.Etiqueta</td>
                                                    <td class="text-muted" style="font-size:11px;">@(string.IsNullOrWhiteSpace(x.Comp) ? "TOTAL" : x.Comp)</td>
                                                    <td class="text-end font-monospace fw-bold text-danger">@simbolo @neto.ToString(fmt)</td>
                                                    <td class="text-end font-monospace text-muted">@simbolo @iva.ToString(fmt)</td>
                                                    <td class="text-end font-monospace fw-bold text-dark">@simbolo @total.ToString(fmt)</td>
                                                    <td class="text-center font-monospace text-muted">@(gate.FechaFinVigencia?.ToString("dd/MM/yyyy") ?? "-")</td>
                                                    <td class="text-end pe-4">
