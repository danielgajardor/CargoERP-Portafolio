@model AtilsonCargoSpa.Pages.Comercial.IndexModel
@{
    ViewData["Title"] = "Command Center Comercial - Tarifario y Negociaciones";
    // VARIABLES GLOBALES PARA FILTROS DE CIUDADES (PUERTOS)
    var nombresPuertosFiltro = new[] { "VALPARAISO", "VAP", "SAN ANTONIO", "SAI", "SAN VICENTE", "CORONEL", "LIRQ" };
    var optionsPuertosFiltro = new SelectList(Model.ListaCiudades.Where(c => nombresPuertosFiltro.Any(p => QuitarAcentos(c.Text).Contains(p))), "Value", "Text");
    var selectListaNombres = ViewData["ListaCiudadesNombre"] as SelectList;
    var optionsPuertosNombreFiltro = selectListaNombres != null ? new SelectList(selectListaNombres.Where(c => nombresPuertosFiltro.Any(p => QuitarAcentos(c.Text).Contains(p))), "Value", "Text") : null;
}
@functions {
    // Ventas marítimas reefer de la pestaña RF Congelado / RF Fresco Prepaid. Las que no
    // tienen clasificación (cargadas antes de oct-2026) aplican a ambas y salen en las dos.
    IEnumerable<AtilsonCargoSpa.Models.TarifasCliente> VentasMaritimasRf(string clasificacion) =>
        Model.TarifasClientes.Where(t => t.GrupoCobro == "Marítimo"
            && ((t.TipoContenedor ?? "").ToUpper().Contains("RF") || (t.TipoContenedor ?? "").ToUpper().Contains("REEFER")
                || !string.IsNullOrWhiteSpace(t.Clasificacion))
            && (string.IsNullOrWhiteSpace(t.Clasificacion) || t.Clasificacion == clasificacion));

    // Reciben DateTime? explícitamente: si la propiedad real del modelo es
    // "DateTime" (no nullable) o "DateTime?", ambas se aceptan sin cambios acá
    // gracias a la conversión implícita de C# (DateTime -> DateTime?) — así
    // funcionan sin importar cómo esté declarado el campo en cada tabla.
    bool TieneModificacion(DateTime? fecha) => fecha.HasValue;
    string InfoModTitulo(string? usuario, DateTime? fecha) => fecha.HasValue ? $"Modificado por {usuario ?? "Sistema"} el {fecha.Value:dd/MM/yyyy HH:mm}" : "";
    // Quita tildes antes de comparar, así "Lirquén", "LIRQUÉN" o variantes con acento
    // "descompuesto" en la BD igual matchean contra "LIRQUEN".
    string QuitarAcentos(string? texto)
    {
        if (string.IsNullOrEmpty(texto)) return string.Empty;
        var normalizado = texto.ToUpper().Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in normalizado)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }
        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
    }
        // Abreviaturas de ubicaciones recurrentes. Si el texto CONTIENE una clave, se
    // muestra solo la abreviatura (ej: "SAN ANTONIO" -> "SAI"). Si no hay match, se
    // deja el texto tal cual.
    static readonly Dictionary<string, string> AbreviaturasUbicacion = new(StringComparer.OrdinalIgnoreCase)
    {
        { "VALPARAISO", "VAP" },
        { "SAN ANTONIO", "SAI" },
        { "SAN VICENTE", "SVE" },
        { "CORONEL", "COR" },
        { "LIRQUEN", "LQN" }
    };

    string AbrevUbic(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return texto ?? "";
        string t = QuitarAcentos(texto);
        foreach (var kv in AbreviaturasUbicacion.OrderByDescending(k => k.Key.Length))
        {
            if (t.Contains(kv.Key)) return kv.Value;
        }
        return texto.Trim();
    }
    // Contenedor de una tarifa Gate (TipoContenedor guardado: "20DRY", "40DRY", "40RF",
    // "DRY", "RF", "20/40RF", "20", null...). Minuta oct-2026: solo se trabajan 20' Dry,
    // 40' Dry y 40' Reefer. Codigos = a cuáles de esos 3 filtros responde la fila
    // (vacío = formato que no se usa, ej. 20' Reefer, y no se muestra).
    (string Etiqueta, string Codigos, int Orden) ContenedorGate(string? tc)
    {
        string t = (tc ?? "").ToUpper().Replace(" ", "").Replace("'", "");
        bool rf = t.Contains("RF") || t.Contains("REEFER");
        bool c20 = t.Contains("20"), c40 = t.Contains("40");
        if (rf)
        {
            if (c20 && !c40) return ("20' REEFER", "", 9);
            return ("40' REEFER", "40RF", 4);
        }
        if (c20 && !c40) return ("20' DRY", "20DRY", 1);
        if (c40 && !c20) return ("40' DRY", "40DRY", 3);
        if (t.Contains("DRY") || (c20 && c40)) return ("20' / 40' DRY", "20DRY 40DRY", 2);
        return ("TODOS", "20DRY 40DRY 40RF", 0);
    }

    string MonedaFmt(string? moneda, decimal valor)
    {
        bool clp = (moneda ?? "CLP").ToUpper() == "CLP";
        return (clp ? "$" : (moneda ?? "USD").ToUpper()) + " " + valor.ToString(clp ? "N0" : "N2");
    }
}
