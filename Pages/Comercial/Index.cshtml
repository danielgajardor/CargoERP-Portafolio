                        <div class="tab-pane fade" id="prov-mar-otros">
                            <div class="d-flex justify-content-end mb-3 gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary fw-bold px-3 shadow-sm" data-bs-toggle="collapse" data-bs-target="#panelComparativoRecargos">
