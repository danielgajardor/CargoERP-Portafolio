        <script>
        function abrirEditarDetalleAlm(btn) {
            document.getElementById('detalleAlmEditId').value = btn.dataset.id;
            document.getElementById('detalleAlmEditProv').textContent = btn.dataset.proveedor || '';
            document.getElementById('detalleAlmEditTexto').value = btn.dataset.comentarios || '';
