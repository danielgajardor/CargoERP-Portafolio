                                            @foreach (var tt in Model.TarifasTerrestres.Where(t => t.IdTipoCarga == 1).OrderBy(t => t.ValorNeto))
                                            {
                                                <tr style="border-bottom: 1px dashed #e2e8f0; @(rankDry == 1 ? "background-color: #f0fdf4;" : "")">
                                                    <td class="ps-4 fw-bold text-center @(rankDry == 1 ? "text-success" : "text-muted")" style="font-size: 12px;">@rankDry</td>
                                                    <td class="fw-bold text-uppercase" style="color: var(--atilson-dark); font-size: 11px;">
                                                        <i class="bi bi-truck me-1 @(rankDry == 1 ? "text-success" : "text-muted opacity-50")"></i> @(tt.IdProveedorNavigation?.NombreProveedor ?? "SIN PROVEEDOR")
                                                    </td>
                                                    <td class="fw-bold text-dark" style="font-size: 11px;">
                                                        @AbrevUbic(tt.IdCiudadOrigenNavigation?.Nombre) ➔ @(tt.IdCiudadPlantaNavigation?.Nombre) ➔ @AbrevUbic(tt.IdCiudadDestinoNavigation?.Nombre)
                                                    </td>
                                                    <td class="text-end font-monospace fw-bold text-dark" style="font-size: 13px;">$@(tt.ValorNeto?.ToString("N0") ?? "-")</td>
                                                    <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFletePlanta.HasValue ? tt.FalsoFletePlanta.Value.ToString("N0") : (tt.ValorNeto * 0.90m)?.ToString("N0") ?? "-")</td>
                                                    <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteRutaMayor50.HasValue ? tt.FalsoFleteRutaMayor50.Value.ToString("N0") : (tt.ValorNeto * 0.80m)?.ToString("N0") ?? "-")</td>
                                                    <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteRutaMenor50.HasValue ? tt.FalsoFleteRutaMenor50.Value.ToString("N0") : (tt.ValorNeto * 0.70m)?.ToString("N0") ?? "-")</td>
                                                    <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteDeposito?.ToString("N0") ?? "-")</td>
                                                    <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.ServicioPorteoPuerto?.ToString("N0") ?? "-")</td>
