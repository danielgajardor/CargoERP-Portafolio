                                </button>
                            </div>
                            <div class="collapse mb-3" id="panelComparativoRecargos">
                                <div class="faf-card">
                                    <div class="fw-bold text-uppercase mb-2" style="font-size: 11px; color: var(--atilson-dark);"><i class="bi bi-columns-gap me-1 text-primary"></i> Comparativo — conceptos equivalentes entre navieras</div>
                                    <div class="text-muted mb-3" style="font-size: 10px;">Comparación aproximada: cada naviera define condiciones y tramos de tiempo distintos para un mismo concepto — ver el detalle exacto en la tabla de abajo antes de cotizar o facturar.</div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered m-0" style="font-size: 11px;">
                                            <thead class="text-muted" style="font-size: 9px; text-transform: uppercase;">
                                                <tr>
                                                    <th>Concepto</th>
                                                    @foreach (var nav in Model.NavierasComparativo) { <th class="text-center">@nav</th> }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var fila in Model.ComparativoRecargosMaritimo)
                                                {
                                                    <tr>
                                                        <td class="fw-bold text-dark">@fila.Concepto</td>
                                                        @foreach (var nav in Model.NavierasComparativo)
                                                        {
                                                            var m = fila.PorNaviera.GetValueOrDefault(nav);
                                                            <td class="text-center">
                                                                @if (m == null)
                                                                {
                                                                    <span class="text-muted">—</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="fw-bold @(m.AplicaIva ? "text-danger" : "text-dark")">@m.Moneda @m.ValorNeto.ToString(m.Moneda == "CLP" ? "N0" : "N2")</span>
                                                                    <span class="text-muted">@(m.AplicaIva ? " +IVA" : " exento")</span>
                                                                }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
