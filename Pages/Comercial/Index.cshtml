                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                @foreach (var tbl in Model.TarifasBl)
                                {
                                    string etiquetaTbl = tbl.TipoEmision == "OTRO"
                                        ? (tbl.TipoEmisionOtro ?? "Otro")
