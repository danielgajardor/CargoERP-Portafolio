                                        </td>
                                    </tr>
                                }
                                @if (!Model.TarifasBl.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-4">No hay tarifas de Emisión BL configuradas.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
