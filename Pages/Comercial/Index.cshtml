                        </div>
                        <!-- PESTAÑA REEFER TERRESTRE (nov-2026). Misma estructura que Dry, con IdTipoCarga = 2.
                             La comparativa agrupa por tramo (retiro ➔ planta ➔ puerto) y marca el transportista
                             más barato de cada uno, que es como se usa el comparativo reefer de temporada. -->
                        @{
                            var tarifasRfTer = Model.TarifasTerrestres.Where(t => t.IdTipoCarga == 2).ToList();
                        }
                        <div class="tab-pane fade" id="prov-ter-rf">
                            <div class="d-flex justify-content-between mb-3 gap-2 align-items-center">
                                <div class="small text-muted"><i class="bi bi-snow text-primary me-1"></i>@tarifasRfTer.Count tramo(s) reefer de @tarifasRfTer.Select(t => t.IdProveedor).Distinct().Count() transportista(s)</div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm fw-bold px-3 shadow-sm d-flex align-items-center" style="height: 31px; border-radius: 4px; background-color: #f8fafc; border: 1px solid #cbd5e1; color: #475569; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.2s ease;"
                                            onclick="
                                        var viewGrouped = document.getElementById('view-grouped-rf');
                                        var viewRanking = document.getElementById('view-ranking-rf');
                                        var btnIcon = this.querySelector('i');
                                        var btnText = this.querySelector('span');
                                        if (viewGrouped.classList.contains('d-none')) {
                                        viewGrouped.classList.remove('d-none');
                                        viewRanking.classList.add('d-none');
                                        this.style.backgroundColor = '#f8fafc';
                                        this.style.borderColor = '#cbd5e1';
                                        this.style.color = '#475569';
                                        btnIcon.className = 'bi bi-sort-numeric-down text-primary me-2';
                                        btnText.innerText = 'Comparativa por tramo';
                                        } else {
                                        viewGrouped.classList.add('d-none');
                                        viewRanking.classList.remove('d-none');
                                        this.style.backgroundColor = '#f0fdf4';
                                        this.style.borderColor = '#22c55e';
                                        this.style.color = '#16a34a';
                                        btnIcon.className = 'bi bi-check-circle-fill me-2';
                                        btnText.innerText = 'Comparativa activa';
                                        }
                                        ">
                                        <i class="bi bi-sort-numeric-down text-primary me-2" style="font-size: 12px;"></i> <span>Comparativa por tramo</span>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-dark fw-bold px-3 shadow-sm d-flex align-items-center" style="height: 31px; border-radius: 4px;" onclick="toggleNuevaTarifaForm('form-prov-ter-rf')">
                                        <i class="bi bi-plus-lg me-1"></i> NUEVO TRAMO REEFER
                                    </button>
                                </div>
                            </div>
                            <div id="view-grouped-rf">
                                <div class="table-container">
                                    <table class="table table-erp searchable-table">
                                        <thead>
                                            <tr>
                                                <th colspan="2" class="ps-4">Empresa Transporte</th>
                                                <th class="text-end pe-4">Desplegar Tramos (REEFER)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr id="form-prov-ter-rf" class="inline-form-row d-none">
                                                <td colspan="3">
                                                    <div class="faf-card">
                                                        <form method="post" asp-page-handler="CrearCostoTerrestre">
                                                            <input type="hidden" name="NuevoCostoTerrestre.IdTipoCarga" value="2" />
                                                            <div class="faf-grid">
                                                                <div class="faf-g"><label>Transportista</label><select name="NuevoCostoTerrestre.IdProveedor" asp-items="Model.ListaTransportistas" class="form-select-xs" required><option value="">- Seleccione -</option></select></div>
                                                                <div class="faf-g"><label>Ciudad Retiro</label><select name="NuevoCostoTerrestre.IdCiudadOrigen" asp-items="Model.ListaCiudades" class="form-select-xs" required><option value="">Retiro</option></select></div>
                                                                <div class="faf-g"><label>Planta</label><select name="NuevoCostoTerrestre.IdCiudadPlanta" asp-items="Model.ListaCiudades" class="form-select-xs" required><option value="">Planta</option></select></div>
                                                                <div class="faf-g"><label>Puerto Entrega</label><select name="NuevoCostoTerrestre.IdCiudadDestino" asp-items="Model.ListaCiudades" class="form-select-xs" required><option value="">Puerto</option></select></div>
                                                                <div class="faf-g"><label>Tipo Carga</label><input type="text" class="form-control-xs fw-bold text-primary" value="REEFER" readonly tabindex="-1"></div>
                                                                <div class="faf-g"><label>Costo Flete Base</label><div class="faf-money"><span class="input-group-text bg-light p-1 px-2 border" style="font-size:11px;">$</span><input name="NuevoCostoTerrestre.ValorNeto" type="number" class="form-control-xs" required placeholder="0"></div></div>
                                                                <div class="faf-g"><label>Falso Flete Planta</label><input name="NuevoCostoTerrestre.FalsoFletePlanta" type="number" class="form-control-xs" placeholder="Opcional"></div>
                                                                <div class="faf-g"><label>Falso Flete Ruta &gt;50%</label><input name="NuevoCostoTerrestre.FalsoFleteRutaMayor50" type="number" class="form-control-xs" placeholder="Opcional"></div>
                                                                <div class="faf-g"><label>Falso Flete Ruta &lt;50%</label><input name="NuevoCostoTerrestre.FalsoFleteRutaMenor50" type="number" class="form-control-xs" placeholder="Opcional"></div>
                                                                <div class="faf-g"><label>Falso Flete Depósito</label><input name="NuevoCostoTerrestre.FalsoFleteDeposito" type="number" step="0.01" class="form-control-xs" placeholder="Opcional"></div>
                                                                <div class="faf-g"><label>Servicio Porteo</label><input name="NuevoCostoTerrestre.ServicioPorteoPuerto" type="number" class="form-control-xs" placeholder="Opcional"></div>
                                                                <div class="faf-g"><label>Interplanta</label><input name="NuevoCostoTerrestre.Interplanta" type="number" class="form-control-xs" placeholder="Opcional"></div>
                                                                <div class="faf-g"><label>Hrs Libres Planta</label><input name="NuevoCostoTerrestre.HorasLibresPlanta" type="number" class="form-control-xs" value="7"></div>
                                                                <div class="faf-g"><label>Hrs Libres Puerto</label><input name="NuevoCostoTerrestre.HorasLibresPuerto" type="number" class="form-control-xs" value="4"></div>
                                                                <div class="faf-g"><label>Expiración</label><input name="NuevoCostoTerrestre.FechaFinVigencia" type="date" class="form-control-xs" required></div>
                                                                <div class="faf-actions">
                                                                    <button type="submit" class="btn btn-sm btn-primary fw-bold"><i class="bi bi-check2 me-1"></i> AGREGAR TRAMO</button>
                                                                </div>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                            @foreach (var grupo in tarifasRfTer.GroupBy(t => t.IdProveedor).OrderBy(g => g.First().IdProveedorNavigation?.NombreProveedor))
                                            {
                                                var prov = grupo.First().IdProveedorNavigation;
                                                var tramosRf = grupo.OrderBy(t => t.IdCiudadOrigenNavigation?.Nombre).ThenBy(t => t.IdCiudadPlantaNavigation?.Nombre).ThenBy(t => t.IdCiudadDestinoNavigation?.Nombre).ToList();
                                                <tr class="main-row" data-bs-toggle="collapse" data-bs-target="#prov-rf-@grupo.Key" style="cursor: pointer;">
                                                    <td colspan="2" class="ps-4 fw-bold text-uppercase" style="color: var(--atilson-dark); font-size:13px;"><i class="bi bi-truck me-2 text-primary"></i> @(prov?.NombreProveedor ?? "SIN PROVEEDOR ASIGNADO") <span class="badge bg-light text-muted border ms-2 fw-normal" style="font-size:10px;">@tramosRf.Count @(tramosRf.Count == 1 ? "tramo" : "tramos")</span></td>
                                                    <td class="text-end pe-4"><i class="bi bi-chevron-down text-muted"></i></td>
                                                </tr>
                                                <tr id="prov-rf-@grupo.Key" class="collapse detail-row">
                                                    <td colspan="3" class="p-0">
                                                        <div class="p-3 bg-light border-bottom" style="overflow-x: auto;">
                                                            <table class="table table-sm table-borderless m-0" style="min-width: 1200px;">
                                                                <thead class="text-muted" style="font-size: 9px; text-transform: uppercase;">
                                                                    <tr>
                                                                        <th>Tramo / Ruta</th>
                                                                        <th class="text-end text-dark fw-bold">Flete Base</th>
                                                                        <th class="text-end">F.F Planta</th>
                                                                        <th class="text-end">F.F &gt;50%</th>
                                                                        <th class="text-end">F.F &lt;50%</th>
                                                                        <th class="text-end">F.F Depósito</th>
                                                                        <th class="text-end">Porteo</th>
                                                                        <th class="text-end">Interplanta</th>
                                                                        <th class="text-center">Hrs Libres (Plt/Pto)</th>
                                                                        <th class="text-center">Sobreestadía</th>
                                                                        <th></th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var tt in tramosRf)
                                                                    {
                                                                        <tr style="border-bottom: 1px dashed #e2e8f0;">
                                                                            <td class="fw-bold text-dark" style="font-size: 11px;">
                                                                                @AbrevUbic(tt.IdCiudadOrigenNavigation?.Nombre) ➔ @(tt.IdCiudadPlantaNavigation?.Nombre) ➔ @AbrevUbic(tt.IdCiudadDestinoNavigation?.Nombre)
                                                                            </td>
                                                                            <td class="text-end font-monospace fw-bold text-dark" style="font-size: 12px;">$@(tt.ValorNeto?.ToString("N0") ?? "-")</td>
                                                                            <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFletePlanta.HasValue ? tt.FalsoFletePlanta.Value.ToString("N0") : (tt.ValorNeto * 0.90m)?.ToString("N0") ?? "-")</td>
                                                                            <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteRutaMayor50.HasValue ? tt.FalsoFleteRutaMayor50.Value.ToString("N0") : (tt.ValorNeto * 0.80m)?.ToString("N0") ?? "-")</td>
                                                                            <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteRutaMenor50.HasValue ? tt.FalsoFleteRutaMenor50.Value.ToString("N0") : (tt.ValorNeto * 0.70m)?.ToString("N0") ?? "-")</td>
                                                                            <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteDeposito?.ToString("N0") ?? "-")</td>
                                                                            <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.ServicioPorteoPuerto?.ToString("N0") ?? "-")</td>
                                                                            <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.Interplanta?.ToString("N0") ?? "-")</td>
                                                                            <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tt.HorasLibresPlanta?.ToString() ?? "7")hrs / @(tt.HorasLibresPuerto?.ToString() ?? "4")hrs</td>
                                                                            <td class="text-center text-danger font-monospace fw-bold" style="font-size: 11px;">$12.000/hr</td>
                                                                            <td class="text-end pe-2">
                                                                                <div class="d-flex justify-content-end gap-1">
                                                                                    <i class="bi bi-info-circle info-mod-icon @(TieneModificacion(tt.FechaModificacion) ? "" : "d-none")" tabindex="0" data-bs-toggle="tooltip" data-bs-trigger="hover focus" title="@InfoModTitulo(tt.UsuarioModificador, tt.FechaModificacion)" style="cursor:pointer;" onclick="abrirModalHistorial('Terrestre', @tt.Id)"></i>
                                                                                    <button type="button" class="btn btn-sm text-primary border-0" style="background: transparent; padding: 4px 8px; font-size: 13px;" onclick="abrirModalEditarTerrestre(@tt.Id, '@tt.ValorNeto', '@(tt.FechaFinVigencia?.ToString("yyyy-MM-dd") ?? "")')" title="Actualizar Tarifa Maestra">
                                                                                        <i class="bi bi-pencil"></i>
                                                                                    </button>
                                                                                    <form method="post" asp-page-handler="EliminarCostoTerrestre" onsubmit="return confirm('¿Archivar este tramo de forma permanente?');">
                                                                                        <input type="hidden" name="idTarifa" value="@tt.Id" />
                                                                                        <button type="submit" class="btn btn-delete" title="Archivar Tarifa"><i class="bi bi-trash"></i></button>
                                                                                    </form>
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            @if (!tarifasRfTer.Any())
                                            {
                                                <tr><td colspan="3" class="text-center text-muted py-4">No hay tarifas terrestres reefer para mostrar. Ajusta los filtros o agrega un tramo.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div id="view-ranking-rf" class="d-none">
                                <div class="table-container shadow-sm" style="border-top: 3px solid var(--atilson-dark); overflow-x: auto;">
                                    <table class="table table-erp m-0" style="min-width: 1200px;">
                                        <thead style="background-color: #f8fafc;">
                                            <tr>
                                                <th class="ps-4 text-center" style="width: 40px;">N°</th>
                                                <th>Transportista (Proveedor)</th>
                                                <th>Ruta (Retiro ➔ Planta ➔ Pto. Entrega)</th>
                                                <th class="text-end text-dark fw-bold">Flete Base</th>
                                                <th class="text-end">Dif. vs mejor</th>
                                                <th class="text-end">F.F Planta</th>
                                                <th class="text-end">F.F &gt;50%</th>
                                                <th class="text-end">F.F &lt;50%</th>
                                                <th class="text-center">Hrs Libres (Plt/Pto)</th>
                                                <th class="text-center">Sobreestadía</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var tramo in tarifasRfTer
                                                .GroupBy(t => new { t.IdCiudadOrigen, t.IdCiudadPlanta, t.IdCiudadDestino })
                                                .OrderBy(g => g.First().IdCiudadPlantaNavigation?.Nombre)
                                                .ThenBy(g => g.First().IdCiudadOrigenNavigation?.Nombre)
                                                .ThenBy(g => g.First().IdCiudadDestinoNavigation?.Nombre))
                                            {
                                                var primero = tramo.First();
                                                var ordenadas = tramo.OrderBy(t => t.ValorNeto ?? decimal.MaxValue).ToList();
                                                var mejor = ordenadas.First().ValorNeto;
                                                <tr style="background-color: #f1f5f9;">
                                                    <td colspan="10" class="ps-4 fw-bold text-dark" style="font-size: 11px;">
                                                        <i class="bi bi-signpost-split text-primary me-1"></i> @AbrevUbic(primero.IdCiudadOrigenNavigation?.Nombre) ➔ @(primero.IdCiudadPlantaNavigation?.Nombre) ➔ @AbrevUbic(primero.IdCiudadDestinoNavigation?.Nombre)
                                                        <span class="text-muted fw-normal ms-2">@ordenadas.Count transportista(s)</span>
                                                    </td>
                                                </tr>
                                                int rankRf = 1;
                                                foreach (var tt in ordenadas)
                                                {
                                                    var dif = (tt.ValorNeto.HasValue && mejor.HasValue) ? tt.ValorNeto.Value - mejor.Value : (decimal?)null;
                                                    <tr style="border-bottom: 1px dashed #e2e8f0; @(rankRf == 1 ? "background-color: #f0fdf4;" : "")">
                                                        <td class="ps-4 fw-bold text-center @(rankRf == 1 ? "text-success" : "text-muted")" style="font-size: 12px;">@rankRf</td>
                                                        <td class="fw-bold text-uppercase" style="color: var(--atilson-dark); font-size: 11px;">
                                                            <i class="bi bi-truck me-1 @(rankRf == 1 ? "text-success" : "text-muted opacity-50")"></i> @(tt.IdProveedorNavigation?.NombreProveedor ?? "SIN PROVEEDOR")
                                                        </td>
                                                        <td class="text-muted" style="font-size: 11px;">@AbrevUbic(tt.IdCiudadOrigenNavigation?.Nombre) ➔ @(tt.IdCiudadPlantaNavigation?.Nombre) ➔ @AbrevUbic(tt.IdCiudadDestinoNavigation?.Nombre)</td>
                                                        <td class="text-end font-monospace fw-bold text-dark" style="font-size: 13px;">$@(tt.ValorNeto?.ToString("N0") ?? "-")</td>
                                                        <td class="text-end font-monospace @(dif > 0 ? "text-danger" : "text-success")" style="font-size: 11px;">@(dif == null ? "-" : dif == 0 ? "Mejor" : "+$" + dif.Value.ToString("N0"))</td>
                                                        <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFletePlanta.HasValue ? tt.FalsoFletePlanta.Value.ToString("N0") : (tt.ValorNeto * 0.90m)?.ToString("N0") ?? "-")</td>
                                                        <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteRutaMayor50.HasValue ? tt.FalsoFleteRutaMayor50.Value.ToString("N0") : (tt.ValorNeto * 0.80m)?.ToString("N0") ?? "-")</td>
                                                        <td class="text-end font-monospace text-muted" style="font-size: 11px;">$@(tt.FalsoFleteRutaMenor50.HasValue ? tt.FalsoFleteRutaMenor50.Value.ToString("N0") : (tt.ValorNeto * 0.70m)?.ToString("N0") ?? "-")</td>
                                                        <td class="text-center font-monospace text-primary" style="font-size: 11px;">@(tt.HorasLibresPlanta?.ToString() ?? "7")hrs / @(tt.HorasLibresPuerto?.ToString() ?? "4")hrs</td>
                                                        <td class="text-center text-danger font-monospace fw-bold" style="font-size: 11px;">$12.000/hr</td>
                                                    </tr>
                                                    rankRf++;
                                                }
                                            }
                                            @if (!tarifasRfTer.Any())
                                            {
                                                <tr><td colspan="10" class="text-center text-muted py-4">No hay tarifas terrestres reefer para comparar. Ajusta los filtros.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- PROVEEDORES -> DOCUMENTAL -->
                <div class="tab-pane fade" id="prov-documental">
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded border shadow-sm filtro-toolbar">
                        <div class="subtabs-row">
