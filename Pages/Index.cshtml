@page
@model AtilsonCargoSpa.Pages.IndexModel
@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Atilson Cargo · Servicios logísticos";
    var isotipo = Url.Content("~/img/marca/atilson-isotipo.svg");
}
@section Head {
    <link rel="stylesheet" href="~/css/vitrina-portal.css" asp-append-version="true" />
    <style>
        /* Landing (oct-2026, nov-2026). Lo común del sitio está en wwwroot/css/publico.css.
           Lo memorable es el globo con el corredor del logo, que funciona como ventana:
           las fotos del carrusel se ven a través de él, sobre una red de puntos conectados. */
        /* ---------- Hero: el globo Atilson como ventana ---------- */
        .hero-section {
            position: relative;
            background:
                radial-gradient(1200px 700px at 78% 45%, rgba(68,48,148,.55), transparent 65%),
                linear-gradient(180deg, var(--noche) 0%, #1a1139 100%);
            color: #fff;
            padding: 150px 0 120px;
            overflow: hidden;
            isolation: isolate;
            /* El hero siempre cabe el globo completo (sin cortarlo abajo) y, en pantallas
               altas, llena la primera vista: no asoma la franja blanca ni el buscador de
               booking, que se monta 40 px sobre el borde inferior del hero. */
            --globo-w: min(49vw, 700px);
            --globo-h: calc(var(--globo-w) * 1.022);
            min-height: calc(var(--globo-h) + 104px + 88px);
            min-height: max(calc(var(--globo-h) + 104px + 88px), calc(100vh + 8px));
            min-height: max(calc(var(--globo-h) + 104px + 88px), calc(100svh + 8px));
            display: flex; flex-direction: column; justify-content: center;
        }
        .hero-globo {
            position: absolute;
            z-index: 0;
            right: max(-60px, calc((100vw - 1240px) / 2 - 90px));
            top: max(104px, calc(50% - var(--globo-h) / 2 + 40px));
            width: var(--globo-w);
            aspect-ratio: 1049 / 1072;
            background: var(--indigo);
            -webkit-mask-image: var(--iso); mask-image: var(--iso);
            -webkit-mask-size: contain; mask-size: contain;
            -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
            -webkit-mask-position: center; mask-position: center;
            animation: globoEntra 1.4s cubic-bezier(.2,.7,.2,1) both;
        }
        .hero-globo img {
            position: absolute; inset: 0;
            width: 100%; height: 100%;
            object-fit: cover;
            mix-blend-mode: luminosity;
            opacity: 0;
            transition: opacity 1.1s ease;
        }
        .hero-globo img.is-activa { opacity: .9; }
        .hero-globo::after {
            content: ""; position: absolute; inset: 0;
            background: linear-gradient(200deg, rgba(195,182,245,.25) 0%, rgba(68,48,148,.05) 45%, rgba(22,14,47,.55) 100%);
            pointer-events: none;
        }
        @@keyframes globoEntra {
            from { opacity: 0; transform: scale(.94) rotate(-4deg); }
            to { opacity: 1; transform: none; }
        }

        .hero-carousel { position: relative; z-index: 1; }
        /* Cambio de texto en dos tiempos: primero se va el anterior y luego aparece el nuevo,
           así nunca se ven dos titulares superpuestos. */
        .hero-carousel.carousel-fade .carousel-item { transition: opacity .35s ease; }
        .hero-carousel.carousel-fade .active.carousel-item-start,
        .hero-carousel.carousel-fade .active.carousel-item-end { opacity: 0; transition: opacity .3s ease; }
        .hero-carousel.carousel-fade .carousel-item-next.carousel-item-start,
        .hero-carousel.carousel-fade .carousel-item-prev.carousel-item-end { opacity: 0; transition: none; }
        .hero-carousel .carousel-inner { overflow: visible; }
        .hero-copia { max-width: 620px; padding-top: 40px; }
        .hero-lema { color: var(--lila); font-weight: 600; font-size: 17px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
        .hero-lema::before { content: ""; width: 28px; height: 2px; background: var(--lila); }
        .hero-title { font-size: clamp(40px, 4.9vw, 68px); margin-bottom: 26px; text-wrap: balance; }
        .hero-subtitle { font-size: 19px; line-height: 1.6; color: #d6d0ec; max-width: 520px; margin-bottom: 36px; }
        .hero-acciones { display: flex; flex-wrap: wrap; gap: 12px; }
        .hero-copia-anima { animation: copiaEntra .9s .35s cubic-bezier(.2,.7,.2,1) both; }
        @@keyframes copiaEntra { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

        /* Rastreo */
        .static-tracking-container { position: relative; z-index: 3; margin-top: -40px; }
        .tracking-widget {
            display: flex; align-items: center; gap: 8px;
            background: #fff; border-radius: 999px;
            padding: 8px 8px 8px 26px;
            box-shadow: 0 24px 60px -24px rgba(22,14,47,.55), 0 0 0 1px var(--linea);
            max-width: 760px;
        }
        .tracking-widget i { color: var(--indigo); font-size: 18px; }
        .tracking-input { flex: 1; min-width: 0; border: 0; outline: 0; font-size: 16px; padding: 12px 6px; background: transparent; color: var(--tinta); }
        .tracking-input::placeholder { color: #8a85a0; }
        .tracking-btn {
            border: 0; border-radius: 999px;
            background: var(--indigo); color: #fff;
            font-weight: 700; font-size: 15px;
            padding: 13px 28px;
            transition: background-color .2s;
        }
        .tracking-btn:hover { background: var(--indigo-700); }

        /* Accesos rápidos */
        .e-services-bar { padding: 34px 0 10px; }
        .accesos { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--linea); border-bottom: 1px solid var(--linea); }
        .service-tab {
            display: flex; align-items: center; gap: 12px;
            padding: 20px 22px;
            color: var(--tinta); font-weight: 600; font-size: 15px;
            text-decoration: none;
            transition: color .2s, background-color .2s;
        }
        .service-tab + .service-tab { border-left: 1px solid var(--linea); }
        .service-tab i { color: var(--indigo); font-size: 20px; }
        .service-tab:hover { background: var(--niebla); color: var(--indigo); }

        /* Servicios: una lista, no tarjetas */
        .servicios-grid { display: grid; grid-template-columns: 5fr 7fr; gap: 72px; align-items: start; }
        .servicios-intro { position: sticky; top: 120px; }
        .servicios-intro .btn-hero-principal { background: var(--indigo); color: #fff; margin-top: 32px; }
        .servicios-intro .btn-hero-principal:hover { background: var(--indigo-700); color: #fff; }
        .servicio {
            display: grid; grid-template-columns: 56px 1fr; gap: 22px;
            padding: 30px 0;
            border-top: 1px solid var(--linea);
        }
        .servicio:last-child { border-bottom: 1px solid var(--linea); }
        .servicio-icono {
            width: 56px; height: 56px; border-radius: 50%;
            display: grid; place-items: center;
            background: var(--niebla); color: var(--indigo); font-size: 24px;
        }
        .servicio h3 { font-size: 24px; font-stretch: 112%; font-weight: 750; letter-spacing: -0.01em; margin: 4px 0 8px; }
        .servicio p { color: var(--gris); margin: 0; max-width: 58ch; }

        /* Noticias */
        .news-section { background: var(--niebla); }
        .news-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 44px; }
        .link-externo { display: inline-flex; align-items: center; gap: 8px; color: var(--indigo); font-weight: 700; text-decoration: none; white-space: nowrap; }
        .link-externo:hover { color: var(--indigo-700); text-decoration: underline; text-underline-offset: 4px; }
        .news-slider-wrapper { position: relative; margin: -6px -4px 0; }
        .news-slider-track {
            display: flex; gap: 30px;
            overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
            padding: 6px 4px 24px; scroll-padding-inline: 4px; scrollbar-width: none; overscroll-behavior-x: contain;
        }
        .news-slider-track::-webkit-scrollbar { display: none; }
        .news-card {
            flex: 0 0 380px; background: #fff; scroll-snap-align: start;
            color: inherit; text-decoration: none;
            border-radius: var(--radio);
            overflow: hidden;
            box-shadow: 0 0 0 1px var(--linea);
            display: flex; flex-direction: column;
        }
        .img-wrapper {
            aspect-ratio: 16 / 9; overflow: hidden; position: relative;
            background: linear-gradient(145deg, var(--indigo) 0%, var(--noche) 100%);
        }
        /* Sin foto (o si no carga): el globo Atilson sobre índigo, nunca un recuadro vacío. */
        .img-wrapper::before {
            content: ""; position: absolute; inset: 18% 36%;
            background: #fff; opacity: .18;
            -webkit-mask: var(--iso) center / contain no-repeat; mask: var(--iso) center / contain no-repeat;
        }
        .news-img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
        .news-card:hover .news-img { transform: scale(1.04); }
        .news-content { padding: 22px 24px 26px; display: flex; flex-direction: column; flex: 1; }
        .news-date { font-size: 13px; color: var(--gris); margin-bottom: 8px; display: flex; gap: 6px; align-items: center; }
        .news-fuente { color: var(--indigo); font-weight: 600; }
        .news-card:hover .news-title { color: var(--indigo); }
        .news-card:focus-visible { outline: 3px solid var(--indigo); outline-offset: 3px; }
        .news-esqueleto { pointer-events: none; }
        .news-esqueleto .linea { height: 12px; border-radius: 6px; background: var(--linea); margin-bottom: 12px; }
        .news-vacio {
            flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
            background: #fff; border-radius: var(--radio); box-shadow: 0 0 0 1px var(--linea); padding: 32px 36px;
        }
        .news-vacio p { margin: 0; color: var(--gris); max-width: 60ch; }
        .news-vacio strong { display: block; color: var(--tinta); font-size: 18px; margin-bottom: 4px; }
        .news-title { font-size: 19px; font-weight: 700; line-height: 1.3; margin: 0 0 10px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        .news-desc { color: var(--gris); font-size: 15px; margin: 0 0 18px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        .news-link { margin-top: auto; color: var(--indigo); font-weight: 700; font-size: 15px; display: inline-flex; gap: 6px; align-items: center; }
        .news-card:hover .news-link { text-decoration: underline; text-underline-offset: 4px; }
        .slider-controles { display: flex; gap: 8px; }
        .slider-btn {
            width: 46px; height: 46px; border-radius: 50%;
            border: 1px solid var(--linea); background: #fff; color: var(--tinta);
            display: grid; place-items: center; font-size: 18px;
            transition: background-color .2s, color .2s, border-color .2s;
        }
        .slider-btn:hover { background: var(--indigo); border-color: var(--indigo); color: #fff; }
        .slider-btn:disabled { opacity: .35; pointer-events: none; }
        .news-loading { width: 100%; text-align: center; padding: 60px 0; color: var(--gris); }

        /* Red global */
        .global-section { background: var(--noche); color: #fff; padding: 110px 0; position: relative; overflow: hidden; }
        .global-section::before {
            content: ""; position: absolute; inset: 0;
            background:
                repeating-linear-gradient(0deg, transparent 0 79px, rgba(255,255,255,.035) 79px 80px),
                repeating-linear-gradient(90deg, transparent 0 79px, rgba(255,255,255,.035) 79px 80px);
            mask-image: radial-gradient(ellipse at 70% 50%, #000 0%, transparent 70%);
            -webkit-mask-image: radial-gradient(ellipse at 70% 50%, #000 0%, transparent 70%);
        }
        .global-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
        .global-section .section-title { color: #fff; }
        .global-section .section-subtitle { color: #c9c3e2; }
        .rutas { list-style: none; margin: 0; padding: 0; }
        .ruta { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px; padding: 24px 0; border-top: 1px solid rgba(255,255,255,.12); }
        .ruta:last-child { border-bottom: 1px solid rgba(255,255,255,.12); }
        .puerto strong { display: block; font-size: 20px; font-weight: 700; }
        .puerto span { color: var(--lila); font-stretch: 75%; font-weight: 600; font-size: 15px; letter-spacing: .04em; }
        .puerto-destino { text-align: right; }
        .ruta-linea { display: flex; align-items: center; gap: 10px; color: var(--lila); }
        .ruta-linea::before, .ruta-linea::after { content: ""; width: 54px; border-top: 1.5px dashed rgba(195,182,245,.6); }
        .stat-box { display: flex; gap: 48px; margin-top: 48px; flex-wrap: wrap; }
        .stat-box h4 { font-stretch: var(--ancho-titular); font-weight: 800; font-size: 48px; letter-spacing: -0.02em; margin: 0; line-height: 1; font-variant-numeric: tabular-nums; }
        .stat-box p { color: #c9c3e2; margin: 8px 0 0; font-size: 15px; }

        /* Contacto */
        .contact-grid { display: grid; grid-template-columns: 5fr 6fr; gap: 72px; align-items: start; }
        .contacto-dato { display: flex; gap: 16px; align-items: flex-start; margin-top: 26px; }
        .contacto-dato i { width: 46px; height: 46px; border-radius: 50%; background: var(--niebla); color: var(--indigo); display: grid; place-items: center; font-size: 19px; flex: none; }
        .contacto-dato strong { display: block; font-size: 16px; }
        .contacto-dato span, .contacto-dato a { color: var(--gris); }
        .contact-card { background: var(--niebla); border-radius: 20px; padding: 40px; }
        .contact-card h3 { font-size: 24px; font-stretch: 112%; font-weight: 750; margin: 0 0 24px; }
        .contact-card label { font-size: 14px; font-weight: 600; margin-bottom: 6px; display: block; }
        .form-control-custom {
            background: #fff; border: 1px solid var(--linea); border-radius: 10px;
            padding: 13px 16px; font-size: 16px; color: var(--tinta);
        }
        .form-control-custom:focus { border-color: var(--indigo); box-shadow: 0 0 0 4px rgba(68,48,148,.14); }
        .btn-submit {
            display: inline-flex; align-items: center; gap: 10px;
            border: 0; border-radius: 999px;
            background: var(--indigo); color: #fff;
            font-weight: 700; font-size: 16px;
            padding: 14px 30px;
            transition: background-color .2s;
        }
        .btn-submit:hover { background: var(--indigo-700); }
        .btn-submit:disabled { opacity: .7; }
        .contacto-aviso { border-radius: 12px; padding: 14px 16px; margin-top: 18px; font-size: 15px; display: none; }
        .contacto-aviso.ok { display: block; background: #e7f6ee; color: #14532d; }
        .contacto-aviso.error { display: block; background: #fdecec; color: #8a1c1c; }
        .contacto-aviso a { color: inherit; font-weight: 700; }
        .form-control-custom.is-invalid { border-color: #c2410c; }
        .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
        .contacto-dato a { color: var(--gris); text-decoration: none; }
        .contacto-dato a:hover { color: var(--indigo); text-decoration: underline; text-underline-offset: 3px; }

        /* Fondo animado del hero: sobre el globo, desvanecido bajo el texto */
        .hero-section .plexus { z-index: 1; -webkit-mask-image: linear-gradient(90deg, rgba(0,0,0,.35) 0%, rgba(0,0,0,.55) 40%, #000 62%); mask-image: linear-gradient(90deg, rgba(0,0,0,.35) 0%, rgba(0,0,0,.55) 40%, #000 62%); }
        .hero-section > .contenedor { position: relative; z-index: 2; }
        .hero-nota { margin: 14px 0 0; font-size: 13.5px; color: #b9b1da; display: flex; align-items: center; gap: 8px; }
        .hero-nota i { color: var(--lila); }
        /* Servicios: cada fila lleva a su página */
        a.servicio { color: inherit; text-decoration: none; grid-template-columns: 56px 1fr 28px; align-items: center; }
        a.servicio:hover h3 { color: var(--indigo); }
        a.servicio:hover .servicio-icono { background: var(--indigo); color: #fff; }
        .servicio-ir { color: #b8b1d3; font-size: 20px; transition: transform .2s, color .2s; }
        a.servicio:hover .servicio-ir { color: var(--indigo); transform: translateX(4px); }
        .servicio-etiqueta { display: inline-block; font-size: 12px; font-weight: 700; color: var(--indigo); background: var(--niebla); border-radius: 999px; padding: 2px 10px; margin-left: 10px; vertical-align: middle; font-stretch: 100%; letter-spacing: 0; }
        .servicio-icono { transition: background-color .2s, color .2s; }

        @@media (max-width: 991px) {
            .hero-section { padding: 96px 0 96px; min-height: 0; display: block; }
            .hero-globo { position: relative; right: auto; top: auto; width: min(78vw, 440px); margin: 0 auto 8px; }
            .hero-copia { padding-top: 0; }
            .hero-section .plexus { -webkit-mask-image: none; mask-image: none; opacity: .6; }
            .servicios-grid, .global-grid, .contact-grid { grid-template-columns: 1fr; gap: 44px; }
            .servicios-intro { position: static; }
            .accesos { grid-template-columns: 1fr 1fr; }
            .service-tab:nth-child(3) { border-left: 0; }
            .service-tab:nth-child(n+3) { border-top: 1px solid var(--linea); }
        }
        @@media (max-width: 575px) {
            .global-section { padding: 76px 0; }
            .hero-title { font-size: 40px; }
            .hero-subtitle { font-size: 17px; }
            .hero-acciones .btn-hero { flex: 1 1 100%; justify-content: center; }
            .tracking-widget { padding-left: 18px; }
            .tracking-btn { padding: 12px 18px; }
            .news-head { flex-direction: column; align-items: flex-start; }
            .news-card { flex-basis: 84vw; }
            .ruta { grid-template-columns: 1fr; gap: 6px; }
            .puerto-destino { text-align: left; }
            .ruta-linea::after { display: none; }
            .ruta-linea::before { width: 24px; }
            .stat-box { gap: 28px; }
            .stat-box h4 { font-size: 38px; }
            .contact-card { padding: 26px; }
        }
    </style>
}

    <!-- HERO -->
    <section class="hero-section">
        <div class="plexus" data-plexus="1" aria-hidden="true"></div>
        <div class="hero-globo" id="heroGlobo" style="--iso: url('@isotipo')" aria-hidden="true">
            <img src="https://images.unsplash.com/photo-1494412651409-8963ce7935a7?auto=format&fit=crop&w=1400&q=80" alt="" class="is-activa">
            <img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?auto=format&fit=crop&w=1400&q=80" alt="">
            <img src="https://images.unsplash.com/photo-1616156027751-fc9a850fdc9b?q=80&w=1400&auto=format&fit=crop&ixlib=rb-4.1.0" alt="">
        </div>

        <div class="contenedor">
            <div id="heroCarousel" class="carousel slide carousel-fade hero-carousel hero-copia-anima" data-bs-ride="carousel" data-bs-pause="hover">
                <div class="carousel-inner">
                    <div class="carousel-item active" data-bs-interval="6000">
                        <div class="hero-copia">
                            <p class="hero-lema">Freight forwarder en Valparaíso</p>
                            <h1 class="titular hero-title">El futuro de la logística global, en tus manos.</h1>
                            <p class="hero-subtitle">Especialistas en comercio internacional. Visibilidad, tecnología y control sobre tus embarques marítimos y terrestres.</p>
                        </div>
                    </div>
                    <div class="carousel-item" data-bs-interval="6000">
                        <div class="hero-copia">
                            <p class="hero-lema">Transporte terrestre</p>
                            <h2 class="titular hero-title">Del puerto a tu puerta, sin escalas.</h2>
                            <p class="hero-subtitle">Transportistas certificados y monitoreo GPS en cada kilómetro, para que tu carga llegue a tiempo a planta o a puerto.</p>
                        </div>
                    </div>
                    <div class="carousel-item" data-bs-interval="6000">
                        <div class="hero-copia">
                            <p class="hero-lema">Portal de clientes</p>
                            <h2 class="titular hero-title">Datos precisos, decisiones exactas.</h2>
                            <p class="hero-subtitle">Sigue cada operación las 24 horas: hitos, documentos y costos en una sola plataforma.</p>
                        </div>
                    </div>
                </div>

                <div class="hero-copia" style="padding-top:0">
                    <div class="hero-acciones">
                        <a href="/Itinerarios" class="btn-hero btn-hero-principal"><i class="bi bi-calendar2-week"></i> Itinerarios</a>
                        <a href="/PortalCliente/SolicitarCotizacion" class="btn-hero btn-hero-secundario"><i class="bi bi-calculator"></i> Cotizar servicio</a>
                        <a href="/PortalCliente/SolicitarReserva" class="btn-hero btn-hero-secundario"><i class="bi bi-clipboard-check"></i> Solicitar servicio</a>
                    </div>
                    <p class="hero-nota"><i class="bi bi-shield-lock" aria-hidden="true"></i> Cotizar y solicitar servicio requieren ingresar al portal de clientes.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="static-tracking-container">
        <div class="contenedor">
            <form class="tracking-widget" role="search" method="get" action="/PortalCliente/Index" id="formRastreo">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="text" name="SearchString" class="tracking-input" placeholder="N° de booking o BL" aria-label="Número de booking o BL" maxlength="40" required>
                <button class="tracking-btn" type="submit">Rastrear</button>
            </form>
        </div>
    </div>

    <div class="e-services-bar d-none d-md-block">
        <div class="contenedor">
            <nav class="accesos" aria-label="Accesos rápidos">
                <a href="/Itinerarios" class="service-tab"><i class="bi bi-calendar2-week"></i> Itinerarios</a>
                <a href="/PortalCliente/SolicitarCotizacion" class="service-tab"><i class="bi bi-calculator"></i> Cotizar servicio</a>
                <a href="#servicios" class="service-tab"><i class="bi bi-boxes"></i> Nuestros servicios</a>
                <a href="/Login" class="service-tab"><i class="bi bi-pc-display"></i> Ingreso portal</a>
            </nav>
        </div>
    </div>

    <section class="section-padding" id="servicios">
        <div class="contenedor servicios-grid">
            <div class="servicios-intro">
                <h2 class="titular section-title">Soluciones logísticas integrales</h2>
                <p class="section-subtitle">Marítimo, terrestre, documental y aduanas bajo una sola gestión, y un portal para seguirlo todo. Elige un servicio para conocerlo en detalle.</p>
                <a href="#contacto" class="btn-hero btn-hero-principal"><i class="bi bi-chat-text"></i> Hablar con un ejecutivo</a>
                <partial name="_VideoEmpresa" />
            </div>
            <div>
                @foreach (var s in AtilsonCargoSpa.Pages.Servicios.ServiciosWeb.Todos)
                {
                    <a class="servicio" href="@s.Url">
                        <div class="servicio-icono"><i class="bi @s.Icono"></i></div>
                        <div>
                            <h3>@s.Nombre@if (s.EsPortal) {<span class="servicio-etiqueta">Plataforma propia</span>}</h3>
                            <p>@s.Resumen</p>
                        </div>
                        <i class="bi bi-chevron-right servicio-ir" aria-hidden="true"></i>
                    </a>
                }
            </div>
        </div>
    </section>

    <partial name="_VitrinaPortal" model='"landing"' />

    <section class="section-padding news-section" id="noticias" style="--iso: url('@isotipo')">
        <div class="contenedor">
            <div class="news-head">
                <div>
                    <h2 class="titular section-title">Actualidad marítima</h2>
                    <p class="section-subtitle">Lo último del sector, desde Mundo Marítimo.</p>
                </div>
                <div class="d-flex align-items-center gap-4 flex-wrap">
                    <a href="https://www.mundomaritimo.cl" target="_blank" rel="noopener" class="link-externo">Ir a Mundo Marítimo <i class="bi bi-box-arrow-up-right"></i></a>
                    <div class="slider-controles">
                        <button class="slider-btn slider-btn-prev" id="btn-prev-news" type="button" aria-label="Noticias anteriores"><i class="bi bi-chevron-left"></i></button>
                        <button class="slider-btn slider-btn-next" id="btn-next-news" type="button" aria-label="Más noticias"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
            </div>

            <div class="news-slider-wrapper">
                <div class="news-slider-track" id="news-track" aria-live="polite" aria-busy="true">
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="news-card news-esqueleto" aria-hidden="true">
                            <div class="img-wrapper"></div>
                            <div class="news-content"><div class="linea" style="width:40%"></div><div class="linea" style="width:90%;height:16px"></div><div class="linea" style="width:75%;height:16px"></div><div class="linea" style="width:60%"></div></div>
                        </div>
                    }
                </div>
            </div>
            <p class="text-center small mt-1 d-md-none" style="color: var(--gris);">Desliza para ver más noticias</p>
        </div>
    </section>

    <partial name="_Clientes" />

    <section class="global-section" id="global">
        <div class="contenedor global-grid">
            <div class="reveal stats-box">
                <h2 class="titular section-title">Conectando origen y destino</h2>
                <p class="section-subtitle">Desde San Antonio a Yantian, desde Valparaíso a Rotterdam. Coordinamos transbordos y rutas directas con la precisión que exige cada embarque.</p>
                <div class="stat-box">
                    <div>
                        <h4>+<span class="counter" data-target="50">0</span></h4>
                        <p>puertos activos</p>
                    </div>
                    <div>
                        <h4><span class="counter" data-target="24">0</span>/7</h4>
                        <p>monitoreo continuo</p>
                    </div>
                    <div>
                        <h4><span class="counter" data-target="100">0</span>%</h4>
                        <p>operaciones digitalizadas</p>
                    </div>
                </div>
            </div>
            <ul class="rutas" aria-label="Rutas frecuentes">
                <li class="ruta">
                    <div class="puerto"><strong>San Antonio</strong><span>CL SAI</span></div>
                    <div class="ruta-linea" aria-label="hacia"><i class="bi bi-arrow-right"></i></div>
                    <div class="puerto puerto-destino"><strong>Yantian</strong><span>CN YTN</span></div>
                </li>
                <li class="ruta">
                    <div class="puerto"><strong>Valparaíso</strong><span>CL VAP</span></div>
                    <div class="ruta-linea" aria-label="hacia"><i class="bi bi-arrow-right"></i></div>
                    <div class="puerto puerto-destino"><strong>Rotterdam</strong><span>NL RTM</span></div>
                </li>
            </ul>
        </div>
    </section>

    <section class="section-padding contact-section" id="contacto">
        <div class="contenedor contact-grid">
            <div>
                <h2 class="titular section-title">¿Listo para optimizar tu logística?</h2>
                <p class="section-subtitle">Cuéntanos qué mueves y hacia dónde. Revisamos tus rutas actuales y te proponemos cómo bajar costos operativos.</p>

                <div class="contacto-dato">
                    <i class="bi bi-geo-alt"></i>
                    <div><strong>Oficina central</strong><a href="https://www.google.com/maps/search/?api=1&query=Arturo+Prat+814%2C+Valpara%C3%ADso%2C+Chile" target="_blank" rel="noopener">A Prat 814 Of. 503, Valparaíso, V Región</a></div>
                </div>
                <div class="contacto-dato">
                    <i class="bi bi-envelope"></i>
                    <div><strong>Correo comercial</strong><a href="mailto:@Model.CorreoContacto">@Model.CorreoContacto</a></div>
                </div>
                @if (Model.Telefono != null)
                {
                    <div class="contacto-dato">
                        <i class="bi bi-telephone"></i>
                        <div><strong>Teléfono</strong><a href="@Model.TelefonoEnlace">@Model.Telefono</a></div>
                    </div>
                }
            </div>
            <div class="contact-card">
                <h3>Envíanos un mensaje</h3>
                <form method="post" asp-page-handler="Contacto" id="formContacto" novalidate>
                    <div class="trampa" aria-hidden="true"><label>No completar <input name="SitioWeb" tabindex="-1" autocomplete="off"></label></div>
                    <div class="row g-3">
                        <div class="col-md-6"><label for="c-nombre">Nombre completo</label><input id="c-nombre" name="Nombre" type="text" class="form-control form-control-custom" autocomplete="name" maxlength="100" required></div>
                        <div class="col-md-6"><label for="c-empresa">Empresa</label><input id="c-empresa" name="Empresa" type="text" class="form-control form-control-custom" autocomplete="organization" maxlength="120"></div>
                        <div class="col-12"><label for="c-correo">Correo corporativo</label><input id="c-correo" name="Correo" type="email" class="form-control form-control-custom" autocomplete="email" maxlength="120" required></div>
                        <div class="col-12"><label for="c-mensaje">¿En qué te podemos ayudar?</label><textarea id="c-mensaje" name="Mensaje" class="form-control form-control-custom" rows="4" maxlength="3000" required placeholder="Origen, destino, tipo de carga y frecuencia"></textarea></div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn-submit" id="btnContacto"><i class="bi bi-send"></i> <span>Enviar mensaje</span></button>
                        </div>
                    </div>
                    <div class="contacto-aviso" id="avisoContacto" role="status" aria-live="polite"></div>
                </form>
            </div>
        </div>
    </section>

@section Scripts {
    <script src="~/js/vitrina-portal.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // 1b. HERO: el globo muestra la foto de la diapositiva activa
            const carrusel = document.getElementById('heroCarousel');
            const fotos = document.querySelectorAll('#heroGlobo img');
            if (carrusel && fotos.length) {
                carrusel.addEventListener('slide.bs.carousel', function (e) {
                    fotos.forEach((f, i) => f.classList.toggle('is-activa', i === e.to));
                });
            }

            // 2. CONTADORES: se animan al entrar en pantalla
            function animateValue(obj, start, end, duration) {
                let startTimestamp = null;
                const step = (timestamp) => {
                    if (!startTimestamp) startTimestamp = timestamp;
                    const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                    obj.innerHTML = Math.floor(progress * (end - start) + start);
                    if (progress < 1) window.requestAnimationFrame(step);
                    else obj.innerHTML = end;
                };
                window.requestAnimationFrame(step);
            }

            function reveal() {
                var reveals = document.querySelectorAll(".reveal");
                for (var i = 0; i < reveals.length; i++) {
                    var windowHeight = window.innerHeight;
                    var elementTop = reveals[i].getBoundingClientRect().top;
                    if (elementTop < windowHeight - 100) {
                        if (!reveals[i].classList.contains("active")) {
                            reveals[i].classList.add("active");
                            if (reveals[i].classList.contains("stats-box")) {
                                let counters = reveals[i].querySelectorAll(".counter");
                                counters.forEach(c => animateValue(c, 0, parseInt(c.getAttribute("data-target")), 2500));
                            }
                        }
                    }
                }
            }
            window.addEventListener("scroll", reveal, { passive: true });
            reveal();

            // 4. NOTICIAS DE MUNDO MARÍTIMO
            // Las trae el servidor (Services/NoticiasMaritimasService.cs): RSS o portada del sitio,
            // con la imagen de cada artículo servida por https desde la propia landing.
            const newsTrack = document.getElementById('news-track');
            const btnNextNews = document.getElementById('btn-next-news');
            const btnPrevNews = document.getElementById('btn-prev-news');
            const esc = (s) => String(s ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));

            fetch('@Url.Page("/Index", "Noticias")', { headers: { 'Accept': 'application/json' } })
                .then(res => res.ok ? res.json() : Promise.reject(new Error('HTTP ' + res.status)))
                .then(data => {
                    const lista = (data && Array.isArray(data.noticias)) ? data.noticias.filter(n => n.titulo && n.enlace) : [];
                    if (!lista.length) throw new Error('Sin noticias (' + (data && data.fuente) + ')');
                    renderNews(lista);
                })
                .catch(error => {
                    console.warn('Noticias de Mundo Marítimo no disponibles:', error);
                    sinNoticias();
                });

            function tarjeta(n) {
                const img = n.imagen ? `<img src="${esc(n.imagen)}" alt="" class="news-img" loading="lazy" decoding="async" onerror="this.remove()">` : '';
                return `
                    <a class="news-card" href="${esc(n.enlace)}" target="_blank" rel="noopener">
                        <div class="img-wrapper">${img}</div>
                        <div class="news-content">
                            <span class="news-date"><span class="news-fuente">Mundo Marítimo</span>${n.fecha ? ' · ' + esc(n.fecha) : ''}</span>
                            <h3 class="news-title">${esc(n.titulo)}</h3>
                            ${n.resumen ? `<p class="news-desc">${esc(n.resumen)}</p>` : ''}
                            <span class="news-link">Leer en Mundo Marítimo <i class="bi bi-box-arrow-up-right"></i></span>
                        </div>
                    </a>`;
            }

            function renderNews(lista) {
                newsTrack.innerHTML = lista.map(tarjeta).join('');
                newsTrack.setAttribute('aria-busy', 'false');
                initSlider();
            }

            function sinNoticias() {
                newsTrack.setAttribute('aria-busy', 'false');
                newsTrack.innerHTML = `
                    <div class="news-vacio">
                        <p><strong>Las noticias no están disponibles en este momento.</strong>Puedes leer la actualidad marítima directamente en Mundo Marítimo.</p>
                        <a href="https://www.mundomaritimo.cl" target="_blank" rel="noopener" class="link-externo">Ir a Mundo Marítimo <i class="bi bi-box-arrow-up-right"></i></a>
                    </div>`;
                document.querySelectorAll('.slider-controles, [data-ticker]').forEach(el => el.classList.add('d-none'));
            }

            function initSlider() {
                if (!btnNextNews || !btnPrevNews) return;
                const paso = () => {
                    const card = newsTrack.querySelector('.news-card');
                    return card ? card.getBoundingClientRect().width + 30 : 410; // ancho + separación
                };
                const actualizar = () => {
                    const max = newsTrack.scrollWidth - newsTrack.clientWidth - 8;
                    btnPrevNews.disabled = newsTrack.scrollLeft <= 8;
                    btnNextNews.disabled = newsTrack.scrollLeft >= max;
                };
                btnNextNews.addEventListener('click', () => newsTrack.scrollBy({ left: paso(), behavior: 'smooth' }));
                btnPrevNews.addEventListener('click', () => newsTrack.scrollBy({ left: -paso(), behavior: 'smooth' }));
                newsTrack.addEventListener('scroll', () => window.requestAnimationFrame(actualizar), { passive: true });
                window.addEventListener('resize', actualizar);
                actualizar();
            }

            // 5. CONTACTO: envía el mensaje al equipo comercial por correo
            const formContacto = document.getElementById('formContacto');
            if (formContacto) formContacto.addEventListener('submit', async function (e) {
                e.preventDefault();
                const aviso = document.getElementById('avisoContacto');
                const btn = document.getElementById('btnContacto');
                formContacto.querySelectorAll('.is-invalid').forEach(x => x.classList.remove('is-invalid'));
                const avisar = (tipo, html) => { aviso.className = 'contacto-aviso ' + tipo; aviso.innerHTML = html; };

                const faltante = [...formContacto.querySelectorAll('[required]')].find(x => !x.checkValidity());
                if (faltante) {
                    faltante.classList.add('is-invalid'); faltante.focus();
                    avisar('error', faltante.type === 'email' && faltante.value ? 'Revisa el correo: debe tener el formato nombre@empresa.cl.' : 'Completa tu nombre, correo y mensaje.');
                    return;
                }
                btn.disabled = true; btn.querySelector('span').textContent = 'Enviando…';
                try {
                    const res = await fetch(formContacto.action, { method: 'POST', body: new FormData(formContacto), headers: { 'Accept': 'application/json' } });
                    const r = await res.json();
                    if (r.ok) {
                        avisar('ok', esc(r.mensaje));
                        formContacto.reset();
                    } else {
                        if (r.campo) { const c = formContacto.querySelector(`[name="${r.campo}"]`); if (c) { c.classList.add('is-invalid'); c.focus(); } }
                        avisar('error', esc(r.mensaje) + (r.mailto ? ` <a href="${esc(r.mailto)}">Escribir el correo</a>` : ''));
                    }
                } catch (err) {
                    avisar('error', 'No pudimos enviar tu mensaje. Escríbenos a <a href="mailto:@Model.CorreoContacto">@Model.CorreoContacto</a>.');
                } finally {
                    btn.disabled = false; btn.querySelector('span').textContent = 'Enviar mensaje';
                }
            });
        });
    </script>
}
