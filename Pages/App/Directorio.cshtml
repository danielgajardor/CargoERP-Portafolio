@page
@model AtilsonCargoSpa.Pages.App.DirectorioModel
@using AtilsonCargoSpa.Services
@{
    ViewData["Title"] = "Directorio del equipo";
}
<link rel="stylesheet" href="~/css/perfil.css" asp-append-version="true" />
<style>
    .dir-barra { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-bottom: 18px; }
    .dir-buscar { position: relative; flex: 1 1 280px; max-width: 420px; }
    .dir-buscar i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #5d5872; }
    .dir-buscar input { width: 100%; height: 42px; border: 1px solid #e3dfee; border-radius: 999px; padding: 0 16px 0 40px; font-size: 14.5px; }
    .dir-buscar input:focus { outline: none; border-color: #443094; box-shadow: 0 0 0 4px rgba(68,48,148,.14); }
    .dir-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
    .dir-card { background: #fff; border: 1px solid #e3dfee; border-radius: 16px; padding: 18px; display: flex; gap: 14px; align-items: flex-start; }
    .dir-av { position: relative; flex: none; width: 56px; height: 56px; }
    .dir-av img, .dir-av .ini { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; }
    .dir-av .ini { display: grid; place-items: center; background: linear-gradient(145deg, #443094, #160e2f); color: #fff; font-weight: 800; font-size: 19px; }
    .dir-card h3 { font-size: 15.5px; font-weight: 800; margin: 0; }
    .dir-card .cargo { font-size: 13.5px; color: #1e1835; margin: 2px 0 0; }
    .dir-card .rol { font-size: 12.5px; color: #5d5872; margin: 0 0 8px; }
    .dir-contacto { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 10px; font-size: 13px; }
    .dir-contacto a { color: #443094; text-decoration: none; font-weight: 600; }
    .dir-contacto a:hover { text-decoration: underline; }
</style>

<div class="pf" style="max-width:none">
    <header class="pf-cabecera">
        <h1>Directorio del equipo</h1>
        <p>@Model.Personas.Count personas. Cada uno completa su foto, cargo y teléfono en <a asp-page="/App/Perfil">Mi perfil</a>.</p>
    </header>
    @if (Model.FaltaScript)
    {
        <div class="pf-aviso error"><i class="bi bi-exclamation-triangle"></i><span>@PerfilUsuarioService.ScriptPendiente</span></div>
    }
    <div class="dir-barra">
        <label class="dir-buscar"><i class="bi bi-search" aria-hidden="true"></i><input type="search" id="dirBuscar" placeholder="Buscar por nombre, cargo o área" aria-label="Buscar en el directorio" /></label>
    </div>
    <div class="dir-grid" id="dirGrid">
        @foreach (var x in Model.Personas)
        {
            var u = x.Usuario; var p = x.Perfil;
            <article class="dir-card" data-texto="@($"{u.NombreCompleto} {p?.Cargo} {u.Rol}".ToLower())">
                <div class="dir-av">
                    @if (p?.FotoUrl != null) { <img src="@p.FotoUrl" alt="" loading="lazy" /> } else { <div class="ini" aria-hidden="true">@PerfilUsuarioService.Iniciales(u.NombreCompleto)</div> }
                </div>
                <div style="min-width:0">
                    <h3>@u.NombreCompleto</h3>
                    @if (!string.IsNullOrEmpty(p?.Cargo)) { <p class="cargo">@p.Cargo</p> }
                    <p class="rol">@u.Rol</p>
                    <div class="dir-contacto">
                        <a href="mailto:@u.Correo"><i class="bi bi-envelope"></i> Correo</a>
                        @if (!string.IsNullOrEmpty(p?.Telefono))
                        {
                            <a href="tel:@System.Text.RegularExpressions.Regex.Replace(p.Telefono, @"[^\d+]", "")"><i class="bi bi-telephone"></i> @p.Telefono</a>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
    <p class="pf-intro mt-3" id="dirVacio" hidden>Nadie coincide con la búsqueda.</p>
</div>

@section Scripts {
    <script>
        (function () {
            const buscar = document.getElementById('dirBuscar');
            function aplicar() {
                const q = (buscar.value || '').trim().toLowerCase();
                let n = 0;
                document.querySelectorAll('#dirGrid .dir-card').forEach(c => {
                    const ver = !q || c.dataset.texto.includes(q);
                    c.hidden = !ver; if (ver) n++;
                });
                document.getElementById('dirVacio').hidden = n > 0;
            }
            buscar.addEventListener('input', aplicar);
        })();
    </script>
}
