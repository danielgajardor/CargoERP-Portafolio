@page "{id:int?}"
@model AtilsonCargoSpa.Pages.App.Navieras.EditModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nueva naviera" : $"Naviera: {Model.NombreOriginal}";
}
<link rel="stylesheet" href="~/css/maestros.css" asp-append-version="true" />

<div class="container-fluid py-4 mx mx-ficha-wrap">
    <header class="mx-cabecera">
        <div>
            <div class="mx-miga"><a asp-page="./Index">Maestros › Navieras</a></div>
            <h1 class="mx-titulo">@(Model.EsNuevo ? "Nueva naviera" : Model.NombreOriginal)</h1>
            <p class="mx-subtitulo">@(Model.EsNuevo ? "Registra una línea naviera." : "Edita los datos de la naviera. Cada cambio queda registrado con tu usuario, fecha y hora.")</p>
        </div>
        <div class="mx-acciones">
            <a asp-page="./Index" class="mx-btn mx-btn-secundario"><i class="bi bi-arrow-left"></i> Volver a la lista</a>
        </div>
    </header>

    <form method="post" data-mx-ficha novalidate>
        <input type="hidden" asp-for="Form.Id" />
        <input type="hidden" asp-for="Form.Version" />

        <div asp-validation-summary="All" class="mx-errores" role="alert"><strong>Revisa lo siguiente antes de guardar:</strong></div>

        <div class="mx-ficha">
            <div>
                <section class="mx-tarjeta">
                    <div class="mx-tarjeta-cab"><i class="bi bi-water"></i><h2>Datos de la naviera</h2></div>
                    <div class="mx-tarjeta-cuerpo">
                        <div class="mx-campos">
                            <div class="mx-campo c8">
                                <label asp-for="Form.Nombre">Nombre<span class="req">*</span></label>
                                <input asp-for="Form.Nombre" class="mx-input" maxlength="100" required autocomplete="off" />
                                <span asp-validation-for="Form.Nombre" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c4">
                                <label>Estado</label>
                                <div class="mx-estado-toggle" role="radiogroup" aria-label="Estado">
                                    <input type="radio" id="estActivo" name="Form.Activo" value="true" checked="@Model.Form.Activo" />
                                    <label for="estActivo" class="mx-est-activo">Activa</label>
                                    <input type="radio" id="estInactivo" name="Form.Activo" value="false" checked="@(!Model.Form.Activo)" />
                                    <label for="estInactivo" class="mx-est-inactivo">Inactiva</label>
                                </div>
                            </div>
                            <div class="mx-campo c8">
                                <label asp-for="Form.LinkTracking">Enlace de seguimiento</label>
                                <input asp-for="Form.LinkTracking" class="mx-input" type="url" maxlength="500" placeholder="https://…" />
                                <span asp-validation-for="Form.LinkTracking" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c4">
                                <label asp-for="Form.Color">Color en tableros</label>
                                <input asp-for="Form.Color" type="color" class="mx-input" style="padding:3px 6px;height:38px;" />
                                <span asp-validation-for="Form.Color" class="mx-error-campo"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="mx-tarjeta">
                    <div class="mx-tarjeta-cab"><i class="bi bi-calendar-x"></i><h2>Penalidad por roleo o cancelación</h2></div>
                    <div class="mx-tarjeta-cuerpo">
                        <div class="mx-campos">
                            <div class="mx-campo c4">
                                <label asp-for="Form.DiasPenalidadRoleo">Ventana antes del zarpe (días)</label>
                                <input asp-for="Form.DiasPenalidadRoleo" type="number" min="0" max="90" step="1" class="mx-input" />
                                <span asp-validation-for="Form.DiasPenalidadRoleo" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c4">
                                <label asp-for="Form.MontoPenalidadRoleoUsd">Monto sugerido (USD)</label>
                                <input asp-for="Form.MontoPenalidadRoleoUsd" inputmode="decimal" class="mx-input" placeholder="Opcional" />
                                <span asp-validation-for="Form.MontoPenalidadRoleoUsd" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c12">
                                <label class="mx-check">
                                    <input asp-for="Form.PenalidadRoleoSiempreAplica" />
                                    <span>La penalidad aplica a todo booking (Spot y Contrato)
                                        <small>Si no se marca, dentro de la ventana solo se sugiere la penalidad para bookings Spot.</small>
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="mx-tarjeta">
                    <div class="mx-tarjeta-cab"><i class="bi bi-door-open"></i><h2>Gate</h2></div>
                    <div class="mx-tarjeta-cuerpo">
                        <label class="mx-check">
                            <input asp-for="Form.AplicaTarifaGatePlana" />
                            <span>La naviera cobra el Gate con tarifa plana
                                <small>En Control Financiero el Gate se asigna a la naviera como proveedor.</small>
                            </span>
                        </label>
                    </div>
                </section>

                <div class="mx-pie">
                    <span class="mx-pie-nota"><i class="bi bi-shield-check"></i> Se guardará a nombre de <strong>@AtilsonCargoSpa.Services.MaestrosAuditoria.Usuario(User)</strong>.</span>
                    <a asp-page="./Index" class="mx-btn mx-btn-secundario">Cancelar</a>
                    <button type="submit" class="mx-btn mx-btn-primario" data-mx-guardar><i class="bi bi-check2"></i> <span>@(Model.EsNuevo ? "Crear naviera" : "Guardar cambios")</span></button>
                </div>
            </div>

            @if (!Model.EsNuevo)
            {
                <partial name="_MaestroRegistro" model="Model.Registro" />
            }
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/maestros.js" asp-append-version="true"></script>
}
