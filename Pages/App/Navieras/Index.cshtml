@page
@model AtilsonCargoSpa.Pages.App.Navieras.IndexModel
@using AtilsonCargoSpa.Services
@{
    ViewData["Title"] = "Maestro de Navieras";
}
<link rel="stylesheet" href="~/css/maestros.css" asp-append-version="true" />

<div class="container-fluid py-4 mx">
    <header class="mx-cabecera">
        <div>
            <div class="mx-miga">Maestros</div>
            <h1 class="mx-titulo">Navieras</h1>
            <p class="mx-subtitulo">Líneas navieras, su enlace de seguimiento y las reglas de penalidad por roleo/cancelación.</p>
        </div>
        <div class="mx-acciones">
            <a asp-page="./Edit" class="mx-btn mx-btn-primario"><i class="bi bi-plus-lg"></i> Nueva naviera</a>
        </div>
    </header>

    <div class="mx-barra">
        <div class="mx-buscar">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" data-mx-filtro value="@Model.Q" placeholder="Buscar naviera…" aria-label="Buscar naviera" autocomplete="off" />
        </div>
        <nav class="mx-segmentos" aria-label="Estado">
            <a asp-route-estado="activos" class="@(Model.Estado == "activos" ? "activo" : "")">Activas<span class="mx-cuenta">@Model.TotalActivos</span></a>
            <a asp-route-estado="inactivos" class="@(Model.Estado == "inactivos" ? "activo" : "")">Inactivas<span class="mx-cuenta">@Model.TotalInactivos</span></a>
            <a asp-route-estado="todos" class="@(Model.Estado == "todos" ? "activo" : "")">Todas</a>
        </nav>
        <span class="mx-total" data-mx-total>@Model.Navieras.Count registros</span>
    </div>

    <div class="mx-tabla-wrap">
        <table class="mx-tabla" data-mx-tabla>
            <thead>
                <tr>
                    <th>Naviera</th>
                    <th>Seguimiento</th>
                    <th>Penalidad roleo</th>
                    <th>Gate</th>
                    <th>Última modificación</th>
                    <th>Estado</th>
                    <th class="mx-col-acciones"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model.Navieras)
                {
                    bool activa = n.Activo == 1;
                    <tr data-mx-texto="@n.NombreNaviera" class="@(activa ? "" : "mx-inactivo") @(Model.Resaltar == n.Id ? "mx-resaltado" : "")">
                        <td>
                            <span class="mx-color" style="background:@(MaestrosAuditoria.ColorValido(n.ColorRepresentativo) ?? "#94a3b8")"></span>
                            <a asp-page="./Edit" asp-route-id="@n.Id" class="mx-nombre text-decoration-none">@n.NombreNaviera</a>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(n.LinkTracking) && n.LinkTracking.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@n.LinkTracking" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Abrir</a>
                            }
                            else
                            {
                                <span class="text-muted">Sin enlace</span>
                            }
                        </td>
                        <td>
                            @(n.PenalidadRoleoSiempreAplica ? "Siempre" : "Solo Spot") · @n.DiasPenalidadRoleo días
                            @if (n.MontoPenalidadRoleoUsd.HasValue)
                            {
                                <span class="mx-sec">USD @n.MontoPenalidadRoleoUsd.Value.ToString("N2")</span>
                            }
                        </td>
                        <td>
                            @if (n.AplicaTarifaGatePlana)
                            {
                                <span class="mx-pill mx-pill-info">Tarifa plana</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="mx-mod">
                            @(string.IsNullOrWhiteSpace(n.UsuarioModificador) ? "—" : n.UsuarioModificador)
                            <small>@MaestrosAuditoria.FormatoFecha(n.FechaModificacion)</small>
                        </td>
                        <td>
                            @if (activa)
                            {
                                <span class="mx-pill mx-pill-ok">Activa</span>
                            }
                            else
                            {
                                <span class="mx-pill mx-pill-off">Inactiva</span>
                            }
                        </td>
                        <td class="mx-col-acciones">
                            <a asp-page="./Edit" asp-route-id="@n.Id" class="mx-btn mx-btn-secundario mx-btn-sm"><i class="bi bi-pencil"></i> Editar</a>
                            <form method="post" asp-page-handler="CambiarEstado" asp-route-id="@n.Id" asp-route-activar="@(!activa)" asp-route-estado="@Model.Estado"
                                  data-mx-confirmar="@(activa ? $"¿Desactivar la naviera «{n.NombreNaviera}»? Dejará de aparecer al crear operaciones." : $"¿Reactivar la naviera «{n.NombreNaviera}»?")">
                                @if (activa)
                                {
                                    <button type="submit" class="mx-btn mx-btn-peligro mx-btn-sm" title="Desactivar" aria-label="Desactivar"><i class="bi bi-slash-circle"></i></button>
                                }
                                else
                                {
                                    <button type="submit" class="mx-btn mx-btn-ok mx-btn-sm"><i class="bi bi-arrow-counterclockwise"></i> Reactivar</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
                <tr data-mx-sin-coincidencias hidden><td colspan="7" class="mx-vacio"><i class="bi bi-search"></i>Ninguna naviera coincide con la búsqueda.</td></tr>
                @if (!Model.Navieras.Any())
                {
                    <tr><td colspan="7" class="mx-vacio"><i class="bi bi-water"></i>No hay navieras @(Model.Estado == "inactivos" ? "inactivas" : "registradas").</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/maestros.js" asp-append-version="true"></script>
}
