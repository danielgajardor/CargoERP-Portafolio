@page
@model AtilsonCargoSpa.Pages.App.Equipo.PermisosModel
@using AtilsonCargoSpa.Helpers
@{
    ViewData["Title"] = "Permisos por usuario";
}
<link rel="stylesheet" href="~/css/maestros.css" asp-append-version="true" />
<style>
    .pv-grid { display: grid; grid-template-columns: 290px minmax(0, 1fr); gap: 18px; align-items: start; }
    @@media (max-width: 900px) { .pv-grid { grid-template-columns: 1fr; } }
    .pv-card { background: #fff; border: 1px solid var(--mx-line); border-radius: 12px; box-shadow: var(--mx-shadow); }
    .pv-usuarios { padding: 8px; max-height: 70vh; overflow: auto; }
    .pv-buscar { width: 100%; height: 34px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0 10px; font-size: 13px; margin-bottom: 6px; }
    .pv-u { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px; color: var(--mx-ink); text-decoration: none; }
    .pv-u:hover { background: #f8fafc; color: var(--mx-ink); }
    .pv-u.activo { background: #f3e8ff; }
    .pv-u strong { display: block; font-size: 13px; font-weight: 700; }
    .pv-u small { display: block; font-size: 11px; color: var(--mx-muted); }
    .pv-u.inactivo strong { color: #94a3b8; }
    .pv-chip { flex-shrink: 0; font-size: 9.5px; font-weight: 800; border-radius: 999px; padding: 1px 8px; white-space: nowrap; }
    .pv-chip--rol { color: #475569; background: #f1f5f9; }
    .pv-chip--prop { color: #6d2d9e; background: #f3e8ff; border: 1px solid #e4d9f1; }
    .pv-cab { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; padding: 16px 18px; border-bottom: 1px solid var(--mx-line); }
    .pv-cab h2 { font-size: 17px; font-weight: 800; margin: 0; color: var(--mx-brand-dark); }
    .pv-cab p { margin: 3px 0 0; font-size: 12.5px; color: var(--mx-muted); }
    .pv-modulos { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; padding: 16px 18px; }
    .pv-mod { border: 1px solid var(--mx-line); border-radius: 10px; overflow: hidden; }
    .pv-mod-cab { display: flex; align-items: center; gap: 8px; padding: 9px 12px; background: #f8fafc; border-bottom: 1px solid var(--mx-line); margin: 0; cursor: pointer; font-size: 13px; font-weight: 800; color: var(--mx-ink); }
    .pv-mod-cab i { color: #6d2d9e; }
    .pv-mod-cab .pv-cuenta { margin-left: auto; font-size: 10.5px; font-weight: 700; color: var(--mx-muted); }
    .pv-vista { display: flex; align-items: flex-start; gap: 8px; padding: 7px 12px; margin: 0; font-size: 12.5px; cursor: pointer; border-top: 1px dashed #eef2f6; }
    .pv-vista:first-of-type { border-top: 0; }
    .pv-vista .pv-difiere { margin-left: auto; font-size: 9px; font-weight: 800; color: #b45309; white-space: nowrap; }
    .pv-pie { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; padding: 12px 18px 16px; border-top: 1px dashed var(--mx-line); }
    .pv-pie small { color: var(--mx-muted); font-size: 12px; }
    .pv-herr { width: auto; min-width: 170px; font-size: 12px; }
    .pv-matriz th { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .3px; color: var(--mx-muted); background: #f8fafc; vertical-align: bottom; }
    .pv-matriz th i { color: #6d2d9e; font-size: 13px; }
    .pv-matriz td { font-size: 12.5px; vertical-align: middle; }
    .pv-matriz tr.pv-inactivo td { color: #94a3b8; }
    .pv-celda { display: inline-block; min-width: 44px; font-size: 11px; font-weight: 800; border-radius: 6px; padding: 2px 6px; }
    .pv-celda.todo { background: #dcfce7; color: #166534; }
    .pv-celda.parte { background: #fef9c3; color: #854d0e; }
    .pv-celda.nada { background: #f1f5f9; color: #94a3b8; }
    .pv-hist-campo { display: inline-block; font-size: 10px; font-weight: 800; border-radius: 999px; padding: 1px 8px; margin-right: 6px; background: #f1f5f9; color: #475569; }
    .pv-hist-campo.agrega { background: #dcfce7; color: #166534; }
    .pv-hist-campo.quita { background: #fee2e2; color: #991b1b; }
    .pv-dato { border: 1px solid var(--mx-line); border-radius: 10px; padding: 10px 12px; height: 100%; }
    .pv-dato strong { display: block; font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; color: var(--mx-muted); margin-bottom: 3px; }
    .pv-dato span { font-size: 13.5px; overflow-wrap: anywhere; }
</style>

<div class="container-fluid py-4 mx">
    <header class="mx-cabecera">
        <div>
            <div class="mx-miga">Maestros › Equipo Atilson</div>
            <h1 class="mx-titulo">Permisos por usuario</h1>
            <p class="mx-subtitulo">Elige qué vistas del menú ve cada persona: el módulo completo o vista por vista. Sin selección propia, cada persona ve lo que da su rol.</p>
        </div>
        <a asp-page="/App/Equipo/Index" asp-route-vista="usuarios" class="btn btn-outline-secondary btn-sm"><i class="bi bi-people me-1"></i> Usuarios del equipo</a>
    </header>

    @if (Model.FaltaScript)
    {
        <div class="alert alert-warning" style="font-size:13px;"><i class="bi bi-exclamation-triangle-fill"></i> Falta correr <code>Sql/2026-11_vistas_por_usuario.sql</code> en la base: mientras tanto todos ven lo de su rol y no se pueden guardar permisos.</div>
    }
    @if (TempData["PermisosOk"] is string ok)
    {
        <div class="alert alert-success" style="font-size:13px;"><i class="bi bi-check-circle-fill"></i> @ok</div>
    }
    @if (TempData["PermisosError"] is string err)
    {
        <div class="alert alert-danger" style="font-size:13px;"><i class="bi bi-x-circle-fill"></i> @err</div>
    }

    <nav class="mx-segmentos mb-3" aria-label="Secciones">
        <a asp-route-tab="persona" asp-route-id="@Model.Id" class="@(Model.Tab == "persona" ? "activo" : "")"><i class="bi bi-person-check me-1"></i>Por persona</a>
        <a asp-route-tab="resumen" class="@(Model.Tab == "resumen" ? "activo" : "")"><i class="bi bi-grid-3x3-gap me-1"></i>Resumen del equipo</a>
        <a asp-route-tab="historial" class="@(Model.Tab == "historial" ? "activo" : "")"><i class="bi bi-clock-history me-1"></i>Historial de cambios</a>
        <a asp-route-tab="correo" class="@(Model.Tab == "correo" ? "activo" : "")"><i class="bi bi-envelope-check me-1"></i>Correo del sistema</a>
    </nav>

    @if (Model.Tab == "resumen")
    {
        <div class="pv-card">
            <div class="pv-cab"><div><h2>Resumen del equipo</h2><p>Vistas que ve cada persona por módulo (propias o las de su rol). Clic en una persona para cambiarlas.</p></div></div>
            <div class="table-responsive">
                <table class="table pv-matriz mb-0">
                    <thead>
                        <tr>
                            <th>Persona</th>
                            <th>Rol</th>
                            @foreach (var m in VistasCatalogo.Modulos) { <th class="text-center" title="@m.Nombre"><i class="bi @m.Icono"></i><span class="d-block">@m.Nombre.Split(" (")[0]</span></th> }
                            <th class="text-center">Origen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Usuarios)
                        {
                            var ef = Model.Efectivas.TryGetValue(u.Id, out var e) ? e : new HashSet<string>();
                            <tr class="@(u.Activo == 1 ? "" : "pv-inactivo")">
                                <td><a asp-route-tab="persona" asp-route-id="@u.Id" class="fw-bold">@u.NombreCompleto</a></td>
                                <td>@u.Rol</td>
                                @foreach (var m in VistasCatalogo.Modulos)
                                {
                                    int n = m.Vistas.Count(v => ef.Contains(v.Clave));
                                    <td class="text-center"><span class="pv-celda @(n == 0 ? "nada" : (n == m.Vistas.Length ? "todo" : "parte"))" title="@string.Join(", ", m.Vistas.Where(v => ef.Contains(v.Clave)).Select(v => v.Nombre.Split(" (")[0]))">@(n == 0 ? "—" : (n == m.Vistas.Length ? "Todo" : $"{n}/{m.Vistas.Length}"))</span></td>
                                }
                                <td class="text-center"><span class="pv-chip @(Model.ConSeleccion.Contains(u.Id) ? "pv-chip--prop" : "pv-chip--rol")">@(Model.ConSeleccion.Contains(u.Id) ? "Personalizado" : "Según rol")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.Tab == "historial")
    {
        <div class="pv-card">
            <div class="pv-cab"><div><h2>Historial de cambios de permisos</h2><p>Quién cambió las vistas de cada persona, cuándo y qué agregó o quitó.</p></div></div>
            <div class="table-responsive">
                <table class="table pv-matriz mb-0">
                    <thead><tr><th style="width:150px;">Fecha y hora</th><th>Persona</th><th>Cambio</th><th style="width:170px;">Hecho por</th></tr></thead>
                    <tbody>
                        @foreach (var (c, persona) in Model.Historial)
                        {
                            <tr>
                                <td class="text-nowrap">@c.FechaCambio.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold">@persona</td>
                                <td>
                                    <span class="pv-hist-campo @(c.Campo.Contains("quitadas") ? "quita" : (c.Campo.Contains("agregadas") ? "agrega" : ""))">@c.Campo</span>
                                    <span>@(c.ValorNuevo ?? c.ValorAnterior)</span>
                                    <small class="d-block text-muted">@c.Comentario</small>
                                </td>
                                <td>@c.Usuario</td>
                            </tr>
                        }
                        @if (!Model.Historial.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">Todavía no hay cambios de permisos registrados.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.Tab == "correo")
    {
        <div class="pv-card">
            <div class="pv-cab"><div><h2>Correo del sistema</h2><p>Todos los correos (confirmaciones de zarpe y arribo, avisos de llegada, reservas, registros…) salen desde esta cuenta.</p></div></div>
            <div class="p-3">
                <div class="row g-3 mb-3">
                    <div class="col-md-4"><div class="pv-dato"><strong>Remitente</strong><span>@(string.IsNullOrWhiteSpace(Model.CorreoRemitente) ? "Sin configurar" : Model.CorreoRemitente)</span></div></div>
                    <div class="col-md-4"><div class="pv-dato"><strong>Servidor</strong><span>@Model.CorreoServidor</span></div></div>
                    <div class="col-md-4"><div class="pv-dato"><strong>Estado</strong><span class="@(Model.EstadoCorreo.Valido ? "text-success" : "text-danger") fw-bold">@Model.EstadoCorreo.Mensaje</span></div></div>
                </div>
                @if (!Model.EstadoCorreo.Valido)
                {
                    <div class="alert alert-warning small">La contraseña no se guarda en el código. En el equipo donde corre el sistema, en la carpeta del proyecto: <code>dotnet user-secrets set "Smtp:Password" "LA_CONTRASEÑA"</code> (en un servidor, la variable de entorno <code>Smtp__Password</code>). Con Microsoft 365, la cuenta debe tener habilitado "SMTP autenticado".</div>
                }
                <form method="post" asp-page-handler="CorreoPrueba" class="d-flex gap-2 flex-wrap align-items-end">
                    <div>
                        <label class="form-label fw-bold small mb-1" for="pvDestino">Enviar un correo de prueba a</label>
                        <input type="email" id="pvDestino" name="destino" class="form-control form-control-sm" style="min-width:280px;" value="@Model.CorreoUsuarioActual" required />
                    </div>
                    <button type="submit" class="btn btn-dark btn-sm"><i class="bi bi-send me-1"></i> Enviar prueba</button>
                </form>
            </div>
        </div>
    }
    else
    {
    <div class="pv-grid">
        <div class="pv-card pv-usuarios">
            <input type="search" class="pv-buscar" placeholder="Buscar persona…" oninput="pvFiltrar(this.value)" />
            @foreach (var u in Model.Usuarios)
            {
                bool prop = Model.ConSeleccion.Contains(u.Id);
                <a class="pv-u @(u.Id == Model.Seleccionado?.Id ? "activo" : "") @(u.Activo == 1 ? "" : "inactivo")" asp-route-id="@u.Id" data-pv-texto="@((u.NombreCompleto + " " + u.Rol + " " + u.Correo).ToLowerInvariant())">
                    <span>
                        <strong>@u.NombreCompleto</strong>
                        <small>@(u.Rol + (u.Activo == 1 ? "" : " · inactivo"))</small>
                    </span>
                    <span class="pv-chip @(prop ? "pv-chip--prop" : "pv-chip--rol")">@(prop ? "Personalizado" : "Según rol")</span>
                </a>
            }
        </div>

        @if (Model.Seleccionado is { } sel)
        {
            <form method="post" class="pv-card" id="pvForm">
                <input type="hidden" name="id" value="@sel.Id" />
                <div class="pv-cab">
                    <div>
                        <h2>@sel.NombreCompleto</h2>
                        <p>
                            Rol <strong>@sel.Rol</strong>@(sel.PermisoTarifasTransporte ? " · permiso de tarifas de transporte" : "") ·
                            @if (Model.Personalizado) { <span>vistas elegidas por un administrador (@Model.Modificado)</span> }
                            else { <span>ve lo que da su rol</span> }
                        </p>
                        @if (Model.SeleccionadoEsAdmin)
                        {
                            <p><i class="bi bi-shield-lock"></i> Es administrador: siempre puede entrar a Equipo y Permisos por usuario.</p>
                        }
                    </div>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <select class="form-select form-select-sm pv-herr" onchange="pvAplicar('rol', this)" title="Marcar las vistas que da un rol">
                            <option value="">Aplicar perfil de rol…</option>
                            @foreach (var r in Model.PerfilesRol.Keys) { <option value="@r">@r</option> }
                        </select>
                        <select class="form-select form-select-sm pv-herr" onchange="pvAplicar('persona', this)" title="Copiar las vistas de otra persona">
                            <option value="">Copiar de…</option>
                            @foreach (var u in Model.Usuarios.Where(x => x.Id != sel.Id && x.Activo == 1)) { <option value="@u.Id">@u.NombreCompleto</option> }
                        </select>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="pvTodas(true)">Marcar todo</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="pvTodas(false)">Desmarcar todo</button>
                    </div>
                </div>

                <div class="pv-modulos">
                    @foreach (var m in VistasCatalogo.Modulos)
                    {
                        <div class="pv-mod" data-pv-mod="@m.Clave">
                            <label class="pv-mod-cab">
                                <input type="checkbox" class="form-check-input m-0 pv-mod-chk" />
                                <i class="bi @m.Icono"></i> @m.Nombre
                                <span class="pv-cuenta"></span>
                            </label>
                            @foreach (var v in m.Vistas)
                            {
                                bool difiere = Model.Personalizado && Model.Marcadas.Contains(v.Clave) != Model.PorRol.Contains(v.Clave);
                                <label class="pv-vista">
                                    <input type="checkbox" class="form-check-input m-0 pv-chk" name="vistas" value="@v.Clave" @(Model.Marcadas.Contains(v.Clave) ? "checked" : "") />
                                    <span>@v.Nombre</span>
                                    @if (difiere)
                                    {
                                        <span class="pv-difiere" title="Distinto de lo que da su rol">@(Model.PorRol.Contains(v.Clave) ? "Quitada" : "Agregada")</span>
                                    }
                                </label>
                            }
                        </div>
                    }
                </div>

                <div class="pv-pie">
                    <small><i class="bi bi-info-circle"></i> El Dashboard lo ven todos. Los cambios aplican en la próxima página que abra la persona, sin volver a iniciar sesión.</small>
                    <div class="d-flex gap-2">
                        @if (Model.Personalizado)
                        {
                            <button type="submit" asp-page-handler="Restablecer" class="btn btn-outline-danger btn-sm" formnovalidate
                                    onclick="return confirm('¿Volver a lo que da el rol? Se borran las vistas elegidas para esta persona.');">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Restablecer según rol
                            </button>
                        }
                        <button type="submit" asp-page-handler="Guardar" class="btn btn-dark btn-sm"><i class="bi bi-check2-circle me-1"></i> Guardar permisos</button>
                    </div>
                </div>
            </form>
        }
        else
        {
            <div class="pv-card p-4 text-muted">No hay usuarios del equipo.</div>
        }
    </div>
    }
</div>

<script>
    function pvFiltrar(t) {
        t = (t || '').trim().toLowerCase();
        document.querySelectorAll('.pv-u').forEach(a => { a.style.display = !t || a.dataset.pvTexto.includes(t) ? '' : 'none'; });
    }
    function pvActualizar(mod) {
        const chks = Array.from(mod.querySelectorAll('.pv-chk'));
        const n = chks.filter(c => c.checked).length;
        const todo = mod.querySelector('.pv-mod-chk');
        todo.checked = n === chks.length;
        todo.indeterminate = n > 0 && n < chks.length;
        mod.querySelector('.pv-cuenta').textContent = n + ' de ' + chks.length;
    }
    const pvPerfiles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PerfilesRol));
    const pvPersonas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Efectivas.ToDictionary(k => k.Key.ToString(), k => k.Value.ToList())));
    function pvAplicar(tipo, sel) {
        const lista = tipo === 'rol' ? pvPerfiles[sel.value] : pvPersonas[sel.value];
        if (!sel.value || !lista) return;
        document.querySelectorAll('.pv-chk').forEach(c => { c.checked = lista.includes(c.value); });
        document.querySelectorAll('.pv-mod').forEach(pvActualizar);
        sel.value = '';
    }
    function pvTodas(v) {
        document.querySelectorAll('.pv-chk').forEach(c => { c.checked = v; });
        document.querySelectorAll('.pv-mod').forEach(pvActualizar);
    }
    document.addEventListener('change', ev => {
        const mod = ev.target.closest && ev.target.closest('.pv-mod');
        if (!mod) return;
        if (ev.target.classList.contains('pv-mod-chk')) mod.querySelectorAll('.pv-chk').forEach(c => { c.checked = ev.target.checked; });
        pvActualizar(mod);
    });
    document.querySelectorAll('.pv-mod').forEach(pvActualizar);
</script>
