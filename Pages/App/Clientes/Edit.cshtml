@page "{id:int?}"
@model AtilsonCargoSpa.Pages.App.Clientes.EditModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nuevo cliente" : $"Cliente: {Model.NombreOriginal}";
}
<link rel="stylesheet" href="~/css/maestros.css" asp-append-version="true" />

<div class="container-fluid py-4 mx mx-ficha-wrap">
    <header class="mx-cabecera">
        <div>
            <div class="mx-miga"><a asp-page="./Index">Maestros › Clientes</a></div>
            <h1 class="mx-titulo">@(Model.EsNuevo ? "Nuevo cliente" : Model.NombreOriginal)</h1>
            <p class="mx-subtitulo">@(Model.EsNuevo ? "Registra una empresa cliente." : "Edita los datos del cliente. Cada cambio queda registrado con tu usuario, fecha y hora.")</p>
            @if (!Model.EsNuevo && (Model.EsClienteEspecial || Model.SuscripcionCobranzaActiva))
            {
                <div class="d-flex gap-2 mt-2">
                    @if (Model.EsClienteEspecial)
                    {
                        <span class="mx-pill mx-pill-info" title="Se cambia desde Comercial">Cliente especial</span>
                    }
                    @if (Model.SuscripcionCobranzaActiva)
                    {
                        <span class="mx-pill mx-pill-info" title="Se cambia desde Finanzas › Cobranza">Recordatorios de cobranza activos</span>
                    }
                </div>
            }
        </div>
        <div class="mx-acciones">
            <a asp-page="./Index" class="mx-btn mx-btn-secundario"><i class="bi bi-arrow-left"></i> Volver a la lista</a>
        </div>
    </header>

    <form method="post" data-mx-ficha novalidate>
        <input type="hidden" asp-for="Form.Id" />
        <input type="hidden" asp-for="Form.Version" />

        <div asp-validation-summary="All" class="mx-errores" role="alert"><strong>Revisa lo siguiente antes de guardar:</strong></div>

        <div class="mx-ficha">
            <div>
                <section class="mx-tarjeta">
                    <div class="mx-tarjeta-cab"><i class="bi bi-building"></i><h2>Identificación</h2></div>
                    <div class="mx-tarjeta-cuerpo">
                        <div class="mx-campos">
                            <div class="mx-campo c4">
                                <label asp-for="Form.Rut">RUT / Tax ID</label>
                                <input asp-for="Form.Rut" class="mx-input" maxlength="20" placeholder="76.123.456-7" autocomplete="off" />
                                <span asp-validation-for="Form.Rut" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c8">
                                <label asp-for="Form.RazonSocial">Razón social<span class="req">*</span></label>
                                <input asp-for="Form.RazonSocial" class="mx-input" maxlength="200" required autocomplete="off" />
                                <span asp-validation-for="Form.RazonSocial" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c8">
                                <label asp-for="Form.NombreCliente">Nombre de fantasía</label>
                                <input asp-for="Form.NombreCliente" class="mx-input" maxlength="200" />
                                <span asp-validation-for="Form.NombreCliente" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c4">
                                <label>Estado</label>
                                <div class="mx-estado-toggle" role="radiogroup" aria-label="Estado">
                                    <input type="radio" id="estActivo" name="Form.Activo" value="true" checked="@Model.Form.Activo" />
                                    <label for="estActivo" class="mx-est-activo">Activo</label>
                                    <input type="radio" id="estInactivo" name="Form.Activo" value="false" checked="@(!Model.Form.Activo)" />
                                    <label for="estInactivo" class="mx-est-inactivo">Inactivo</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="mx-tarjeta">
                    <div class="mx-tarjeta-cab"><i class="bi bi-person-lines-fill"></i><h2>Contacto y ubicación</h2></div>
                    <div class="mx-tarjeta-cuerpo">
                        <div class="mx-campos">
                            <div class="mx-campo">
                                <label asp-for="Form.Contacto">Persona de contacto</label>
                                <input asp-for="Form.Contacto" class="mx-input" maxlength="150" />
                                <span asp-validation-for="Form.Contacto" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo">
                                <label asp-for="Form.Telefono">Teléfono</label>
                                <input asp-for="Form.Telefono" class="mx-input" maxlength="50" inputmode="tel" placeholder="+56 9 …" />
                                <span asp-validation-for="Form.Telefono" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c12">
                                <label asp-for="Form.Correo">Correo</label>
                                <input asp-for="Form.Correo" class="mx-input" maxlength="250" type="text" inputmode="email" placeholder="contacto@empresa.cl; operaciones@empresa.cl" />
                                <span asp-validation-for="Form.Correo" class="mx-error-campo"></span>
                                <div class="mx-ayuda">Puedes poner varios correos separados por punto y coma.</div>
                            </div>
                            <div class="mx-campo c8">
                                <label asp-for="Form.Direccion">Dirección comercial</label>
                                <input asp-for="Form.Direccion" class="mx-input" maxlength="250" />
                                <span asp-validation-for="Form.Direccion" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c4">
                                <label asp-for="Form.IdCiudad">Ciudad</label>
                                <select asp-for="Form.IdCiudad" asp-items="Model.Ciudades" data-buscador="si">
                                    <option value="">— Sin ciudad —</option>
                                </select>
                                <span asp-validation-for="Form.IdCiudad" class="mx-error-campo"></span>
                            </div>
                        </div>
                    </div>
                </section>

                @if (!Model.EsNuevo)
                {
                    <section class="mx-tarjeta">
                        <div class="mx-tarjeta-cab">
                            <i class="bi bi-briefcase"></i><h2>Tarifas pactadas vigentes</h2>
                            <span class="ms-auto mx-pill mx-pill-off">Se editan en Comercial</span>
                        </div>
                        <div class="mx-tabla-wrap" style="box-shadow:none;border:0;border-radius:0 0 12px 12px;">
                            <table class="mx-tabla">
                                <thead>
                                    <tr><th>Área</th><th>Concepto</th><th>Ruta</th><th>Equipo</th><th class="text-end">Tarifa</th><th>Vence</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.Tarifas)
                                    {
                                        <tr>
                                            <td>@t.GrupoCobro</td>
                                            <td class="fw-bold">@t.Concepto</td>
                                            <td>@(string.IsNullOrEmpty(t.Pol) ? "—" : $"{t.Pol} → {t.Pod}")</td>
                                            <td>@(t.TipoContenedor ?? "Todos")</td>
                                            <td class="text-end fw-bold">@t.Moneda @t.PrecioPactado.ToString("N2")</td>
                                            <td class="@(t.FechaFinVigencia < DateTime.Now ? "text-danger fw-bold" : "")">@t.FechaFinVigencia.ToString("dd-MM-yyyy")</td>
                                        </tr>
                                    }
                                    @if (!Model.Tarifas.Any())
                                    {
                                        <tr><td colspan="6" class="mx-vacio"><i class="bi bi-inbox"></i>Sin tarifas vigentes para este cliente.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }

                <div class="mx-pie">
                    <span class="mx-pie-nota"><i class="bi bi-shield-check"></i> Se guardará a nombre de <strong>@AtilsonCargoSpa.Services.MaestrosAuditoria.Usuario(User)</strong>.</span>
                    <a asp-page="./Index" class="mx-btn mx-btn-secundario">Cancelar</a>
                    <button type="submit" class="mx-btn mx-btn-primario" data-mx-guardar><i class="bi bi-check2"></i> <span>@(Model.EsNuevo ? "Crear cliente" : "Guardar cambios")</span></button>
                </div>
            </div>

            @if (!Model.EsNuevo)
            {
                <partial name="_MaestroRegistro" model="Model.Registro" />
            }
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/maestros.js" asp-append-version="true"></script>
}
