@page
@model AtilsonCargoSpa.Pages.App.Clientes.SolicitudesModel
@using AtilsonCargoSpa.Models
@using AtilsonCargoSpa.Services
@{
    ViewData["Title"] = "Solicitudes de registro";
}
<link rel="stylesheet" href="~/css/maestros.css" asp-append-version="true" />
<style>
    .sr-lista { display: grid; gap: 14px; }
    .sr-card { background: #fff; border: 1px solid var(--mx-line); border-radius: 12px; box-shadow: var(--mx-shadow); }
    .sr-cab { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 14px 18px; border-bottom: 1px solid var(--mx-line); }
    .sr-cab h2 { font-size: 16px; font-weight: 800; margin: 0; color: var(--mx-brand-dark); }
    .sr-cab small { color: var(--mx-muted); font-size: 12px; }
    .sr-cuerpo { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 20px; padding: 16px 18px; }
    @@media (max-width: 900px) { .sr-cuerpo { grid-template-columns: 1fr; } }
    .sr-dato strong { display: block; font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; color: var(--mx-muted); margin-bottom: 2px; }
    .sr-dato span, .sr-dato a { font-size: 13.5px; color: var(--mx-ink); overflow-wrap: anywhere; }
    .sr-acciones { display: flex; justify-content: flex-end; align-items: flex-start; gap: 8px; flex-wrap: wrap; padding: 12px 18px 16px; border-top: 1px dashed var(--mx-line); }
    .sr-rechazo { display: flex; gap: 8px; flex: 1 1 380px; }
    .sr-rechazo input { flex: 1; min-width: 0; height: 36px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 0 10px; font-size: 13px; }
    .sr-bloqueo { margin: 0 18px 4px; }
    .sr-completar { margin: 0 18px 14px; border: 1px solid var(--mx-line); border-radius: 10px; background: #f8fafc; overflow: hidden; }
    .sr-completar summary { cursor: pointer; list-style: none; padding: 10px 12px; font-size: 12px; font-weight: 800; color: var(--mx-brand-dark); display:flex; align-items:center; gap:7px; }
    .sr-completar summary::-webkit-details-marker { display:none; }
    .sr-completar summary::before { content:"›"; font-size:18px; line-height:1; transition:transform .15s ease; }
    .sr-completar[open] summary::before { transform:rotate(90deg); }
    .sr-completar-form { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px 12px; padding:0 12px 12px; }
    .sr-completar-form .full { grid-column:1 / -1; }
    .sr-completar-form label { display:block; font-size:9px; font-weight:800; text-transform:uppercase; letter-spacing:.45px; color:var(--mx-muted); margin-bottom:4px; }
    .sr-completar-form input { width:100%; height:35px; border:1px solid #cbd5e1; border-radius:8px; padding:0 9px; font-size:12px; }
    .sr-completar-nota { grid-column:1 / -1; font-size:11px; color:var(--mx-muted); line-height:1.4; }
    @@media (max-width:700px){ .sr-completar-form{grid-template-columns:1fr}.sr-completar-form .full{grid-column:auto} }
</style>

<div class="container-fluid py-4 mx">
    <header class="mx-cabecera">
        <div>
            <div class="mx-miga"><a asp-page="./Index">Maestros › Clientes</a></div>
            <h1 class="mx-titulo">Solicitudes de registro</h1>
            <p class="mx-subtitulo">Solicitudes recibidas desde “Registra tu empresa”. El formulario público exige solo Nombre, Teléfono y Email; aquí puedes completar los datos opcionales antes de aprobar.</p>
        </div>
        <div class="mx-acciones">
            <form method="post" asp-page-handler="ProbarCorreo" class="d-inline">
                <button type="submit" class="mx-btn mx-btn-secundario" title="Verifica que el servidor pueda enviar correos al usuario conectado"><i class="bi bi-envelope-check"></i> Verificar correo operativo</button>
            </form>
            <a asp-page="./Index" class="mx-btn mx-btn-secundario"><i class="bi bi-arrow-left"></i> Volver a clientes</a>
        </div>
    </header>

    <p class="mx-subtitulo" style="margin:-8px 0 14px;"><i class="bi bi-envelope"></i> Cada solicitud nueva envía una confirmación a la empresa y un aviso a <strong>@(Model.CorreoAviso ?? "— (sin correo configurado)")</strong>. Al aprobar o rechazar, la empresa recibe un correo.</p>

    <div class="mx-barra">
        <nav class="mx-segmentos" aria-label="Estado">
            <a asp-route-estado="pendientes" class="@(Model.Estado == "pendientes" ? "activo" : "")">Pendientes<span class="mx-cuenta">@Model.Pendientes</span></a>
            <a asp-route-estado="revisadas" class="@(Model.Estado == "revisadas" ? "activo" : "")">Revisadas</a>
        </nav>
    </div>

    @if (!Model.Filas.Any())
    {
        <div class="mx-tabla-wrap"><div class="mx-vacio"><i class="bi bi-inbox"></i>@(Model.Estado == "pendientes" ? "No hay solicitudes pendientes." : "Aún no hay solicitudes revisadas.")</div></div>
    }

    <div class="sr-lista">
        @foreach (var f in Model.Filas)
        {
            var s = f.Solicitud;
            bool pendiente = s.Estado == SolicitudRegistroCliente.EstadoPendiente;
            bool tieneRazonSocial = !string.IsNullOrWhiteSpace(s.RazonSocial);
            bool tienePassword = !string.IsNullOrWhiteSpace(s.PasswordHash);
            bool puedeAprobar = f.Bloqueo == null && tieneRazonSocial && tienePassword;
            string empresaVisible = tieneRazonSocial ? s.RazonSocial : "(Razón social por completar)";
            string textoPlanta = string.IsNullOrWhiteSpace(s.NombrePlanta) ? "." : $", más la planta «{s.NombrePlanta}».";
            <article class="sr-card" id="sol-@s.Id">
                <div class="sr-cab">
                    <div>
                        <h2>@empresaVisible</h2>
                        <small>@(string.IsNullOrWhiteSpace(s.Rut) ? "RUT no informado" : $"RUT {s.Rut}") · solicitado el @MaestrosAuditoria.FormatoFecha(s.FechaSolicitud)</small>
                    </div>
                    <div>
                        @if (pendiente)
                        {
                            <span class="mx-pill mx-pill-warn">Pendiente</span>
                        }
                        else if (s.Estado == SolicitudRegistroCliente.EstadoAprobada)
                        {
                            <span class="mx-pill mx-pill-ok">Aprobada</span>
                            <small class="d-block mt-1">@s.UsuarioRevision · @MaestrosAuditoria.FormatoFecha(s.FechaRevision)</small>
                        }
                        else
                        {
                            <span class="mx-pill mx-pill-off">Rechazada</span>
                            <small class="d-block mt-1">@s.UsuarioRevision · @MaestrosAuditoria.FormatoFecha(s.FechaRevision)</small>
                        }
                    </div>
                </div>
                <div class="sr-cuerpo">
                    <div class="sr-dato"><strong>Contacto</strong><span>@s.NombreContacto</span></div>
                    <div class="sr-dato"><strong>Teléfono</strong><span>@s.Telefono</span></div>
                    <div class="sr-dato"><strong>Correo (usuario del portal)</strong><span>@s.Correo</span></div>
                    <div class="sr-dato"><strong>Dirección oficina</strong><span>@(string.IsNullOrWhiteSpace(s.DireccionOficina) ? "No informada" : s.DireccionOficina)</span></div>
                    <div class="sr-dato"><strong>Acceso al portal</strong><span>@(tienePassword ? "Contraseña definida · se creará usuario al aprobar" : "Sin contraseña · define una temporal (Completar datos) antes de aprobar")</span></div>
                                        @if (!string.IsNullOrWhiteSpace(s.NombrePlanta))
                    {
                    <div class="sr-dato"><strong>Planta</strong><span>@s.NombrePlanta</span></div>
                    <div class="sr-dato"><strong>Zona (comuna)</strong><span>@(f.Comuna ?? "—")</span></div>
                    <div class="sr-dato"><strong>Dirección planta</strong><span>@s.DireccionPlanta</span></div>
                    <div class="sr-dato">
                        <strong>Google Maps</strong>
                        @if (s.UrlGoogleMapsPlanta?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true)
                        {
                            <a href="@s.UrlGoogleMapsPlanta" target="_blank" rel="noopener"><i class="bi bi-geo-alt"></i> Ver ubicación</a>
                        }
                        else
                        {
                            <span>@s.UrlGoogleMapsPlanta</span>
                        }
                    </div>
}
                    @if (!string.IsNullOrWhiteSpace(s.MotivoRechazo))
                    {
                        <div class="sr-dato"><strong>Motivo del rechazo</strong><span>@s.MotivoRechazo</span></div>
                    }
                </div>
                @if (pendiente)
                {
                    <details class="sr-completar" open="@(!tieneRazonSocial ? "open" : null)">
                        <summary><i class="bi bi-pencil-square"></i> Completar datos opcionales / preparar aprobación</summary>
                        <form method="post" asp-page-handler="Completar" asp-route-id="@s.Id" class="sr-completar-form">
                            <div>
                                <label>Razón social</label>
                                <input type="text" name="razonSocial" value="@s.RazonSocial" maxlength="100" placeholder="Necesaria para crear la ficha cliente" />
                            </div>
                            <div>
                                <label>RUT</label>
                                <input type="text" name="rut" value="@s.Rut" maxlength="12" placeholder="Opcional" />
                            </div>
                            <div class="full">
                                <label>Dirección oficina</label>
                                <input type="text" name="direccionOficina" value="@s.DireccionOficina" maxlength="255" placeholder="Opcional" />
                            </div>
                            <div class="full">
                                <label>Contraseña temporal</label>
                                <input type="password" name="passwordTemporal" autocomplete="new-password" placeholder="Déjala vacía para conservar la actual; si no existe, define una temporal" />
                            </div>
                            <div class="sr-completar-nota">
                                El registro público puede llegar solo con Nombre, Teléfono y Email. Para aprobar se necesita completar la Razón Social y tener una contraseña definida (puede ser una temporal ingresada aquí). RUT y dirección siguen siendo opcionales.
                            </div>
                            <div class="full d-flex justify-content-end">
                                <button type="submit" class="mx-btn mx-btn-secundario mx-btn-sm"><i class="bi bi-save"></i> Guardar datos</button>
                            </div>
                        </form>
                    </details>
                }
                @if (pendiente && f.Bloqueo != null)
                {
                    <div class="alert alert-warning py-2 px-3 sr-bloqueo" style="font-size:13px;"><i class="bi bi-exclamation-triangle-fill"></i> @f.Bloqueo</div>
                }
                @if (pendiente && !tieneRazonSocial)
                {
                    <div class="alert alert-info py-2 px-3 sr-bloqueo" style="font-size:13px;"><i class="bi bi-info-circle-fill"></i> Completa la Razón Social antes de aprobar. No se inventará un nombre de empresa automáticamente.</div>
                }
                @if (pendiente && !tienePassword)
                {
                    <div class="alert alert-info py-2 px-3 sr-bloqueo" style="font-size:13px;"><i class="bi bi-key-fill"></i> La persona no definió contraseña. Antes de aprobar, establece una contraseña temporal en “Completar datos” para crear su usuario del portal.</div>
                }
                @if (pendiente)
                {
                    <div class="sr-acciones">
                        <form method="post" asp-page-handler="Rechazar" asp-route-id="@s.Id" class="sr-rechazo"
                              data-mx-confirmar="@($"¿Rechazar la solicitud de «{empresaVisible}»? Se le enviará el motivo por correo.")">
                            <input type="text" name="motivo" maxlength="500" placeholder="Motivo del rechazo (lo verá el cliente)" aria-label="Motivo del rechazo" required />
                            <button type="submit" class="mx-btn mx-btn-peligro"><i class="bi bi-x-lg"></i> Rechazar</button>
                        </form>
                        <form method="post" asp-page-handler="Aprobar" asp-route-id="@s.Id"
                              data-mx-confirmar="@($"¿Aprobar a «{empresaVisible}»? Se crearán la ficha cliente y su usuario del portal ({s.Correo}){textoPlanta}")">
                            <button type="submit" class="mx-btn mx-btn-primario" disabled="@(!puedeAprobar)"><i class="bi bi-check2"></i> Aprobar y crear cliente</button>
                        </form>
                    </div>
                }
                else if (s.IdClienteCreado.HasValue)
                {
                    <div class="sr-acciones">
                        <a asp-page="./Edit" asp-route-id="@s.IdClienteCreado" class="mx-btn mx-btn-secundario mx-btn-sm"><i class="bi bi-box-arrow-up-right"></i> Ver ficha del cliente</a>
                    </div>
                }
            </article>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/maestros.js" asp-append-version="true"></script>
}
