@page
@model AtilsonCargoSpa.Pages.App.Clientes.IndexModel
@using AtilsonCargoSpa.Services
@{
    ViewData["Title"] = "Maestro de Clientes";
}
<link rel="stylesheet" href="~/css/maestros.css" asp-append-version="true" />

<div class="container-fluid py-4 mx">
    <header class="mx-cabecera">
        <div>
            <div class="mx-miga">Maestros</div>
            <h1 class="mx-titulo">Clientes</h1>
            <p class="mx-subtitulo">Empresas a las que les prestamos servicio. Las tarifas pactadas se administran en Comercial.</p>
        </div>
        <div class="mx-acciones">
            <a asp-page="./Solicitudes" class="mx-btn mx-btn-secundario"><i class="bi bi-person-plus"></i> Solicitudes de registro</a>
            <form method="post" asp-page-handler="ExportExcel" data-mx-con-filtro class="d-inline">
                <input type="hidden" name="SearchString" value="@Model.Q" />
                <button type="submit" class="mx-btn mx-btn-secundario"><i class="bi bi-file-earmark-excel"></i> Excel</button>
            </form>
            <form method="post" asp-page-handler="ExportPdf" data-mx-con-filtro class="d-inline">
                <input type="hidden" name="SearchString" value="@Model.Q" />
                <button type="submit" class="mx-btn mx-btn-secundario"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
            </form>
            <a asp-page="./Edit" class="mx-btn mx-btn-primario"><i class="bi bi-plus-lg"></i> Nuevo cliente</a>
        </div>
    </header>

    <div class="mx-barra">
        <div class="mx-buscar">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" data-mx-filtro value="@Model.Q" placeholder="Buscar por razón social, nombre, RUT, contacto o correo…" aria-label="Buscar cliente" autocomplete="off" />
        </div>
        <div class="mx-filtro-extra">
            <select data-mx-filtro-extra data-buscador="si" aria-label="Filtrar por ciudad">
                <option value="">Todas las ciudades</option>
                @foreach (var c in Model.OpcionesCiudad)
                {
                    <option value="@c.Valor" selected="@(Model.F == c.Valor)">@c.Texto</option>
                }
            </select>
        </div>
        <nav class="mx-segmentos" aria-label="Estado">
            <a asp-route-estado="activos" class="@(Model.Estado == "activos" ? "activo" : "")">Activos<span class="mx-cuenta">@Model.TotalActivos</span></a>
            <a asp-route-estado="inactivos" class="@(Model.Estado == "inactivos" ? "activo" : "")">Inactivos<span class="mx-cuenta">@Model.TotalInactivos</span></a>
            <a asp-route-estado="todos" class="@(Model.Estado == "todos" ? "activo" : "")">Todos</a>
        </nav>
        <span class="mx-total" data-mx-total>@Model.Filas.Count registros</span>
    </div>

    <div class="mx-tabla-wrap">
        <table class="mx-tabla" data-mx-tabla>
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>RUT</th>
                    <th>Contacto</th>
                    <th>Ciudad</th>
                    <th>Última modificación</th>
                    <th>Estado</th>
                    <th class="mx-col-acciones"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Filas)
                {
                    var c = f.Cliente;
                    <tr data-mx-texto="@c.RazonSocial @c.NombreCliente @c.Rut @c.Contacto @c.Correo @c.Telefono @f.Ciudad" data-mx-extra="@(c.IdCiudad?.ToString() ?? "")"
                        class="@(f.Activo ? "" : "mx-inactivo") @(Model.Resaltar == c.Id ? "mx-resaltado" : "")">
                        <td>
                            <a asp-page="./Edit" asp-route-id="@c.Id" class="mx-nombre text-decoration-none">@c.RazonSocial</a>
                            @if (!string.IsNullOrWhiteSpace(c.NombreCliente))
                            {
                                <span class="mx-sec">@c.NombreCliente</span>
                            }
                            @if (c.EsClienteEspecial)
                            {
                                <span class="mx-pill mx-pill-info mt-1">Cliente especial</span>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(c.Rut) ? "—" : c.Rut)</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(c.Contacto) ? "—" : c.Contacto)
                            @if (!string.IsNullOrWhiteSpace(c.Correo) || !string.IsNullOrWhiteSpace(c.Telefono))
                            {
                                <span class="mx-sec">@c.Correo @(string.IsNullOrWhiteSpace(c.Correo) || string.IsNullOrWhiteSpace(c.Telefono) ? "" : "·") @c.Telefono</span>
                            }
                        </td>
                        <td>@(f.Ciudad ?? "—")</td>
                        <td class="mx-mod">
                            @(string.IsNullOrWhiteSpace(c.UsuarioModificador) ? (string.IsNullOrWhiteSpace(c.UsuarioCreador) ? "—" : c.UsuarioCreador) : c.UsuarioModificador)
                            <small>@MaestrosAuditoria.FormatoFecha(c.FechaModificacion ?? c.FechaCreacion)</small>
                        </td>
                        <td>
                            @if (f.Activo)
                            {
                                <span class="mx-pill mx-pill-ok">Activo</span>
                            }
                            else
                            {
                                <span class="mx-pill mx-pill-off">Inactivo</span>
                            }
                        </td>
                        <td class="mx-col-acciones">
                            <a asp-page="./Edit" asp-route-id="@c.Id" class="mx-btn mx-btn-secundario mx-btn-sm"><i class="bi bi-pencil"></i> Editar</a>
                            <form method="post" asp-page-handler="CambiarEstado" asp-route-id="@c.Id" asp-route-activar="@(!f.Activo)" asp-route-estado="@Model.Estado"
                                  data-mx-confirmar="@(f.Activo ? $"¿Desactivar al cliente «{c.RazonSocial}»? Dejará de aparecer al crear operaciones." : $"¿Reactivar al cliente «{c.RazonSocial}»?")">
                                @if (f.Activo)
                                {
                                    <button type="submit" class="mx-btn mx-btn-peligro mx-btn-sm" title="Desactivar" aria-label="Desactivar"><i class="bi bi-slash-circle"></i></button>
                                }
                                else
                                {
                                    <button type="submit" class="mx-btn mx-btn-ok mx-btn-sm"><i class="bi bi-arrow-counterclockwise"></i> Reactivar</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
                <tr data-mx-sin-coincidencias hidden><td colspan="7" class="mx-vacio"><i class="bi bi-search"></i>Ningún cliente coincide con la búsqueda.</td></tr>
                @if (!Model.Filas.Any())
                {
                    <tr><td colspan="7" class="mx-vacio"><i class="bi bi-people"></i>No hay clientes @(Model.Estado == "inactivos" ? "inactivos" : "registrados").</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/maestros.js" asp-append-version="true"></script>
}
