@page "{id:int?}"
@model AtilsonCargoSpa.Pages.App.Puertos.EditModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nuevo puerto" : $"Puerto: {Model.NombreOriginal}";
}
<link rel="stylesheet" href="~/css/maestros.css" asp-append-version="true" />

<div class="container-fluid py-4 mx mx-ficha-wrap">
    <header class="mx-cabecera">
        <div>
            <div class="mx-miga"><a asp-page="./Index">Maestros › Puertos</a></div>
            <h1 class="mx-titulo">@(Model.EsNuevo ? "Nuevo puerto" : Model.NombreOriginal)</h1>
            <p class="mx-subtitulo">@(Model.EsNuevo ? "Registra un puerto de origen o destino." : "Edita los datos del puerto. Cada cambio queda registrado con tu usuario, fecha y hora.")</p>
        </div>
        <div class="mx-acciones">
            <a asp-page="./Index" class="mx-btn mx-btn-secundario"><i class="bi bi-arrow-left"></i> Volver a la lista</a>
        </div>
    </header>

    <form method="post" data-mx-ficha novalidate>
        <input type="hidden" asp-for="Form.Id" />
        <input type="hidden" asp-for="Form.Version" />

        <div asp-validation-summary="All" class="mx-errores" role="alert"><strong>Revisa lo siguiente antes de guardar:</strong></div>

        <div class="mx-ficha">
            <div>
                <section class="mx-tarjeta">
                    <div class="mx-tarjeta-cab"><i class="bi bi-anchor"></i><h2>Datos del puerto</h2></div>
                    <div class="mx-tarjeta-cuerpo">
                        <div class="mx-campos">
                            <div class="mx-campo c8">
                                <label asp-for="Form.Nombre">Nombre<span class="req">*</span></label>
                                <input asp-for="Form.Nombre" class="mx-input" maxlength="100" required autocomplete="off"
                                       data-mx-nombre-original="@Model.NombreOriginal" data-mx-aviso="avisoNombre" />
                                <span asp-validation-for="Form.Nombre" class="mx-error-campo"></span>
                                @if (!Model.EsNuevo)
                                {
                                    <div id="avisoNombre" class="mx-aviso-cambio">
                                        <i class="bi bi-info-circle"></i> Las tarifas marítimas y cotizaciones que usan el nombre del puerto como texto mantendrán el nombre anterior.
                                    </div>
                                }
                            </div>
                            <div class="mx-campo c4">
                                <label>Estado</label>
                                <div class="mx-estado-toggle" role="radiogroup" aria-label="Estado">
                                    <input type="radio" id="estActivo" name="Form.Activo" value="true" checked="@Model.Form.Activo" />
                                    <label for="estActivo" class="mx-est-activo">Activo</label>
                                    <input type="radio" id="estInactivo" name="Form.Activo" value="false" checked="@(!Model.Form.Activo)" />
                                    <label for="estInactivo" class="mx-est-inactivo">Inactivo</label>
                                </div>
                            </div>
                            <div class="mx-campo">
                                <label asp-for="Form.Terminal">Terminal</label>
                                <input asp-for="Form.Terminal" class="mx-input" maxlength="100" placeholder="Ej: TPS, STI, DP World…" />
                                <span asp-validation-for="Form.Terminal" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo">
                                <label asp-for="Form.Pais">País<span class="req">*</span></label>
                                <input asp-for="Form.Pais" class="mx-input" maxlength="80" list="listaPaises" autocomplete="off" placeholder="Escribe y elige de la lista" />
                                <datalist id="listaPaises">
                                    @foreach (var pais in Model.PaisesSugeridos)
                                    {
                                        <option value="@pais"></option>
                                    }
                                </datalist>
                                <span asp-validation-for="Form.Pais" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c12">
                                <label asp-for="Form.IdCiudad">Ciudad del puerto</label>
                                <select asp-for="Form.IdCiudad" asp-items="Model.Ciudades" data-buscador="si">
                                    <option value="">— Sin ciudad —</option>
                                </select>
                                <span asp-validation-for="Form.IdCiudad" class="mx-error-campo"></span>
                                <div class="mx-ayuda">Para puertos chilenos: se usa para cruzar la tarifa de transporte del tramo (por ejemplo VALPARAÍSO o SAN ANTONIO).</div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="mx-pie">
                    <span class="mx-pie-nota"><i class="bi bi-shield-check"></i> Se guardará a nombre de <strong>@AtilsonCargoSpa.Services.MaestrosAuditoria.Usuario(User)</strong>.</span>
                    <a asp-page="./Index" class="mx-btn mx-btn-secundario">Cancelar</a>
                    <button type="submit" class="mx-btn mx-btn-primario" data-mx-guardar><i class="bi bi-check2"></i> <span>@(Model.EsNuevo ? "Crear puerto" : "Guardar cambios")</span></button>
                </div>
            </div>

            @if (!Model.EsNuevo)
            {
                <partial name="_MaestroRegistro" model="Model.Registro" />
            }
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/maestros.js" asp-append-version="true"></script>
}
