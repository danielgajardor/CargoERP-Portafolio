@page
@model AtilsonCargoSpa.Pages.App.Proveedores.IndexModel
@using AtilsonCargoSpa.Services
@using AtilsonCargoSpa.Pages.App.Proveedores
@{
    ViewData["Title"] = "Maestro de Proveedores";
}
<link rel="stylesheet" href="~/css/maestros.css" asp-append-version="true" />

<div class="container-fluid py-4 mx">
    <header class="mx-cabecera">
        <div>
            <div class="mx-miga">Maestros</div>
            <h1 class="mx-titulo">Proveedores</h1>
            <p class="mx-subtitulo">Empresas de transporte y depósitos. El nombre y el RUT se usan para encontrar la tarifa de transporte de cada operación.</p>
        </div>
        <div class="mx-acciones">
            <a asp-page="./Edit" class="mx-btn mx-btn-primario"><i class="bi bi-plus-lg"></i> Nuevo proveedor</a>
        </div>
    </header>

    <div class="mx-barra">
        <div class="mx-buscar">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" data-mx-filtro value="@Model.Q" placeholder="Buscar por nombre, RUT, contacto o correo…" aria-label="Buscar proveedor" autocomplete="off" />
        </div>
        <div class="mx-filtro-extra">
            <select data-mx-filtro-extra aria-label="Filtrar por tipo">
                <option value="">Todos los tipos</option>
                @foreach (var t in Model.OpcionesTipo)
                {
                    <option value="@t.Valor" selected="@(Model.F == t.Valor)">@t.Texto</option>
                }
            </select>
        </div>
        <nav class="mx-segmentos" aria-label="Estado">
            <a asp-route-estado="activos" class="@(Model.Estado == "activos" ? "activo" : "")">Activos<span class="mx-cuenta">@Model.TotalActivos</span></a>
            <a asp-route-estado="inactivos" class="@(Model.Estado == "inactivos" ? "activo" : "")">Inactivos<span class="mx-cuenta">@Model.TotalInactivos</span></a>
            <a asp-route-estado="todos" class="@(Model.Estado == "todos" ? "activo" : "")">Todos</a>
        </nav>
        <span class="mx-total" data-mx-total>@Model.Filas.Count registros</span>
    </div>

    <div class="mx-tabla-wrap">
        <table class="mx-tabla" data-mx-tabla>
            <thead>
                <tr>
                    <th>Proveedor</th>
                    <th>Tipo</th>
                    <th>RUT</th>
                    <th>Contacto</th>
                    <th class="text-end">Tarifas transporte</th>
                    <th>Última modificación</th>
                    <th>Estado</th>
                    <th class="mx-col-acciones"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Filas)
                {
                    var p = f.Proveedor;
                    bool esDeposito = p.IdTipoProveedor == AtilsonCargoSpa.Helpers.TransportistaHelper.TipoDeposito;
                    <tr data-mx-texto="@p.NombreProveedor @p.Rut @p.Contacto @p.CorreoOperativo @f.Ciudad" data-mx-extra="@(esDeposito ? "deposito" : "transporte")"
                        class="@(f.Activo ? "" : "mx-inactivo") @(Model.Resaltar == p.Id ? "mx-resaltado" : "")">
                        <td>
                            <a asp-page="./Edit" asp-route-id="@p.Id" class="mx-nombre text-decoration-none">@p.NombreProveedor</a>
                            @if (f.Ciudad != null)
                            {
                                <span class="mx-sec">@f.Ciudad</span>
                            }
                        </td>
                        <td>@IndexModel.NombreTipo(p.IdTipoProveedor)</td>
                        <td>@(string.IsNullOrWhiteSpace(p.Rut) ? "—" : p.Rut)</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(p.Contacto) ? "—" : p.Contacto)
                            @if (!string.IsNullOrWhiteSpace(p.CorreoOperativo))
                            {
                                <span class="mx-sec">@p.CorreoOperativo</span>
                            }
                        </td>
                        <td class="text-end">@(f.Tarifas == 0 ? "—" : f.Tarifas.ToString())</td>
                        <td class="mx-mod">
                            @(f.ModificadoPor ?? "—")
                            <small>@MaestrosAuditoria.FormatoFecha(f.ModificadoEl)</small>
                        </td>
                        <td>
                            @if (f.Activo)
                            {
                                <span class="mx-pill mx-pill-ok">Activo</span>
                            }
                            else
                            {
                                <span class="mx-pill mx-pill-off">Inactivo</span>
                            }
                        </td>
                        <td class="mx-col-acciones">
                            <a asp-page="./Edit" asp-route-id="@p.Id" class="mx-btn mx-btn-secundario mx-btn-sm"><i class="bi bi-pencil"></i> Editar</a>
                            <form method="post" asp-page-handler="CambiarEstado" asp-route-id="@p.Id" asp-route-activar="@(!f.Activo)" asp-route-estado="@Model.Estado"
                                  data-mx-confirmar="@(f.Activo ? $"¿Desactivar al proveedor «{p.NombreProveedor}»? Dejará de aparecer en Operaciones y Comercial." : $"¿Reactivar al proveedor «{p.NombreProveedor}»?")">
                                @if (f.Activo)
                                {
                                    <button type="submit" class="mx-btn mx-btn-peligro mx-btn-sm" title="Desactivar" aria-label="Desactivar"><i class="bi bi-slash-circle"></i></button>
                                }
                                else
                                {
                                    <button type="submit" class="mx-btn mx-btn-ok mx-btn-sm"><i class="bi bi-arrow-counterclockwise"></i> Reactivar</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
                <tr data-mx-sin-coincidencias hidden><td colspan="8" class="mx-vacio"><i class="bi bi-search"></i>Ningún proveedor coincide con la búsqueda.</td></tr>
                @if (!Model.Filas.Any())
                {
                    <tr><td colspan="8" class="mx-vacio"><i class="bi bi-truck"></i>No hay proveedores @(Model.Estado == "inactivos" ? "inactivos" : "registrados").</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/maestros.js" asp-append-version="true"></script>
}
