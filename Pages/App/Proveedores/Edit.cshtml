@page "{id:int?}"
@model AtilsonCargoSpa.Pages.App.Proveedores.EditModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nuevo proveedor" : $"Proveedor: {Model.NombreOriginal}";
}
<link rel="stylesheet" href="~/css/maestros.css" asp-append-version="true" />

<div class="container-fluid py-4 mx mx-ficha-wrap">
    <header class="mx-cabecera">
        <div>
            <div class="mx-miga"><a asp-page="./Index">Maestros › Proveedores</a></div>
            <h1 class="mx-titulo">@(Model.EsNuevo ? "Nuevo proveedor" : Model.NombreOriginal)</h1>
            <p class="mx-subtitulo">@(Model.EsNuevo ? "Registra una empresa de transporte o un depósito." : "Edita los datos del proveedor. Cada cambio queda registrado con tu usuario, fecha y hora.")</p>
        </div>
        <div class="mx-acciones">
            <a asp-page="./Index" class="mx-btn mx-btn-secundario"><i class="bi bi-arrow-left"></i> Volver a la lista</a>
        </div>
    </header>

    <form method="post" data-mx-ficha novalidate>
        <input type="hidden" asp-for="Form.Id" />
        <input type="hidden" asp-for="Form.Version" />

        <div asp-validation-summary="All" class="mx-errores" role="alert"><strong>Revisa lo siguiente antes de guardar:</strong></div>

        <div class="mx-ficha">
            <div>
                <section class="mx-tarjeta">
                    <div class="mx-tarjeta-cab"><i class="bi bi-truck"></i><h2>Datos del proveedor</h2></div>
                    <div class="mx-tarjeta-cuerpo">
                        <div class="mx-campos">
                            <div class="mx-campo c8">
                                <label asp-for="Form.Nombre">Nombre<span class="req">*</span></label>
                                <input asp-for="Form.Nombre" class="mx-input" maxlength="100" required autocomplete="off"
                                       data-mx-nombre-original="@Model.NombreOriginal" data-mx-aviso="avisoNombre" />
                                <span asp-validation-for="Form.Nombre" class="mx-error-campo"></span>
                                @if (!Model.EsNuevo)
                                {
                                    <div id="avisoNombre" class="mx-aviso-cambio">
                                        <i class="bi bi-info-circle"></i> Las operaciones guardan la empresa de transporte como texto: las ya creadas seguirán con el nombre anterior y su tarifa se buscará por RUT. Revisa que el RUT esté completo.
                                    </div>
                                }
                            </div>
                            <div class="mx-campo c4">
                                <label>Estado</label>
                                <div class="mx-estado-toggle" role="radiogroup" aria-label="Estado">
                                    <input type="radio" id="estActivo" name="Form.Activo" value="true" checked="@Model.Form.Activo" />
                                    <label for="estActivo" class="mx-est-activo">Activo</label>
                                    <input type="radio" id="estInactivo" name="Form.Activo" value="false" checked="@(!Model.Form.Activo)" />
                                    <label for="estInactivo" class="mx-est-inactivo">Inactivo</label>
                                </div>
                            </div>
                            <div class="mx-campo c4">
                                <label asp-for="Form.Rut">RUT</label>
                                <input asp-for="Form.Rut" class="mx-input" maxlength="12" placeholder="76.123.456-7" autocomplete="off" />
                                <span asp-validation-for="Form.Rut" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c8">
                                <label>Tipo</label>
                                <div class="mx-estado-toggle" role="radiogroup" aria-label="Tipo de proveedor">
                                    <input type="radio" id="tipoTransporte" name="Form.EsDeposito" value="false" checked="@(!Model.Form.EsDeposito)" />
                                    <label for="tipoTransporte" class="mx-est-activo">Transporte</label>
                                    <input type="radio" id="tipoDeposito" name="Form.EsDeposito" value="true" checked="@Model.Form.EsDeposito" />
                                    <label for="tipoDeposito" class="mx-est-activo">Depósito</label>
                                </div>
                                <div class="mx-ayuda">Transporte: aparece como empresa de transporte en Operaciones y en las tarifas. Depósito: aparece en almacenamiento.</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="mx-tarjeta">
                    <div class="mx-tarjeta-cab"><i class="bi bi-person-lines-fill"></i><h2>Contacto</h2></div>
                    <div class="mx-tarjeta-cuerpo">
                        <div class="mx-campos">
                            <div class="mx-campo">
                                <label asp-for="Form.Contacto">Persona de contacto</label>
                                <input asp-for="Form.Contacto" class="mx-input" maxlength="100" />
                                <span asp-validation-for="Form.Contacto" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo">
                                <label asp-for="Form.Correo">Correo operativo</label>
                                <input asp-for="Form.Correo" class="mx-input" maxlength="100" type="text" inputmode="email" placeholder="operaciones@empresa.cl" />
                                <span asp-validation-for="Form.Correo" class="mx-error-campo"></span>
                                <div class="mx-ayuda">Se completa solo al elegir esta empresa en el transporte de una operación.</div>
                            </div>
                            <div class="mx-campo">
                                <label asp-for="Form.IdCiudad">Ciudad</label>
                                <select asp-for="Form.IdCiudad" asp-items="Model.Ciudades" data-buscador="si">
                                    <option value="">— Sin ciudad —</option>
                                </select>
                                <span asp-validation-for="Form.IdCiudad" class="mx-error-campo"></span>
                            </div>
                        </div>
                        @if (!Model.EsNuevo && Model.TarifasTransporte > 0)
                        {
                            <div class="mx-ayuda mt-3"><i class="bi bi-info-circle"></i> Tiene @Model.TarifasTransporte tarifa(s) de transporte activas en Comercial.</div>
                        }
                    </div>
                </section>

                <div class="mx-pie">
                    <span class="mx-pie-nota"><i class="bi bi-shield-check"></i> Se guardará a nombre de <strong>@AtilsonCargoSpa.Services.MaestrosAuditoria.Usuario(User)</strong>.</span>
                    <a asp-page="./Index" class="mx-btn mx-btn-secundario">Cancelar</a>
                    <button type="submit" class="mx-btn mx-btn-primario" data-mx-guardar><i class="bi bi-check2"></i> <span>@(Model.EsNuevo ? "Crear proveedor" : "Guardar cambios")</span></button>
                </div>
            </div>

            @if (!Model.EsNuevo)
            {
                <partial name="_MaestroRegistro" model="Model.Registro" />
            }
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/maestros.js" asp-append-version="true"></script>
}
