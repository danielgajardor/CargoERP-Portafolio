@page "{id:int?}"
@model AtilsonCargoSpa.Pages.App.Plantas.EditModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nueva planta" : $"Planta: {Model.NombreOriginal}";
}
<link rel="stylesheet" href="~/css/maestros.css" asp-append-version="true" />

<div class="container-fluid py-4 mx mx-ficha-wrap">
    <header class="mx-cabecera">
        <div>
            <div class="mx-miga"><a asp-page="./Index">Maestros › Plantas</a></div>
            <h1 class="mx-titulo">@(Model.EsNuevo ? "Nueva planta" : Model.NombreOriginal)</h1>
            <p class="mx-subtitulo">@(Model.EsNuevo ? "Registra una planta o packing de carga." : "Edita los datos de la planta. Cada cambio queda registrado con tu usuario, fecha y hora.")</p>
        </div>
        <div class="mx-acciones">
            <a asp-page="./Index" class="mx-btn mx-btn-secundario"><i class="bi bi-arrow-left"></i> Volver a la lista</a>
        </div>
    </header>

    <form method="post" data-mx-ficha novalidate>
        <input type="hidden" asp-for="Form.Id" />
        <input type="hidden" asp-for="Form.Version" />

        <div asp-validation-summary="All" class="mx-errores" role="alert"><strong>Revisa lo siguiente antes de guardar:</strong></div>

        <div class="mx-ficha">
            <div>
                <section class="mx-tarjeta">
                    <div class="mx-tarjeta-cab"><i class="bi bi-buildings"></i><h2>Datos de la planta</h2></div>
                    <div class="mx-tarjeta-cuerpo">
                        <div class="mx-campos">
                            <div class="mx-campo c8">
                                <label asp-for="Form.Nombre">Nombre<span class="req">*</span></label>
                                <input asp-for="Form.Nombre" class="mx-input" maxlength="200" required autocomplete="off"
                                       data-mx-nombre-original="@Model.NombreOriginal" data-mx-aviso="avisoNombre" />
                                <span asp-validation-for="Form.Nombre" class="mx-error-campo"></span>
                                @if (!Model.EsNuevo)
                                {
                                    <div id="avisoNombre" class="mx-aviso-cambio">
                                        <i class="bi bi-info-circle"></i> Las operaciones ya creadas guardan el nombre anterior como texto; el cambio aplica a las operaciones nuevas.
                                    </div>
                                }
                            </div>
                            <div class="mx-campo c4">
                                <label>Estado</label>
                                <div class="mx-estado-toggle" role="radiogroup" aria-label="Estado">
                                    <input type="radio" id="estActivo" name="Form.Activo" value="true" checked="@Model.Form.Activo" />
                                    <label for="estActivo" class="mx-est-activo">Activa</label>
                                    <input type="radio" id="estInactivo" name="Form.Activo" value="false" checked="@(!Model.Form.Activo)" />
                                    <label for="estInactivo" class="mx-est-inactivo">Inactiva</label>
                                </div>
                                <div class="mx-ayuda">Inactiva: no aparece al crear o editar operaciones.</div>
                            </div>

                            <div class="mx-campo">
                                <label asp-for="Form.IdCiudad">Ciudad<span class="req">*</span></label>
                                <select asp-for="Form.IdCiudad" asp-items="Model.Ciudades" data-buscador="si" required>
                                    <option value="">— Elige la ciudad —</option>
                                </select>
                                <span asp-validation-for="Form.IdCiudad" class="mx-error-campo"></span>
                                <div class="mx-ayuda">Se usa para encontrar la tarifa del tramo. ¿Falta la ciudad? Créala en <a asp-page="/App/Ciudades/Index" target="_blank">Maestros › Ciudades</a>.</div>
                            </div>
                            <div class="mx-campo">
                                <label asp-for="Form.IdCliente">Cliente</label>
                                <select asp-for="Form.IdCliente" asp-items="Model.Clientes" data-buscador="si">
                                    <option value="">Todos los clientes</option>
                                </select>
                                <span asp-validation-for="Form.IdCliente" class="mx-error-campo"></span>
                                <div class="mx-ayuda">Si eliges un cliente, en el portal solo ese cliente ve la planta. El equipo interno la ve siempre.</div>
                            </div>

                            <div class="mx-campo c12">
                                <label asp-for="Form.Direccion">Dirección</label>
                                <input asp-for="Form.Direccion" class="mx-input" maxlength="500" placeholder="Ej: Ruta 5 Sur km 250, San Fernando" />
                                <span asp-validation-for="Form.Direccion" class="mx-error-campo"></span>
                            </div>
                            <div class="mx-campo c12">
                                <label asp-for="Form.UrlGoogleMaps">Enlace de Google Maps</label>
                                <input asp-for="Form.UrlGoogleMaps" class="mx-input" type="url" maxlength="1000" placeholder="https://maps.app.goo.gl/…" />
                                <span asp-validation-for="Form.UrlGoogleMaps" class="mx-error-campo"></span>
                                <div class="mx-ayuda">Operaciones lo usa para ubicar la planta al coordinar el transporte.</div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="mx-pie">
                    <span class="mx-pie-nota"><i class="bi bi-shield-check"></i> Se guardará a nombre de <strong>@AtilsonCargoSpa.Services.MaestrosAuditoria.Usuario(User)</strong>.</span>
                    <a asp-page="./Index" class="mx-btn mx-btn-secundario">Cancelar</a>
                    <button type="submit" class="mx-btn mx-btn-primario" data-mx-guardar><i class="bi bi-check2"></i> <span>@(Model.EsNuevo ? "Crear planta" : "Guardar cambios")</span></button>
                </div>
            </div>

            @if (!Model.EsNuevo)
            {
                <partial name="_MaestroRegistro" model="Model.Registro" />
            }
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/maestros.js" asp-append-version="true"></script>
}
