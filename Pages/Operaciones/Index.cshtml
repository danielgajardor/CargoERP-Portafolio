                                            </ul>

                                            @{
                                                // Parsear líneas del historial
                                                var lineasHistorial = string.IsNullOrEmpty(op.HistorialCorreos)
                                                    ? new List<string>()
                                                    : op.HistorialCorreos.Split('\n', StringSplitOptions.RemoveEmptyEntries).ToList();

                                                // Helper local para renderizar una línea
                                                // Formato: "dd/MM/yyyy HH:mm|usuario|MODULO|descripcion" 
                                                // NUEVO TRANSBORDO EN PUERTO CONEXION .
                                                // Formato: "dd/MM/yyyy HH:mm|usuario|MODULO|descripcion"
                                                // Helper local para renderizar una línea
                                                // Formato: "dd/MM/yyyy HH:mm|usuario|MODULO|descripcion"
                                                string RenderLinea(string linea)
                                                {
                                                    var p = linea.Split('|');
                                                    if (p.Length < 4) return "";
                                                    string fecha = p[0];
                                                    string usuario = p[1];
                                                    string modulo = p[2].ToUpper();
                                                    string desc = p[3];

                                                    string color = modulo switch
                                                    {
                                                        "MARITIMO" => "#0284c7",
                                                        "TRANSPORTE" => "#16a34a",
                                                        "DOCUMENTAL" => "#7e22ce",
                                                        _ => "#475569"
                                                    };
                                                    string bgColor = modulo switch
                                                    {
                                                        "MARITIMO" => "#f0f9ff",
                                                        "TRANSPORTE" => "#f0fdf4",
                                                        "DOCUMENTAL" => "#faf5ff",
                                                        _ => "#f8fafc"
                                                    };
                                                    string icon = modulo switch
                                                    {
                                                        "MARITIMO" => "bi-water",
                                                        "TRANSPORTE" => "bi-truck",
                                                        "DOCUMENTAL" => "bi-file-earmark-check",
                                                        _ => "bi-grid"
                                                    };

                                                    return $@"
                <div class='d-flex align-items-start mb-2 p-2 rounded' style='background-color: {bgColor}; border-left: 3px solid {color};'>
                    <div class='me-2 mt-1'>
                        <i class='bi {icon}' style='color:{color}; font-size: 14px;'></i>
                    </div>
                    <div class='flex-grow-1 ps-1'>
                        <div style='font-size: 11px; line-height: 1.4; color: #0f172a; font-weight: 500;'>{desc}</div>
                        <div class='d-flex justify-content-between align-items-center mt-1'>
                            <span style='font-size: 9px; color: #64748b;'><i class='bi bi-person-fill me-1'></i>{usuario}</span>
                            <span style='font-size: 9px; font-weight: 600; color: {color}; opacity: 0.8;'>{fecha}</span>
                        </div>
                    </div>
                </div>";
                                                }
                                            }

                                            <div class="tab-content" style="max-height:450px; overflow-y:auto;">

                                     
                                                <div class="tab-pane fade show active" id="hist-todas-@op.Id">
                                                    @if (!lineasHistorial.Any())
                                                    {
                                                        <div class="text-center p-5 bg-light rounded border border-dashed">
                                                            <i class="bi bi-clock-history text-muted opacity-25" style="font-size:3rem;"></i>
                                                            <h6 class="fw-bold text-muted mt-3 mb-1">Sin actividad registrada</h6>
                                                            <p class="text-muted mb-0" style="font-size:12px;">
                                                                Las acciones realizadas sobre esta operación aparecerán aquí.
                                                            </p>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="px-1">
                                                            @foreach (var l in lineasHistorial)
                                                            {
                                                                @Html.Raw(RenderLinea(l))
                                                            }
                                                        </div>
                                                    }
                                                </div>

                                             
                                                <div class="tab-pane fade" id="hist-general-@op.Id">
                                                    @{
                                                        var linesGen = lineasHistorial
                                                            .Where(l => { var pp = l.Split('|'); return pp.Length >= 3 && pp[2].ToUpper() == "GENERAL"; })
                                                            .ToList();
                                                    }
                                                    @if (!linesGen.Any())
                                                    {
                                                        <div class="text-center py-5 text-muted" style="font-size:12px;">
                                                            <i class="bi bi-grid opacity-25 d-block mb-2" style="font-size:2rem;"></i>
                                                            Sin registros en General.
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="px-1">
                                                            @foreach (var l in linesGen)
                                                            {
                                                                @Html.Raw(RenderLinea(l))
                                                            }
                                                        </div>
                                                    }
                                                </div>

                                                @if (reqMaritimo)
                                                {
                                                    <div class="tab-pane fade" id="hist-maritimo-@op.Id">
                                                        @{
                                                            var linesMar = lineasHistorial
