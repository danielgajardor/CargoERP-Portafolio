                                    <option value="Pagado por Atilson y refacturar al cliente">Atilson Refactura al Cliente</option>
                                    <option value="Por cuenta de cliente">Por cuenta de cliente</option>
                                    <option value="Por cuenta de Atilson">Por cuenta de Atilson</option>
                                    <option value="Por cuenta de naviera">Por cuenta de naviera</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-section p-3 mb-0">
                        <div class="section-title-sm mb-2">Eventos de Aduana</div>
                        <div class="row g-2">
                            <div class="col-md-4">
