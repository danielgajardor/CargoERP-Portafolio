        if (base64 && base64.trim() !== '') {
            try {
                let binaryString = window.atob(base64); let binaryLen = binaryString.length; let bytes = new Uint8Array(binaryLen);
                for (let i = 0; i < binaryLen; i++) { bytes[i] = binaryString.charCodeAt(i); }
                comentarios = new TextDecoder("utf-8").decode(bytes);
            } catch (e) { console.error("Error leyendo datos:", e); comentarios = "Error al intentar leer los comentarios del cliente."; }
        }
        Swal.fire({ title: 'Correcciones Solicitadas', html: `<div style="text-align: left; padding: 15px; background: #f8fafc; border-left: 4px solid #dc2626; border-radius: 4px; font-size: 13px; color: #334155; line-height: 1.5; white-space: pre-wrap; margin-top: 10px;">${comentarios}</div>`, icon: 'warning', iconColor: '#dc2626', confirmButtonText: 'Entendido', confirmButtonColor: '#0f172a', target: document.getElementById('megaModal') });
