@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/traspaso-finanzas.js" asp-append-version="true"></script>
    <script src="~/js/operaciones-common.js" asp-append-version="true"></script>
    <script src="~/js/extracosto-modal.js" asp-append-version="true"></script>
    @if (TempData["ErrorMsg"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire('Atención', '@Html.Raw(TempData["ErrorMsg"])', 'error');
            });
        </script>
    }
    @if (TempData["SuccessMsg"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    title: '¡Operación Exitosa!',
                    html: '@Html.Raw(TempData["SuccessMsg"])',
                    icon: 'success',
                    confirmButtonColor: '#10b981'
                });

                @if (TempData["OpenPdfId"] != null)
                {
                    <text>
                    setTimeout(() => {
                        window.open('/Operaciones/ReservaPdf?id=@TempData["OpenPdfId"]', '_blank');
                    }, 1000);
                    </text>
                }
            });
        </script>
    }

    <script src="~/js/operaciones-index.js" asp-append-version="true"></script>
}
}
    
