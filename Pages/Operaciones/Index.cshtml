<div class="modal fade modal-minimal" id="modalNotificacionesUnificadas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-warning border-2">
            <div class="modal-header" style="background-color: #fefce8;">
                <div>
                    <span class="mod-label text-warning mb-1" style="color: #d97706 !important;">Centro de Notificaciones</span>
                    <h4 class="modal-title fw-bold m-0 text-dark" style="font-size: 16px;"><i class="bi bi-bell-fill text-warning me-2"></i> Solicitudes desde el Portal</h4>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" style="background-color: #f8fafc; max-height:70vh; overflow-y:auto;">
                @if (Model.NotificacionesPendientes == null || !Model.NotificacionesPendientes.Any())
                {
                    <div class="text-center text-muted py-5"><i class="bi bi-check-circle fs-1 opacity-25"></i><p class="mt-2 mb-0" style="font-size:12px;">No hay notificaciones pendientes.</p></div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var n in Model.NotificacionesPendientes)
                        {
                            string colorTipo = n.Tipo == "ROLEO" ? "#dc2626" : n.CotEsCotizacionReal ? "#6d2d9e" : "#d97706";
                            string bgTipo = n.Tipo == "ROLEO" ? "#fef2f2" : n.CotEsCotizacionReal ? "#f5f0fa" : "#fffbeb";
                            string iconTipo = n.Tipo == "ROLEO" ? "bi-arrow-repeat" : n.CotEsCotizacionReal ? "bi-calculator" : "bi-inbox-fill";
                            <div class="p-3 rounded border bg-white shadow-sm" style="border-left: 4px solid @colorTipo !important;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="d-flex align-items-start gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:32px; height:32px; background:@bgTipo; color:@colorTipo;"><i class="bi @iconTipo"></i></div>
                                        <div>
                                            <span class="fw-bold text-dark d-block" style="font-size:12.5px;">@n.Titulo</span>
                                            @if (!string.IsNullOrWhiteSpace(n.CotCliente))
                                            {
                                                <span class="d-block fw-bold" style="font-size:11px; color:#6d2d9e;"><i class="bi bi-person-badge me-1"></i>@n.CotCliente</span>
                                            }
                                            <span class="text-muted d-block" style="font-size:11px;">@n.Subtitulo</span>
                                            <span class="text-muted d-block mt-1" style="font-size:10.5px; font-style:italic;">"@n.Detalle"</span>
                                            <span class="text-muted d-block mt-1" style="font-size:9px;">@n.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                                            @if (n.Tipo == "COTIZACION")
                                            {
                                                var chipsCot = new List<(string Icono, string Texto)>();
                                                if (!string.IsNullOrWhiteSpace(n.CotPlantaCarga)) chipsCot.Add(("bi-buildings", "Planta: " + n.CotPlantaCarga));
                                                if (!string.IsNullOrWhiteSpace(n.CotDepositoRetiro)) chipsCot.Add(("bi-box-seam", "Depósito: " + n.CotDepositoRetiro));
                                                if (n.CotFechaCarga.HasValue) chipsCot.Add(("bi-truck", "Carga: " + n.CotFechaCarga.Value.ToString("dd/MM/yyyy")));
                                                if (n.CotCantidadContenedores.HasValue) chipsCot.Add(("bi-stack", n.CotCantidadContenedores + " x " + (string.IsNullOrWhiteSpace(n.CotTipoContenedor) ? "contenedor(es)" : n.CotTipoContenedor)));
                                                if (!string.IsNullOrWhiteSpace(n.CotCondicionReefer)) chipsCot.Add(("bi-snow", "Reefer " + n.CotCondicionReefer));
                                                if (n.CotFechaTentativaEmbarque.HasValue) chipsCot.Add(("bi-water", "Embarque: " + n.CotFechaTentativaEmbarque.Value.ToString("dd/MM/yyyy")));
                                                if (!string.IsNullOrWhiteSpace(n.CotTipoCertificado)) chipsCot.Add(("bi-file-earmark-text", "Cert.: " + n.CotTipoCertificado));
                                                if (n.CotRequiereSag == true) chipsCot.Add(("bi-check2-square", "SAG"));
                                                if (n.CotRequiereSernapesca == true) chipsCot.Add(("bi-check2-square", "Sernapesca"));
                                                if (!string.IsNullOrWhiteSpace(n.CotNave)) chipsCot.Add(("bi-water", (n.CotDesdeItinerario ? "Nave elegida: " : "Nave: ") + n.CotNave + (string.IsNullOrWhiteSpace(n.CotNaviera) ? "" : " (" + n.CotNaviera + ")")));
                                                if (!string.IsNullOrWhiteSpace(n.CotBooking)) chipsCot.Add(("bi-ticket-perforated", "BKG " + n.CotBooking));
                                                if (!string.IsNullOrWhiteSpace(n.CotPuertoTerrestre)) chipsCot.Add(("bi-geo-alt", "Puerto terrestre: " + n.CotPuertoTerrestre));
                                                if (!string.IsNullOrWhiteSpace(n.CotInstructivo)) chipsCot.Add(("bi-file-earmark-text", "Instructivo " + n.CotInstructivo));
                                                if (n.CotIdCotizacionOrigen != null) chipsCot.Add(("bi-receipt", "Desde cotización #" + n.CotIdCotizacionOrigen));
                                                if (chipsCot.Any())
                                                {
                                                    <div class="d-flex flex-wrap gap-1 mt-2">
                                                        @foreach (var chip in chipsCot)
                                                        {
                                                            <span class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded border" style="font-size:9.5px; font-weight:700; color:#475569; background:#f8fafc; border-color:#e2e8f0 !important;"><i class="bi @chip.Icono" style="color:#6d2d9e;"></i>@chip.Texto</span>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex flex-column gap-1 flex-shrink-0">
                                        @if (n.Tipo == "COTIZACION" && n.CotEsCotizacionReal)
                                        {
                                            <a class="btn btn-sm fw-bold px-3 text-white" style="font-size:10px; background:#6d2d9e;" asp-page="/Operaciones/Cotizaciones" asp-route-id="@n.IdReferencia">Responder</a>
                                        }
                                        else if (n.Tipo == "COTIZACION")
                                        {
                                            var cotData = new
                                            {
                                                id = n.IdReferencia, cliente = n.CotCliente, correoCliente = n.CotCorreoCliente,
                                                servicio = n.CotTipoServicio, carga = n.CotTipoCarga,
                                                origen = n.CotOrigen, destino = n.CotDestino, paisFinal = n.CotPaisDestinoFinal,
                                                mercancia = n.CotMercancia, comentarios = n.CotComentarios,
                                                planta = n.CotPlantaCarga, deposito = n.CotDepositoRetiro, zona = n.CotZonaCarga,
                                                fechaCarga = n.CotFechaCarga?.ToString("dd/MM/yyyy"),
                                                contenedores = n.CotCantidadContenedores,
                                                fechaEmbarque = n.CotFechaTentativaEmbarque?.ToString("dd/MM/yyyy"),
                                                tipoContenedor = n.CotTipoContenedor, condicionReefer = n.CotCondicionReefer,
                                                temperatura = n.CotTemperatura, humedad = n.CotHumedad, ventilacion = n.CotVentilacion,
                                                certificado = n.CotTipoCertificado, sag = n.CotRequiereSag, sernapesca = n.CotRequiereSernapesca,
                                                seguro = n.CotRequiereSeguro, fechaSolicitud = n.Fecha.ToString("dd/MM/yyyy HH:mm"),
                                                pol = n.CotPol, pod = n.CotPod, puertoTerrestre = n.CotPuertoTerrestre, zonaEntrega = n.CotZonaEntrega,
                                                naviera = n.CotNaviera, nave = n.CotNave, desdeItinerario = n.CotDesdeItinerario,
                                                etaItinerario = n.CotEtaItinerario?.ToString("dd/MM/yyyy"), booking = n.CotBooking,
                                                instructivo = n.CotInstructivo, corteDoc = n.CotCorteDocumental?.ToString("dd/MM/yyyy HH:mm"),
                                                cotizacionOrigen = n.CotIdCotizacionOrigen
                                            };
                                            <button type="button" class="btn btn-sm btn-dark fw-bold px-3" style="font-size:10px;" data-cot="@System.Text.Json.JsonSerializer.Serialize(cotData)" onclick="verDetalleCotizacionPortal(this)">Revisar</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-dark fw-bold px-3" style="font-size:10px;" onclick="abrirDesdeNotificacionRoleo(@n.IdOperacion, 'maritimo-@n.IdOperacion')">Ir a la Operación</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary fw-bold px-3" style="font-size:10px;" onclick="marcarRoleoAtendido(@n.IdReferencia, this)">Marcar Atendido</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-minimal" id="modalSolicitudesCotizacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-warning border-2">
            <div class="modal-header" style="background-color: #fefce8;">
                <div>
                    <span class="mod-label text-warning mb-1" style="color: #d97706 !important;">Área Comercial</span>
                    <h4 class="modal-title fw-bold m-0 text-dark" style="font-size: 16px;"><i class="bi bi-inbox-fill text-warning me-2"></i> Solicitudes Recibidas desde el Portal</h4>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" style="background-color: #f8fafc;">
                @if (Model.NuevasCotizaciones != null && Model.NuevasCotizaciones.Any())
                {
                    <div class="table-responsive bg-white border rounded shadow-sm">
                        <table class="table table-hover align-middle mb-0" style="font-size: 11px;">
                            <thead class="bg-light text-muted" style="font-size: 10px; text-transform: uppercase;">
                                <tr>
                                    <th class="ps-3 py-3">Fecha Solicitud</th>
                                    <th class="py-3">Servicio Solicitado</th>
                                    <th class="py-3">Ruta Esperada</th>
                                    <th class="py-3">Mercancía</th>
                                    <th class="text-end pe-4 py-3">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var cot in Model.NuevasCotizaciones)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-dark">@(cot.FechaSolicitud?.ToString("dd/MM/yyyy HH:mm"))</td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary mb-1">@cot.TipoServicio</span><br>
                                            <span class="text-muted fw-bold" style="font-size: 9px;">@cot.TipoCarga</span>
                                        </td>
                                        <td class="fw-bold text-secondary">
                                            <span class="text-uppercase">@cot.Origen</span> <i class="bi bi-arrow-right mx-1 text-info"></i> <span class="text-uppercase">@cot.Destino</span>
                                        </td>
                                        <td class="text-uppercase text-muted" style="max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            @(string.IsNullOrEmpty(cot.Mercancia) ? "NO ESPECIFICADO" : cot.Mercancia)
                                        </td>
                                        <td class="text-end pe-4">
    <button type="button" class="btn btn-sm btn-dark fw-bold px-3 py-1" 
            onclick="verDetalleCotizacion(@cot.Id, '@cot.TipoServicio', '@cot.TipoCarga', '@cot.Origen', '@cot.Destino', '@(cot.Mercancia?.Replace("'","\\'") ?? "")', '@(cot.Comentarios?.Replace("\n", " ").Replace("\r", " ").Replace("'","\\'") ?? "")')" 
            style="font-size: 10px;">
        <i class="bi bi-eye-fill me-1"></i> Revisar
    </button>
    <button type="button" class="btn btn-sm btn-outline-danger fw-bold px-2 py-1 ms-1" 
            onclick="archivarSolicitudCotizacion(@cot.Id, this, event)" 
            title="Descartar solicitud">
        <i class="bi bi-trash3"></i>
    </button>
</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

