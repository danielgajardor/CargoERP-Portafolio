                            <div class="col-md-3"><label class="erp-label">Salida Planta (OUT)</label><input type="datetime-local" class="form-control erp-input fs-calc-planta" id="fsSalidaPlanta" name="SalidaPlanta" /></div>
                            <div class="col-md-3 d-flex align-items-end">
                                <div class="w-100 p-2 rounded text-center border" id="fsSobreestadiaBox" style="background: var(--bg-soft);">
                                    <span class="mod-label mb-1">SOBREESTADÍA PLANTA</span><span class="fw-bold text-dark" id="fsSobreestadiaTxt" style="font-size: 13px;">0h 0m</span>
                                </div>
                            </div>
                        </div>
                    </div>

