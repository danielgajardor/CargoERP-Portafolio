/* Contenido: transición suave al cambiar de pestaña (sin saltos) */
.pro-content-area { padding: 28px 36px !important; }
.tab-pane { animation: proFadeIn 0.18s ease; }
@@keyframes proFadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Cards: bordes más suaves, look menos "cuadrado" */
