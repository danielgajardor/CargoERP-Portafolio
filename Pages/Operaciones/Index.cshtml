    background-color: #10b981 !important;
    }

    .custom-switch-md .form-check-input.sw-danger:checked {
    background-color: #ef4444 !important;
    }

    .custom-switch-md .form-check-input:disabled {
    opacity: 0.6 !important;
    cursor: not-allowed;
    }

    .custom-switch-md .form-check-label {
    font-size: 11px;
    font-weight: 900;
    cursor: pointer;
    margin-bottom: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
