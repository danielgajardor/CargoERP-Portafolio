    margin-bottom: 0 !important;
    }
    #global-alert-content .text-info,
    #global-alert-content .text-warning,
    #global-alert-content .text-dark,
    #global-alert-content .border-info,
    #global-alert-content .border-warning {
    color: #0f172a !important;
    border-color: #0f172a !important;
    }
    #global-alert-content .text-danger,
    #global-alert-content .border-danger {
    color: #dc2626 !important;
    border-color: #dc2626 !important;
    }
    #global-alert-content strong {
    font-size: 11.5px !important;
    letter-spacing: 0.3px;
    }

    #global-alert-box::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 15px;
    width: 12px;
    height: 12px;
    background: #fff;
    border-left: 1px solid #fca5a5;
