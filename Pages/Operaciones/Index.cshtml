        <div class="modal-content border-0">
            <div class="modal-header" style="background: var(--atilson-dark);">
                <div><h5 class="modal-title fw-bold text-white" style="font-size: 15px;"><i class="bi bi-flag-fill me-2 text-success"></i> Aviso Servicio Finalizado</h5></div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Operaciones/Index?handler=FinalizarServicio" enctype="multipart/form-data">
                <input type="hidden" name="__RequestVerificationToken" class="anti-forgery-token-input" value="" />
                <input type="hidden" name="id" id="finOpId" value="" />
