                                <input type="number" id="fsHorasLibresPuerto" name="HorasLibresPuerto" value="3" class="form-control erp-input border-primary fw-bold" />
                            </div>
                            <div class="col-md-3"><label class="erp-label">Llegada Puerto (IN)</label><input type="datetime-local" class="form-control erp-input fs-calc-puerto" id="fsLlegadaPuerto" name="LlegadaPuerto" required /></div>
                            <div class="col-md-3"><label class="erp-label">Salida Puerto (OUT)</label><input type="datetime-local" class="form-control erp-input fs-calc-puerto" id="fsSalidaPuerto" name="SalidaPuerto" /></div>
                            <div class="col-md-3 d-flex align-items-end">
                                <div class="w-100 p-2 rounded text-center border" id="fsSobreestadiaPuertoBox" style="background: var(--bg-soft);">
                                    <span class="mod-label mb-1">SOBREESTADÍA PUERTO</span><span class="fw-bold text-dark" id="fsSobreestadiaPuertoTxt" style="font-size: 13px;">0h 0m</span>
                                </div>
                            </div>

                            <div class="col-12 mt-3 p-3 rounded border border-danger bg-danger bg-opacity-10 d-none" id="fsLarContainer">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5 me-2"></i>
