                        <div class="col-6"><span style="font-size:10px; color:#64748b; font-weight:800; text-transform:uppercase;">Origen:</span><br><strong style="color:#0f172a; text-transform:uppercase;">${origen}</strong></div>
                        <div class="col-6"><span style="font-size:10px; color:#64748b; font-weight:800; text-transform:uppercase;">Destino:</span><br><strong style="color:#0f172a; text-transform:uppercase;">${destino}</strong></div>
                    </div>
                    <div class="mb-3 pb-2 border-bottom">
                        <span style="font-size:10px; color:#64748b; font-weight:800; text-transform:uppercase;">Mercancía:</span><br>
                        <strong style="color:#0f172a; text-transform:uppercase;">${mercancia || 'No especificada'}</strong>
                    </div>
                    <div>
                        <span style="font-size:10px; color:#64748b; font-weight:800; text-transform:uppercase;">Comentarios del Cliente:</span><br>
                        <span style="color:#475569; font-style:italic;">${comentarios || 'Sin requerimientos adicionales.'}</span>
                    </div>
                </div>
            `,
            width: 600,
            showCancelButton: true,
            confirmButtonText: '<i class="bi bi-rocket-takeoff-fill me-1"></i> APROBAR E INICIAR OPERACIÓN',
            cancelButtonText: 'Cerrar',
            confirmButtonColor: '#0ea5e9',
            cancelButtonColor: '#64748b',
        }).then((result) => {
            if(result.isConfirmed) {
                window.location.href = '/Operaciones/Create?cotId=' + id;
            } else {
                if (modalObj) modalObj.show();
            }
        });
    };

    window.toggleCourierBloque = function(contextId, checked) {
    const ctx = modalCtx() || document;
    const div = ctx.querySelector(`#courier-fields-${contextId}`);
    if (div) div.style.display = checked ? 'block' : 'none';
    if (checked) detectarPaisCourier(contextId);
};

window.setTipoCourier = function(contextId, tipo) {
    const ctx = modalCtx() || document;
    const hidden = ctx.querySelector(`#hidden-tipo-courier-${contextId}`);
    if (hidden) hidden.value = tipo;
    const btnNac = ctx.querySelector(`#btn-courier-nac-${contextId}`);
    const btnInt = ctx.querySelector(`#btn-courier-int-${contextId}`);
    if (btnNac) btnNac.classList.toggle('active', tipo === 'Nacional');
    if (btnInt) btnInt.classList.toggle('active', tipo === 'Internacional');
    const zonaDiv = ctx.querySelector(`#zona-courier-${contextId}`);
    if (zonaDiv) zonaDiv.style.display = tipo === 'Internacional' ? 'block' : 'none';
};

window.detectarPaisCourier = function(contextId) {
    const ctx = modalCtx() || document;
    const wrapper = ctx.querySelector(`#courier-${contextId}`);
    if (!wrapper) return;

    let paisOrigen = wrapper.getAttribute('data-pais-origen') || '';
    let paisDestino = wrapper.getAttribute('data-pais-destino') || '';

    const selOrigen = ctx.querySelector(`#mar-form-${contextId} select[name="IdPuertoOrigen"]`);
    const selDestino = ctx.querySelector(`#mar-form-${contextId} select[name="IdPuertoDestino"]`);
    if (selOrigen && selOrigen.selectedIndex >= 0) {
        const opt = selOrigen.options[selOrigen.selectedIndex];
        if (opt && opt.getAttribute('data-pais')) paisOrigen = opt.getAttribute('data-pais');
    }
    if (selDestino && selDestino.selectedIndex >= 0) {
        const opt = selDestino.options[selDestino.selectedIndex];
        if (opt && opt.getAttribute('data-pais')) paisDestino = opt.getAttribute('data-pais');
    }

    let paisExtranjero = '';
    if (paisOrigen && paisOrigen !== 'CHILE') paisExtranjero = paisOrigen;
    else if (paisDestino && paisDestino !== 'CHILE') paisExtranjero = paisDestino;

    setTipoCourier(contextId, paisExtranjero ? 'Internacional' : 'Nacional');

    if (paisExtranjero) {
        const selPais = ctx.querySelector(`#select-pais-courier-${contextId}`);
        if (selPais) {
            for (let i = 0; i < selPais.options.length; i++) {
                if (selPais.options[i].value.toUpperCase() === paisExtranjero.toUpperCase()) { selPais.selectedIndex = i; break; }
            }
        }
    }
};

    window.procesarCambioInterplanta = function(select, idOp, numPlanta) {
    const form = select.closest('form');
    if (!form) return;

    // 1. Rellenar automáticamente el Link de Maps
    const option = select.options[select.selectedIndex];
    const linkMaps = option ? option.getAttribute('data-url') : '';
    const inputLink = form.querySelector(`input[name="LinkMaps${numPlanta}"]`);
    if (inputLink) inputLink.value = linkMaps || '';

    // 2. Disparar la evaluación de la ruta
    evaluarRutaLogistica(idOp, form);
};

window.evaluarRutaLogistica = async function(idOp, form) {
    const chkAplica = form.querySelector(`input[name="AplicaInterplanta"]`);
    if (!chkAplica || !chkAplica.checked) return; // Si no aplica interplanta, no hacemos nada

    const selP1 = form.querySelector('select[name="PlantaCarga"]');
    const selP2 = form.querySelector('select[name="PlantaCarga2"]');
    
    if (!selP1 || !selP2 || selP1.value === "" || selP2.value === "") return;

    // Extraemos las ciudades de los data-attributes
    const ciudad1 = selP1.options[selP1.selectedIndex].getAttribute('data-ciudad') || '';
    const ciudad2 = selP2.options[selP2.selectedIndex].getAttribute('data-ciudad') || '';

    if (ciudad1 && ciudad2 && ciudad1 !== ciudad2) {
        try {
            // Llamada asíncrona al backend de C#
            let response = await fetch(`?handler=CalcularDistanciaLogistica&origen=${encodeURIComponent(ciudad1)}&destino=${encodeURIComponent(ciudad2)}`);
            
            if (response.ok) {
                let data = await response.json();
                if (data.success) {
                    let dist = data.distanciaKm;
                    console.log(`[ATILSON] Trayecto Interplanta Evaluado: ${dist} km`);

                    if (dist > 70) {
                        Swal.fire({
                            icon: 'error',
                            title: `Trayecto largo (${dist} km)`,
                            text: 'El trayecto supera el límite interplanta. El sistema dividirá esta operación en 2 Tramos Terrestres independientes para su facturación.',
                            confirmButtonColor: '#0f172a',
                            target: document.getElementById('megaModal')
                        });
                    } else if (dist > 20) {
                        Swal.fire({
                            icon: 'warning',
                            title: `Alerta de Distancia (${dist} km)`,
                            text: 'La distancia supera los 20 km. Se requiere ingresar y justificar un ACUERDO COMERCIAL ESPECIAL para procesar esta interplanta.',
                            confirmButtonColor: '#d97706',
                            target: document.getElementById('megaModal')
                        });
                    } else {
                        Swal.fire({
                            icon: 'success',
                            title: `Interplanta Corta (${dist} km)`,
                            text: 'Aplica tarifa plana automática de porteo.',
                            timer: 2000,
                            showConfirmButton: false,
                            target: document.getElementById('megaModal')
                        });
                    }
                }
            }
        } catch (e) {
            console.error("Error al procesar el motor de rutas", e);
        }
    }
};

    // Modal de PDF Booking Cliente
    document.addEventListener('click', function(e) {
        const btn = e.target.closest('.btn-enviar-correo');
        if (!btn) return;
        e.preventDefault();

        const idOp = btn.getAttribute('data-id');
        const versionActual = parseInt(btn.getAttribute('data-version')) || 1;
        const fueEnviadoAlgunaVez = btn.getAttribute('data-fue-enviado') === 'true';
        const correoCliente = btn.getAttribute('data-correo') || '';
        const nuevaVersion = fueEnviadoAlgunaVez ? versionActual + 1 : versionActual;

        const iframe = document.getElementById('iframePdfIndex');
        const spinner = document.getElementById('pdfLoadingSpinnerIndex');
        const inputCorreo = document.getElementById('modalCorreoDestino');
        const indicador = document.getElementById('indicadorEnvioIndex');
        const subtitle = document.getElementById('pdfPreviewSubtitle');
        const btnEnviar = document.getElementById('btnEnviarAlClienteIndex');

        if (inputCorreo) inputCorreo.value = correoCliente;
        if (subtitle) subtitle.innerText = fueEnviadoAlgunaVez ? `Reenvío — se generará la versión V${nuevaVersion}` : 'Primer envío al cliente';

        if (indicador) {
            indicador.style.display = 'inline-block';
            if (fueEnviadoAlgunaVez) { indicador.style.background = '#dbeafe'; indicador.style.color = '#1d4ed8'; indicador.innerText = `Actualización V${nuevaVersion}`; } 
            else { indicador.style.background = '#fef3c7'; indicador.style.color = '#d97706'; indicador.innerText = 'Primer Envío'; }
        }

        if (iframe && spinner) {
            iframe.style.display = 'none'; spinner.style.display = 'flex'; iframe.src = `/Operaciones/ReservaPdf/${idOp}`;
            iframe.onload = function() { spinner.style.display = 'none'; iframe.style.display = 'block'; };
        }

        if (btnEnviar) { btnEnviar.setAttribute('data-id', idOp); btnEnviar.setAttribute('data-nueva-version', nuevaVersion); }
        let modalObj = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalPdfPreviewIndex'));
        modalObj.show();
    }, true);

    document.getElementById('btnEnviarAlClienteIndex')?.addEventListener('click', function() {
        const idOp = this.getAttribute('data-id');
        const nuevaVersion = this.getAttribute('data-nueva-version');
        const correo = document.getElementById('modalCorreoDestino').value.trim();
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        if (!correo || !correo.includes('@@')) { Swal.fire('Correo inválido', 'Ingresa un correo válido para el cliente.', 'warning'); return; }

        const originalHtml = this.innerHTML; this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Enviando...'; this.disabled = true; const btnRef = this;
        let formData = new FormData(); formData.append('id', idOp); formData.append('correoDestino', correo); formData.append('nuevaVersion', nuevaVersion);

        fetch('?handler=EnviarCorreoReserva', { method: 'POST', headers: { 'RequestVerificationToken': token }, body: formData })
        .then(res => res.json()).then(data => {
            btnRef.innerHTML = originalHtml; btnRef.disabled = false;
            if (data.success) {
                Swal.fire({ icon: 'success', title: '¡Enviado!', text: `Booking enviado correctamente (V${nuevaVersion}).`, confirmButtonColor: '#10b981' })
                .then(() => { let modalObj = bootstrap.Modal.getInstance(document.getElementById('modalPdfPreviewIndex')); if (modalObj) modalObj.hide(); location.reload(); });
            } else { Swal.fire('Error', data.message || 'No se pudo enviar el correo.', 'error'); }
        }).catch(() => { btnRef.innerHTML = originalHtml; btnRef.disabled = false; Swal.fire('Error', 'Fallo de conexión al enviar el correo.', 'error'); });
    });

</script>
}
