@page
@model AtilsonCargoSpa.Pages.Operaciones.IndexModel
@{
    ViewData["Title"] = "Panel Operativo";
    DateOnly hoyDateOnly = DateOnly.FromDateTime(DateTime.Now);
}
@functions {
    // 1. Declaramos las funciones UNA SOLA VEZ para todo el documento
    public string FormatearTipoPuro(string tipoConte, int? tipoCarga) {
        int tcNum = tipoCarga.GetValueOrDefault(1);
        string tc = (tipoConte ?? "40' HC").Replace("'", "").Replace("REEFER", "RF");
        if (!tc.Contains("DRY") && !tc.Contains("RF")) tc += (tcNum == 2 ? " RF" : " DRY");
        return tc;
    }

        public string GetProDot(bool? aplica, string log) {
        if (aplica == false) return "bg-secondary opacity-25";
        if (string.IsNullOrEmpty(log)) return "bg-warning";
        if (log.ToUpper().Contains("RECHAZADO") || log.ToUpper().Contains("❌")) return "bg-danger";
        if (log.ToUpper().Contains("APROBADO") || log.ToUpper().Contains("RECEPCIÓN CONFIRMADA")) return "bg-success";
        return "bg-info"; 
    }

    // Badge visible de la modalidad SAG, sin necesidad de entrar en modo edición.
    public string GetSagModalidadBadgeClass(string? modalidad) {
        if (modalidad == "Planta") return "bg-success bg-opacity-10 text-success border-success";
        if (modalidad == "Puerto") return "bg-warning bg-opacity-10 text-warning border-warning";
        return "bg-danger bg-opacity-10 text-danger border-danger";
    }
    public string GetSagModalidadTexto(string? modalidad) {
        if (modalidad == "Planta") return "SAG EN PLANTA · SIN COSTO";
        if (modalidad == "Puerto") return "SAG FUERA DE PLANTA · APLICA TARIFA";
        return "MODALIDAD SAG PENDIENTE";
    }
    public string GetSagModalidadIcono(string? modalidad) {
        if (modalidad == "Planta") return "bi-house-check-fill";
        if (modalidad == "Puerto") return "bi-geo-alt-fill";
        return "bi-question-circle-fill";
    }

    public string RenderLinea(string linea) {
        var p = linea.Split('|');
        if (p.Length < 4) return "";
        string fecha = p[0];
        string usuario = p[1];
        string modulo = p[2].ToUpper();
        string desc = p[3];

        string color = modulo switch {
            "MARITIMO" => "#0284c7",
            "TRANSPORTE" => "#16a34a",
            "DOCUMENTAL" => "#7e22ce",
            _ => "#475569"
        };
        string bgColor = modulo switch {
            "MARITIMO" => "#f0f9ff",
            "TRANSPORTE" => "#f0fdf4",
            "DOCUMENTAL" => "#faf5ff",
            _ => "#f8fafc"
        };
        string icon = modulo switch {
            "MARITIMO" => "bi-water",
            "TRANSPORTE" => "bi-truck",
            "DOCUMENTAL" => "bi-file-earmark-check",
            _ => "bi-grid"
        };

                return $@"
        <div class='d-flex align-items-start mb-2 p-2 rounded' style='background-color: {bgColor}; border-left: 3px solid {color};'>
            <div class='me-2 mt-1'>
                <i class='bi {icon}' style='color:{color}; font-size: 14px;'></i>
            </div>
            <div class='flex-grow-1 ps-1'>
                <div style='font-size: 11px; line-height: 1.4; color: #0f172a; font-weight: 500;'>{desc}</div>
                <div class='d-flex justify-content-between align-items-center mt-1'>
                    <span style='font-size: 9px; color: #64748b;'><i class='bi bi-person-fill me-1'></i>{usuario}</span>
                    <span style='font-size: 9px; font-weight: 600; color: {color}; opacity: 0.8;'>{fecha}</span>
                </div>
            </div>
        </div>";
    }

    // Colores del badge de Estado, reutilizables por contenedor (antes vivía
    // inline y solo aplicaba a un único estado por booking).
    public (string Bg, string Txt, string Border) ColorEstado(string? estado) {
        string estadoUpper = (estado ?? "SOLICITADO").ToUpper();
        string bg = "#f8fafc"; string txt = "#64748b"; string border = "#e2e8f0";
        if (estadoUpper.Contains("SOLICITADO") || estadoUpper.Contains("CONFIRMADO") || estadoUpper.Contains("ENVIO A CLIENTE") || estadoUpper.Contains("ENVÍO A CLIENTE"))
        { bg = "#fef3c7"; txt = "#d97706"; border = "#fde68a"; }
        else if (estadoUpper.Contains("EN RUTA PLANTA") || estadoUpper.Contains("ENTREGADO A STACKING") || estadoUpper.Contains("ARRIBADO A PLANTA") || estadoUpper.Contains("SALIDA DE PLANTA") || estadoUpper.Contains("EN RUTA A PUERTO"))
        { bg = "#e0f2fe"; txt = "#0284c7"; border = "#bae6fd"; }
        else if (estadoUpper.Contains("EMBARCADO") || estadoUpper.Contains("ZARPE") || estadoUpper.Contains("PROXIMO ARRIBO") || estadoUpper.Contains("PRÓXIMO ARRIBO"))
        { bg = "#f3e8ff"; txt = "#7e22ce"; border = "#e9d5ff"; }
        else if (estadoUpper.Contains("ARRIBADO") || estadoUpper.Contains("CONTENEDOR RETIRADO") || estadoUpper.Contains("FINALIZADO") || estadoUpper.Contains("CERRADO"))
        { bg = "#dcfce7"; txt = "#16a34a"; border = "#bbf7d0"; }
        else if (estadoUpper.Contains("CANCELADO"))
        { bg = "#fef2f2"; txt = "#dc2626"; border = "#fecaca"; }
        return (bg, txt, border);
    }
}
