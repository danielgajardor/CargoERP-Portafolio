var t = terrPorUnidad.TryGetValue(0, out var tMainUnit) ? tMainUnit : null;
var d = docsPorUnidad.TryGetValue(0, out var dMainUnit) ? dMainUnit : null;
                        var tiposBlSeleccionados = (op.TipoEmisionBl ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();

