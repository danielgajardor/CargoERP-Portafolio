@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    @if (TempData["ErrorMsg"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire('Atención', '@Html.Raw(TempData["ErrorMsg"])', 'error');
            });
        </script>
    }
    @if (TempData["SuccessMsg"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    title: '¡Operación Exitosa!',
                    html: '@Html.Raw(TempData["SuccessMsg"])',
                    icon: 'success',
                    confirmButtonColor: '#10b981'
                });

                @if (TempData["OpenPdfId"] != null)
                {
                    <text>
                    setTimeout(() => {
                        window.open('/Operaciones/ReservaPdf?id=@TempData["OpenPdfId"]', '_blank');
                    }, 1000);
                    </text>
                }
            });
        </script>
    }

<script>
    // ==========================================
    // 0. HELPERS (Contexto del Modal)
    // ==========================================
    function modalCtx() { return document.getElementById('modalDynamicBody'); }
    function mq(selector) { const ctx = modalCtx(); return ctx ? ctx.querySelector(selector) : null; }
    function mqAll(selector) { const ctx = modalCtx(); return ctx ? Array.from(ctx.querySelectorAll(selector)) : []; }

        function isToday(dateString) {
        const d = new Date(dateString);
        const today = new Date();
        return d.getDate() === today.getDate() &&
               d.getMonth() === today.getMonth() &&
               d.getFullYear() === today.getFullYear();
    }
    // ==========================================
    // 0.1 SELECT2: BÚSQUEDA PREDICTIVA (Naviera, POL, POD, Depósito, Planta, Agencia)
    // Se re-inicializa en CADA apertura del modal, porque #modalDynamicBody
    // se vacía y se vuelve a clonar desde el <template> cada vez — no hay
    // una instancia persistente que reutilizar entre operaciones.
    // ==========================================
    window.initSelect2EnModal = function() {
        if (typeof $ === 'undefined' || !$.fn.select2) return;
        const ctx = modalCtx();
        if (!ctx) return;
        $(ctx).find('.select2-enable').each(function() {
            $(this).select2({
                width: '100%',
                dropdownParent: $(ctx),
                language: {
                    noResults: function() { return "Sin resultados"; },
                    searching: function() { return "Buscando..."; }
                }
            });
        });
    };
    if (typeof $ !== 'undefined') {
        $(document).on('keyup', '.select2-search__field', function() {
            $(this).val($(this).val().toUpperCase());
        });
    }
    // ==========================================
    // 0.4 MODALIDAD CERTIFICADO (GRUPAL / INDIVIDUAL)
    // ==========================================
    window.cambiarModalidadCertificado = function(idOp, modalidad) {
        let token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        let formData = new FormData();
        formData.append('idOperacion', idOp);
        formData.append('modalidad', modalidad);

        fetch('?handler=ActualizarModalidadCertificado', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                Swal.fire({ icon: 'success', title: 'Modalidad actualizada', toast: true, position: 'top-end', timer: 1200, showConfirmButton: false });
                setTimeout(() => window.location.reload(), 700);
            } else {
                Swal.fire('No se pudo cambiar', data.message || 'Error desconocido.', 'warning').then(() => window.location.reload());
            }
        }).catch(() => { Swal.fire('Error', 'Fallo de conexión.', 'error'); window.location.reload(); });
    };

    window.cambiarModalidadCertPorCertificado = function(idOp, certKey, modalidad) {
