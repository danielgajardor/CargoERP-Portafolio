                                </div>
                            </div>
                            <div class="col-md-8" id="fsSorteoEscanerFileDiv" style="display: none;">
                                <label class="erp-label text-muted">Respaldo EIR (Opcional)</label>
                                <input type="file" name="EvidenciaEscaner" id="fsSorteoEscanerFile" class="form-control erp-input py-1" accept=".pdf, .jpg, .png" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-2">
                    <button type="button" class="btn btn-light border btn-sm fw-bold" data-bs-dismiss="modal">CANCELAR</button>
                    <button type="submit" class="btn btn-dark btn-sm fw-bold px-4">FINALIZAR Y NOTIFICAR</button>
                </div>
            </form>
        </div>
    </div>
</div>

