                            13 => "IMP TER",
                            14 => "IMP DOC",
                            _ => "POR CONFIRMAR"
                        };

                        bool reqMaritimo = new[] { 1, 2, 3, 5, 8, 9, 10, 12 }.Contains(s);
                        bool reqTerrestre = new[] { 1, 2, 4, 6, 8, 9, 11, 13 }.Contains(s);
                        bool reqDocumental = new[] { 1, 3, 4, 7, 8, 10, 11, 14 }.Contains(s);
                        bool reqMatriz = reqMaritimo || reqDocumental;

                        string actMar = reqMaritimo ? "active" : "";
                        string actTer = !reqMaritimo && reqTerrestre ? "active" : "";
                        string actDoc = !reqMaritimo && !reqTerrestre && reqDocumental ? "active" : "";
                        string showMar = reqMaritimo ? "show active" : "";
                        string showTer = !reqMaritimo && reqTerrestre ? "show active" : "";
