                                                                                <div class="tab-pane fade" id="almacenamiento-@op.Id" role="tabpanel">
    @{
        var almacen = op.OperacionesAlmacenamientos?.FirstOrDefault();
        string estadoAlmacen = "SIN ASIGNAR";
        string colorEstadoAlmacen = "#94a3b8";
        if (almacen != null)
        {
            if (almacen.FechaIngreso.HasValue && !almacen.FechaSalida.HasValue) { estadoAlmacen = "EN PATIO"; colorEstadoAlmacen = "#d97706"; }
            else if (almacen.FechaIngreso.HasValue && almacen.FechaSalida.HasValue) { estadoAlmacen = "RETIRADO"; colorEstadoAlmacen = "#16a34a"; }
            else { estadoAlmacen = "PROGRAMADO"; colorEstadoAlmacen = "#0284c7"; }
        }
    }
    <form method="post" action="/Operaciones/Index?handler=GuardarAlmacenamiento" enctype="multipart/form-data" id="almacen-form-@op.Id">
        <input type="hidden" name="__RequestVerificationToken" class="anti-forgery-token-input" value="" />
        <input type="hidden" name="IdOperacion" value="@op.Id" />

        <div class="form-section shadow-sm">
            <div class="section-title-sm">
                <span><i class="bi bi-boxes me-1"></i> Servicio de Almacenamiento</span>
                <span class="fw-bold text-uppercase px-3 py-1 rounded" style="font-size:9px; letter-spacing:0.5px; background:#f8fafc; border:1px solid var(--border-soft); color:@colorEstadoAlmacen;">@estadoAlmacen</span>
            </div>

            <div class="row g-4">
                <!-- INGRESO -->
                <div class="col-md-6">
                    <h6 class="mod-label mb-3" style="font-size:10px; border-bottom:1px solid var(--border-soft); padding-bottom:8px;"><i class="bi bi-box-arrow-in-right me-1"></i> Ingreso a Patio</h6>

                    <div class="row g-3 mb-3">
                                                <div class="col-12">
                            <label class="mod-label">Depósito Asignado</label>
                            <select name="IdProveedor" class="form-select erp-input select2-enable">
                                <option value="">- Seleccionar Depósito de Almacenamiento -</option>
                                @foreach (var grupoAlm in Model.ListaCadenasAlmacen.GroupBy(x => x.Group?.Name ?? ""))
                                {
                                    <optgroup label="@grupoAlm.Key">
                                        @foreach (var itemAlm in grupoAlm)
                                        {
                                            <option value="@itemAlm.Value" selected="@(almacen?.IdProveedor?.ToString() == itemAlm.Value ? "selected" : null)">@itemAlm.Text</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="mod-label">Estado del Contenedor</label>
                            <select name="EstadoContenedor" class="form-select erp-input fw-bold">
                                <option value="">- Seleccionar -</option>
                                <option value="FULL" selected="@(almacen?.EstadoContenedor == "FULL" ? "selected" : null)">Lleno (Full)</option>
                                <option value="VACIO" selected="@(almacen?.EstadoContenedor == "VACIO" ? "selected" : null)">Vacío</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="mod-label">Fecha y Hora de Ingreso</label>
                            <input type="datetime-local" name="FechaIngreso" class="form-control erp-input" value="@(almacen?.FechaIngreso?.ToString("yyyy-MM-ddTHH:mm"))" />
                        </div>
                    </div>

                    <div class="p-3 border rounded mb-3" style="background:var(--bg-soft);">
                        <div class="mod-label mb-2" style="border-bottom:1px solid var(--border-soft); padding-bottom:6px;">Datos del Transportista (Entrega)</div>
                        <div class="row g-2">
                            <div class="col-7"><input type="text" name="ConductorIngresoNombre" list="listaChoferesAlmacen-@op.Id" class="form-control erp-input" value="@almacen?.ConductorIngresoNombre" placeholder="Nombre completo" autocomplete="off" /></div>
                            <div class="col-5"><input type="text" name="ConductorIngresoRut" class="form-control erp-input font-monospace" value="@almacen?.ConductorIngresoRut" placeholder="RUT" /></div>
                            <div class="col-6"><input type="text" name="ConductorIngresoTelefono" class="form-control erp-input font-monospace" value="@almacen?.ConductorIngresoTelefono" placeholder="Teléfono" /></div>
                            <div class="col-6"><input type="text" name="CamionIngresoPatente" class="form-control erp-input fw-bold text-uppercase" value="@almacen?.CamionIngresoPatente" placeholder="Patente" /></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="mod-label">Observaciones</label>
                        <input type="text" name="Comentarios" class="form-control erp-input" value="@almacen?.Comentarios" placeholder="Opcional..." />
                    </div>

                    <div class="text-end pt-2 border-top">
                        <button type="button" class="btn btn-sm btn-outline-dark fw-bold py-1 px-3" style="font-size:10px;" onclick="guardarAlmacenYEnviar(@op.Id, 'almacenIngreso')">
                            <i class="bi bi-envelope-paper me-1"></i> PREVISUALIZAR CORREO DE INGRESO
                        </button>
                    </div>
                </div>

                <!-- RETIRO -->
                <div class="col-md-6 ps-md-4" style="border-left: 1px dashed var(--border-soft);">
                    <h6 class="mod-label mb-3" style="font-size:10px; border-bottom:1px solid var(--border-soft); padding-bottom:8px;"><i class="bi bi-box-arrow-up-right me-1"></i> Retiro de Patio</h6>

                    <div class="row g-3 mb-3">
                                                <div class="col-12">
                            <label class="mod-label">Depósito Asignado</label>
                            <select name="IdProveedorRetiro" class="form-select erp-input select2-enable">
                                <option value="">- Seleccionar Depósito -</option>
                                @foreach (var grupoAlmR in Model.ListaCadenasAlmacen.GroupBy(x => x.Group?.Name ?? ""))
                                {
                                    <optgroup label="@grupoAlmR.Key">
                                        @foreach (var itemAlmR in grupoAlmR)
                                        {
                                            <option value="@itemAlmR.Value" selected="@(almacen?.IdProveedor?.ToString() == itemAlmR.Value ? "selected" : null)">@itemAlmR.Text</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="mod-label">Fecha y Hora de Salida</label>
                            <input type="datetime-local" name="FechaSalida" class="form-control erp-input" value="@(almacen?.FechaSalida?.ToString("yyyy-MM-ddTHH:mm"))" />
                        </div>
                    </div>

                    <div class="p-3 border rounded mb-3" style="background:var(--bg-soft);">
                        <div class="mod-label mb-2" style="border-bottom:1px solid var(--border-soft); padding-bottom:6px;">Datos del Transportista (Retiro)</div>
                        <div class="row g-2">
                            <div class="col-7"><input type="text" name="ConductorSalidaNombre" list="listaChoferesAlmacen-@op.Id" class="form-control erp-input" value="@almacen?.ConductorSalidaNombre" placeholder="Nombre completo" autocomplete="off" /></div>
                            <div class="col-5"><input type="text" name="ConductorSalidaRut" class="form-control erp-input font-monospace" value="@almacen?.ConductorSalidaRut" placeholder="RUT" /></div>
                            <div class="col-6"><input type="text" name="ConductorSalidaTelefono" class="form-control erp-input font-monospace" value="@almacen?.ConductorSalidaTelefono" placeholder="Teléfono" /></div>
                            <div class="col-6"><input type="text" name="CamionSalidaPatente" class="form-control erp-input fw-bold text-uppercase" value="@almacen?.CamionSalidaPatente" placeholder="Patente" /></div>
                        </div>
                    </div>

                    <div class="p-3 border rounded mb-3" style="background:var(--bg-soft);">
                        <label class="mod-label mb-2"><i class="bi bi-receipt me-1"></i> Respaldo de Pago (Almacenaje)</label>
                        <input type="file" name="ArchivoTransferenciaAlmacen" class="form-control form-control-sm erp-input" accept=".pdf, image/*" onchange="subirRespaldoAlmacen(this, @op.Id)" />
                        <div id="link-respaldo-almacen-@op.Id" class="mt-2" style="display:@(!string.IsNullOrEmpty(almacen?.RutaArchivoTransferencia) ? "block" : "none");">
                            <a href="@almacen?.RutaArchivoTransferencia" target="_blank" class="btn btn-sm btn-outline-dark py-1 px-2 fw-bold" style="font-size:10px;"><i class="bi bi-eye me-1"></i> Ver Comprobante Actual</a>
                        </div>
                    </div>

                    <div class="text-end pt-2 border-top">
                        <button type="button" class="btn btn-sm btn-outline-dark fw-bold py-1 px-3" style="font-size:10px;" onclick="guardarAlmacenYEnviar(@op.Id, 'almacenRetiro')">
                            <i class="bi bi-envelope-paper me-1"></i> PREVISUALIZAR CORREO DE RETIRO
                        </button>
                    </div>
                </div>
            </div>

            <div class="text-end mt-4 pt-3 border-top">
                <button type="button" class="btn btn-dark btn-sm fw-bold px-4 shadow-sm" onclick="guardarAlmacenamientoAjax(@op.Id, this)">
                    <i class="bi bi-save me-1"></i> Guardar Almacenamiento
                </button>
            </div>
        </div>
    </form>

    <datalist id="listaChoferesAlmacen-@op.Id">
        @foreach (var c in Model.ChoferesHistorialAlmacen)
        {
            <option value="@c.Nombre" data-rut="@c.Rut" data-tel="@c.Telefono" data-pat="@c.Patente"></option>
        }
    </datalist>
</div>

                                        <div class="tab-pane fade" id="courier-@op.Id" role="tabpanel" data-pais-origen="@((op.IdPuertoOrigenNavigation?.Pais ?? "").ToUpper())" data-pais-destino="@((op.IdPuertoDestinoNavigation?.Pais ?? "").ToUpper())">
