                                                                data-bs-target="#hist-documental-@op.Id"
                                                                type="button"
                                                                style="font-size:10px; font-weight:800; background:#f1f5f9; color:#7e22ce; border:1px solid #e9d5ff; border-radius:6px; width: 120px; text-align: left;">
                                                            <i class="bi bi-file-earmark-check me-1"></i> Documental
                                                        </button>
