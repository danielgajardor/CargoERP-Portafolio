        foreach (var uTerPct in op.Unidadestecnicas)
        {
            var terrU = terrPorUnidad.TryGetValue(uTerPct.Id, out var tUVPct) ? tUVPct : null;
            pctsTer.Add(ContarCamposTer(terrU, uTerPct.NroContenedor, uTerPct.NumeroSello) * 100.0 / 7);
        }
    }
    int pctTer = (int)Math.Round(pctsTer.Average());
    bool completeTer = pctTer >= 100;

    // --- DOCUMENTAL: base 2 (Agencia + DUS/DIN) + Fito (si Aplica SAG) + Sanitario (si Aplica Sernapesca) ---
    int docTotal = 2; int docHechos = 0;
    if (d != null)
    {
        if (d.IdAgenciaAduana.HasValue) docHechos++;
        if (!string.IsNullOrWhiteSpace(d.DusDin) || !string.IsNullOrWhiteSpace(d.Din)) docHechos++;
        if (d.AplicaSag == true) { docTotal++; if (!string.IsNullOrWhiteSpace(d.CertFitosanitario)) docHechos++; }
        if (d.AplicaSernapesca == true) { docTotal++; if (!string.IsNullOrWhiteSpace(d.CertSanitario)) docHechos++; }
    }
    int pctDoc = (int)Math.Round(docHechos * 100.0 / docTotal);
    bool completeDoc = pctDoc >= 100;

    // --- MATRIZ - BL: 3 campos ---
    int matrizHechos = 0;
    bool matrizYaTeniaBl = !string.IsNullOrWhiteSpace(d?.RutaBL);
    bool matrizYaAprobada = d?.EstadoDocumental == "B/L APROBADO";
    if (d?.MatrizPresentada == true) matrizHechos++;
    if (matrizYaTeniaBl) matrizHechos++;
    if (matrizYaAprobada) matrizHechos++;
    int pctMatriz = (int)Math.Round(matrizHechos * 100.0 / 3);
    bool completeMatriz = pctMatriz >= 100;

    // --- GATE OUT/IN: 2 o 3 campos (Pago solo cuenta si no es "Cliente gestiona directo") ---
    bool clienteGestionaDirecto = op.GestionaGate == "Cliente gestiona directo";
    int gateTotal = clienteGestionaDirecto ? 2 : 3;
    int gateHechos = 0;
    if (!string.IsNullOrWhiteSpace(op.TipoGate)) gateHechos++;
    if (!string.IsNullOrWhiteSpace(op.GestionaGate)) gateHechos++;
    if (!clienteGestionaDirecto && !string.IsNullOrWhiteSpace(op.PagoGate)) gateHechos++;
    int pctGate = (int)Math.Round(gateHechos * 100.0 / gateTotal);
    bool completeGate = pctGate >= 100;
}
