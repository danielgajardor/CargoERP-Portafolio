@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/naves-catalogo.js" asp-append-version="true"></script>
    <script>
        (function () {
            // Las listas se arman al terminar de cargar la página: así toman el ajuste de posición
            // del zoom de la vista (escala-vista.js, que carga después) y el desplegable queda
            // justo bajo el campo.
            document.addEventListener('DOMContentLoaded', function () {
                if (window.escalaVistaParchear) window.escalaVistaParchear();
                if (!window.jQuery || !$.fn.select2) return;
                $('.it-select2').select2({ width: '100%', language: { noResults: function () { return 'Sin resultados'; } } });
                // Nave del catálogo: primero las de la naviera elegida, después las demás.
                if (window.NavesCatalogo) NavesCatalogo.enlazar(document.getElementById('itNave'), document.getElementById('itNaviera'));
            });

            const etd = document.getElementById('itEtd');
            const eta = document.getElementById('itEta');
            const transit = document.getElementById('itTransit');
            function calcularTransito() {
                if (!etd || !eta || !transit) return;
                if (!etd.value || !eta.value) { transit.textContent = ''; return; }
                // Días de tránsito entre las fechas (la hora no cambia el conteo de días).
                const fEtd = new Date(etd.value.substring(0, 10)), fEta = new Date(eta.value.substring(0, 10));
                const dias = Math.round((fEta - fEtd) / 86400000);
                const invalido = (new Date(eta.value) - new Date(etd.value)) < 0;
                transit.textContent = invalido ? 'La ETA no puede ser anterior a la ETD' : dias + ' días de tránsito';
                transit.classList.toggle('is-error', invalido);
                eta.setCustomValidity(invalido ? 'La ETA no puede ser anterior a la ETD' : '');
            }
            if (etd) {
                etd.addEventListener('change', function () { if (eta && !eta.value) eta.min = etd.value; calcularTransito(); });
                eta.addEventListener('change', calcularTransito);
                calcularTransito();
            }

            const modalZarpe = document.getElementById('modalZarpe');
            if (modalZarpe) {
                modalZarpe.addEventListener('show.bs.modal', function (ev) {
                    const b = ev.relatedTarget;
                    if (!b) return;
                    document.getElementById('zarpeIdSalida').value = b.dataset.id;
                    document.getElementById('zarpeNave').textContent = b.dataset.nave + ' · ETD ' + (b.dataset.etd || '').replace('T', ' ');
                    document.getElementById('zarpeFecha').value = b.dataset.zarpe || b.dataset.etd || '';
                    // Si ya estaba registrado, cambiarlo no reenvía la confirmación salvo que se marque.
                    document.getElementById('zarpeNotificar').checked = !b.dataset.zarpe;
                    document.querySelector('.it-form-real[data-tipo="zarpe"]').dataset.confirmado = '';
                    cargarDestinatarios('zarpe', b.dataset.id);
                });
            }
            const modalArribo = document.getElementById('modalArribo');
            if (modalArribo) {
                modalArribo.addEventListener('show.bs.modal', function (ev) {
                    const b = ev.relatedTarget;
                    if (!b) return;
                    document.getElementById('arriboIdSalida').value = b.dataset.id;
                    document.getElementById('arriboNave').textContent = b.dataset.nave + ' · ETA ' + (b.dataset.eta || '').replace('T', ' ');
                    document.getElementById('arriboFecha').value = b.dataset.arribo || b.dataset.eta || '';
                    document.getElementById('arriboNotificar').checked = !b.dataset.arribo;
                    document.querySelector('.it-form-real[data-tipo="arribo"]').dataset.confirmado = '';
                    cargarDestinatarios('arribo', b.dataset.id);
                });
            }

            // 13-nov: antes de enviar, a quién le llega la confirmación (bookings marítimos de la nave).
            const esc = t => String(t ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
            async function cargarDestinatarios(tipo, idSalida) {
                const caja = document.getElementById(tipo + 'Dest');
                caja.dataset.n = '0';
                caja.innerHTML = '<span class="cot-muted">Buscando los bookings de la nave…</span>';
                try {
                    const r = await fetch('/Operaciones/Itinerarios?handler=Destinatarios&tipo=' + tipo + '&idSalida=' + encodeURIComponent(idSalida));
                    const d = await r.json();
                    const lista = d.lista || [];
                    caja.dataset.n = String(lista.filter(x => x.correo).length);
                    caja.innerHTML = lista.length
                        ? '<strong>' + lista.length + ' booking(s) marítimo(s) reciben la fecha:</strong><ul>' + lista.map(x => '<li><span>' + esc(x.booking) + ' · ' + esc(x.cliente) + '</span><span class="' + (x.correo ? '' : 'sin-correo') + '">' + esc(x.correo || 'sin correo') + '</span></li>').join('') + '</ul>'
                        : '<span class="cot-muted">Ningún booking marítimo pendiente de esta fecha en la nave: solo se guarda en la salida.</span>';
                } catch (e) { caja.innerHTML = '<span class="text-danger">No se pudo cargar la lista de clientes.</span>'; }
            }
            document.querySelectorAll('.it-form-real').forEach(function (f) {
                f.addEventListener('submit', async function (e) {
                    if (f.dataset.confirmado === '1') return;
                    const tipo = f.dataset.tipo;
                    const notificar = document.getElementById(tipo + 'Notificar');
                    const fecha = document.getElementById(tipo + 'Fecha').value;
                    const n = parseInt(document.getElementById(tipo + 'Dest').dataset.n || '0', 10);
                    if (!notificar.checked || !fecha || !n || !window.Swal) return;
                    e.preventDefault();
                    const q = await Swal.fire({
                        icon: 'question', title: '¿Enviar la confirmación de ' + tipo + '?',
                        text: 'Se enviará un correo a ' + n + ' cliente(s) de la nave.',
                        showCancelButton: true, showDenyButton: true, confirmButtonText: 'Sí, guardar y enviar', denyButtonText: 'Guardar sin enviar', cancelButtonText: 'Cancelar', confirmButtonColor: '#0f172a'
                    });
                    if (q.isDismissed) return;
                    if (q.isDenied) notificar.checked = false;
                    f.dataset.confirmado = '1';
                    f.submit();
                });
            });
            window.itHistorial = async function (id, btn) {
                document.getElementById('modalHistorialTitulo').textContent = 'Historial · ' + (btn.dataset.nave || 'salida');
                const cuerpo = document.getElementById('historialCuerpo');
                cuerpo.innerHTML = '<span class="cot-muted">Cargando…</span>';
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalHistorial')).show();
                try {
                    const r = await fetch('/Operaciones/Itinerarios?handler=Historial&id=' + id);
                    cuerpo.innerHTML = r.ok ? await r.text() : '<span class="text-danger">No se pudo cargar el historial.</span>';
                } catch (e) { cuerpo.innerHTML = '<span class="text-danger">No se pudo cargar el historial.</span>'; }
            };

            const form = document.getElementById('formSalida');
            if (form) {
                form.addEventListener('submit', function (e) {
                    const pol = document.getElementById('itPol').value;
                    const pod = document.getElementById('itPod').value;
                    if (pol && pol === pod) {
                        e.preventDefault();
                        alert('El puerto de origen y el de destino no pueden ser el mismo.');
                    }
                });
            }
        })();
    </script>
}
