                                <div class="step-item @(blEnviado ? "completed" : "")" style="width:25%;"><div class="step-circle"><i class="bi bi-check-lg" style="font-size:14px;"></i></div><div class="step-title">Envío Cliente</div></div>
                                <div class="step-item @(blCambios ? "rejected" : "")" style="width:25%;"><div class="step-circle"><i class="bi @(blCambios ? "bi-exclamation-lg" : "bi-check-lg")" style="font-size:14px;"></i></div><div class="step-title">Cambios</div></div>
                                <div class="step-item @(blAprobado ? "completed" : "")" style="width:25%;"><div class="step-circle"><i class="bi bi-check-lg" style="font-size:14px;"></i></div><div class="step-title">OK Final</div></div>
                            </div>
                        </div>
                        <div class="col-12 text-end mt-3 pt-2">
                            <button type="button" class="btn btn-dark btn-sm fw-bold w-100 py-2" onclick="guardarMatrizBlDet(this, @op.Id)">Guardar Matriz y B/L</button>
