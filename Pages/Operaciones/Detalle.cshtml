                                <select name="IdPuertoOrigen" class="form-select inline-field select2-enable" disabled>
                                    <option value="">-- Seleccionar --</option>
                                    @if (ViewData["PuertosList"] != null)
                                    {
                                        foreach (var pto in ((IEnumerable<AtilsonCargoSpa.Models.Puerto>)ViewData["PuertosList"]).GroupBy(p => p.NombrePuerto).Select(g => g.First()))
                                        {
                                            <option value="@pto.Id" selected="@(op.IdPuertoOrigen == pto.Id ? "selected" : null)">@pto.NombrePuerto</option>
                                        }
                                    }
                                </select>
                                <div class="op-route-edit-sub">
                                    <div>
                                        <label class="mod-label">Terminal</label>
                                        <input type="text" class="form-control inline-field text-uppercase" value="@(t?.TerminalTerrestreStr ?? "-")" readonly />
                                    </div>
                                    <div>
                                        <label class="mod-label">ETD (Zarpe)</label>
                                        <input type="date" name="EtdPol" class="form-control inline-field" value="@(op.EtdPol?.ToString("yyyy-MM-dd"))" readonly />
                                    </div>
                                </div>
                                <div class="op-route-edit-sub op-route-edit-sub--full op-route-edit-sub--real">
                                    <div>
                                        <label class="mod-label"><i class="bi bi-check-circle-fill me-1"></i> ETD Real (Zarpe)</label>
                                        <input type="date" name="EtdReal" class="form-control inline-field" value="@(op.EtdReal?.ToString("yyyy-MM-dd"))" readonly />
                                    </div>
                                </div>
                            </div>

                            <div class="op-route-edit-connector"><span class="op-route-edit-marker"><i class="bi bi-water"></i></span></div>

                            <div class="op-route-edit-stop">
                                <div class="op-route-edit-eyebrow"><i class="bi bi-box-arrow-in-down-left"></i> Destino (POD)</div>
                                <label class="mod-label">Puerto</label>
                                <select name="IdPuertoDestino" class="form-select inline-field select2-enable" disabled>
                                    <option value="">-- Seleccionar --</option>
                                    @if (ViewData["PuertosList"] != null)
                                    {
                                        foreach (var pto in ((IEnumerable<AtilsonCargoSpa.Models.Puerto>)ViewData["PuertosList"]).GroupBy(p => p.NombrePuerto).Select(g => g.First()))
                                        {
                                            <option value="@pto.Id" selected="@(op.IdPuertoDestino == pto.Id ? "selected" : null)">@pto.NombrePuerto</option>
                                        }
                                    }
                                </select>
                                <div class="op-route-edit-sub op-route-edit-sub--full">
                                    <div>
                                        <label class="mod-label">ETA (Arribo)</label>
                                        <input type="date" name="EtaPod" class="form-control inline-field" value="@(op.EtaPod?.ToString("yyyy-MM-dd"))" readonly />
                                    </div>
                                </div>
                                <div class="op-route-edit-sub op-route-edit-sub--full op-route-edit-sub--real">
                                    <div>
                                        <label class="mod-label"><i class="bi bi-check-circle-fill me-1"></i> ETA Real (Arribo)</label>
                                        <input type="date" name="EtaReal" class="form-control inline-field" value="@(op.EtaReal?.ToString("yyyy-MM-dd"))" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="op-window-strip mb-3">
                            <div class="op-window-item">
                                <label class="op-window-eyebrow"><i class="bi bi-door-open"></i> Stacking IN (Apertura)</label>
                                <input type="datetime-local" name="FechaStacking" class="form-control inline-field" value="@(op.FechaStacking?.ToString("yyyy-MM-ddTHH:mm"))" readonly />
                            </div>
                            <div class="op-window-item op-window-item--danger">
                                <label class="op-window-eyebrow"><i class="bi bi-door-closed"></i> Stacking OUT (Cierre)</label>
                                <input type="datetime-local" name="CutOffMatriz" class="form-control inline-field fw-bold" value="@(op.CutOffMatriz?.ToString("yyyy-MM-ddTHH:mm"))" readonly />
                            </div>
                            <div class="op-window-item op-window-item--warning">
                                <label class="op-window-eyebrow"><i class="bi bi-clock-history"></i> Late Arrival Inicio</label>
                                <input type="datetime-local" name="LateArrival" class="form-control inline-field" value="@(op.LateArrival?.ToString("yyyy-MM-ddTHH:mm"))" readonly />
                            </div>
                            <div class="op-window-item op-window-item--warning">
                                <label class="op-window-eyebrow"><i class="bi bi-clock-fill"></i> Late Arrival Término</label>
                                <input type="datetime-local" name="ElarDate" class="form-control inline-field" value="@(op.ElarDate?.ToString("yyyy-MM-ddTHH:mm"))" readonly />
                            </div>
                        </div>
                        </div>

                        

                        <div class="form-subcard mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="mod-label m-0"><i class="bi bi-exclamation-diamond me-1"></i> Roleo / Cancelación / No Show</span>
                                <button type="button" class="btn btn-sm btn-outline-dark fw-bold py-1 px-3" style="font-size:10px;" onclick="registrarRoleoCancelacionDetalle(@op.Id, '@op.TipoTarifaMaritima', '@(op.IdNavieraNavigation?.NombreNaviera)', @(op.IdNavieraNavigation?.DiasPenalidadRoleo ?? 7), '@(op.IdNavieraNavigation?.PenalidadRoleoSiempreAplica == true ? "true" : "false")', @(1 + (op.Unidadestecnicas?.Count ?? 0)), '@(op.EtdPol?.ToString("yyyy-MM-ddTHH:mm"))', '@(op.IdNavieraNavigation?.MontoPenalidadRoleoUsd?.ToString(System.Globalization.CultureInfo.InvariantCulture))')">
                                    <i class="bi bi-plus-circle me-1"></i> Registrar Nuevo
                                </button>
                            </div>
                            @{ var historialRoleos = op.RoleosCancelaciones?.OrderByDescending(r => r.FechaCreacion).ToList() ?? new List<AtilsonCargoSpa.Models.RoleoCancelacion>(); }
                            @if (!historialRoleos.Any())
                            {
                                <div class="text-muted" style="font-size:10px; font-style:italic;">Sin registros de roleo o cancelación para este booking.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var r in historialRoleos)
                                    {
                                        string nombreRoleoTipo = r.Tipo == "ROLEO" ? "Roleo" : "Cancelación / No Show";
                                        string colorPen = r.PenalidadConfirmada == "SI" ? "#dc2626" : (r.PenalidadConfirmada == "NO" ? "#16a34a" : "#d97706");
                                        string txtPen = r.PenalidadConfirmada switch { "SI" => "CON PENALIDAD", "NO" => "SIN PENALIDAD", _ => "PENALIDAD POR DETERMINAR" };
                                        <div class="p-2 rounded border bg-white">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <span class="fw-bold" style="font-size:11px;">@nombreRoleoTipo</span>
                                                    <span class="ms-2" style="font-size:10px; font-weight:800; color:@colorPen;">@txtPen</span>
                                                    @if (r.DiasAnticipacion.HasValue)
                                                    {
                                                        <span class="text-muted ms-1" style="font-size:9px;">(@r.DiasAnticipacion días de anticipación · @(r.NavieraTipoTarifa ?? "Sin tarifa"))</span>
                                                    }
                                                    <div class="text-muted" style="font-size:9px;">@r.CantidadContenedoresAfectados contenedor(es)@(r.MontoPenalidadUnitarioUsd.HasValue && r.PenalidadConfirmada == "SI" ? $" · USD {(r.MontoPenalidadUnitarioUsd.Value * r.CantidadContenedoresAfectados):N0}" : "")</div>
                                                    @if (!string.IsNullOrWhiteSpace(r.Comentario))
                                                    {
                                                        <div class="text-muted mt-1" style="font-size:10px; font-style:italic;">"@r.Comentario"</div>
                                                    }
                                                    @if (r.DatosNuevosPendientes)
                                                    {
                                                        <div class="text-warning mt-1" style="font-size:9px; font-weight:800;"><i class="bi bi-hourglass-split me-1"></i>ITINERARIO NUEVO PENDIENTE</div>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(r.NuevaNave))
                                                    {
                                                        <div class="text-muted mt-1" style="font-size:9px;">Nueva nave: <strong>@r.NuevaNave</strong> · ETD: @r.NuevoEtd?.ToString("dd/MM HH:mm")</div>
                                                    }
                                                    <div class="text-muted mt-1" style="font-size:9px;">@r.Usuario — @r.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</div>
                                                </div>
                                                <div class="d-flex flex-column gap-1">
                                                    @if (r.PenalidadConfirmada == "POR_DETERMINAR")
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-warning fw-bold py-1 px-2" style="font-size:9px;" onclick="actualizarPenalidadRoleoDetalle(@r.Id, '@(r.MontoPenalidadUnitarioUsd?.ToString(System.Globalization.CultureInfo.InvariantCulture))')">Confirmar Penalidad</button>
                                                    }
                                                    @if (r.DatosNuevosPendientes)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold py-1 px-2" style="font-size:9px;" onclick="confirmarItinerarioRoleoDetalle(@r.Id)">Confirmar Itinerario</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="resp-widget">
                            <span class="resp-widget-icon"><i class="bi bi-cash-coin"></i></span>
                            <div class="resp-widget-field">
                                <label>Pagado por</label>
                                <select class="resp-pagado" data-concepto="@estRespMar.ConceptoReal" onchange="guardarResponsabilidadDetalle(@op.Id, this.getAttribute('data-concepto'), this, this.closest('.resp-widget').querySelector('.resp-responsable'))">
                                    <option value="ATILSON" selected="@(estRespMar.PagadoPor == "ATILSON" || estRespMar.PagadoPor == null ? "selected" : null)">Atilson</option>
                                    <option value="AGENCIA" selected="@(estRespMar.PagadoPor == "AGENCIA" ? "selected" : null)">Agencia</option>
                                    <option value="PROVEEDOR" selected="@(estRespMar.PagadoPor == "PROVEEDOR" ? "selected" : null)">Proveedor</option>
                                </select>
                            </div>
                            <i class="bi bi-arrow-right resp-widget-arrow"></i>
                            <div class="resp-widget-field">
                                <label>Responsable</label>
                                <select class="resp-responsable" data-concepto="@estRespMar.ConceptoReal" onchange="guardarResponsabilidadDetalle(@op.Id, this.getAttribute('data-concepto'), this.closest('.resp-widget').querySelector('.resp-pagado'), this)">
                                    <option value="CLIENTE" selected="@(estRespMar.Responsable == "CLIENTE" || estRespMar.Responsable == null ? "selected" : null)">Cliente</option>
                                    <option value="ATILSON" selected="@(estRespMar.Responsable == "ATILSON" ? "selected" : null)">Atilson</option>
                                    <option value="PROVEEDOR" selected="@(estRespMar.Responsable == "PROVEEDOR" ? "selected" : null)">Proveedor</option>
                                    <option value="AGENCIA" selected="@(estRespMar.Responsable == "AGENCIA" ? "selected" : null)">Agencia</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(op.Transbordo))
                {
                    var trans = op.GestionTransbordo;
                    var fechaLimiteTrans = AtilsonCargoSpa.Helpers.TransbordoHelpers.FechaLimite(trans);
                    string estadoTrans = AtilsonCargoSpa.Helpers.TransbordoHelpers.EstadoTransbordo(trans);
                    bool resueltoTrans = estadoTrans == "RESUELTO";
                    var estiloTrans = estadoTrans switch
                    {
                        "RESUELTO" => ("#f0fdf4", "#16a34a", "#bbf7d0", "NUEVA NAVE CONFIRMADA"),
                        "VENCIDO" => ("#fef2f2", "#dc2626", "#fecaca", "PLAZO VENCIDO — GESTIONAR AHORA"),
                        "CRITICO" => ("#fff7ed", "#ea580c", "#fed7aa", "PLAZO POR VENCER"),
                        "PENDIENTE" => ("#f0f9ff", "#0284c7", "#bae6fd", "EN TRÁNSITO — GESTIÓN PENDIENTE"),
                        _ => ("#f8fafc", "#64748b", "#e2e8f0", "SIN DATOS DE ARRIBO")
                    };

                    <div class="form-section mt-3 @(estadoTrans == "VENCIDO" ? "row-alert" : "")" style="@(estadoTrans == "VENCIDO" ? "border-color:#fecaca;" : "")">
                        <div class="section-title-sm">
                            <span><i class="bi bi-arrow-left-right me-1"></i> Gestión de Transbordo</span>
                            <span class="fw-bold text-uppercase px-3 py-1 rounded" style="font-size:9px; letter-spacing:.5px; background:@estiloTrans.Item1; color:@estiloTrans.Item2; border:1px solid @estiloTrans.Item3;">@estiloTrans.Item4</span>
                        </div>

                        @if (trans?.FechaArriboTransbordo.HasValue == true && !resueltoTrans)
                        {
                            <div class="alert d-flex align-items-center gap-2 py-2 px-3 mb-3" style="font-size:11px; font-weight:700; border-radius:8px; background:@estiloTrans.Item1; color:@estiloTrans.Item2; border:1px solid @estiloTrans.Item3;">
                                <i class="bi @(estadoTrans == "VENCIDO" ? "bi-exclamation-octagon-fill" : "bi-clock-history")"></i>
                                <div>
                                    @if (fechaLimiteTrans.HasValue)
                                    {
                                        <strong>Fecha límite de gestión: @fechaLimiteTrans.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                                        <span> — @(estadoTrans == "VENCIDO" ? "Ya se superó el plazo otorgado en puerto." : $"Quedan {Math.Max(0, (int)Math.Ceiling((fechaLimiteTrans.Value - DateTime.Now).TotalDays))} día(s) para confirmar la nueva nave.")</span>
                                    }
                                    else
                                    {
                                        <strong>Falta ingresar los días libres para calcular el plazo.</strong>
                                    }
                                </div>
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <form method="post" asp-page-handler="GuardarTransbordo">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="IdOperacion" value="@op.Id" />
                                    <div class="form-subcard h-100">
                                        <div class="form-subcard-title"><i class="bi bi-geo-alt"></i> Arribo y Plazo en Puerto</div>
                                        <div class="mb-2">
                                            <span class="mod-label m-0">Puerto de Transbordo</span>
                                            <div class="fw-bold text-uppercase" style="font-size:13px;">@(op.Transbordo ?? "-")</div>
                                            <span class="text-muted" style="font-size:9px;"><i class="bi bi-pencil me-1"></i>Editable en Servicio Marítimo → Editar → Modalidad de Tránsito.</span>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="mod-label">Fecha Arribo a Puerto</label>
                                                <input type="datetime-local" name="FechaArriboTransbordo" class="form-control erp-input" value="@(trans?.FechaArriboTransbordo?.ToString("yyyy-MM-ddTHH:mm"))" />
                                            </div>
                                                                        <div class="col-6">
                                <label class="mod-label">Días Libres (estimados por puerto/naviera)</label>
                                <input type="number" name="DiasLibres" class="form-control erp-input fw-bold" value="@trans?.DiasLibres" min="0" placeholder="Ej: 7" />
                                @if (AtilsonCargoSpa.Helpers.TransbordoHelpers.EstaResuelto(trans))
                                {
                                    <span class="text-muted" style="font-size:9px;">Real (con nave confirmada): <strong>@AtilsonCargoSpa.Helpers.TransbordoHelpers.DiasLibresCalculados(trans) días</strong></span>
                                }
                            </div>
                                        </div>
                                        <div class="text-end mt-3">
                                            <button type="button" class="btn btn-dark btn-sm fw-bold px-3" onclick="guardarFormularioDetalle(this.closest('form'), this)"><i class="bi bi-save me-1"></i> Guardar Plazo</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <form method="post" asp-page-handler="ConfirmarNuevaNaveTransbordo">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="IdOperacion" value="@op.Id" />
                                    <input type="hidden" name="SincronizarEtaOperacion" value="true" />
                                    <div class="form-subcard h-100" style="background:@(resueltoTrans ? "#f0fdf4" : "var(--bg-soft)"); border-color:@(resueltoTrans ? "#bbf7d0" : "var(--border-soft)");">
                                        <div class="form-subcard-title"><i class="bi bi-water"></i> Nueva Nave Confirmada</div>
                                        <div class="row g-2">
                                            <div class="col-12">
                                                <label class="mod-label">Nave / Viaje</label>
                                                <input type="text" name="NuevaNaveConfirmada" class="form-control erp-input text-uppercase fw-bold" value="@trans?.NuevaNaveConfirmada" placeholder="Pendiente de confirmar..." />
                                            </div>
                                            <div class="col-6">
                                                <label class="mod-label text-success">Nuevo ETD (desde Transbordo)</label>
                                                <input type="datetime-local" name="NuevoEtdTransbordo" class="form-control erp-input" value="@(trans?.NuevoEtdTransbordo?.ToString("yyyy-MM-ddTHH:mm"))" />
                                            </div>
                                            <div class="col-6">
                                                <label class="mod-label text-success">Nuevo ETA Destino Final</label>
                                                <input type="datetime-local" name="NuevoEtaDestinoFinal" class="form-control erp-input" value="@(trans?.NuevoEtaDestinoFinal?.ToString("yyyy-MM-ddTHH:mm"))" />
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <span class="text-muted" style="font-size:9px;"><i class="bi bi-info-circle me-1"></i>Actualiza el ETA del booking.</span>
                                            <button type="button" class="btn btn-dark btn-sm fw-bold px-3" onclick="guardarFormularioDetalle(this.closest('form'), this)"><i class="bi bi-check2-circle me-1"></i> Confirmar Nave</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                @{ int nCorrBlHead = AtilsonCargoSpa.Helpers.CorreccionBlHelper.Listar(op).Count; }
                <div class="form-section mt-3">
                        <div class="op-toggle-wrap">
                            <button type="button" class="op-toggle" data-bs-toggle="collapse" data-bs-target="#matriz-bl-collapse-@op.Id" aria-expanded="false" aria-controls="matriz-bl-collapse-@op.Id">
                                <span class="op-toggle__icon"><i class="bi bi-file-earmark-text"></i></span>
                                <span class="op-toggle__label">
                                    <strong>Gestión de Matriz y B/L</strong>
                                    <span class="op-toggle__estado @(matrizBlCompleto ? "op-toggle__estado--ok" : "op-toggle__estado--pend")">@(matrizBlCompleto ? $"Completo — B/L {d?.NumeroBL} · {resumenEmisionDet}" : (emisionCompletaDet ? "Pendiente: confirmar matriz y cargar N° de B/L" : "Pendiente: tipo de emisión, matriz y N° de B/L"))@(nCorrBlHead > 0 ? $" · {nCorrBlHead} {(nCorrBlHead == 1 ? "corrección" : "correcciones")} de BL" : "")</span>
                                </span>
                                <i class="bi bi-chevron-down op-toggle__chevron"></i>
                            </button>
                            <div class="collapse" id="matriz-bl-collapse-@op.Id">
                            <div class="op-toggle-body">
                                <form method="post" asp-page-handler="UpdateMatriz" id="form-matriz-bl">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="IdOperacion" value="@op.Id" />
                        @{
                            var vmEmisionMatriz = new AtilsonCargoSpa.Models.EmisionBlCamposVm
                            {
                                IdPrefijo = $"embl-matriz-{op.Id}",
                                Tipo = tipoEmisionDet,
                                Otro = op.TipoEmisionBlOtro,
                                Lugar = op.UbicacionOriginalesDestino,
                                TipoObligatorio = true
                            };
                        }
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-subcard h-100">
                                    <div class="form-subcard-title"><i class="bi bi-file-earmark-text"></i> Gestión de Matriz</div>
                                    <label class="status-toggle-row">
                                        <input class="cuadradito-check" type="checkbox" name="MatrizPresentada" value="true" @(matrizOk ? "checked" : "") />
                                        <span>Matriz Confirmada</span>
                                    </label>
                                    <div class="mt-3 pt-3" style="border-top:1px dashed var(--border-soft);">
                                        <input type="hidden" name="TipoEmisionBlMarker" value="1" />
                                        <partial name="_EmisionBlCampos" model="vmEmisionMatriz" />
                                    </div>
                                    <div class="mt-3">
                                        <label class="mod-label">Evidencia Envío (A Naviera)</label>
                                        <input type="file" name="EvidenciaEnvioNaviera" class="erp-input py-1 m-0" accept=".pdf, .jpg, .png" id="file-envio-naviera-det" onchange="onEvidenciaNavieraChangeDet(this)" />
                                        <div id="btn-envio-naviera-wrapper-det" class="d-none mt-2">
                                            <button type="button" class="btn btn-sm fw-bold w-100 py-2" style="background:#0f172a; color:#fff; border:none; border-radius:8px; font-size:11px;" onclick="abrirModalEnvioNavieraDet()">
                                                <i class="bi bi-envelope-arrow-up me-2"></i> Enviar Evidencia a Naviera
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-subcard h-100">
                                    <div class="form-subcard-title"><i class="bi bi-file-earmark-pdf"></i> Gestión de B/L</div>
                                    <label class="mod-label">N° de B/L</label>
                                    <input type="text" name="NumeroBL" class="form-control erp-input py-1 fw-bold" placeholder="Ej: MSCU1234567" id="input-bl-det" value="@(op.OperacionesDocumentales.FirstOrDefault()?.NumeroBL)" />
                                    <div class="mt-2">
                                        <label class="mod-label" style="margin-bottom:4px;">Adjuntar archivo (opcional)</label>
                                        <input type="file" name="ArchivoBL" accept=".pdf,.jpg,.png" class="form-control erp-input py-1" id="file-bl-det" onchange="registrarArchivoBlMatrizDet(this)" />
