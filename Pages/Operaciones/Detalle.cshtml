@page "{id:int}"
@model AtilsonCargoSpa.Pages.Operaciones.DetalleModel
@{
    ViewData["Title"] = $"Operación {Model.Op.NumeroBooking}";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<link rel="stylesheet" href="~/css/operaciones-detalle.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/detalle-premium.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/emision-bl.css" asp-append-version="true" />

<div class="container-fluid py-4 dt-premium" style="max-width: 1500px;" data-op-id="@Model.Op.Id">

    <!-- Datos ocultos requeridos por abrirGeneradorCorreos() (función genérica reusada del modal) -->
    <div class="atilson-banner d-none">
        <span class="banner-label">Cliente</span>
        <span class="fw-bold">N° BOOKING: @Model.Op.NumeroBooking</span>
    </div>
    <input type="hidden" name="CorreosCliente" value="@(Model.Op.IdClienteNavigation?.Correo ?? "")" />

    <!-- Puente de datos para wwwroot/js/operaciones-detalle.js (refactor oct-2026: separar JS de la vista).
         El JS externo no puede interpolar @Model directamente, así que estos valores se exponen acá
         como data-attributes y se leen con la función detalleOpData() al inicio del archivo .js. -->
    <div id="detalle-op-data" class="d-none"
         data-id="@Model.Op.Id"
         data-booking="@Model.Op.NumeroBooking"
         data-correo-cliente="@(Model.Op.IdClienteNavigation?.Correo ?? "")"
         data-numero-contenedor="@(Model.Op.NumeroContenedor ?? "")"
         data-numero-sello="@(Model.Op.NumeroSello ?? "")"
         data-aplica-sernapesca="@(Model.Op.OperacionesDocumentales.FirstOrDefault(x => x.IdUnidadTecnica == null)?.AplicaSernapesca == true ? "true" : "false")"
         data-puerto-origen="@(Model.Op.IdPuertoOrigenNavigation?.NombrePuerto ?? "")"
         data-nave="@(Model.Op.Nave ?? "")"
         data-naviera="@(Model.Op.IdNavieraNavigation?.NombreNaviera ?? "")"
         data-tipo-contenedor="@(Model.Op.TipoContenedor ?? "")"
         data-cliente-razon-social="@(Model.Op.IdClienteNavigation?.RazonSocial ?? "")"
    ></div>

    @{
        var opHead = Model.Op;
        var tHead = opHead.OperacionesTerrestres.FirstOrDefault(x => x.IdUnidadTecnica == null);
        var dHead = opHead.OperacionesDocumentales.FirstOrDefault(x => x.IdUnidadTecnica == null);

        var marItemsHead = new List<bool> {
            opHead.IdNaviera > 0, !string.IsNullOrEmpty(opHead.Nave), opHead.IdPuertoOrigen.HasValue, opHead.IdPuertoDestino.HasValue,
            opHead.EtdPol.HasValue, opHead.EtaPod.HasValue, opHead.FechaStacking.HasValue, opHead.CutOffMatriz.HasValue
        };
        int pctMarHead = (int)Math.Round(marItemsHead.Count(x => x) * 100.0 / marItemsHead.Count);
        bool completeMarHead = pctMarHead >= 100;

        int ContarCamposTerHead(AtilsonCargoSpa.Models.OperacionesTerrestre? terrRow, string? numContenedor, string? numSello)
        {
            int c = 0;
            if (terrRow != null)
            {
                if (!string.IsNullOrWhiteSpace(terrRow.EmpresaTransporte)) c++;
                if (!string.IsNullOrWhiteSpace(terrRow.NombreConductor)) c++;
                if (!string.IsNullOrWhiteSpace(terrRow.Patente)) c++;
                if (!string.IsNullOrWhiteSpace(terrRow.DepositoRetiro)) c++;
                if (terrRow.FechaCarga.HasValue) c++;
            }
            if (!string.IsNullOrWhiteSpace(numContenedor)) c++;
            if (!string.IsNullOrWhiteSpace(numSello)) c++;
            return c;
        }
        var pctsTerHead = new List<double> { ContarCamposTerHead(tHead, opHead.NumeroContenedor, opHead.NumeroSello) * 100.0 / 7 };
        if (opHead.Unidadestecnicas != null)
        {
            foreach (var uT in opHead.Unidadestecnicas)
            {
                var terrU = opHead.OperacionesTerrestres.FirstOrDefault(x => x.IdUnidadTecnica == uT.Id);
                pctsTerHead.Add(ContarCamposTerHead(terrU, uT.NroContenedor, uT.NumeroSello) * 100.0 / 7);
            }
        }
        int pctTerHead = (int)Math.Round(pctsTerHead.Average());
        bool completeTerHead = pctTerHead >= 100;

        int docTotalHead = 2; int docHechosHead = 0;
        if (dHead != null)
        {
            if (dHead.IdAgenciaAduana.HasValue) docHechosHead++;
            if (!string.IsNullOrWhiteSpace(dHead.DusDin) || !string.IsNullOrWhiteSpace(dHead.Din)) docHechosHead++;
            if (dHead.AplicaSag == true) { docTotalHead++; if (!string.IsNullOrWhiteSpace(dHead.CertFitosanitario)) docHechosHead++; }
            if (dHead.AplicaSernapesca == true) { docTotalHead++; if (!string.IsNullOrWhiteSpace(dHead.CertSanitario)) docHechosHead++; }
        }
        int pctDocHead = (int)Math.Round(docHechosHead * 100.0 / docTotalHead);
        bool completeDocHead = pctDocHead >= 100;

        bool clienteGestionaDirectoHead = opHead.GestionaGate == "Cliente gestiona directo";
        int gateTotalHead = clienteGestionaDirectoHead ? 2 : 3;
        int gateHechosHead = 0;
        if (!string.IsNullOrWhiteSpace(opHead.TipoGate)) gateHechosHead++;
        if (!string.IsNullOrWhiteSpace(opHead.GestionaGate)) gateHechosHead++;
        if (!clienteGestionaDirectoHead && !string.IsNullOrWhiteSpace(opHead.PagoGate)) gateHechosHead++;
        int pctGateHead = (int)Math.Round(gateHechosHead * 100.0 / gateTotalHead);
        bool completeGateHead = gateHechosHead == gateTotalHead;

        var almacenHead = opHead.OperacionesAlmacenamientos?.FirstOrDefault();
        bool completeAlmacenHead = almacenHead != null && almacenHead.FechaIngreso.HasValue && almacenHead.FechaSalida.HasValue;
        int pctAlmacenHead = almacenHead == null ? 0 : (completeAlmacenHead ? 100 : (almacenHead.FechaIngreso.HasValue || almacenHead.IdProveedor.HasValue ? 50 : 0));

        ViewData["DtPctMar"] = pctMarHead;
        ViewData["DtPctTer"] = pctTerHead;
        ViewData["DtPctDoc"] = pctDocHead;
        ViewData["DtPctGate"] = pctGateHead;
    }

    <partial name="_DetalleHero" model="Model" />

    <ul class="nav modern-tabs" id="detalleTabs" role="tablist">
        @if (Model.ReqMaritimo)
        {
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#det-maritimo" type="button"><span class="tab-progress-ring" id="ring-mar-@opHead.Id" style="--pct:@pctMarHead;" data-complete="@(completeMarHead ? "true" : "false")"></span><i class="bi bi-water me-1"></i> Marítimo</button></li>
        }
        @if (Model.ReqTerrestre)
        {
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-transporte" type="button"><span class="tab-progress-ring" id="ring-ter-@opHead.Id" style="--pct:@pctTerHead;" data-complete="@(completeTerHead ? "true" : "false")"></span><i class="bi bi-truck me-1"></i> Transporte</button></li>
        }
        @if (Model.ReqDocumental)
        {
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-documental" type="button"><span class="tab-progress-ring" id="ring-doc-@opHead.Id" style="--pct:@pctDocHead;" data-complete="@(completeDocHead ? "true" : "false")"></span><i class="bi bi-file-earmark-check me-1"></i> Documental</button></li>
        }
        <li class="nav-item"><button class="nav-link @(!Model.ReqMaritimo ? "active" : "")" data-bs-toggle="tab" data-bs-target="#det-gate" type="button"><span class="tab-progress-ring" id="ring-gate-@opHead.Id" style="--pct:@pctGateHead;" data-complete="@(completeGateHead ? "true" : "false")"></span><i class="bi bi-box-arrow-right me-1"></i> Gate Out / In</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-almacenamiento" type="button"><span class="tab-progress-ring" id="ring-almacen-@opHead.Id" style="--pct:@pctAlmacenHead;" data-complete="@(completeAlmacenHead ? "true" : "false")"></span><i class="bi bi-boxes me-1"></i> Almacenamiento</button></li>
        
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-lar" type="button"><i class="bi bi-clock-history me-1"></i> Gest. LAR</button></li>    
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-courier" type="button"><i class="bi bi-box-seam me-1"></i> Courier</button></li>
        <li class="nav-item"><button class="nav-link fw-bold text-danger" data-bs-toggle="tab" data-bs-target="#det-extracostos" type="button"><i class="bi bi-wallet2 me-1"></i> Extracostos</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-historial" type="button"><i class="bi bi-clock-history me-1"></i> Historial</button></li>
    </ul>

    <div class="tab-content">
                @if (Model.ReqMaritimo)
        {
            var op = Model.Op;
            var t = op.OperacionesTerrestres.FirstOrDefault(x => x.IdUnidadTecnica == null);
            var estRespMar = Model.ObtenerEstadoConcepto(op, "Flete Marítimo");
            var tiposBlSeleccionados = (op.TipoEmisionBl ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
            bool matrizOk = op.OperacionesDocumentales.FirstOrDefault()?.MatrizPresentada == true;
            var d = op.OperacionesDocumentales.FirstOrDefault();
            string estDoc = d?.EstadoDocumental ?? "";
            bool solNaviera = d?.MatrizPresentada == true;
            bool blAprobado = estDoc == "B/L APROBADO" || d?.MatrizPresentada == true;
            bool blCambios = estDoc == "CAMBIOS B/L" || estDoc == "RECHAZADO";
            bool blEnviado = estDoc == "BORRADOR ENVIADO" || blCambios || blAprobado;

            // "Gestión de Matriz y B/L" arranca siempre colapsada (igual que el resto de
            // los paneles desplegables de Detalle); el estado "Completo/Pendiente" se ve
            // en la cabecera del toggle sin necesidad de desplegarla.
            bool matrizBlCompleto = matrizOk && !string.IsNullOrWhiteSpace(d?.NumeroBL);

            // Emisión del B/L (oct-2026): obligatoria en Gestión de Matriz; con
            // Originales también se exige el Lugar de emisión.
            string? tipoEmisionDet = AtilsonCargoSpa.Helpers.EmisionBlHelper.TipoActual(op.TipoEmisionBl);
            bool esOriginalesDet = tipoEmisionDet == AtilsonCargoSpa.Helpers.EmisionBlHelper.Originales;
            bool emisionCompletaDet = tipoEmisionDet != null && (!esOriginalesDet || !string.IsNullOrWhiteSpace(op.UbicacionOriginalesDestino));
            matrizBlCompleto = matrizBlCompleto && emisionCompletaDet;
            string resumenEmisionDet = AtilsonCargoSpa.Helpers.EmisionBlHelper.Resumen(op);

            <div class="tab-pane fade show active" id="det-maritimo" role="tabpanel">
                <form method="post" asp-page-handler="QuickEditMaritimo" id="form-maritimo">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdOperacion" value="@op.Id" />

                    <div class="form-section" id="mar-form-@op.Id" data-tarifa-pendiente="@(estRespMar.PendienteTarifa ? "true" : "false")"
                         data-resumen-panel="mar-resumen-@op.Id" data-core-panel="mar-form-core-@op.Id" data-resumen-completo="@(completeMarHead ? "true" : "false")">
                        <div class="section-title-sm">
                            <span>
                                <i class="bi bi-water me-1"></i> Servicio Marítimo
                                @if (estRespMar.PendienteTarifa)
                                {
                                    <i class="bi bi-exclamation-octagon dt-tarifa-ico" data-tarifa-detalle="Flete Marítimo" title="Pendiente de asignación de tarifa. Falta que Comercial agregue el valor de Flete Marítimo en Acuerdos Operativos. Puedes seguir editando esta pestaña mientras tanto."></i>
                                }
                            </span>
                            <div class="section-title-actions">
                                <a class="btn-edit-inline" onclick="toggleEditMode('mar-form-@op.Id', this)"><i class="bi bi-pencil me-1"></i> Editar</a>
                                <button type="button" class="btn-cancel-inline edit-only-inline" onclick="cancelEditMode('mar-form-@op.Id')">Cancelar</button>
                                <button type="button" class="btn-save-inline edit-only-inline" onclick="guardarFormularioDetalle(this.closest('form'), this)"><i class="bi bi-save me-1"></i> Guardar</button>
                            </div>
                        </div>

                        @{
                            string navieraNombreMar = op.IdNavieraNavigation?.NombreNaviera ?? "";
                            string? navieraColorMar = op.IdNavieraNavigation?.ColorRepresentativo;
                            string navieraInicialesMar = "";
                            if (!string.IsNullOrWhiteSpace(navieraNombreMar))
                            {
                                var palabrasNavieraMar = navieraNombreMar.Split(new[] { ' ', '-' }, StringSplitOptions.RemoveEmptyEntries);
                                navieraInicialesMar = palabrasNavieraMar.Length >= 2
                                    ? string.Concat(palabrasNavieraMar.Take(2).Select(p => char.ToUpperInvariant(p[0])))
                                    : navieraNombreMar.Substring(0, Math.Min(2, navieraNombreMar.Length)).ToUpperInvariant();
                            }
                        }
                        <div class="op-resumen @(completeMarHead ? "" : "d-none")" id="mar-resumen-@op.Id">
                            <div class="op-hero">
                                <div class="op-hero-main">
                                    <span class="op-hero-icon @(string.IsNullOrEmpty(navieraInicialesMar) ? "" : "op-hero-icon--mono")"
                                          style="@(string.IsNullOrWhiteSpace(navieraColorMar) ? "" : $"background:{navieraColorMar}1a; color:{navieraColorMar};")">
                                        @if (!string.IsNullOrEmpty(navieraInicialesMar))
                                        {
                                            @navieraInicialesMar
                                        }
                                        else
                                        {
                                            <i class="bi bi-anchor"></i>
                                        }
                                    </span>
                                    <div>
                                        <div class="op-hero-eyebrow">@(op.IdNavieraNavigation?.NombreNaviera ?? "Naviera por confirmar")</div>
                                        <div class="op-hero-title">@(string.IsNullOrWhiteSpace(op.Nave) ? "Nave por confirmar" : op.Nave)</div>
                                    </div>
                                </div>
                                <div class="op-chips">
                                    @if (!string.IsNullOrWhiteSpace(op.TipoTarifaMaritima))
                                    {
                                        <span class="op-chip">@(op.TipoTarifaMaritima == "SPOT" ? "Spot" : "Contrato")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(op.PropietarioContrato))
                                    {
                                        <span class="op-chip" title="Propietario de Contrato">Contrato: @op.PropietarioContratoTexto</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(t?.DepositoRetiro))
                                    {
                                        <span class="op-chip" title="Depósito de retiro vacío (tarifa del Gate)"><i class="bi bi-dropbox me-1"></i>@t.DepositoRetiro</span>
                                    }
                                    else
                                    {
                                        <span class="op-chip op-chip--warning" title="Sin depósito no se puede calcular la tarifa del Gate">Depósito retiro por definir</span>
                                    }
                                    @{
                                        string? condPagoLabelMar = op.CondicionPago switch { 1 => "Prepaid", 2 => "Full Prepaid", 3 => "Collect", 4 => "Full Collect", 5 => "Elsewhere", _ => null };
                                        bool condPagoCollectMar = op.CondicionPago == 3 || op.CondicionPago == 4;
                                    }
                                    @if (condPagoLabelMar != null)
                                    {
                                        <span class="op-chip @(condPagoCollectMar ? "op-chip--warning" : "")">@condPagoLabelMar</span>
                                    }
                                </div>
                            </div>

                            <div class="op-route">
                                <div class="op-route-port">
                                    <span class="op-route-eyebrow">Origen (POL)</span>
                                    <div class="op-route-nombre">@(op.IdPuertoOrigenNavigation?.NombrePuerto ?? "-")</div>
                                    <div class="op-route-sub">@(t?.TerminalTerrestreStr ?? "Terminal por confirmar")</div>
                                    <div class="op-route-date">
                                        <span class="op-route-date-label"><i class="bi bi-calendar-check"></i> ETD</span>
                                        <span class="op-route-date-val">@(op.EtdPol?.ToString("dd/MM/yyyy") ?? "--")</span>
                                    </div>
                                    @if (op.EtdReal.HasValue)
                                    {
                                        <div class="op-route-date op-route-date--real">
                                            <span class="op-route-date-label"><i class="bi bi-check-circle-fill"></i> Zarpe real</span>
                                            <span class="op-route-date-val">@op.EtdReal.Value.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    }
                                </div>

                                <div class="op-route-connector">
                                    <span class="op-route-connector-line"></span>
                                    <span class="op-route-marker"><i class="bi bi-water"></i></span>
                                    <span class="op-route-connector-caption">@(string.IsNullOrWhiteSpace(op.Transbordo) ? "Directo" : $"Vía {op.Transbordo}")</span>
                                </div>

                                <div class="op-route-port op-route-port--end">
                                    <span class="op-route-eyebrow">Destino (POD)</span>
                                    <div class="op-route-nombre">@(op.IdPuertoDestinoNavigation?.NombrePuerto ?? "-")</div>
                                    <div class="op-route-sub">&nbsp;</div>
                                    <div class="op-route-date">
                                        <span class="op-route-date-label"><i class="bi bi-calendar-check"></i> ETA</span>
                                        <span class="op-route-date-val">@(op.EtaPod?.ToString("dd/MM/yyyy") ?? "--")</span>
                                    </div>
                                    @if (op.EtaReal.HasValue)
                                    {
                                        <div class="op-route-date op-route-date--real">
                                            <span class="op-route-date-label"><i class="bi bi-check-circle-fill"></i> Arribo real</span>
                                            <span class="op-route-date-val">@op.EtaReal.Value.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="op-timeline-strip">
                                <div class="op-timeline-item">
                                    <i class="bi bi-door-open"></i>
                                    <div><span class="op-timeline-label">Stacking Apertura</span><span class="op-timeline-val">@(op.FechaStacking?.ToString("dd/MM HH:mm") ?? "--")</span></div>
                                </div>
                                <div class="op-timeline-item op-timeline-item--danger">
                                    <i class="bi bi-door-closed"></i>
                                    <div><span class="op-timeline-label">Stacking Cierre</span><span class="op-timeline-val">@(op.CutOffMatriz?.ToString("dd/MM HH:mm") ?? "--")</span></div>
                                </div>
                                <div class="op-timeline-item op-timeline-item--warning">
                                    <i class="bi bi-clock-history"></i>
                                    <div><span class="op-timeline-label">Late Arrival</span><span class="op-timeline-val">@(op.LateArrival?.ToString("dd/MM HH:mm") ?? "--")@(op.ElarDate.HasValue ? $" – {op.ElarDate.Value:dd/MM HH:mm}" : "")</span></div>
                                </div>
                            </div>
                        </div>

                        <div class="op-form-core @(completeMarHead ? "d-none" : "")" id="mar-form-core-@op.Id">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="mod-label">Naviera Asignada</label>
                                <select name="IdNaviera" class="form-select inline-field select2-enable" disabled asp-items="ViewBag.IdNaviera">
                                    <option value="@op.IdNaviera" selected>@(op.IdNavieraNavigation?.NombreNaviera ?? "TBA")</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="mod-label">Nave / Viaje</label>
                                <input type="text" name="Nave" class="form-control inline-field text-uppercase" value="@op.Nave" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="mod-label">Condición Tarifa</label>
                                <select name="TipoTarifaMaritima" class="form-select inline-field" disabled>
                                    <option value="">-- Seleccionar --</option>
                                    <option value="SPOT" selected="@(op.TipoTarifaMaritima == "SPOT" ? "selected" : null)">Spot</option>
                                    <option value="CONTRATO" selected="@(op.TipoTarifaMaritima == "CONTRATO" ? "selected" : null)">Contrato</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="mod-label">Condición de Pago</label>
                                <select name="CondicionPago" class="form-select inline-field @(op.CondicionPago == 3 || op.CondicionPago == 4 ? "border-warning text-warning fw-bold" : "")" disabled>
                                    <option value="">-- Seleccionar --</option>
                                    <option value="1" selected="@(op.CondicionPago == 1 ? "selected" : null)">Prepaid</option>
                                    <option value="2" selected="@(op.CondicionPago == 2 ? "selected" : null)">Full Prepaid</option>
                                    <option value="3" selected="@(op.CondicionPago == 3 ? "selected" : null)">Collect</option>
                                    <option value="4" selected="@(op.CondicionPago == 4 ? "selected" : null)">Full Collect</option>
                                    <option value="5" selected="@(op.CondicionPago == 5 ? "selected" : null)">Elsewhere</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 op-transbordo-row">
                            <div class="col-md-8">
                                <label class="mod-label">Modalidad de Tránsito</label>
                                <div class="d-flex gap-2 align-items-center">
                                    <input type="text" class="form-control inline-field text-uppercase fw-bold text-primary view-only-transbordo"
                                           id="view-transbordo" value="@(string.IsNullOrEmpty(op.Transbordo) ? "DIRECTO" : $"TRANSBORDO: {op.Transbordo}")" readonly />
                                    <select class="form-select inline-field edit-only-transbordo" style="width:45%; display:none;" disabled id="sel-transbordo" onchange="toggleTransbordoDetalle(this)">
                                        <option value="DIRECTO" selected="@(string.IsNullOrEmpty(op.Transbordo) ? "selected" : null)">Directo</option>
                                        <option value="TRANSBORDO" selected="@(!string.IsNullOrEmpty(op.Transbordo) ? "selected" : null)">Transbordo</option>
                                    </select>
                                    <input type="text" name="Transbordo" id="inp-transbordo" class="form-control inline-field text-uppercase edit-only-transbordo"
                                           value="@op.Transbordo" placeholder="Puerto conexión..." style="width:55%; display:none;" disabled />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="mod-label">Propietario de Contrato</label>
                                @{ string? propNormDet = AtilsonCargoSpa.Models.Operacione.NormalizarPropietarioContrato(op.PropietarioContrato); }
                                <select name="PropietarioContrato" class="form-select inline-field" disabled onchange="var o=this.parentElement.querySelector('.prop-otro-det'); if(o){ o.style.display = this.value === 'OTROS' ? '' : 'none'; }">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var opc in AtilsonCargoSpa.Models.Operacione.OpcionesPropietarioContrato)
                                    {
                                        <option value="@opc.Valor" selected="@(propNormDet == opc.Valor ? "selected" : null)">@opc.Texto</option>
                                    }
                                </select>
                                <input type="text" name="PropietarioContratoOtro" class="form-control inline-field text-uppercase mt-1 prop-otro-det" value="@op.PropietarioContratoOtro" maxlength="100" placeholder="Cliente / recibidor (opcional)" readonly style="display:@(propNormDet == "OTROS" ? "" : "none");" />
                            </div>
                        </div>

                        @{
                            // Depósito de retiro vacío (oct-2026): con tramo marítimo se define aquí
                            // (para la tarifa del Gate) y se replica en Terrestre.
                            string depositoMarDet = (t?.DepositoRetiro ?? "").Trim();
                            var depositosMarDet = (ViewData["DepositosList"] as IEnumerable<AtilsonCargoSpa.Models.Deposito>)?.ToList() ?? new List<AtilsonCargoSpa.Models.Deposito>();
                            bool depositoMarEnLista = depositoMarDet == "" || depositosMarDet.Any(dp => string.Equals(dp.NombreDeposito, depositoMarDet, StringComparison.OrdinalIgnoreCase));
                        }
                        <div class="row g-3 op-deposito-row">
