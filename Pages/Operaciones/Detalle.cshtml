                                    <option value="Atilson gestiona y refactura" selected="@(opGate.GestionaGate == "Atilson gestiona y refactura")">Atilson gestiona por el cliente</option>
                                    <option value="Gate out incluido para cliente" selected="@(opGate.GestionaGate == "Gate out incluido para cliente")">Gate out incluido para cliente</option>
                                    <option value="Cliente gestiona directo" selected="@(opGate.GestionaGate == "Cliente gestiona directo")">Cliente gestiona directamente</option>
                                </select>
