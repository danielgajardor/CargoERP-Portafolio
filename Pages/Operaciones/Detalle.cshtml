                            <button type="button" class="btn btn-dark btn-sm fw-bold px-4" onclick="guardarFormularioDetalle(this.closest('form'), this)" @(gatePendiente ? "disabled title='Bloqueado: falta tarifa'" : "")>Guardar Gate</button>
                        </div>
                    </div>
                </fieldset>
            </form>
        </div>
                @if (Model.ReqTerrestre)
