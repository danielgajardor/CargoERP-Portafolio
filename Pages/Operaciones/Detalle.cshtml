                    contenedoresLarDet.Add((Model.Op.Id.ToString(), "Contenedor Principal", (int?)null, Model.Op.EstadoLar, Model.Op.LateArrival, Model.Op.ElarDate, Model.Op.ContenedorIngresado, valLlegadaPuertoPrincipalLar));
                    if (Model.Op.Unidadestecnicas != null)
                    {
                        foreach (var uLarDet in Model.Op.Unidadestecnicas)
