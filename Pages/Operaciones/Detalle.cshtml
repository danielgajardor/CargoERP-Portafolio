    /* El contenido inyectado son los mismos bloques que arma GenerarAlertasProactivas
       en el servidor (con colores Bootstrap info/warning/danger). Acá se simplifican
       a solo dos tonos — negro para lo informativo, rojo para lo crítico — sobre
       fondo blanco, con más aire entre cada bloque. */
    #global-alert-content > div {
    background: #ffffff !important;
    margin-bottom: 12px !important;
    padding: 12px 14px !important;
    font-size: 12px !important;
    line-height: 1.5 !important;
    border-radius: 8px !important;
    box-shadow: none !important;
    }
    #global-alert-content > div:last-child {
    margin-bottom: 0 !important;
    }
    #global-alert-content .text-info,
    #global-alert-content .text-warning,
    #global-alert-content .text-dark,
    #global-alert-content .border-info,
    #global-alert-content .border-warning {
    color: #0f172a !important;
    border-color: #0f172a !important;
    }
    #global-alert-content .text-danger,
    #global-alert-content .border-danger {
    color: #dc2626 !important;
    border-color: #dc2626 !important;
    }
    #global-alert-content strong {
    font-size: 11.5px !important;
    letter-spacing: 0.3px;
    }

    #global-alert-box::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 15px;
    width: 12px;
    height: 12px;
    background: #fff;
    border-left: 1px solid #fca5a5;
