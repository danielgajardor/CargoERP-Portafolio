/* =========================================================================
   NIVEL PREMIUM — REDISEÑO VISUAL COMPARTIDO (afecta todas las pestañas
   del modal: Marítimo, Transporte, Documental, Matriz/BL, LAR, Gate,
   Almacenamiento, Courier, Extracostos, Historial). Solo propiedades
   visuales — ninguna propiedad de display/pointer-events/appearance que
   ya controla la lógica de edición fue modificada.
   ========================================================================= */

:root {
  --atilson-dark: #0b1220;
  --atilson-purple: #6d2d9e;
  --atilson-purple-deep: #4c1d7a;
  --atilson-purple-soft: #f4edfc;
  --atilson-purple-border: #e3d4f5;
  --txt-main: #1b2130;
  --txt-muted: #6b7486;
  --border-soft: #e7e9f0;
  --bg-main: #ffffff;
  --bg-soft: #f8f9fc;
  --shadow-xs: 0 1px 2px rgba(15,23,42,.05);
  --shadow-sm: 0 1px 2px rgba(15,23,42,.04), 0 6px 16px -8px rgba(15,23,42,.10);
  --shadow-md: 0 2px 6px -1px rgba(15,23,42,.06), 0 14px 32px -12px rgba(15,23,42,.16);
  --shadow-lg: 0 8px 20px -4px rgba(15,23,42,.10), 0 28px 60px -20px rgba(15,23,42,.24);
}

/* --- CASCARÓN DEL MODAL --- */
.modal-minimal .modal-content {
  border-radius: 18px !important;
  box-shadow: var(--shadow-lg) !important;
}
.modal-minimal .modal-body {
  background: linear-gradient(180deg, #fbfbfd 0%, var(--bg-soft) 140px);
  padding: 26px 30px !important;
}
.modal-minimal .modal-body::-webkit-scrollbar { width: 8px; }
.modal-minimal .modal-body::-webkit-scrollbar-track { background: transparent; }
.modal-minimal .modal-body::-webkit-scrollbar-thumb {
  background: #d8d4e6; border-radius: 10px;
}
.modal-minimal .modal-body::-webkit-scrollbar-thumb:hover { background: var(--atilson-purple); }

/* --- BANNER SUPERIOR (CABECERA DEL BOOKING) --- */
.atilson-banner {
  background: linear-gradient(120deg, #0b1220 0%, #241539 55%, var(--atilson-purple-deep) 130%);
  border-radius: 14px;
  padding: 20px 28px;
  box-shadow: 0 10px 28px -10px rgba(76,29,122,.45);
  border: 1px solid rgba(255,255,255,.06);
}
.banner-label {
  color: #b8b2d4 !important;
  font-weight: 800;
  letter-spacing: .6px;
}
.banner-input {
  font-weight: 800 !important;
  letter-spacing: .2px;
}
.edit-mode .banner-input {
  background: rgba(255,255,255,.12) !important;
  border: 1px solid rgba(255,255,255,.3) !important;
  border-radius: 8px;
}
.edit-mode .banner-input:focus {
  background: rgba(255,255,255,.2) !important;
  box-shadow: 0 0 0 3px rgba(167,139,250,.25);
}
.btn-edit-banner {
  border-radius: 8px;
  letter-spacing: .6px;
  background: rgba(255,255,255,.08) !important;
  transition: all .18s ease;
}
.btn-edit-banner:hover {
  background: rgba(255,255,255,.18) !important;
  transform: translateY(-1px);
}

/* --- PESTAÑAS PRINCIPALES DEL MODAL (Marítimo/Transporte/Documental/etc.) --- */
.modern-tabs {
  gap: 6px !important;
  border-bottom: 1px solid var(--border-soft) !important;
  padding: 0 2px !important;
}
.modern-tabs .nav-link {
  background: transparent !important;
  border: none !important;
  border-bottom: 2px solid transparent !important;
  border-radius: 10px 10px 0 0 !important;
  color: var(--txt-muted) !important;
  font-weight: 800 !important;
  letter-spacing: .4px !important;
  padding: 11px 16px !important;
  transition: all .16s ease !important;
}
.modern-tabs .nav-link:hover {
  background: var(--atilson-purple-soft) !important;
  color: var(--atilson-purple-deep) !important;
}
.modern-tabs .nav-link.active {
  background: var(--bg-main) !important;
  color: var(--atilson-purple-deep) !important;
  border-bottom: 2px solid var(--atilson-purple) !important;
  box-shadow: 0 -1px 0 0 var(--border-soft) inset, var(--shadow-xs) !important;
}

/* --- SECCIONES / TARJETAS DE CONTENIDO --- */
.modal-minimal .tab-content .form-section,
.modal-minimal:not(#megaModal) .form-section {
  background: var(--bg-main) !important;
  border: 1px solid var(--border-soft) !important;
  border-radius: 14px !important;
  box-shadow: var(--shadow-sm) !important;
  padding: 26px 28px !important;
}
.section-title-sm {
  font-size: 11.5px !important;
  letter-spacing: .7px !important;
  color: var(--atilson-dark) !important;
  border-bottom: 1px solid var(--border-soft) !important;
  padding-bottom: 12px !important;
  margin-bottom: 18px !important;
}
.mod-label {
  letter-spacing: .5px !important;
  color: #9398a8 !important;
  font-weight: 800 !important;
}

/* --- CAMPOS DE FORMULARIO (texto, select, fecha) --- */
.erp-input, .inline-field {
  border-radius: 9px !important;
  transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease;
}
.erp-input {
  border: 1px solid var(--border-soft) !important;
  background-color: var(--bg-soft) !important;
}
.erp-input:focus {
  border-color: var(--atilson-purple) !important;
  background-color: #fff !important;
  box-shadow: 0 0 0 3px rgba(109,45,158,.10) !important;
  outline: none !important;
}
.erp-input::placeholder { color: #aab0bf; font-weight: 500; }
.edit-mode .inline-field {
  border: 1px solid var(--border-soft) !important;
  background: var(--bg-soft) !important;
  border-radius: 9px !important;
}
.edit-mode .inline-field:focus {
  border-color: var(--atilson-purple) !important;
  background: #fff !important;
  box-shadow: 0 0 0 3px rgba(109,45,158,.10) !important;
}
.inline-field:not(.edit-mode *) {
  color: var(--txt-main);
}

/* --- BOTÓN "EDITAR" (dentro de cada sección) --- */
.btn-edit-inline {
  background: var(--atilson-purple-soft) !important;
  border: 1px solid var(--atilson-purple-border) !important;
  border-radius: 8px !important;
  letter-spacing: .5px !important;
  padding: 7px 14px !important;
  transition: all .16s ease;
}
.btn-edit-inline:hover {
  background: var(--atilson-purple) !important;
  color: #fff !important;
  border-color: var(--atilson-purple) !important;
  transform: translateY(-1px);
  box-shadow: 0 4px 10px -2px rgba(109,45,158,.35);
}

/* --- ALERTAS (tarifa pendiente, bloqueado, etc.) --- */
.form-section .alert-danger {
  background: #fff5f5 !important;
  border: 1px solid #fecaca !important;
  border-left: 3px solid #dc2626 !important;
  border-radius: 10px !important;
  color: #991b1b !important;
}
.form-section .alert-light {
  background: var(--bg-soft) !important;
  border: 1px solid var(--border-soft) !important;
  border-radius: 10px !important;
}
.alert-secondary {
  background: #f1f0f6 !important;
  border: 1px solid #ddd9ea !important;
  border-left: 3px solid var(--atilson-purple) !important;
  border-radius: 10px !important;
  color: var(--atilson-purple-deep) !important;
}

/* --- SWITCHES Y CHECKBOXES --- */
.custom-switch-md .form-check-input {
  box-shadow: inset 0 1px 2px rgba(0,0,0,.12) !important;
}
.custom-switch-md .form-check-input:checked {
  box-shadow: 0 2px 6px -1px rgba(109,45,158,.4) !important;
}
.cuadradito-check {
  border-radius: 5px !important;
  border-width: 1.5px !important;
  transition: all .15s ease;
}
.cuadradito-check:checked {
  box-shadow: 0 2px 5px -1px rgba(109,45,158,.4) !important;
}

/* --- STEPPERS (trazabilidad) --- */
.stepper-trazabilidad::before { background: #e4e1ee !important; }
.step-circle {
  box-shadow: 0 0 0 4px #fff, 0 1px 3px rgba(15,23,42,.08) !important;
}
.step-item.completed .step-circle {
  border-color: #16a34a !important;
  background: #16a34a !important;
  box-shadow: 0 0 0 4px #fff, 0 0 0 7px rgba(22,163,74,.12) !important;
}
.step-item.rejected .step-circle {
  border-color: #dc2626 !important;
  background: #dc2626 !important;
  box-shadow: 0 0 0 4px #fff, 0 0 0 7px rgba(220,38,38,.12) !important;
}
.pro-stepper::before { background: #e4e1ee !important; }
.pro-step-icon { box-shadow: 0 0 0 4px #fff, 0 1px 3px rgba(15,23,42,.08) !important; }
.pro-step.completed .pro-step-icon {
  box-shadow: 0 0 0 4px #fff, 0 0 0 7px rgba(16,185,129,.12) !important;
}

/* --- BITÁCORAS / LOGS DE INCIDENCIAS --- */
.log-incidencias-wrap {
  background: var(--bg-soft) !important;
  border: 1px solid var(--border-soft) !important;
  border-radius: 10px !important;
}
.log-incidencias-wrap::-webkit-scrollbar { width: 6px; }
.log-incidencias-wrap::-webkit-scrollbar-thumb { background: #d8d4e6; border-radius: 10px; }

/* --- TARJETAS INTERNAS (bloques gris dentro de secciones) --- */
.form-section .border.rounded.bg-light,
.form-section .p-3.border.rounded {
  border-color: var(--border-soft) !important;
  background: var(--bg-soft) !important;
  border-radius: 12px !important;
}

/* --- BADGES DE ESTADO --- */
.estado-badge, .email-badge, .servicio-bw {
  border-radius: 7px !important;
}

/* --- BOTONES GENÉRICOS DENTRO DEL MODAL --- */
.modal-minimal .btn {
  border-radius: 9px !important;
  transition: all .15s ease !important;
}
.modal-minimal .btn:not(.btn-link):not(.btn-action-dot):not(.btn-edit-inline):not(.btn-edit-banner):hover {
  transform: translateY(-1px);
}
.modal-minimal .btn-dark {
  background: var(--atilson-dark) !important;
  border: none !important;
}
.modal-minimal .btn-dark:hover {
  background: #050810 !important;
  box-shadow: 0 6px 16px -4px rgba(0,0,0,.35);
}

/* --- SELECT2 (Naviera, POL, POD, Depósito, Planta, Agencia) --- */
.select2-container--default .select2-selection--single {
  border-radius: 9px !important;
  border: 1px solid var(--border-soft) !important;
}
.select2-container--open .select2-selection--single {
  border-color: var(--atilson-purple) !important;
  box-shadow: 0 0 0 3px rgba(109,45,158,.10) !important;
}
.select2-dropdown {
  border-radius: 10px !important;
  box-shadow: var(--shadow-md) !important;
}

/* --- TABLAS INTERNAS (Pro, Reemisiones) --- */
.pro-table th {
  letter-spacing: .5px !important;
  color: #9398a8 !important;
}
.pro-table td { border-bottom: 1px dashed var(--border-soft) !important; }

/* --- SIDEBAR DOCUMENTAL (V3) --- */
.pro-wrapper {
  border: 1px solid var(--border-soft) !important;
  box-shadow: var(--shadow-sm) !important;
}
.pro-sidebar { background: linear-gradient(180deg, #fbfbfd 0%, var(--bg-soft) 100%) !important; }

/* ============ FASE 6 — HEADER PREMIUM, CARDS Y RESP-WIDGET ============ */
.back-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 700; color: var(--txt-muted);
    text-decoration: none; margin-bottom: 10px; padding: 4px 2px;
    transition: color .15s ease;
}
.back-link:hover { color: var(--atilson-purple); }
.back-link i { font-size: 12px; }

.detalle-header-top {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 24px;
    padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid rgba(255,255,255,.1);
}
.detalle-kicker {
    font-size: 9.5px; font-weight: 800; color: #b8b2d4;
    letter-spacing: .7px; text-transform: uppercase; display: block; margin-bottom: 5px;
}
.detalle-title { font-size: 26px; font-weight: 900; margin: 0; letter-spacing: -.3px; }
.detalle-subtitle { font-size: 12px; color: #cbd5e1; margin-top: 4px; }
.detalle-instructivo { text-align: right; flex-shrink: 0; }
.detalle-instructivo-val { font-size: 15px; font-weight: 800; color: #fff; }
.detalle-header-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.detalle-stat-val { font-size: 13px; font-weight: 700; color: #fff; text-transform: uppercase; }
@@media (max-width: 992px) { .detalle-header-grid { grid-template-columns: repeat(2, 1fr); } }

.form-subcard {
    background: var(--bg-soft); border: 1px solid var(--border-soft);
    border-radius: 12px; padding: 18px 20px; height: 100%;
}
.form-subcard-title {
    font-size: 10.5px; font-weight: 900; letter-spacing: .5px; text-transform: uppercase;
    color: var(--txt-main); margin: 0 0 14px; padding-bottom: 10px;
    border-bottom: 1px solid var(--border-soft); display: flex; align-items: center; gap: 7px;
}
.form-subcard-title i { color: var(--atilson-purple); font-size: 13px; }

.status-toggle-row {
    display: flex; align-items: center; gap: 10px; cursor: pointer;
    font-size: 12px; font-weight: 800; color: var(--txt-main);
    text-transform: uppercase; letter-spacing: .3px; margin: 0;
}

.resp-widget {
    display: flex; align-items: center; gap: 10px; margin-top: 14px;
    padding: 10px 14px; background: var(--bg-soft); border: 1px solid var(--border-soft); border-radius: 10px;
}
.resp-widget-icon {
    width: 26px; height: 26px; border-radius: 50%; background: var(--atilson-purple-soft);
    color: var(--atilson-purple); display: flex; align-items: center; justify-content: center;
    font-size: 12px; flex-shrink: 0;
}
.resp-widget-field { display: flex; flex-direction: column; gap: 2px; }
.resp-widget-field label {
    font-size: 8.5px; font-weight: 800; color: #9398a8; text-transform: uppercase; letter-spacing: .4px;
}
.resp-widget-field select {
    border: 1px solid var(--border-soft); background: #fff; border-radius: 6px;
    font-size: 11px; font-weight: 700; color: var(--txt-main); padding: 3px 8px; cursor: pointer;
}
.resp-widget-field:last-child select { color: #b91c1c; }
.resp-widget-arrow { color: #cbd5e1; font-size: 13px; flex-shrink: 0; }

/* ===== Banner de operación cerrada ("Vacío Devuelto") ===== */
.cierre-banner {
    display: flex; align-items: center; gap: 14px;
    background: #ecfdf5; border: 1px solid #bbf7d0; border-radius: 12px;
    padding: 14px 20px; margin-bottom: 18px;
}
.cierre-banner-icon {
    width: 38px; height: 38px; border-radius: 50%; background: #16a34a; color: #fff;
    display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;
}
.cierre-banner-title { font-size: 13px; font-weight: 900; color: #15803d; text-transform: uppercase; letter-spacing: .4px; }
.cierre-banner-sub { font-size: 11.5px; color: #16a34a; margin-top: 2px; }

</style>

<div class="container-fluid py-4" style="max-width: 1500px;">

    <!-- Datos ocultos requeridos por abrirGeneradorCorreos() (función genérica reusada del modal) -->
    <div class="atilson-banner d-none">
        <span class="banner-label">Cliente</span>
        <span class="fw-bold">N° BOOKING: @Model.Op.NumeroBooking</span>
    </div>
    <input type="hidden" name="CorreosCliente" value="@(Model.Op.IdClienteNavigation?.Correo ?? "")" />

    <a asp-page="./Index" class="back-link"><i class="bi bi-arrow-left"></i> Main Board</a>

    <div class="detalle-header">
        <div class="detalle-header-top">
            <div>
                <span class="detalle-kicker">Booking</span>
                <h1 class="detalle-title">@Model.Op.NumeroBooking</h1>
                <div class="detalle-subtitle">@Model.Op.IdClienteNavigation?.RazonSocial — @Model.NombreServicio</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Op.NumeroInstructivo))
            {
                <div class="detalle-instructivo">
                    <span class="detalle-kicker">Instructivo</span>
                    <div class="detalle-instructivo-val">@Model.Op.NumeroInstructivo</div>
                </div>
            }
        </div>
        <div class="detalle-header-grid">
            <div>
                <span class="detalle-kicker">Cliente Asociado</span>
                <div class="detalle-stat-val">@(Model.Op.IdClienteNavigation?.RazonSocial ?? "-")</div>
            </div>
            <div>
                <span class="detalle-kicker">Servicio Logístico</span>
                <div class="detalle-stat-val">@Model.NombreServicio</div>
            </div>
            <div>
                <span class="detalle-kicker">Mercancía</span>
                <div class="detalle-stat-val">@(Model.Op.Commodity ?? "GENERAL")</div>
            </div>
            <div>
                <span class="detalle-kicker">Tipo Contenedor</span>
                <div class="detalle-stat-val">@(Model.Op.TipoContenedor ?? "S/N")</div>
            </div>
        </div>
    </div>

    @if (Model.OperacionCerrada)
    {
        <div class="cierre-banner">
            <div class="cierre-banner-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="cierre-banner-title">Operación Cerrada — Vacío Devuelto</div>
                <div class="cierre-banner-sub">
                    El contenedor fue retirado y el ciclo logístico está completo.
                    @if (Model.FechaCierreMasReciente.HasValue)
                    {
                        <text> Último retiro registrado: @Model.FechaCierreMasReciente.Value.ToString("dd/MM/yyyy HH:mm").</text>
                    }
                </div>
            </div>
        </div>
    }

    @{
        var opHead = Model.Op;
        var tHead = opHead.OperacionesTerrestres.FirstOrDefault(x => x.IdUnidadTecnica == null);
        var dHead = opHead.OperacionesDocumentales.FirstOrDefault(x => x.IdUnidadTecnica == null);

        var marItemsHead = new List<bool> {
            opHead.IdNaviera > 0, !string.IsNullOrEmpty(opHead.Nave), opHead.IdPuertoOrigen.HasValue, opHead.IdPuertoDestino.HasValue,
            opHead.EtdPol.HasValue, opHead.EtaPod.HasValue, opHead.FechaStacking.HasValue, opHead.CutOffMatriz.HasValue
        };
        int pctMarHead = (int)Math.Round(marItemsHead.Count(x => x) * 100.0 / marItemsHead.Count);
        bool completeMarHead = pctMarHead >= 100;

        int ContarCamposTerHead(AtilsonCargoSpa.Models.OperacionesTerrestre? terrRow, string? numContenedor, string? numSello)
        {
            int c = 0;
            if (terrRow != null)
            {
                if (!string.IsNullOrWhiteSpace(terrRow.EmpresaTransporte)) c++;
                if (!string.IsNullOrWhiteSpace(terrRow.NombreConductor)) c++;
                if (!string.IsNullOrWhiteSpace(terrRow.Patente)) c++;
                if (!string.IsNullOrWhiteSpace(terrRow.DepositoRetiro)) c++;
                if (terrRow.FechaCarga.HasValue) c++;
            }
            if (!string.IsNullOrWhiteSpace(numContenedor)) c++;
            if (!string.IsNullOrWhiteSpace(numSello)) c++;
            return c;
        }
        var pctsTerHead = new List<double> { ContarCamposTerHead(tHead, opHead.NumeroContenedor, opHead.NumeroSello) * 100.0 / 7 };
        if (opHead.Unidadestecnicas != null)
        {
            foreach (var uT in opHead.Unidadestecnicas)
            {
                var terrU = opHead.OperacionesTerrestres.FirstOrDefault(x => x.IdUnidadTecnica == uT.Id);
                pctsTerHead.Add(ContarCamposTerHead(terrU, uT.NroContenedor, uT.NumeroSello) * 100.0 / 7);
            }
        }
        int pctTerHead = (int)Math.Round(pctsTerHead.Average());
        bool completeTerHead = pctTerHead >= 100;

        int docTotalHead = 2; int docHechosHead = 0;
        if (dHead != null)
        {
            if (dHead.IdAgenciaAduana.HasValue) docHechosHead++;
            if (!string.IsNullOrWhiteSpace(dHead.DusDin) || !string.IsNullOrWhiteSpace(dHead.Din)) docHechosHead++;
            if (dHead.AplicaSag == true) { docTotalHead++; if (!string.IsNullOrWhiteSpace(dHead.CertFitosanitario)) docHechosHead++; }
            if (dHead.AplicaSernapesca == true) { docTotalHead++; if (!string.IsNullOrWhiteSpace(dHead.CertSanitario)) docHechosHead++; }
        }
        int pctDocHead = (int)Math.Round(docHechosHead * 100.0 / docTotalHead);
        bool completeDocHead = pctDocHead >= 100;

        bool clienteGestionaDirectoHead = opHead.GestionaGate == "Cliente gestiona directo";
        int gateTotalHead = clienteGestionaDirectoHead ? 2 : 3;
        int gateHechosHead = 0;
        if (!string.IsNullOrWhiteSpace(opHead.TipoGate)) gateHechosHead++;
        if (!string.IsNullOrWhiteSpace(opHead.GestionaGate)) gateHechosHead++;
        if (!clienteGestionaDirectoHead && !string.IsNullOrWhiteSpace(opHead.PagoGate)) gateHechosHead++;
        int pctGateHead = (int)Math.Round(gateHechosHead * 100.0 / gateTotalHead);
        bool completeGateHead = gateHechosHead == gateTotalHead;

        var almacenHead = opHead.OperacionesAlmacenamientos?.FirstOrDefault();
        bool completeAlmacenHead = almacenHead != null && almacenHead.FechaIngreso.HasValue && almacenHead.FechaSalida.HasValue;
        int pctAlmacenHead = almacenHead == null ? 0 : (completeAlmacenHead ? 100 : (almacenHead.FechaIngreso.HasValue || almacenHead.IdProveedor.HasValue ? 50 : 0));
    }

    <ul class="nav modern-tabs" id="detalleTabs" role="tablist">
        @if (Model.ReqMaritimo)
        {
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#det-maritimo" type="button"><span class="tab-progress-ring" id="ring-mar-@opHead.Id" style="--pct:@pctMarHead;" data-complete="@(completeMarHead ? "true" : "false")"></span><i class="bi bi-water me-1"></i> Marítimo</button></li>
        }
        @if (Model.ReqTerrestre)
        {
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-transporte" type="button"><span class="tab-progress-ring" id="ring-ter-@opHead.Id" style="--pct:@pctTerHead;" data-complete="@(completeTerHead ? "true" : "false")"></span><i class="bi bi-truck me-1"></i> Transporte</button></li>
        }
        @if (Model.ReqDocumental)
        {
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-documental" type="button"><span class="tab-progress-ring" id="ring-doc-@opHead.Id" style="--pct:@pctDocHead;" data-complete="@(completeDocHead ? "true" : "false")"></span><i class="bi bi-file-earmark-check me-1"></i> Documental</button></li>
        }
        <li class="nav-item"><button class="nav-link @(!Model.ReqMaritimo ? "active" : "")" data-bs-toggle="tab" data-bs-target="#det-gate" type="button"><span class="tab-progress-ring" id="ring-gate-@opHead.Id" style="--pct:@pctGateHead;" data-complete="@(completeGateHead ? "true" : "false")"></span><i class="bi bi-box-arrow-right me-1"></i> Gate Out / In</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-almacenamiento" type="button"><span class="tab-progress-ring" id="ring-almacen-@opHead.Id" style="--pct:@pctAlmacenHead;" data-complete="@(completeAlmacenHead ? "true" : "false")"></span><i class="bi bi-boxes me-1"></i> Almacenamiento</button></li>
        
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-lar" type="button"><i class="bi bi-clock-history me-1"></i> Gest. LAR</button></li>    
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-courier" type="button"><i class="bi bi-box-seam me-1"></i> Courier</button></li>
        <li class="nav-item"><button class="nav-link fw-bold text-danger" data-bs-toggle="tab" data-bs-target="#det-extracostos" type="button"><i class="bi bi-wallet2 me-1"></i> Extracostos</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#det-historial" type="button"><i class="bi bi-clock-history me-1"></i> Historial</button></li>
    </ul>

    <div class="tab-content">
                @if (Model.ReqMaritimo)
        {
            var op = Model.Op;
            var t = op.OperacionesTerrestres.FirstOrDefault(x => x.IdUnidadTecnica == null);
            var estRespMar = Model.ObtenerEstadoConcepto(op, "Flete Marítimo");
            var tiposBlSeleccionados = (op.TipoEmisionBl ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
            bool matrizOk = op.OperacionesDocumentales.FirstOrDefault()?.MatrizPresentada == true;
            var d = op.OperacionesDocumentales.FirstOrDefault();
            string estDoc = d?.EstadoDocumental ?? "";
            bool solNaviera = d?.MatrizPresentada == true;
            bool blAprobado = estDoc == "B/L APROBADO" || d?.MatrizPresentada == true;
            bool blCambios = estDoc == "CAMBIOS B/L" || estDoc == "RECHAZADO";
            bool blEnviado = estDoc == "BORRADOR ENVIADO" || blCambios || blAprobado;

            <div class="tab-pane fade show active" id="det-maritimo" role="tabpanel">
                <form method="post" asp-page-handler="QuickEditMaritimo" id="form-maritimo">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdOperacion" value="@op.Id" />

                    <div class="form-section" id="mar-form-@op.Id" data-tarifa-pendiente="@(estRespMar.PendienteTarifa ? "true" : "false")">
                        <div class="section-title-sm">
                            <span>Servicio Marítimo</span>
                            <a class="btn-edit-inline" onclick="toggleEditMode('mar-form-@op.Id', this)"><i class="bi bi-pencil me-1"></i> Editar</a>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="mod-label">Naviera Asignada</label>
                                <select name="IdNaviera" class="form-select inline-field select2-enable" disabled asp-items="ViewBag.IdNaviera">
                                    <option value="@op.IdNaviera" selected>@(op.IdNavieraNavigation?.NombreNaviera ?? "TBA")</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="mod-label">Nave / Viaje</label>
                                <input type="text" name="Nave" class="form-control inline-field text-uppercase" value="@op.Nave" readonly />
                            </div>
                            <div class="col-md-2">
                                <label class="mod-label">Condición Tarifa</label>
                                <select name="TipoTarifaMaritima" class="form-select inline-field" disabled>
                                    <option value="">-- Seleccionar --</option>
                                    <option value="SPOT" selected="@(op.TipoTarifaMaritima == "SPOT" ? "selected" : null)">Spot</option>
                                    <option value="CONTRATO" selected="@(op.TipoTarifaMaritima == "CONTRATO" ? "selected" : null)">Contrato</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="mod-label">Modalidad de Tránsito</label>
                                <div class="d-flex gap-2 align-items-center">
                                    <input type="text" class="form-control inline-field text-uppercase fw-bold text-primary" style="display:@(op.GestionaGate != null ? "" : "")"
                                           id="view-transbordo" value="@(string.IsNullOrEmpty(op.Transbordo) ? "DIRECTO" : $"TRANSBORDO: {op.Transbordo}")" readonly />
                                    <select class="form-select inline-field edit-only-inline" style="width:45%;" disabled id="sel-transbordo" onchange="toggleTransbordoDetalle(this)">
                                        <option value="DIRECTO" selected="@(string.IsNullOrEmpty(op.Transbordo) ? "selected" : null)">Directo</option>
                                        <option value="TRANSBORDO" selected="@(!string.IsNullOrEmpty(op.Transbordo) ? "selected" : null)">Transbordo</option>
                                    </select>
                                    <input type="text" name="Transbordo" id="inp-transbordo" class="form-control inline-field text-uppercase edit-only-inline"
                                           value="@op.Transbordo" placeholder="Puerto conexión..." style="width:55%; display:@(string.IsNullOrEmpty(op.Transbordo) ? "none" : "")" disabled />
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3 mt-2">
                            <div class="col-md-6">
                                <div class="p-3 border rounded h-100">
                                    <label class="mod-label">Puerto de Origen (POL)</label>
                                    <select name="IdPuertoOrigen" class="form-select inline-field select2-enable" disabled>
                                        <option value="">-- Seleccionar --</option>
                                        @if (ViewData["PuertosList"] != null)
                                        {
                                            foreach (var pto in ((IEnumerable<AtilsonCargoSpa.Models.Puerto>)ViewData["PuertosList"]).GroupBy(p => p.NombrePuerto).Select(g => g.First()))
                                            {
                                                <option value="@pto.Id" selected="@(op.IdPuertoOrigen == pto.Id ? "selected" : null)">@pto.NombrePuerto</option>
                                            }
                                        }
                                    </select>
                                    <label class="mod-label mt-2">Terminal</label>
                                    <input type="text" class="form-control inline-field text-uppercase" value="@(t?.TerminalTerrestreStr ?? "-")" readonly />
                                    <label class="mod-label mt-2">ETD (Zarpe)</label>
                                    <input type="date" name="EtdPol" class="form-control inline-field" value="@(op.EtdPol?.ToString("yyyy-MM-dd"))" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border rounded h-100">
                                    <label class="mod-label">Puerto de Destino (POD)</label>
                                    <select name="IdPuertoDestino" class="form-select inline-field select2-enable" disabled>
                                        <option value="">-- Seleccionar --</option>
                                        @if (ViewData["PuertosList"] != null)
                                        {
                                            foreach (var pto in ((IEnumerable<AtilsonCargoSpa.Models.Puerto>)ViewData["PuertosList"]).GroupBy(p => p.NombrePuerto).Select(g => g.First()))
                                            {
                                                <option value="@pto.Id" selected="@(op.IdPuertoDestino == pto.Id ? "selected" : null)">@pto.NombrePuerto</option>
                                            }
                                        }
                                    </select>
                                    <label class="mod-label mt-2">ETA (Arribo)</label>
                                    <input type="date" name="EtaPod" class="form-control inline-field" value="@(op.EtaPod?.ToString("yyyy-MM-dd"))" readonly />
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 pt-3 border-top">
                            <div class="col-md-3">
                                <label class="mod-label text-success"><i class="bi bi-door-open"></i> Stacking IN (Apertura)</label>
                                <input type="datetime-local" name="FechaStacking" class="form-control inline-field" value="@(op.FechaStacking?.ToString("yyyy-MM-ddTHH:mm"))" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="mod-label text-danger"><i class="bi bi-door-closed"></i> Stacking OUT (Cierre)</label>
                                <input type="datetime-local" name="CutOffMatriz" class="form-control inline-field text-danger fw-bold" value="@(op.CutOffMatriz?.ToString("yyyy-MM-ddTHH:mm"))" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="mod-label text-warning"><i class="bi bi-clock-history"></i> Late Arrival Inicio</label>
                                <input type="datetime-local" name="LateArrival" class="form-control inline-field text-warning" value="@(op.LateArrival?.ToString("yyyy-MM-ddTHH:mm"))" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="mod-label text-warning"><i class="bi bi-clock-fill"></i> Late Arrival Término</label>
                                <input type="datetime-local" name="ElarDate" class="form-control inline-field text-warning" value="@(op.ElarDate?.ToString("yyyy-MM-ddTHH:mm"))" readonly />
                            </div>
                        </div>

                        <div class="p-3 rounded border mt-3" style="background:var(--bg-soft);">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="mod-label m-0"><i class="bi bi-exclamation-diamond me-1"></i> Roleo / Cancelación / No Show</span>
                                <button type="button" class="btn btn-sm btn-outline-dark fw-bold py-1 px-3" style="font-size:10px;" onclick="registrarRoleoCancelacionDetalle(@op.Id, '@op.TipoTarifaMaritima', '@(op.IdNavieraNavigation?.NombreNaviera)', @(op.IdNavieraNavigation?.DiasPenalidadRoleo ?? 7), '@(op.IdNavieraNavigation?.PenalidadRoleoSiempreAplica == true ? "true" : "false")', 1)">
                                    <i class="bi bi-plus-circle me-1"></i> Registrar Nuevo
                                </button>
                            </div>
                            @{ var historialRoleos = op.RoleosCancelaciones?.OrderByDescending(r => r.FechaCreacion).ToList() ?? new List<AtilsonCargoSpa.Models.RoleoCancelacion>(); }
                            @if (!historialRoleos.Any())
                            {
                                <div class="text-muted" style="font-size:10px; font-style:italic;">Sin registros de roleo o cancelación para este booking.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var r in historialRoleos)
                                    {
                                        string nombreRoleoTipo = r.Tipo == "ROLEO" ? "Roleo" : "Cancelación / No Show";
                                        string colorPen = r.PenalidadConfirmada == "SI" ? "#dc2626" : (r.PenalidadConfirmada == "NO" ? "#16a34a" : "#d97706");
                                        string txtPen = r.PenalidadConfirmada switch { "SI" => "CON PENALIDAD", "NO" => "SIN PENALIDAD", _ => "PENALIDAD POR DETERMINAR" };
                                        <div class="p-2 rounded border bg-white">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <span class="fw-bold" style="font-size:11px;">@nombreRoleoTipo</span>
                                                    <span class="ms-2" style="font-size:10px; font-weight:800; color:@colorPen;">@txtPen</span>
                                                    @if (r.DiasAnticipacion.HasValue)
                                                    {
                                                        <span class="text-muted ms-1" style="font-size:9px;">(@r.DiasAnticipacion días de anticipación · @(r.NavieraTipoTarifa ?? "Sin tarifa"))</span>
                                                    }
                                                    <div class="text-muted" style="font-size:9px;">@r.CantidadContenedoresAfectados contenedor(es)@(r.MontoPenalidadUnitarioUsd.HasValue && r.PenalidadConfirmada == "SI" ? $" · USD {(r.MontoPenalidadUnitarioUsd.Value * r.CantidadContenedoresAfectados):N0}" : "")</div>
                                                    @if (!string.IsNullOrWhiteSpace(r.Comentario))
                                                    {
                                                        <div class="text-muted mt-1" style="font-size:10px; font-style:italic;">"@r.Comentario"</div>
                                                    }
                                                    @if (r.DatosNuevosPendientes)
                                                    {
                                                        <div class="text-warning mt-1" style="font-size:9px; font-weight:800;"><i class="bi bi-hourglass-split me-1"></i>ITINERARIO NUEVO PENDIENTE</div>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(r.NuevaNave))
                                                    {
                                                        <div class="text-muted mt-1" style="font-size:9px;">Nueva nave: <strong>@r.NuevaNave</strong> · ETD: @r.NuevoEtd?.ToString("dd/MM HH:mm")</div>
                                                    }
                                                    <div class="text-muted mt-1" style="font-size:9px;">@r.Usuario — @r.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</div>
                                                </div>
                                                <div class="d-flex flex-column gap-1">
                                                    @if (r.PenalidadConfirmada == "POR_DETERMINAR")
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-warning fw-bold py-1 px-2" style="font-size:9px;" onclick="actualizarPenalidadRoleoDetalle(@r.Id)">Confirmar Penalidad</button>
                                                    }
                                                    @if (r.DatosNuevosPendientes)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold py-1 px-2" style="font-size:9px;" onclick="confirmarItinerarioRoleoDetalle(@r.Id)">Confirmar Itinerario</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (estRespMar.PendienteTarifa)
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mt-3 mb-0" style="font-size:11px; font-weight:700; border-radius:8px;">
                                <i class="bi bi-lock-fill"></i>
                                <div><strong>Pendiente de asignación de tarifa.</strong> Comercial debe agregar el valor de Flete Marítimo en Acuerdos Operativos para continuar editando esta pestaña.</div>
                            </div>
                        }
                                                <div class="resp-widget">
                            <span class="resp-widget-icon"><i class="bi bi-cash-coin"></i></span>
                            <div class="resp-widget-field">
                                <label>Pagado por</label>
                                <select class="resp-pagado" data-concepto="@estRespMar.ConceptoReal" onchange="guardarResponsabilidadDetalle(@op.Id, this.getAttribute('data-concepto'), this, this.closest('.resp-widget').querySelector('.resp-responsable'))">
                                    <option value="ATILSON" selected="@(estRespMar.PagadoPor == "ATILSON" || estRespMar.PagadoPor == null ? "selected" : null)">Atilson</option>
                                    <option value="AGENCIA" selected="@(estRespMar.PagadoPor == "AGENCIA" ? "selected" : null)">Agencia</option>
                                    <option value="PROVEEDOR" selected="@(estRespMar.PagadoPor == "PROVEEDOR" ? "selected" : null)">Proveedor</option>
                                </select>
                            </div>
                            <i class="bi bi-arrow-right resp-widget-arrow"></i>
                            <div class="resp-widget-field">
                                <label>Responsable</label>
                                <select class="resp-responsable" data-concepto="@estRespMar.ConceptoReal" onchange="guardarResponsabilidadDetalle(@op.Id, this.getAttribute('data-concepto'), this.closest('.resp-widget').querySelector('.resp-pagado'), this)">
                                    <option value="CLIENTE" selected="@(estRespMar.Responsable == "CLIENTE" || estRespMar.Responsable == null ? "selected" : null)">Cliente</option>
                                    <option value="ATILSON" selected="@(estRespMar.Responsable == "ATILSON" ? "selected" : null)">Atilson</option>
                                    <option value="PROVEEDOR" selected="@(estRespMar.Responsable == "PROVEEDOR" ? "selected" : null)">Proveedor</option>
                                    <option value="AGENCIA" selected="@(estRespMar.Responsable == "AGENCIA" ? "selected" : null)">Agencia</option>
                                </select>
                            </div>
                        </div>

                                                <div class="col-12 text-end mt-3 pt-3 border-top edit-only-inline">
                            <button type="button" class="btn btn-sm btn-outline-secondary fw-bold me-2" onclick="cancelEditMode('mar-form-@op.Id')">Cancelar</button>
                            <button type="button" class="btn btn-sm btn-dark fw-bold" onclick="guardarFormularioDetalle(this.closest('form'), this)"><i class="bi bi-save me-1"></i> Guardar Marítimo</button>
                        </div>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(op.Transbordo))
                {
                    var trans = op.GestionTransbordo;
                    var fechaLimiteTrans = AtilsonCargoSpa.Helpers.TransbordoHelpers.FechaLimite(trans);
                    string estadoTrans = AtilsonCargoSpa.Helpers.TransbordoHelpers.EstadoTransbordo(trans);
                    bool resueltoTrans = estadoTrans == "RESUELTO";
                    var estiloTrans = estadoTrans switch
                    {
                        "RESUELTO" => ("#f0fdf4", "#16a34a", "#bbf7d0", "NUEVA NAVE CONFIRMADA"),
                        "VENCIDO" => ("#fef2f2", "#dc2626", "#fecaca", "PLAZO VENCIDO — GESTIONAR AHORA"),
                        "CRITICO" => ("#fff7ed", "#ea580c", "#fed7aa", "PLAZO POR VENCER"),
                        "PENDIENTE" => ("#f0f9ff", "#0284c7", "#bae6fd", "EN TRÁNSITO — GESTIÓN PENDIENTE"),
                        _ => ("#f8fafc", "#64748b", "#e2e8f0", "SIN DATOS DE ARRIBO")
                    };

                    <div class="form-section mt-3 @(estadoTrans == "VENCIDO" ? "row-alert" : "")" style="@(estadoTrans == "VENCIDO" ? "border-color:#fecaca;" : "")">
                        <div class="section-title-sm">
                            <span><i class="bi bi-arrow-left-right me-1"></i> Gestión de Transbordo</span>
                            <span class="fw-bold text-uppercase px-3 py-1 rounded" style="font-size:9px; letter-spacing:.5px; background:@estiloTrans.Item1; color:@estiloTrans.Item2; border:1px solid @estiloTrans.Item3;">@estiloTrans.Item4</span>
                        </div>

                        @if (trans?.FechaArriboTransbordo.HasValue == true && !resueltoTrans)
                        {
                            <div class="alert d-flex align-items-center gap-2 py-2 px-3 mb-3" style="font-size:11px; font-weight:700; border-radius:8px; background:@estiloTrans.Item1; color:@estiloTrans.Item2; border:1px solid @estiloTrans.Item3;">
                                <i class="bi @(estadoTrans == "VENCIDO" ? "bi-exclamation-octagon-fill" : "bi-clock-history")"></i>
                                <div>
                                    @if (fechaLimiteTrans.HasValue)
                                    {
                                        <strong>Fecha límite de gestión: @fechaLimiteTrans.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                                        <span> — @(estadoTrans == "VENCIDO" ? "Ya se superó el plazo otorgado en puerto." : $"Quedan {Math.Max(0, (int)Math.Ceiling((fechaLimiteTrans.Value - DateTime.Now).TotalDays))} día(s) para confirmar la nueva nave.")</span>
                                    }
                                    else
                                    {
                                        <strong>Falta ingresar los días libres para calcular el plazo.</strong>
                                    }
                                </div>
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <form method="post" asp-page-handler="GuardarTransbordo">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="IdOperacion" value="@op.Id" />
                                    <div class="form-subcard h-100">
                                        <div class="form-subcard-title"><i class="bi bi-geo-alt"></i> Arribo y Plazo en Puerto</div>
                                        <div class="mb-2">
                                            <span class="mod-label m-0">Puerto de Transbordo</span>
                                            <div class="fw-bold text-uppercase" style="font-size:13px;">@(op.Transbordo ?? "-")</div>
                                            <span class="text-muted" style="font-size:9px;"><i class="bi bi-pencil me-1"></i>Editable en Servicio Marítimo → Editar → Modalidad de Tránsito.</span>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="mod-label">Fecha Arribo a Puerto</label>
                                                <input type="datetime-local" name="FechaArriboTransbordo" class="form-control erp-input" value="@(trans?.FechaArriboTransbordo?.ToString("yyyy-MM-ddTHH:mm"))" />
                                            </div>
                                            <div class="col-6">
                                                <label class="mod-label">Días Libres Otorgados</label>
                                                <input type="number" name="DiasLibres" class="form-control erp-input fw-bold" value="@trans?.DiasLibres" min="0" placeholder="Ej: 7" />
                                            </div>
                                        </div>
                                        <div class="text-end mt-3">
                                            <button type="button" class="btn btn-dark btn-sm fw-bold px-3" onclick="guardarFormularioDetalle(this.closest('form'), this)"><i class="bi bi-save me-1"></i> Guardar Plazo</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <form method="post" asp-page-handler="ConfirmarNuevaNaveTransbordo">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="IdOperacion" value="@op.Id" />
                                    <input type="hidden" name="SincronizarEtaOperacion" value="true" />
                                    <div class="form-subcard h-100" style="background:@(resueltoTrans ? "#f0fdf4" : "var(--bg-soft)"); border-color:@(resueltoTrans ? "#bbf7d0" : "var(--border-soft)");">
                                        <div class="form-subcard-title"><i class="bi bi-ship"></i> Nueva Nave Confirmada</div>
                                        <div class="row g-2">
                                            <div class="col-12">
                                                <label class="mod-label">Nave / Viaje</label>
                                                <input type="text" name="NuevaNaveConfirmada" class="form-control erp-input text-uppercase fw-bold" value="@trans?.NuevaNaveConfirmada" placeholder="Pendiente de confirmar..." />
                                            </div>
                                            <div class="col-6">
                                                <label class="mod-label text-success">Nuevo ETD (desde Transbordo)</label>
                                                <input type="datetime-local" name="NuevoEtdTransbordo" class="form-control erp-input" value="@(trans?.NuevoEtdTransbordo?.ToString("yyyy-MM-ddTHH:mm"))" />
                                            </div>
                                            <div class="col-6">
                                                <label class="mod-label text-success">Nuevo ETA Destino Final</label>
                                                <input type="datetime-local" name="NuevoEtaDestinoFinal" class="form-control erp-input" value="@(trans?.NuevoEtaDestinoFinal?.ToString("yyyy-MM-ddTHH:mm"))" />
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <span class="text-muted" style="font-size:9px;"><i class="bi bi-info-circle me-1"></i>Actualiza el ETA del booking.</span>
                                            <button type="button" class="btn btn-dark btn-sm fw-bold px-3" onclick="guardarFormularioDetalle(this.closest('form'), this)"><i class="bi bi-check2-circle me-1"></i> Confirmar Nave</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                <form method="post" asp-page-handler="UpdateMatriz" id="form-matriz-bl" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdOperacion" value="@op.Id" />
                    <div class="form-section">
                        <div class="section-title-sm"><span>Gestión de Matriz y B/L</span></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-subcard">
                                    <div class="form-subcard-title"><i class="bi bi-file-earmark-text"></i> Gestión de Matriz</div>
                                    <label class="status-toggle-row">
                                        <input class="cuadradito-check" type="checkbox" name="MatrizPresentada" value="true" @(matrizOk ? "checked" : "") />
                                        <span>Matriz Confirmada</span>
                                    </label>
