                    @if (Model.ReqDocumental)
                    {
                        <li class="nav-item"><button class="nav-link py-1 px-3" data-bs-toggle="pill" data-bs-target="#hist-det-documental" type="button" style="font-size:10px; font-weight:800; background:#f1f5f9; color:#7e22ce; border:1px solid #e9d5ff; border-radius:6px;"><i class="bi bi-file-earmark-check me-1"></i> Documental</button></li>
                    }
                </ul>

                <div class="tab-content" style="max-height:500px; overflow-y:auto;">
                    <div class="tab-pane fade show active" id="hist-det-todas">
                        @if (!lineasHistorialDet.Any())
                        {
                            <div class="text-center p-5 rounded border" style="background:var(--bg-soft);">
                                <i class="bi bi-clock-history text-muted opacity-25" style="font-size:3rem;"></i>
