                                <div class="px-1">@foreach (var l in linesTerDet) { @Html.Raw(RenderLineaDetalle(l)) }</div>
                            }
                        </div>
                    }

                    @if (Model.ReqDocumental)
                    {
                        <div class="tab-pane fade" id="hist-det-documental">
                            @{ var linesDocDet = lineasHistorialDet.Where(l => { var pp = l.Split('|'); return pp.Length >= 3 && pp[2].ToUpper() == "DOCUMENTAL"; }).ToList(); }
                            @if (!linesDocDet.Any())
