                                    <option value="IN/OUT" selected="@(opGate.TipoGate == "IN/OUT")">Gate IN y Gate OUT</option>
                                    <option value="IN" selected="@(opGate.TipoGate == "IN")">Solo Gate IN</option>
                                    <option value="OUT" selected="@(opGate.TipoGate == "OUT")">Solo Gate OUT</option>
                                </select>
                            </div>
