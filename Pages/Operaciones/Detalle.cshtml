        .GroupBy(x => x.IdUnidadTecnica ?? 0)
        .ToDictionary(g => g.Key, g => g.OrderBy(x => x.Id).First());
    var t = terrPorUnidad.TryGetValue(0, out var tMainDet) ? tMainDet : null;

    var contenedoresTerDet = new List<(string Suffix, string Label, int? IdUnidad, AtilsonCargoSpa.Models.OperacionesTerrestre? TerrRow)>();
    contenedoresTerDet.Add((opTer.Id.ToString(), "Contenedor Principal", (int?)null, t));
    if (opTer.Unidadestecnicas != null)
    {
        foreach (var uTerDet in opTer.Unidadestecnicas)
        {
            var terrUnidadDet = terrPorUnidad.TryGetValue(uTerDet.Id, out var tUVDet) ? tUVDet : null;
            string labelUTerDet = string.IsNullOrWhiteSpace(uTerDet.NroContenedor) ? ("Contenedor U" + uTerDet.Id) : uTerDet.NroContenedor;
            contenedoresTerDet.Add(("u" + uTerDet.Id, labelUTerDet, uTerDet.Id, terrUnidadDet));
        }
