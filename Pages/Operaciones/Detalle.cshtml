    window.abrirHistorial = function(btn) {
        const booking = btn.getAttribute('data-booking'); const comentariosBrutos = btn.getAttribute('data-comentarios');
        document.getElementById('historialBookingRef').innerText = booking; const body = document.getElementById('historialCuerpo'); body.innerHTML = '';
        if (!comentariosBrutos || comentariosBrutos.trim() === '') {
            body.innerHTML = '<div class="text-center text-muted p-5"><i class="bi bi-inboxes fs-1 opacity-50 mb-2 d-block"></i><span class="fw-bold" style="font-size:12px;">Sin registros</span><p style="font-size:10px;">Esta operación aún no tiene eventos en su historial.</p></div>';
        } else {
            const lineas = comentariosBrutos.split('\n').filter(l => l.trim() !== ''); let html = '<div class="timeline-atilson">'; const regex = /\[(\d{2}\/\d{2}\/\d{4}\s\d{2}:\d{2})\s+(\w+)\]\s+(.*)/;
            lineas.forEach(linea => {
                let match = linea.match(regex);
                if(match) {
                    let fecha = match[1]; let autor = match[2].toUpperCase(); let mensaje = match[3];
                    let colorStr = 'secondary'; let bgBadge = '#e2e8f0';
                    if (autor.includes('FINANZAS')) { colorStr = 'success'; bgBadge = '#10b981'; } else if (autor.includes('OPERACIONES')) { colorStr = 'primary'; bgBadge = '#3b82f6'; }
                    html += `<div class="timeline-item"><div class="timeline-badge" style="background-color: ${bgBadge};"></div><div class="timeline-content"><div class="d-flex justify-content-between align-items-center mb-1"><span class="badge bg-${colorStr} bg-opacity-10 text-${colorStr} border border-${colorStr}" style="font-size:8px; letter-spacing:0.5px;"><i class="bi bi-person-fill me-1"></i> ${autor}</span><span class="text-muted fw-bold" style="font-size:9px;">${fecha}</span></div><p class="mb-0 fw-bold text-dark" style="font-size:11px; line-height:1.4;">${mensaje}</p></div></div>`;
                } else {
                    html += `<div class="timeline-item"><div class="timeline-badge bg-secondary"></div><div class="timeline-content"><p class="mb-0 text-muted" style="font-size:11px;">${linea}</p></div></div>`;
                }
            });
            html += '</div>'; body.innerHTML = html;
        }
        new bootstrap.Modal(document.getElementById('modalHistorial')).show();
    };

    window.cancelarInterplanta = function(idOp) {
    // 1. Desactivamos el switch visualmente
    let chk = document.getElementById('chkInterplanta-' + idOp);
    if (chk) chk.checked = false;

    // 2. Ocultamos la caja de interplanta y vaciamos los campos
    let box = document.getElementById('interplanta-box-' + idOp);
    if(box) {
        box.style.display = 'none';

        // Vaciamos los selects y gatillamos el "change" para evitar cruces con el motor de rutas
        box.querySelectorAll('select').forEach(s => { 
            s.value = ''; 
