                                </form>

                        @{
                            // Correcciones de BL registradas (cada una es un extracosto Marítimo con su costo).
                            var correccionesBlDet = AtilsonCargoSpa.Helpers.CorreccionBlHelper.Listar(op);
                            int siguienteCorrBlDet = AtilsonCargoSpa.Helpers.CorreccionBlHelper.SiguienteNumero(op);
                            var sugCorrBlDet = Model.SugerenciaCorreccionBl;
                            string motivosUltimaCorrBlDet = correccionesBlDet.Any()
                                ? string.Join(", ", AtilsonCargoSpa.Helpers.CorreccionBlHelper.Leer(correccionesBlDet.Last().Motivo).Motivos)
                                : (AtilsonCargoSpa.Helpers.EmisionBlHelper.NormalizarMotivo(op.TipoCorreccionBl) ?? "");
                            // Registros de antes de oct-2026 (solo hito en el historial, sin costo).
                            var historialCorrBlDet = (op.HistorialCorreos ?? "")
                                .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                                .Select(l => l.Split('|'))
                                .Where(pp => pp.Length >= 4 && pp[2].ToUpper() == "MARITIMO" && string.Join("|", pp.Skip(3)).StartsWith(AtilsonCargoSpa.Pages.Operaciones.DetalleModel.PrefijoHitoCorreccionBl))
                                .Take(10)
                                .ToList();
                            var vmCorrEmision = new AtilsonCargoSpa.Models.EmisionBlCamposVm
                            {
                                IdPrefijo = $"embl-corr-{op.Id}",
                                CampoTipo = "CorreccionTipoEmisionBl",
                                CampoOtro = "CorreccionTipoEmisionBlOtro",
                                CampoLugar = "CorreccionLugarEmision",
                                Tipo = null,
                                ExcluirTipo = tipoEmisionDet,
                                TipoObligatorio = true,
                                TituloTipo = "Nuevo tipo de emisión",
                                TituloLugar = "Lugar de emisión",
                                Deshabilitado = true
                            };
                            var vmCorrLugar = new AtilsonCargoSpa.Models.EmisionBlCamposVm
                            {
                                IdPrefijo = $"embl-corr-lugar-{op.Id}",
                                CampoLugar = "CorreccionLugarEmision",
                                Lugar = null,
                                ExcluirLugar = op.UbicacionOriginalesDestino,
                                SoloLugar = true,
                                TituloLugar = "Nuevo lugar de emisión",
                                Deshabilitado = true
                            };
                            var clCorr = System.Globalization.CultureInfo.GetCultureInfo("es-CL");
                            string monedaSugCorr = sugCorrBlDet?.Moneda ?? "USD";
                            string montoSugCorr = sugCorrBlDet != null ? sugCorrBlDet.Monto.ToString(monedaSugCorr == "CLP" ? "0" : "0.##", System.Globalization.CultureInfo.InvariantCulture) : "";
                        }
                        <form method="post" asp-page-handler="RegistrarCorreccionBl" id="form-correccion-bl-@op.Id" class="mt-3" enctype="multipart/form-data">
                            <input type="hidden" name="IdOperacion" value="@op.Id" />
                        <div class="form-subcard" id="correccion-bl-form-@op.Id" data-ultimo-motivo="@motivosUltimaCorrBlDet" data-siguiente="@AtilsonCargoSpa.Helpers.CorreccionBlHelper.Ordinal(siguienteCorrBlDet)">
                            <div class="form-subcard-title d-flex align-items-center gap-2">
                                <span><i class="bi bi-pencil-square"></i> Corrección de BL</span>
                                @if (correccionesBlDet.Any())
                                {
                                    <span class="corr-bl-count">@correccionesBlDet.Count @(correccionesBlDet.Count == 1 ? "corrección" : "correcciones")</span>
                                }
                            </div>

                            @if (correccionesBlDet.Any())
                            {
                                <div class="corr-bl-lista">
                                    @foreach (var cBl in correccionesBlDet)
                                    {
                                        var detBl = AtilsonCargoSpa.Helpers.CorreccionBlHelper.Leer(cBl.Motivo);
                                        int numBl = AtilsonCargoSpa.Helpers.CorreccionBlHelper.Numero(cBl) ?? (correccionesBlDet.IndexOf(cBl) + 1);
                                        bool tieneEvidBl = !string.IsNullOrWhiteSpace(cBl.Evidencia) && cBl.Evidencia.StartsWith("/");
                                        <div class="corr-bl-card">
                                            <div class="corr-bl-card__head">
                                                <span class="corr-bl-card__num">@numBl</span>
                                                <div class="corr-bl-card__titulo">
                                                    <strong>@AtilsonCargoSpa.Helpers.CorreccionBlHelper.Ordinal(numBl)</strong>
                                                    <span class="corr-bl-card__meta"><i class="bi bi-calendar3"></i> @cBl.FechaCreacion.ToString("dd/MM/yyyy") <i class="bi bi-clock ms-1"></i> @cBl.FechaCreacion.ToString("HH:mm") <i class="bi bi-person ms-1"></i> @cBl.UsuarioCreador</span>
                                                </div>
                                                <span class="corr-bl-card__costo @(cBl.Monto > 0 ? "" : "is-pend")" title="Línea EXT-@cBl.Id en Control Financiero (Marítimo)">
                                                    @(cBl.Monto > 0 ? $"{AtilsonCargoSpa.Helpers.CorreccionBlHelper.FormatearMonto(cBl.Monto, cBl.Moneda)} + IVA" : "Costo por valorizar")
                                                </span>
                                            </div>
                                            <div class="corr-bl-card__motivos">
                                                @foreach (var mBl in detBl.Motivos)
                                                {
                                                    <span class="corr-bl-chip">@mBl</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(detBl.Cambio))
                                            {
                                                <div class="corr-bl-card__linea"><span>Cambio:</span> @detBl.Cambio</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(detBl.Observacion))
                                            {
                                                <div class="corr-bl-card__linea"><span>Obs:</span> @detBl.Observacion</div>
                                            }
                                            <div class="corr-bl-card__pie">
                                                <span>EXT-@cBl.Id · en Control Financiero</span>
                                                @if (tieneEvidBl)
                                                {
                                                    <a href="@cBl.Evidencia" target="_blank"><i class="bi bi-paperclip me-1"></i>Evidencia</a>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="corr-bl-vacio">Aún no hay correcciones registradas para este B/L.</div>
                            }

                            @if (historialCorrBlDet.Any())
                            {
                                <details class="corr-bl-hist mt-2">
                                    <summary class="mod-label m-0"><i class="bi bi-chevron-right corr-bl-hist__chev"></i> Registros anteriores (@historialCorrBlDet.Count) — sin costo asociado</summary>
                                    @foreach (var hc in historialCorrBlDet)
                                    {
                                        string descHc = string.Join("|", hc.Skip(3)).Substring(AtilsonCargoSpa.Pages.Operaciones.DetalleModel.PrefijoHitoCorreccionBl.Length);
                                        <div class="corr-bl-hist__item">
                                            <strong>@descHc</strong>
                                            <div class="corr-bl-hist__meta">@hc[1] — @hc[0]</div>
                                        </div>
                                    }
                                </details>
                            }

                            <div id="corr-bl-nueva-@op.Id" class="corr-bl-nueva d-none">
                                <div class="corr-bl-nueva__titulo"><i class="bi bi-plus-circle me-1"></i> @AtilsonCargoSpa.Helpers.CorreccionBlHelper.Ordinal(siguienteCorrBlDet)</div>

                                <label class="mod-label">Motivos de la corrección <span class="text-danger">*</span> <span class="embl-hint ms-1">puedes marcar más de uno</span></label>
                                <div class="corr-bl-motivos" id="corr-bl-motivos-@op.Id">
                                    @foreach (var motivoBl in AtilsonCargoSpa.Helpers.EmisionBlHelper.MotivosCorreccion)
                                    {
                                        bool esMotivoLugar = motivoBl == AtilsonCargoSpa.Helpers.EmisionBlHelper.MotivoCambioLugar;
                                        bool bloqueadoBl = esMotivoLugar && !esOriginalesDet;
                                        <label class="corr-bl-motivo @(bloqueadoBl ? "is-off" : "")" title="@(bloqueadoBl ? "Solo aplica cuando la emisión es Originales" : "")">
                                            <input type="checkbox" class="cuadradito-check" name="MotivosCorreccionBl" value="@motivoBl" data-motivo="@motivoBl" disabled="@bloqueadoBl" onchange="toggleMotivosCorreccionBlDet(@op.Id, this)" />
                                            <span>@motivoBl@(bloqueadoBl ? " (solo con Originales)" : "")</span>
                                        </label>
                                    }
                                </div>
                                <span class="embl-hint d-block mt-1">"Cambio emisión" y "Cambio lugar de emisión" actualizan también la Matriz, la sección Documental y Finanzas al guardar (se marca uno u otro: el cambio de lugar es para Originales).</span>

                                <div id="wrapCorrEmision-@op.Id" class="mt-3 pt-3 d-none" style="border-top:1px dashed var(--border-soft);">
                                    <partial name="_EmisionBlCampos" model="vmCorrEmision" />
                                </div>
                                <div id="wrapCorrLugar-@op.Id" class="mt-3 pt-3 d-none" style="border-top:1px dashed var(--border-soft);">
                                    <div class="embl-hint mb-2">Lugar actual: <strong>@(op.UbicacionOriginalesDestino ?? "sin definir")</strong></div>
                                    <partial name="_EmisionBlCampos" model="vmCorrLugar" />
                                </div>

                                <div class="row g-3 mt-1">
                                    <div class="col-md-12">
                                        <label class="mod-label" id="lblObsCorrBl-@op.Id" for="obsCorrBl-@op.Id">Comentario (opcional)</label>
                                        <textarea name="CorreccionBlComentario" id="obsCorrBl-@op.Id" class="form-control erp-input" rows="2" maxlength="400" placeholder="Detalle de la corrección..."></textarea>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="mod-label">Costo naviera (neto) <span class="embl-hint ms-1">+ IVA en Finanzas</span></label>
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="MontoCorreccionBl" id="montoCorrBl-@op.Id" class="form-control erp-input" min="0" step="0.01" value="@montoSugCorr" placeholder="Por valorizar" />
                                            <select name="MonedaCorreccionBl" id="monedaCorrBl-@op.Id" class="form-select erp-input" style="max-width:90px;">
                                                <option value="USD" selected="@(monedaSugCorr != "CLP")">USD</option>
                                                <option value="CLP" selected="@(monedaSugCorr == "CLP")">CLP</option>
                                            </select>
                                        </div>
                                        <span class="embl-hint d-block mt-1">@(sugCorrBlDet != null ? sugCorrBlDet.NotaCatalogo : "Sin tarifa de corrección en el catálogo de la naviera: si lo dejas vacío queda por valorizar en Finanzas.")</span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="mod-label">Evidencia / Referencia</label>
                                        <input type="file" name="EvidenciaCorreccionBl" class="erp-input py-1" accept=".pdf,.jpg,.jpeg,.png" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <button type="button" class="btn btn-sm btn-light border fw-bold" onclick="cancelarNuevaCorreccionBlDet(@op.Id)">Cancelar</button>
                                    <button type="button" class="btn btn-sm btn-dark fw-bold px-3" id="btn-guardar-corr-bl-@op.Id" onclick="guardarCorreccionBlDet(this, @op.Id)"><i class="bi bi-check2-circle me-1"></i> Guardar corrección</button>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-2 border-top">
                                <button type="button" class="btn btn-sm btn-dark fw-bold" id="btn-nueva-corr-bl-@op.Id" onclick="abrirNuevaCorreccionBlDet(@op.Id)">
                                    <i class="bi bi-plus-lg me-1"></i> @(correccionesBlDet.Any() ? "Solicitar nueva corrección" : "Solicitar corrección")
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-dark fw-bold" onclick="abrirModalCorreccionBlNaviera(@op.Id, '@op.NumeroBooking')">
                                    <i class="bi bi-envelope-arrow-up me-1"></i> Solicitar Instructivo/Comprobante a Naviera
                                </button>
                            </div>
                        </div>
                        </form>
                            </div>
                            </div>
                        </div>
                    </div>
            </div>
        }

        @if (Model.ReqMaritimo)
        {
            <div class="tab-pane fade" id="det-lar" role="tabpanel">
                @{
                    var contenedoresLarDet = new List<(string Suffix, string Label, int? IdUnidad, string? EstadoLar, DateTime? LateArrival, DateTime? ElarDate, bool ContenedorIngresado, string ValLlegadaPuerto)>();
                    var terrPrincipalLar = Model.Op.OperacionesTerrestres.FirstOrDefault(x => x.IdUnidadTecnica == null);
                    string valLlegadaPuertoPrincipalLar = (terrPrincipalLar != null && Convert.ToDateTime(terrPrincipalLar.LlegadaPuerto).Year > 2000) ? Convert.ToDateTime(terrPrincipalLar.LlegadaPuerto).ToString("yyyy-MM-ddTHH:mm") : "";
                    contenedoresLarDet.Add((Model.Op.Id.ToString(), AtilsonCargoSpa.Helpers.ContenedorEtiquetaHelper.Etiqueta(Model.Op.NumeroContenedor, 1), (int?)null, Model.Op.EstadoLar, Model.Op.LateArrival, Model.Op.ElarDate, Model.Op.ContenedorIngresado, valLlegadaPuertoPrincipalLar));
                    if (Model.Op.Unidadestecnicas != null)
                    {
                        foreach (var uLarDet in Model.Op.Unidadestecnicas.OrderBy(x => x.Id))
                        {
                            var tULarDet = Model.Op.OperacionesTerrestres.FirstOrDefault(x => x.IdUnidadTecnica == uLarDet.Id);
                            string valLlegadaPuertoULarDet = (tULarDet != null && Convert.ToDateTime(tULarDet.LlegadaPuerto).Year > 2000) ? Convert.ToDateTime(tULarDet.LlegadaPuerto).ToString("yyyy-MM-ddTHH:mm") : "";
                            string labelULarDet = AtilsonCargoSpa.Helpers.ContenedorEtiquetaHelper.Etiqueta(uLarDet.NroContenedor, contenedoresLarDet.Count + 1);
                            contenedoresLarDet.Add(("u" + uLarDet.Id, labelULarDet, uLarDet.Id, uLarDet.EstadoLar, uLarDet.LateArrival, uLarDet.ElarDate, uLarDet.ContenedorIngresado, valLlegadaPuertoULarDet));
                        }
                    }
                    bool multiLarDet = contenedoresLarDet.Count > 1;
                }

                @if (multiLarDet)
                {
                    <ul class="nav container-subtabs" role="tablist">
                        @for (int iLarDet = 0; iLarDet < contenedoresLarDet.Count; iLarDet++)
                        {
                            var cNavLarDet = contenedoresLarDet[iLarDet];
                            <li class="nav-item">
                                <button class="nav-link @(iLarDet == 0 ? "active" : "")" data-bs-toggle="pill" data-bs-target="#lar-cont-det-@cNavLarDet.Suffix" type="button">
                                    <i class="bi bi-box"></i>@cNavLarDet.Label
                                </button>
                            </li>
                        }
                    </ul>
                    <p class="container-subtabs-hint"><i class="bi bi-info-circle me-1"></i>Cada contenedor gestiona su propio LAR/ELAR de forma independiente.</p>
                }

                <div class="tab-content">
                    @for (int jLarDet = 0; jLarDet < contenedoresLarDet.Count; jLarDet++)
                    {
                        var cLarDet = contenedoresLarDet[jLarDet];
                        <div class="tab-pane fade @(jLarDet == 0 ? "show active" : "")" id="lar-cont-det-@cLarDet.Suffix">
                            <form method="post" asp-page-handler="UpdateLar" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="IdOperacion" value="@Model.Op.Id" />
                                @if (cLarDet.IdUnidad.HasValue)
                                {
                                    <input type="hidden" name="IdUnidadTecnica" value="@cLarDet.IdUnidad" />
                                }
                                <input type="hidden" name="ContenedorIngresado" id="hidden-ingresado-det-@cLarDet.Suffix" value="@(cLarDet.ContenedorIngresado ? "true" : "false")" />
                                <div class="form-section">
                                    <div class="section-title-sm"><span>Gestión Late Arrival (LAR / ELAR)@(multiLarDet ? $" — {cLarDet.Label}" : "")</span></div>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="form-subcard">
                                                <div class="form-subcard-title"><i class="bi bi-check-circle"></i> Estado Operativo</div>
                                                <label class="mod-label">Estado LAR</label>
                                                <select name="EstadoLar" class="form-select erp-input py-1 mb-3" onchange="syncEstadoLarConFecha(this, 'det-@cLarDet.Suffix')">
                                                    <option value="">No Solicitado</option>
                                                    <option value="SOLICITADO LAR" selected="@(cLarDet.EstadoLar == "SOLICITADO LAR" ? "selected" : null)">Solicitado LAR</option>
                                                    <option value="AUTORIZADO LAR" selected="@(cLarDet.EstadoLar == "AUTORIZADO LAR" ? "selected" : null)">Autorizado LAR</option>
                                                    <option value="INGRESADO CON LAR" selected="@(cLarDet.EstadoLar == "INGRESADO CON LAR" ? "selected" : null)">Ingresado con LAR</option>
                                                    <option value="V°B° Ingresado a puerto" selected="@(cLarDet.EstadoLar == "V°B° Ingresado a puerto" ? "selected" : null)">V°B° Ingresado a puerto</option>
                                                </select>
                                                <label class="mod-label text-primary">Fecha/Hora Ingreso Real</label>
                                                <input type="datetime-local" name="LlegadaPuertoReal" value="@(cLarDet.ValLlegadaPuerto)" class="form-control erp-input py-1" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-subcard" style="background:#fef8f8; border-color:#fde2e2;">
                                                <div class="form-subcard-title" style="border-color:#fde2e2;"><i class="bi bi-clock-history" style="color:#dc2626;"></i> Ventana de Extensión</div>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label class="mod-label text-danger">Inicio (LAR)</label>
                                                        <input type="datetime-local" name="LateArrival" value="@(cLarDet.LateArrival?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control erp-input py-1" style="background:#fff;" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="mod-label text-danger">Término (ELAR)</label>
                                                        <input type="datetime-local" name="ElarDate" value="@(cLarDet.ElarDate?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control erp-input py-1 border-danger" style="background:#fff;" />
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="mod-label text-danger">Respaldo Autorización</label>
                                                        <input type="file" name="EvidenciaLar" class="form-control erp-input py-1" style="background:#fff;" accept=".pdf, .jpg, .png" @(string.IsNullOrEmpty(cLarDet.EstadoLar) ? "required" : "") />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 text-end mt-3 pt-3 border-top">
                                        <button type="button" class="btn btn-dark btn-sm fw-bold px-5" onclick="guardarFormularioDetalle(this.closest('form'), this)">Guardar LAR/ELAR@(multiLarDet ? $" — {cLarDet.Label}" : "")</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }

        @{
            var estRespGateOut = Model.ObtenerEstadoConcepto(Model.Op, "Gate OUT Contenedor");
            var estRespGateIn = Model.ObtenerEstadoConcepto(Model.Op, "Gate IN Contenedor");
            bool gatePendiente = estRespGateOut.PendienteTarifa || estRespGateIn.PendienteTarifa;
            var opGate = Model.Op;
            var costoGateOut = Model.EstadoCostoGateOut(opGate);
        }
        <div class="tab-pane fade @(!Model.ReqMaritimo ? "show active" : "")" id="det-gate" role="tabpanel">
            <form method="post" asp-page-handler="UpdateGate" id="form-gate">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdOperacion" value="@opGate.Id" />
                @if (opGate.GateBloqueado)
                {
                    <div class="alert alert-secondary d-flex align-items-center justify-content-between gap-2 py-2 px-3 mb-2" style="font-size:11px; font-weight:700; border-radius:8px;">
                        <span><i class="bi bi-lock-fill me-1"></i> Gate guardado y bloqueado. Solo Finanzas puede levantar el bloqueo.</span>
                    </div>
                }
                <fieldset @(opGate.GateBloqueado ? "disabled" : "")>
                    <div class="form-section">
                        <div class="section-title-sm">
                            <span>
                                Gestión Gate Out - Gate In
                                @if (gatePendiente)
                                {
                                    <i class="bi bi-exclamation-octagon dt-tarifa-ico" data-tarifa-detalle="Gate" title="Pendiente de asignación de tarifa. Comercial debe agregar el valor de Gate en Acuerdos Operativos."></i>
                                }
                            </span>
                        </div>
                        <div class="dt-gate-costo dt-gate-costo--@costoGateOut.Clase" role="status" title="Indicador informativo: se calcula con las tarifas de Gate y no se edita aquí">
                            <i class="bi @(costoGateOut.Clase switch { "con" => "bi-cash-coin", "sin" => "bi-check2-circle", "pend" => "bi-hourglass-split", _ => "bi-dash-circle" })"></i>
                            <div><b>@costoGateOut.Titulo</b><span>@costoGateOut.Detalle</span></div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="mod-label">Tipo de Movimiento</label>
                                <select class="form-select erp-input fw-bold" name="TipoGate">
