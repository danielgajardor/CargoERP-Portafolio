                                    @if (!depositoMarEnLista)
                                    {
                                        <option value="@depositoMarDet" selected>@depositoMarDet</option>
                                    }
                                    @foreach (var dep in depositosMarDet)
                                    {
                                        <option value="@dep.NombreDeposito" selected="@(string.Equals(dep.NombreDeposito, depositoMarDet, StringComparison.OrdinalIgnoreCase))">@dep.NombreDeposito</option>
                                    }
                                </select>
                                <span class="d-block mt-1" style="font-size:10px; color:#94a3b8;"><i class="bi bi-info-circle me-1"></i>Define la tarifa del Gate del depósito@(Model.ReqTerrestre ? " y se replica en Terrestre" : "").</span>
                            </div>
                        </div>

                        <div class="op-route-edit">
