/* Anillo de progreso por pestaña — se llena en sentido horario a medida que
   se completan los campos requeridos; al 100% queda verde sólido con check. */
.tab-progress-ring {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: conic-gradient(#10b981 calc(var(--pct, 0) * 1%), #e2e8f0 0);
    position: relative;
    display: inline-block;
    margin-right: 6px;
    vertical-align: middle;
    transition: background 0.35s ease;
    flex-shrink: 0;
}
.tab-progress-ring::after {
    content: '';
    position: absolute;
    inset: 2.5px;
    background: #fff;
    border-radius: 50%;
    transition: background 0.35s ease;
}
.tab-progress-ring[data-complete="true"] {
    background: #10b981;
}
.tab-progress-ring[data-complete="true"]::after {
    content: '\2713';
    inset: 0;
    background: transparent;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 900;
}


