                <div class="tab-pane fade" id="det-extracostos" role="tabpanel">
            <div class="form-section">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h6 class="m-0 fw-bold text-dark" style="font-size:12px;"><i class="bi bi-wallet2 me-1 text-danger"></i> Control de Extracostos</h6>
                    <button type="button" class="btn btn-sm btn-danger fw-bold shadow-sm" onclick="abrirModalExtracostosDetalle(@Model.Op.Id, '@Model.Op.NumeroBooking', @Model.Op.IdNaviera)"><i class="bi bi-plus-lg me-1"></i> Añadir Extracosto</button>
                </div>

                @if (Model.Op.ExtracostosOperacions != null && Model.Op.ExtracostosOperacions.Any())
                {
                    <div class="table-responsive rounded border bg-white shadow-sm">
                        <table class="table table-hover table-bordered table-striped m-0" style="font-size: 11px;">
                            <thead class="bg-light">
                                <tr class="text-uppercase" style="color:#64748b; font-size:9px; letter-spacing:0.5px;">
                                    <th class="ps-3 py-2 text-center" style="width:12%;">FECHA</th>
                                    <th class="py-2 text-center" style="width:10%;">REPORTE</th>
                                    <th class="py-2 text-start" style="width:20%;">CATEGORÍA</th>
                                    <th class="py-2 text-start" style="width:30%;">DETALLES / OBSERVACIONES</th>
                                    <th class="py-2 text-center" style="width:14%;">PAGO</th>
                                    <th class="py-2 text-center pe-3" style="width:14%;">RESPALDO</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ec in Model.Op.ExtracostosOperacions.OrderByDescending(c => c.FechaCreacion))
                                {
                                    <tr>
                                        <td class="align-middle text-center text-muted fw-bold ps-3">@ec.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="align-middle text-center text-primary fw-bold" style="font-size:10px;">EXT-@ec.Id</td>
                                        <td class="align-middle text-start fw-bold text-dark" style="font-size:10px; text-transform:uppercase;">@ec.TipoCosto</td>
                                        <td class="align-middle text-start text-muted" style="white-space:normal; line-height:1.4; font-size:10px;">@(string.IsNullOrEmpty(ec.Motivo) ? "Sin detalles registrados." : ec.Motivo)</td>
                                        <td class="align-middle text-center">
                                            @if (string.IsNullOrEmpty(ec.Responsable))
                                            {
                                                <span class="text-muted" style="font-size:9px;">Sin definir</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-dark bg-opacity-10 text-dark border" style="font-size:9px;">@ec.Responsable.ToUpper()</span>
                                            }
                                        </td>
                                        <td class="align-middle text-center pe-3">
                                            @if (!string.IsNullOrEmpty(ec.Evidencia) && ec.Evidencia != "Generado por sistema interno" && !ec.Evidencia.Contains("Generado autom"))
                                            {
                                                <a href="@ec.Evidencia" target="_blank" class="btn btn-outline-danger btn-sm py-1 px-2 fw-bold" style="font-size:10px;"><i class="bi bi-paperclip"></i> Ver Doc</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted fw-bold" style="font-size:9px; font-style:italic;">Sin Respaldo</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 rounded border border-light mt-2" style="background:var(--bg-soft);">
                        <i class="bi bi-check-circle-fill text-success" style="font-size:24px; opacity:0.8;"></i>
                        <p class="mb-0 fw-bold mt-1 text-dark" style="font-size:11px;">Operación Limpia</p>
                        <span class="text-muted" style="font-size:11px;">No hay reportes de extracostos asociados a esta operación.</span>
                    </div>
                }
            </div>
        </div>
                @{
            var lineasHistorialDet = string.IsNullOrEmpty(Model.Op.HistorialCorreos)
                ? new List<string>()
                : Model.Op.HistorialCorreos.Split('\n', StringSplitOptions.RemoveEmptyEntries).ToList();

            string RenderLineaDetalle(string linea)
            {
                var p = linea.Split('|');
                if (p.Length < 4) return "";
                string fecha = p[0];
                // usuario/desc pueden contener texto libre (nombres, comentarios, campo Transbordo, etc.);
                // usuario/desc pueden ser lista desplegable tambien 
                // se HTML-encodean porque esto se renderiza con @Html.Raw (XSS almacenado).
                string usuario = System.Net.WebUtility.HtmlEncode(p[1]);
                string modulo = p[2].ToUpper();
                // La descripción puede traer "|" propios (ej. "Presentada: ✓ | B/L: X"): se une el resto.
                string desc = System.Net.WebUtility.HtmlEncode(string.Join("|", p.Skip(3)));
                string color = modulo switch { "MARITIMO" => "#0284c7", "TRANSPORTE" => "#16a34a", "DOCUMENTAL" => "#7e22ce", _ => "#475569" };
                string bgColor = modulo switch { "MARITIMO" => "#f0f9ff", "TRANSPORTE" => "#f0fdf4", "DOCUMENTAL" => "#faf5ff", _ => "var(--bg-soft)" };
                string icon = modulo switch { "MARITIMO" => "bi-water", "TRANSPORTE" => "bi-truck", "DOCUMENTAL" => "bi-file-earmark-check", _ => "bi-grid" };
                return $@"<div class='d-flex align-items-start mb-2 p-2 rounded' style='background-color:{bgColor}; border-left:3px solid {color};'>
                    <div class='me-2 mt-1'><i class='bi {icon}' style='color:{color}; font-size:14px;'></i></div>
                    <div class='flex-grow-1 ps-1'>
                        <div style='font-size:11px; line-height:1.4; color:#0f172a; font-weight:500;'>{desc}</div>
                        <div class='d-flex justify-content-between align-items-center mt-1'>
                            <span style='font-size:9px; color:#64748b;'><i class='bi bi-person-fill me-1'></i>{usuario}</span>
                            <span style='font-size:9px; font-weight:600; color:{color}; opacity:0.8;'>{fecha}</span>
                        </div>
                    </div>
                </div>";
            }
        }
        <div class="tab-pane fade" id="det-historial" role="tabpanel">
            <div class="form-section">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-secondary"></i>Historial de Actividad</h6>
                    <span class="badge bg-dark bg-opacity-10 text-dark border">BKG: @(Model.Op.NumeroBooking ?? "S/N")</span>
                </div>

                <ul class="nav nav-pills mb-3 gap-1" id="historialTabsDet" role="tablist" style="flex-wrap:wrap;">
                    <li class="nav-item"><button class="nav-link active py-1 px-3" data-bs-toggle="pill" data-bs-target="#hist-det-todas" type="button" style="font-size:10px; font-weight:800; background:#f1f5f9; color:#475569; border:1px solid var(--border-soft); border-radius:6px;"><i class="bi bi-list-ul me-1"></i> Todas</button></li>
                    <li class="nav-item"><button class="nav-link py-1 px-3" data-bs-toggle="pill" data-bs-target="#hist-det-general" type="button" style="font-size:10px; font-weight:800; background:#f1f5f9; color:#475569; border:1px solid var(--border-soft); border-radius:6px;"><i class="bi bi-grid me-1"></i> General</button></li>
                    @if (Model.ReqMaritimo)
                    {
