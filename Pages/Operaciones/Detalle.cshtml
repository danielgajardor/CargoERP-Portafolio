    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/traspaso-finanzas.js" asp-append-version="true"></script>
    <script src="~/js/operaciones-common.js" asp-append-version="true"></script>
    <script src="~/js/extracosto-modal.js" asp-append-version="true"></script>
    <script src="~/js/emision-bl.js" asp-append-version="true"></script>
    <script src="~/js/operaciones-detalle.js" asp-append-version="true"></script>
    <script src="~/js/detalle-premium.js" asp-append-version="true"></script>
    @if (TempData["ErrorMsg"] is string errorMsgDet && !string.IsNullOrWhiteSpace(errorMsgDet))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var msg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMsgDet));
                if (window.Swal) Swal.fire({ icon: 'info', title: 'Atención', text: msg, confirmButtonColor: '#0f172a' }); else alert(msg);
            });
        </script>
    }
}
