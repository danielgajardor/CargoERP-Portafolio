                    }
                    @if (Model.ReqTerrestre)
                    {
                        <li class="nav-item"><button class="nav-link py-1 px-3" data-bs-toggle="pill" data-bs-target="#hist-det-transporte" type="button" style="font-size:10px; font-weight:800; background:#f1f5f9; color:#16a34a; border:1px solid #bbf7d0; border-radius:6px;"><i class="bi bi-truck me-1"></i> Transporte</button></li>
                    }
                    @if (Model.ReqDocumental)
                    {
                        <li class="nav-item"><button class="nav-link py-1 px-3" data-bs-toggle="pill" data-bs-target="#hist-det-documental" type="button" style="font-size:10px; font-weight:800; background:#f1f5f9; color:#7e22ce; border:1px solid #e9d5ff; border-radius:6px;"><i class="bi bi-file-earmark-check me-1"></i> Documental</button></li>
                    }
                </ul>

                <div class="tab-content" style="max-height:500px; overflow-y:auto;">
                    <div class="tab-pane fade show active" id="hist-det-todas">
                        @if (!lineasHistorialDet.Any())
                        {
                            <div class="text-center p-5 rounded border" style="background:var(--bg-soft);">
                                <i class="bi bi-clock-history text-muted opacity-25" style="font-size:3rem;"></i>
                                <h6 class="fw-bold text-muted mt-3 mb-1">Sin actividad registrada</h6>
                                <p class="text-muted mb-0" style="font-size:12px;">Las acciones realizadas sobre esta operación aparecerán aquí.</p>
                            </div>
                        }
                        else
                        {
                            <div class="px-1">
                                @foreach (var l in lineasHistorialDet)
                                {
                                    @Html.Raw(RenderLineaDetalle(l))
                                }
                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" id="hist-det-general">
                        @{ var linesGenDet = lineasHistorialDet.Where(l => { var pp = l.Split('|'); return pp.Length >= 3 && pp[2].ToUpper() == "GENERAL"; }).ToList(); }
                        @if (!linesGenDet.Any())
                        {
                            <div class="text-center py-5 text-muted" style="font-size:12px;"><i class="bi bi-grid opacity-25 d-block mb-2" style="font-size:2rem;"></i>Sin registros en General.</div>
                        }
                        else
                        {
                            <div class="px-1">@foreach (var l in linesGenDet) { @Html.Raw(RenderLineaDetalle(l)) }</div>
                        }
                    </div>

                    @if (Model.ReqMaritimo)
                    {
                        <div class="tab-pane fade" id="hist-det-maritimo">
                            @{ var linesMarDet = lineasHistorialDet.Where(l => { var pp = l.Split('|'); return pp.Length >= 3 && pp[2].ToUpper() == "MARITIMO"; }).ToList(); }
                            @if (!linesMarDet.Any())
                            {
                                <div class="text-center py-5 text-muted" style="font-size:12px;"><i class="bi bi-water opacity-25 d-block mb-2" style="font-size:2rem;"></i>Sin registros en Marítimo.</div>
                            }
                            else
                            {
                                <div class="px-1">@foreach (var l in linesMarDet) { @Html.Raw(RenderLineaDetalle(l)) }</div>
                            }
                        </div>
                    }

                    @if (Model.ReqTerrestre)
                    {
                        <div class="tab-pane fade" id="hist-det-transporte">
                            @{ var linesTerDet = lineasHistorialDet.Where(l => { var pp = l.Split('|'); return pp.Length >= 3 && pp[2].ToUpper() == "TRANSPORTE"; }).ToList(); }
                            @if (!linesTerDet.Any())
                            {
                                <div class="text-center py-5 text-muted" style="font-size:12px;"><i class="bi bi-truck opacity-25 d-block mb-2" style="font-size:2rem;"></i>Sin registros en Transporte.</div>
                            }
                            else
                            {
                                <div class="px-1">@foreach (var l in linesTerDet) { @Html.Raw(RenderLineaDetalle(l)) }</div>
                            }
                        </div>
                    }

                    @if (Model.ReqDocumental)
                    {
                        <div class="tab-pane fade" id="hist-det-documental">
                            @{ var linesDocDet = lineasHistorialDet.Where(l => { var pp = l.Split('|'); return pp.Length >= 3 && pp[2].ToUpper() == "DOCUMENTAL"; }).ToList(); }
                            @if (!linesDocDet.Any())
                            {
                                <div class="text-center py-5 text-muted" style="font-size:12px;"><i class="bi bi-file-earmark-check opacity-25 d-block mb-2" style="font-size:2rem;"></i>Sin registros en Documental.</div>
                            }
                            else
                            {
                                <div class="px-1">@foreach (var l in linesDocDet) { @Html.Raw(RenderLineaDetalle(l)) }</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
