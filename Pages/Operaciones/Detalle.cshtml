                                <label class="mod-label">Responsabilidad de Pago</label>
                                <select class="form-select erp-input" name="PagoGate">
                                    <option value="">-- Seleccionar --</option>
                                    <option value="Mandato de pago agencia aduana" selected="@(opGate.PagoGate == "Mandato de pago agencia aduana")">Mandato de pago agencia aduana</option>
                                    <option value="Atilson paga directamente" selected="@(opGate.PagoGate == "Atilson paga directamente")">Atilson paga directamente</option>
                                </select>
                            </div>
                        </div>

                        @if (gatePendiente)
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mt-3 mb-0" style="font-size:11px; font-weight:700; border-radius:8px;">
                                <i class="bi bi-lock-fill"></i>
                                <div><strong>Pendiente de asignación de tarifa.</strong> Comercial debe agregar el valor de Gate en Acuerdos Operativos.</div>
