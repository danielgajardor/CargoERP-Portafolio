                                <div class="text-center py-5 text-muted" style="font-size:12px;"><i class="bi bi-file-earmark-check opacity-25 d-block mb-2" style="font-size:2rem;"></i>Sin registros en Documental.</div>
                            }
                            else
                            {
                                <div class="px-1">@foreach (var l in linesDocDet) { @Html.Raw(RenderLineaDetalle(l)) }</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
