        });

        // Vaciamos los inputs de links
        box.querySelectorAll('input[type="url"]').forEach(i => i.value = '');

        // Ocultamos la 3ra planta si el usuario la había desplegado
        let boxP3 = document.getElementById('planta3-box-' + idOp);
