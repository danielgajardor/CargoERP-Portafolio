    /* =========================================================
       SELECT2 — BÚSQUEDA PREDICTIVA (Naviera, POL, POD, Depósito,
       Planta, Agencia). El dropdown se ancla al propio modal para
       evitar el problema clásico de z-index/foco de Select2 dentro
       de un modal de Bootstrap.
       ========================================================= */
    .select2-container { width: 100% !important; }
    .select2-container--open { z-index: 20000 !important; }
    .select2-container--default .select2-selection--single {
        height: 38px !important;
        border: 1px solid var(--border-soft) !important;
        border-radius: 6px !important;
        background-color: #f8fafc !important;
        padding: 2px 4px;
    }
    .edit-mode .select2-container--default .select2-selection--single {
        background-color: #fff !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 34px !important;
        font-size: 13px;
        font-weight: 700;
        color: var(--txt-main);
        padding-left: 8px !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 36px !important;
    }
    .select2-container--default.select2-container--disabled .select2-selection--single {
        background-color: #f1f5f9 !important;
        cursor: default;
    }
    .select2-dropdown {
        border: 1px solid var(--atilson-purple) !important;
        border-radius: 8px !important;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }
    .select2-search--dropdown { padding: 6px; }
    .select2-search__field {
        border: 1px solid var(--border-soft) !important;
        border-radius: 6px !important;
        padding: 6px 8px !important;
        font-size: 12.5px;
        font-weight: 700;
        text-transform: uppercase;
        outline: none;
    }
    .select2-results__option--highlighted { background-color: var(--atilson-purple) !important; }
    /* Depósito y Planta se ocultan hasta modo edición: Select2 crea su widget
       como HERMANO del <select> original, así que el toggle vista/edición debe
       aplicarse a ese hermano, no al select (que Select2 ya oculta por su cuenta). */
        select.edit-only-depositoretiro + .select2-container,
    select.edit-only-planta + .select2-container,
    select.edit-only-empresatransporte + .select2-container { display: none !important; }
    .edit-mode select.edit-only-depositoretiro + .select2-container,
    .edit-mode select.edit-only-planta + .select2-container,
    .edit-mode select.edit-only-empresatransporte + .select2-container { display: inline-block !important; }
    /* Texto "Sin archivo" oculto hasta modo edición */
