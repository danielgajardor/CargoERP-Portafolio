                    @await Html.PartialAsync("_PanelTransporte", new AtilsonCargoSpa.Models.TransportePanelVm
                    {
                        Op = opTer,
                        Terr = cTerDet.TerrRow,
                        IdUnidadTecnica = cTerDet.IdUnidad,
                        IdSuffix = cTerDet.Suffix,
