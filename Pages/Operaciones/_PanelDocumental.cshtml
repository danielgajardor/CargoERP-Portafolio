@model AtilsonCargoSpa.Models.DocumentalPanelVm
@using AtilsonCargoSpa.Helpers
@{
    var op = Model.Op;
    var d = Model.Doc;

    // Enruta al overload correcto de IndexModel según si este panel representa
    // el contenedor principal (Grupal, IdUnidadTecnica == null) o un contenedor
    // específico (Individual, IdUnidadTecnica con valor).
                (string? PagadoPor, string? Responsable, bool PendienteTarifa, string ConceptoReal) EstadoConcepto(string concepto)
        => Model.IdUnidadTecnica.HasValue
            ? Model.PageModel.ObtenerEstadoConcepto(op, concepto, Model.IdUnidadTecnica.Value)
            : Model.PageModel.ObtenerEstadoConcepto(op, concepto);

        // Concepto EXACTO por slot de reemisión (1=Principal, 2="R1", 3="R2", 4="R3"),
        // con el mismo sufijo "(Uxx)" que ya usa el resto del panel cuando el booking
        // gestiona el certificado por contenedor individual.
        (string? PagadoPor, string? Responsable, bool PendienteTarifa, string ConceptoReal) EstadoConceptoSlot(string conceptoBase, int slot)
        {
            string sufijoReemision = slot switch { 2 => " R1", 3 => " R2", 4 => " R3", _ => "" };
            string sufijoUnidad = Model.IdUnidadTecnica.HasValue ? $" (U{Model.IdUnidadTecnica.Value})" : "";
            return Model.PageModel.ObtenerEstadoConceptoExacto(op, $"{conceptoBase}{sufijoReemision}{sufijoUnidad}");
        }

        bool TarifaPendiente(params string[] conceptos)
        => Model.IdUnidadTecnica.HasValue
            ? Model.PageModel.HayTarifaPendiente(op, Model.IdUnidadTecnica.Value, conceptos)
            : Model.PageModel.HayTarifaPendiente(op, conceptos);

    bool TieneSolicitudPendiente(string certKey)
        => op.SolicitudesDesbloqueos != null && op.SolicitudesDesbloqueos.Any(s => s.CertKey == certKey && s.IdUnidadTecnica == Model.IdUnidadTecnica && s.Estado == "PENDIENTE");
}
<form id="doc-global-form-v3-@Model.IdSuffix" method="post" action="/Operaciones/Index?handler=QuickEditDocumental" enctype="multipart/form-data">
    <input type="hidden" name="__RequestVerificationToken" value="" class="anti-forgery-token-input" />
    <input type="hidden" name="IdOperacion" value="@op.Id" />
    @if (Model.IdUnidadTecnica.HasValue)
    {
        <input type="hidden" name="IdUnidadTecnica" value="@Model.IdUnidadTecnica" />
    }

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2" style="border-bottom: 1px solid #e5e7eb;">
        <div>
            <h5 class="fw-black text-dark m-0" style="font-size: 18px; letter-spacing: -0.5px;">Gestor Documental Pro@(Model.Label != null ? $" — {Model.Label}" : "")</h5>
            <p class="text-muted m-0 mt-1" style="font-size: 12px;">Arquitectura limpia para gestión de certificados.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="text-muted" style="font-size:10px; font-weight:700;">Cada certificado guarda y notifica a Finanzas de forma independiente.</span>
        </div>
    </div>

    @{
        string dAd = (!string.IsNullOrEmpty(d?.DusDin) || !string.IsNullOrEmpty(d?.Din)) ? "bg-success" : "bg-warning";
        string dOr = DocumentalHelpers.GetProDot(true, d?.LogOrigen ?? "");
        string dFi = DocumentalHelpers.GetProDot(d?.AplicaSag, d?.LogFitosanitario ?? "");
        string dSa = DocumentalHelpers.GetProDot(d?.AplicaSernapesca, d?.LogSanitario ?? "");
        string dCa = DocumentalHelpers.GetProDot(d?.AplicaSernapesca, d?.LogCaptura ?? "");
        string dBa = (!string.IsNullOrEmpty(d?.LogFactura) || !string.IsNullOrEmpty(d?.LogGuia)) ? "bg-success" : "bg-warning";
    }

    <div class="pro-wrapper">

        <div class="pro-sidebar d-flex flex-column">
        <div class="mb-4 pb-3 border-bottom" style="border-color: #e5e7eb;">
            <label class="pro-label text-dark mb-3"><i class="bi bi-gear-fill me-1 text-muted"></i> Requerimientos</label>
            <div class="d-flex flex-column gap-2 px-1">
                <label class="d-flex align-items-center gap-2 m-0 cursor-pointer p-1 rounded" style="transition: background 0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='transparent'">
                    <input class="pro-check inline-field" type="checkbox" id="chkSag-v3-@Model.IdSuffix" name="docUpdates.AplicaSag" value="true" @(d?.AplicaSag == true ? "checked" : "") onchange="handleTipoTramite('v3-@Model.IdSuffix', 'sag')">
                    <span class="fw-bold text-success" style="font-size:10px; text-transform:uppercase; margin-top:1px;">Aplica SAG</span>
                </label>
                <label class="d-flex align-items-center gap-2 m-0 cursor-pointer p-1 rounded" style="transition: background 0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='transparent'">
                    <input class="pro-check inline-field" type="checkbox" id="chkSerna-v3-@Model.IdSuffix" name="docUpdates.AplicaSernapesca" value="true" @(d?.AplicaSernapesca == true ? "checked" : "") onchange="handleTipoTramite('v3-@Model.IdSuffix', 'sernapesca')">
                    <span class="fw-bold text-info" style="font-size:10px; text-transform:uppercase; margin-top:1px;">Aplica Sernapesca</span>
                </label>
                <label class="d-flex align-items-center gap-2 m-0 cursor-pointer p-1 rounded" style="transition: background 0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='transparent'">
                    <input class="pro-check inline-field" type="checkbox" id="chkTerr-v3-@Model.IdSuffix" value="true" @(Model.ReqTerrestre ? "checked" : "") onchange="handleTipoTramite('v3-@Model.IdSuffix', 'terrestre')">
                    <span class="fw-bold text-secondary" style="font-size:10px; text-transform:uppercase; margin-top:1px;">Servicio Terrestre</span>
                </label>
            </div>
        </div>

        <label class="pro-label text-dark mb-2"><i class="bi bi-file-earmark-check me-1 text-muted"></i> Certificados</label>
        <button type="button" class="pro-nav-btn pro-nav-btn-@Model.IdSuffix active" id="btn-aduana-@Model.IdSuffix" onclick="openProTab('@Model.IdSuffix', 'aduana')"><div class="pro-dot @dAd"></div> Aduana y Trámites</button>
        <button type="button" class="pro-nav-btn pro-nav-btn-@Model.IdSuffix" id="btn-origen-@Model.IdSuffix" onclick="openProTab('@Model.IdSuffix', 'origen')"><div class="pro-dot @dOr"></div> Origen / TLC</button>
        <button type="button" class="pro-nav-btn pro-nav-btn-@Model.IdSuffix" id="sidebar-btn-fito-@Model.IdSuffix" onclick="openProTab('@Model.IdSuffix', 'fito')" style="display: @(d?.AplicaSag == true ? "flex" : "none");">
            <div class="pro-dot @dFi"></div> Fitosanitario (SAG)
        </button>
        <button type="button" class="pro-nav-btn pro-nav-btn-@Model.IdSuffix" id="sidebar-btn-sani-@Model.IdSuffix" onclick="openProTab('@Model.IdSuffix', 'sani')" style="display: @(d?.AplicaSernapesca == true ? "flex" : "none");">
            <div class="pro-dot @dSa"></div> Sanitario (Sernap.)
        </button>
        <button type="button" class="pro-nav-btn pro-nav-btn-@Model.IdSuffix" id="sidebar-btn-cap-@Model.IdSuffix" onclick="openProTab('@Model.IdSuffix', 'cap')" style="display: @(d?.AplicaSernapesca == true ? "flex" : "none");">
            <div class="pro-dot @dCa"></div> Cert. Captura
        </button>
        <button type="button" class="pro-nav-btn pro-nav-btn-@Model.IdSuffix" id="btn-sub-@Model.IdSuffix" onclick="openProTab('@Model.IdSuffix', 'sub')"><div class="pro-dot bg-secondary opacity-50"></div> Otros Subcerts</button>
        <button type="button" class="pro-nav-btn pro-nav-btn-@Model.IdSuffix" id="btn-base-@Model.IdSuffix" onclick="openProTab('@Model.IdSuffix', 'base')"><div class="pro-dot @dBa"></div> Documentos Base</button>
    </div>

    <div class="pro-content-area" style="overflow-y: auto; height: 750px; transition: none;">

        @{ bool aduanaPendiente = TarifaPendiente("Honorarios Agencia", "Legalización / Emisión DUS"); }
        <div class="pro-pane-@Model.IdSuffix" id="pane-aduana-@Model.IdSuffix" style="display: block;" data-tarifa-pendiente="@(aduanaPendiente ? "true" : "false")">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light">
                <div>
                    <h3 class="pro-title"><i class="bi bi-bank me-2 text-primary"></i>Aduana y Trámites</h3>
                    <p class="pro-subtitle m-0">Gestión de declaraciones y extracostos aduaneros.</p>
                </div>
                <div class="text-end">
                    <a class="btn-edit-inline" style="font-size:11px;" onclick="toggleEditCert('aduana', 'v3-@Model.IdSuffix', this)"><i class="bi bi-pencil me-1"></i> Editar</a>
                    <div class="btn-save-wrapper d-none d-flex gap-1 mt-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size:10px;" onclick="descartarCert('aduana', 'v3-@Model.IdSuffix')">Descartar</button>
                        <button type="button" class="btn btn-sm btn-success py-1 px-2" style="font-size:10px;" onclick="guardarCertificadoAjax('aduana', 'v3-@Model.IdSuffix', false, this)"><i class="bi bi-save me-1"></i> Guardar</button>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-5">
                    <label class="pro-label">Agencia de Aduanas</label>
                    <select name="docUpdates.IdAgenciaAduana" class="pro-input fw-bold mb-4 select2-enable" disabled onchange="validarBloqueoAgencia('v3-@Model.IdSuffix')">
    <option value="">-- Seleccionar Agencia --</option>
                        @if (ViewBag.IdAgenciaAduana != null) {
                            foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.IdAgenciaAduana) {
                                if (d != null && d.IdAgenciaAduana?.ToString() == item.Value) { <option value="@item.Value" selected>@item.Text</option> }
                                else { <option value="@item.Value">@item.Text</option> }
                            }
                        }
                    </select>

                    <label class="pro-label">Estado Documental General</label>
                    <input type="text" name="docUpdates.EstadoDocumental" class="pro-input text-uppercase fw-bold" value="@d?.EstadoDocumental" placeholder="Ej: Autorizado..." readonly />
                </div>
                <div class="col-md-7">
                    <div class="pro-card-gray m-0 h-100">
                        <div class="d-flex gap-4 mb-3">
                            <label class="d-flex align-items-center gap-2 m-0 cursor-pointer">
                                <input class="pro-check inline-field" type="radio" name="TipoDec_v3_@Model.IdSuffix" id="radioDus_v3-@Model.IdSuffix" value="DUS" @(string.IsNullOrEmpty(d?.Din) ? "checked" : "") onchange="toggleDeclaracion('v3-@Model.IdSuffix')" disabled>
                                <span class="fw-bold text-primary" style="font-size:12px;">DUS (Exportación)</span>
                            </label>
                            <label class="d-flex align-items-center gap-2 m-0 cursor-pointer">
                                <input class="pro-check inline-field" type="radio" name="TipoDec_v3_@Model.IdSuffix" id="radioDin_v3-@Model.IdSuffix" value="DIN" @(!string.IsNullOrEmpty(d?.Din) ? "checked" : "") onchange="toggleDeclaracion('v3-@Model.IdSuffix')" disabled>
                                <span class="fw-bold text-primary" style="font-size:12px;">DIN (Importación)</span>
                            </label>
                        </div>
                        <div class="row g-3" id="container-dus-v3-@Model.IdSuffix" style="display: @(string.IsNullOrEmpty(d?.Din) ? "flex" : "none");">
                            <div class="col-7"><label class="pro-label text-primary">N° DUS</label><input type="text" name="docUpdates.Dus" class="pro-input text-uppercase fw-bold text-primary" value="@d?.DusDin" placeholder="Número..." readonly /></div>
                            <div class="col-5"><label class="pro-label text-success">Valor Trámite ($)</label><input type="text" inputmode="decimal" name="docUpdates.ValorDus" class="pro-input doc-val-input text-success fw-bold" value="@d?.ValorDus" placeholder="0" readonly /></div>
                        </div>
                        <div class="row g-3" id="container-din-v3-@Model.IdSuffix" style="display: @(!string.IsNullOrEmpty(d?.Din) ? "flex" : "none");">
                            <div class="col-7"><label class="pro-label text-primary">N° DIN</label><input type="text" name="docUpdates.Din" class="pro-input text-uppercase fw-bold text-primary" value="@d?.Din" placeholder="Número..." readonly /></div>
                            <div class="col-5"><label class="pro-label text-success">Valor Trámite ($)</label><input type="text" inputmode="decimal" name="docUpdates.ValorDin" class="pro-input doc-val-input text-success fw-bold" value="@d?.ValorDin" placeholder="0" readonly /></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pro-card-red m-0">
    <label class="pro-label text-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-1"></i> Trámites de Corrección / Extracostos</label>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="d-flex align-items-center gap-2 m-0 cursor-pointer">
                <input class="pro-check inline-field" type="checkbox" id="chkAcl-v3-@Model.IdSuffix" name="docUpdates.ExtensionDocumental" value="true" @(d?.ExtensionDocumental == true ? "checked" : "") onchange="toggleExclusionTramites('v3-@Model.IdSuffix');">
                <span class="fw-bold" style="font-size:12px; color:#991b1b;">Aclaración</span>
            </label>
        </div>
        <div class="col-md-4">
            <label class="d-flex align-items-center gap-2 m-0 cursor-pointer">
                <input class="pro-check inline-field" type="checkbox" id="chkCan-v3-@Model.IdSuffix" name="docUpdates.GuiaVisado" value="true" @(d?.GuiaVisado == true ? "checked" : "") onchange="toggleExclusionTramites('v3-@Model.IdSuffix');">
                <span class="fw-bold" style="font-size:12px; color:#991b1b;">Cancelación</span>
            </label>
        </div>
        <div class="col-md-4">
            <label class="d-flex align-items-center gap-2 m-0 cursor-pointer">
                <input class="pro-check inline-field" type="checkbox" id="chkRol-v3-@Model.IdSuffix" name="docUpdates.Roleo" value="true" @(d?.Roleo == true ? "checked" : "")>
                <span class="fw-bold" style="font-size:12px; color:#991b1b;">Roleo</span>
            </label>
        </div>
    </div>
</div>

    <div class="pro-card m-0 mt-3 p-3" id="ivv-container-v3-@Model.IdSuffix" style="background-color: #f8fafc; border-color: #cbd5e1; opacity: @(d?.GeneracionIvv == true ? "1" : "0.5"); transition: opacity 0.3s;">
        <div class="d-flex align-items-center gap-2">
            <input class="pro-check inline-field" type="checkbox" id="chkIvv-v3-@Model.IdSuffix" name="docUpdates.GeneracionIvv" value="true" @(d?.GeneracionIvv == true ? "checked" : "") disabled onchange="document.getElementById('ivv-container-v3-@Model.IdSuffix').style.opacity = this.checked ? '1' : '0.5';">
            <label class="form-check-label fw-bold text-dark" style="font-size:12px; text-transform:uppercase; cursor: pointer;" for="chkIvv-v3-@Model.IdSuffix">
                <i class="bi bi-file-earmark-check text-primary me-1"></i> Generación IVV
            </label>
        </div>
    </div>

    @if (aduanaPendiente)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mt-3 mb-0" style="font-size:11px; font-weight:700; border-radius:8px;">
            <i class="bi bi-lock-fill"></i>
            <div><strong>Pendiente de asignación de tarifa.</strong> Comercial debe agregar el valor de Honorarios Agencia / Legalización en Acuerdos Operativos.</div>
        </div>
    }
    @{ var estRespAduana = EstadoConcepto("Honorarios Agencia"); }
    <div class="d-flex align-items-center gap-1 mt-2 pt-2 border-top" style="font-size:10px;">
        <span class="text-muted fw-bold"><i class="bi bi-cash-coin"></i></span>
        <select class="form-select form-select-sm resp-pagado border-0 bg-light" style="width:auto; font-size:10px; font-weight:700; padding:2px 6px; color:#475569;" data-concepto="@estRespAduana.ConceptoReal" onchange="guardarResponsabilidad(@op.Id, this.getAttribute('data-concepto'), this, this.closest('.d-flex').querySelector('.resp-responsable'))">
            <option value="ATILSON" selected="@(estRespAduana.PagadoPor == "ATILSON" || estRespAduana.PagadoPor == null ? "selected" : null)">Paga: Atilson</option>
            <option value="AGENCIA" selected="@(estRespAduana.PagadoPor == "AGENCIA" ? "selected" : null)">Paga: Agencia</option>
            <option value="PROVEEDOR" selected="@(estRespAduana.PagadoPor == "PROVEEDOR" ? "selected" : null)">Paga: Proveedor</option>
        </select>
        <span class="text-muted">→</span>
        <select class="form-select form-select-sm resp-responsable border-0 bg-light" style="width:auto; font-size:10px; font-weight:700; color:#b91c1c;" data-concepto="@estRespAduana.ConceptoReal" onchange="guardarResponsabilidad(@op.Id, this.getAttribute('data-concepto'), this.closest('.d-flex').querySelector('.resp-pagado'), this)">
            <option value="CLIENTE" selected="@(estRespAduana.Responsable == "CLIENTE" || estRespAduana.Responsable == null ? "selected" : null)">Resp: Cliente</option>
            <option value="ATILSON" selected="@(estRespAduana.Responsable == "ATILSON" ? "selected" : null)">Resp: Atilson</option>
            <option value="PROVEEDOR" selected="@(estRespAduana.Responsable == "PROVEEDOR" ? "selected" : null)">Resp: Proveedor</option>
            <option value="AGENCIA" selected="@(estRespAduana.Responsable == "AGENCIA" ? "selected" : null)">Resp: Agencia</option>
        </select>
        <span class="text-muted ms-1" style="font-size:9px;">(Honorarios Agencia)</span>
    </div>
        </div>

                                @{
            var estRespOrigen = EstadoConcepto("Certificado de Origen");
            string modalidadOri = Model.Op.ModalidadCertOrigen ?? "GRUPAL";
            bool oriBloqueadaModalidad = Model.PageModel.ModalidadCertBloqueada(Model.Op, "ori");
            bool oriEsIndividual = modalidadOri == "INDIVIDUAL" && Model.Contenedores.Any(c => c.IdUnidad.HasValue);
            bool bloqueadoOri = (d?.CertsBloqueados ?? "").Split(',').Contains("ori");
            bool activoOri1 = DocumentalHelpers.SlotBloqueado(d, "ori", 1);
            bool activoOri2 = DocumentalHelpers.SlotBloqueado(d, "ori", 2);
            bool activoOri3 = DocumentalHelpers.SlotBloqueado(d, "ori", 3);
            bool activoOri4 = DocumentalHelpers.SlotBloqueado(d, "ori", 4);
            int siguienteSlotOri = DocumentalHelpers.SiguienteSlotEditable(d, "ori");
            var slotsEnviadosOri = new List<(int Slot, string Label)>();
            for (int s = 1; s <= 4; s++)
                if (DocumentalHelpers.SlotBloqueado(d, "ori", s))
                    slotsEnviadosOri.Add((s, s == 1 ? "Principal" : $"Reemisión {s - 1}"));
        }
<div class="pro-pane-@Model.IdSuffix" id="pane-origen-@Model.IdSuffix" style="display: none;" data-tarifa-pendiente="@(estRespOrigen.PendienteTarifa ? "true" : "false")">
    @if (Model.Contenedores.Any(c => c.IdUnidad.HasValue))
    {
        <div class="d-flex align-items-center gap-3 p-2 px-3 mb-3 rounded" style="background:#f8fafc; border:1px solid #e5e7eb;">
            <span class="mod-label m-0" style="font-size:10px;"><i class="bi bi-boxes me-1"></i> Modalidad</span>
            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check modalidad-cert-radio" name="modCertOri-@Model.IdSuffix" id="modOriGrupal-@Model.IdSuffix" value="GRUPAL" @(modalidadOri == "GRUPAL" ? "checked" : "") @(oriBloqueadaModalidad ? "disabled" : "") onchange="cambiarModalidadCertPorCertificado(@Model.Op.Id, 'ori', this.value)">
                <label class="btn btn-outline-secondary btn-sm fw-bold" for="modOriGrupal-@Model.IdSuffix" style="font-size:10px;">GRUPAL</label>
                                <input type="radio" class="btn-check modalidad-cert-radio" name="modCertOri-@Model.IdSuffix" id="modOriIndividual-@Model.IdSuffix" value="INDIVIDUAL" @(modalidadOri == "INDIVIDUAL" ? "checked" : "") @(oriBloqueadaModalidad ? "disabled" : "") onchange="cambiarModalidadCertPorCertificado(@Model.Op.Id, 'ori', this.value)">
                <label class="btn btn-outline-secondary btn-sm fw-bold" for="modOriIndividual-@Model.IdSuffix" style="font-size:10px;">INDIVIDUAL</label>
            </div>
            @if (oriBloqueadaModalidad)
            {
                <span class="text-muted ms-auto" style="font-size:9px;"><i class="bi bi-lock-fill me-1"></i> Bloqueado — ya hay datos guardados</span>
            }
        </div>
    }
    @if (!oriEsIndividual)
    {
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light">
                <div>
                    <h3 class="pro-title">
                        <i class="bi bi-globe me-2 text-purple"></i>Certificado Origen / TLC
                                                @if (bloqueadoOri)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success ms-2" style="font-size:9px;"><i class="bi bi-check-circle-fill me-1"></i>ENVIADO A FINANZAS</span>
                            @if (TieneSolicitudPendiente("ori"))
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning ms-2" style="font-size:9px;"><i class="bi bi-hourglass-split me-1"></i>DESBLOQUEO SOLICITADO</span>
                                                        }
                            else
                            {
                                <button type="button" class="btn btn-link p-0 ms-2" style="font-size:10px; text-decoration:none; color:#0ea5e9;" onclick="solicitarDesbloqueo(@op.Id, @(Model.IdUnidadTecnica.HasValue ? Model.IdUnidadTecnica.Value.ToString() : "null"), 'ori')"><i class="bi bi-unlock-fill me-1"></i>Solicitar Desbloqueo</button>
                            }
                        }
                    </h3>
                    <p class="pro-subtitle m-0">Documentación y reemisiones de origen.</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <input type="hidden" name="aplica_ori_v3_@Model.IdSuffix" value="si" />
                    <div class="text-end">
    <a class="btn-edit-inline" style="font-size:11px;" onclick="toggleEditCert('ori', 'v3-@Model.IdSuffix', this)"><i class="bi bi-pencil me-1"></i> Editar</a>
    <div class="btn-save-wrapper d-none d-flex gap-1 mt-1">
        <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size:10px;" onclick="descartarCert('ori', 'v3-@Model.IdSuffix')">Descartar</button>
        <button type="button" class="btn btn-sm btn-success py-1 px-2" style="font-size:10px;" onclick="guardarCertificadoAjax('ori', 'v3-@Model.IdSuffix', true, this)"><i class="bi bi-send me-1"></i> Guardar</button>
    </div>
</div>
                </div>
            </div>

            <div id="v3-ori-wrapper-@Model.IdSuffix">
                <div class="row g-5">
