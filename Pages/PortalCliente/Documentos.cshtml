@page
@model AtilsonCargoSpa.Pages.PortalCliente.DocumentosModel
@using AtilsonCargoSpa.Models
@using AtilsonCargoSpa.Pages.PortalCliente
@functions {
    // Extensión legible del archivo (PDF, XLSX, JPG...) a partir de la ruta/URL
    private static string Extension(string? ruta)
    {
        if (string.IsNullOrWhiteSpace(ruta)) return "";
        var limpia = ruta.Split('?', '#')[0];
        var ext = System.IO.Path.GetExtension(limpia);
        return string.IsNullOrEmpty(ext) ? "ARCHIVO" : ext.TrimStart('.').ToUpperInvariant();
    }

    private static string NombreArchivo(string? ruta)
    {
        if (string.IsNullOrWhiteSpace(ruta)) return "";
        var limpia = ruta.Split('?', '#')[0];
        return System.IO.Path.GetFileName(limpia);
    }

    // Mapea el color del DTO al tono del sistema visual
    private static string Tono(string iconClass) => iconClass switch
    {
        "icon-red" => "red",
        "icon-green" => "green",
        _ => "blue"
    };
}
@{
    ViewData["Title"] = "Repositorio Documental";
    Layout = "_LayoutCliente";

    var ops = Model.OperacionesDocumentales ?? new List<Operacione>();

    var data = ops.Select(op =>
    {
        var d = op.OperacionesDocumentales?.FirstOrDefault();
        var archivos = d != null ? Model.ArchivosDisponibles(d) : new List<DocumentoArchivoDto>();
        return new
        {
            Op = op,
            D = d,
            Disponibles = archivos.Where(a => !string.IsNullOrEmpty(a.Ruta) && a.Nombre != "Full Set Documental").ToList(),
            Pendientes = archivos.Where(a => string.IsNullOrEmpty(a.Ruta) && a.Nombre != "Full Set Documental").ToList(),
            FullSet = d?.RutaFullSet,
            BlPorRevisar = d?.EstadoDocumental == "BORRADOR ENVIADO"
        };
    }).ToList();

    int nTodas = data.Count;
    int nDocs = data.Sum(x => x.Disponibles.Count + (string.IsNullOrEmpty(x.FullSet) ? 0 : 1));
    int nBL = data.Count(x => x.BlPorRevisar);
    int nFull = data.Count(x => !string.IsNullOrEmpty(x.FullSet));
    int nTramite = nTodas - nFull;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">

<style>
    /* =========================================================
       0. TOKENS (mismo sistema que Index y Facturas)
       ========================================================= */
    .pc {
        --pc-brand: #6d2d9e; --pc-brand-2: #8b5cf6; --pc-deep: #2c1b4d; --pc-ink: #140c26;
        --pc-text: #1e1b2e; --pc-muted: #6b6880; --pc-faint: #a19eb3; --pc-line: #ece8f3;
        --pc-soft: #f7f5fb; --pc-tint: #f4eefb;
        --pc-ok: #059669; --pc-ok-bg: #ecfdf5; --pc-ok-line: #a7f3d0;
        --pc-warn: #c2410c; --pc-warn-bg: #fff7ed; --pc-warn-line: #fed7aa;
        --pc-grad: linear-gradient(135deg, #6d2d9e 0%, #8b5cf6 55%, #60a5fa 100%);
        --pc-radius: 20px;
        --pc-shadow: 0 1px 2px rgba(20,12,38,.04), 0 10px 30px -12px rgba(20,12,38,.10);
        --pc-shadow-lg: 0 30px 70px -28px rgba(44,27,77,.45);
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: var(--pc-text);
        max-width: 1280px; margin: 0 auto; padding: 8px 4px 56px;
    }
    .pc .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; letter-spacing: -.2px; }
    .pc a { text-decoration: none; }
    .pc-eyebrow { font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; color: var(--pc-faint); }
    .pc-lbl { display: block; font-size: 10px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; color: var(--pc-faint); margin-bottom: 4px; }

    /* Tonos de archivo */
    .t-red { --t: #dc2626; --t-bg: #fef2f2; --t-line: #fecaca; }
    .t-green { --t: #059669; --t-bg: #ecfdf5; --t-line: #a7f3d0; }
    .t-blue { --t: #2563eb; --t-bg: #eff6ff; --t-line: #bfdbfe; }

    /* =========================================================
       1. HERO
       ========================================================= */
    .pc-dhero {
        position: relative; isolation: isolate; overflow: hidden; color: #fff;
        border-radius: 28px; padding: 44px 48px; margin-bottom: 24px;
        display: grid; grid-template-columns: 1.4fr minmax(300px, 1fr); gap: 40px; align-items: center;
        background:
            radial-gradient(700px 360px at 100% 0%, rgba(139,92,246,.45), transparent 60%),
            radial-gradient(500px 300px at 0% 100%, rgba(96,165,250,.18), transparent 60%),
            linear-gradient(135deg, #140c26 0%, #2c1b4d 100%);
        box-shadow: var(--pc-shadow-lg);
    }
    .pc-dhero::after {
        content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
        background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
        background-size: 44px 44px;
        -webkit-mask-image: linear-gradient(90deg, #000 0%, transparent 60%); mask-image: linear-gradient(90deg, #000 0%, transparent 60%);
    }
    .pc-dhero .pc-eyebrow { color: #a99fc4; }
    .pc-dhero h1 { font-size: clamp(28px, 3.6vw, 42px); font-weight: 800; letter-spacing: -1.4px; line-height: 1.05; margin: 10px 0 12px; color: #fff; }
    .pc-dhero h1 span { background: linear-gradient(120deg, #c4b5fd 0%, #a78bfa 40%, #93c5fd 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .pc-dhero p { font-size: 15px; color: #d6d1e6; max-width: 520px; margin: 0 0 26px; line-height: 1.6; }
    .pc-dstats { display: flex; flex-wrap: wrap; gap: 10px; }
    .pc-dstat {
        display: inline-flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 14px;
        background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); font-size: 12.5px; color: #d6d1e6; font-weight: 600;
    }
    .pc-dstat b { color: #fff; font-size: 15px; font-weight: 800; }
    .pc-dstat i { color: #a78bfa; }

    .pc-vaultcard {
        position: relative; padding: 26px 28px; border-radius: 24px;
        background: linear-gradient(160deg, rgba(255,255,255,.14), rgba(255,255,255,.04));
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(20px) saturate(140%); -webkit-backdrop-filter: blur(20px) saturate(140%);
        box-shadow: 0 20px 50px -20px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.15);
    }
    .pc-vaultcard .pc-eyebrow { color: #c9c2dd; }
    .pc-vault-num { display: flex; align-items: baseline; gap: 10px; margin: 8px 0 18px; }
    .pc-vault-num b { font-size: 54px; font-weight: 800; letter-spacing: -2px; line-height: 1; }
    .pc-vault-num span { font-size: 14px; color: #c9c2dd; font-weight: 600; }
    .pc-vault-stack { position: absolute; right: 24px; top: 22px; width: 64px; height: 64px; }
    .pc-vault-stack i { position: absolute; font-size: 34px; color: rgba(255,255,255,.9); filter: drop-shadow(0 6px 14px rgba(0,0,0,.4)); }
    .pc-vault-stack i:nth-child(1) { right: 18px; top: 10px; transform: rotate(-12deg); color: #a78bfa; }
    .pc-vault-stack i:nth-child(2) { right: 9px; top: 5px; transform: rotate(-3deg); color: #93c5fd; }
    .pc-vault-stack i:nth-child(3) { right: 0; top: 0; transform: rotate(8deg); }
    .pc-vault-action {
        display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px;
        background: rgba(251,146,60,.14); border: 1px solid rgba(253,186,116,.35); color: #fed7aa; font-size: 13px; font-weight: 700;
        transition: background .2s;
    }
    .pc-vault-action:hover { background: rgba(251,146,60,.24); color: #fff; }
    .pc-vault-action i.bi-arrow-right { margin-left: auto; }
    .pc-vault-ok { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 800; color: #6ee7b7; background: rgba(16,185,129,.14); border: 1px solid rgba(110,231,183,.3); padding: 7px 12px; border-radius: 99px; }

    /* =========================================================
       2. TOOLBAR
       ========================================================= */
    .pc-section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 14px; flex-wrap: wrap; margin-bottom: 16px; }
    .pc-section-title { font-size: 24px; font-weight: 800; letter-spacing: -.7px; color: var(--pc-ink); margin: 4px 0 0; }
    .pc-section-title .count { font-size: 13px; font-weight: 700; color: var(--pc-brand); background: var(--pc-tint); padding: 3px 10px; border-radius: 99px; vertical-align: middle; margin-left: 8px; letter-spacing: 0; }
    .pc-toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .pc-search {
        display: flex; align-items: center; gap: 10px; flex: 1; max-width: 460px; min-width: 260px;
        background: #fff; border: 1px solid var(--pc-line); border-radius: 14px; padding: 5px 5px 5px 16px;
        box-shadow: var(--pc-shadow); transition: border-color .2s, box-shadow .2s;
    }
    .pc-search:focus-within { border-color: var(--pc-brand-2); box-shadow: 0 0 0 4px rgba(139,92,246,.12); }
    .pc-search > i { color: var(--pc-faint); }
    .pc-search input { border: 0; outline: 0; flex: 1; min-width: 0; font-size: 14px; font-weight: 600; color: var(--pc-text); background: transparent; font-family: inherit; }
    .pc-search input::placeholder { color: var(--pc-faint); font-weight: 500; }
    .pc-search kbd { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--pc-faint); background: var(--pc-soft); border: 1px solid var(--pc-line); border-radius: 6px; padding: 2px 6px; box-shadow: none; }
    .pc-search-clear { color: var(--pc-faint); font-size: 18px; padding: 0 4px; line-height: 1; }
    .pc-search-clear:hover { color: #dc2626; }
    .pc-search button { border: 0; background: var(--pc-deep); color: #fff; border-radius: 10px; padding: 9px 18px; font-weight: 700; font-size: 13px; font-family: inherit; transition: background .2s; }
    .pc-search button:hover { background: var(--pc-brand); }
    .pc-seg { display: inline-flex; flex-wrap: wrap; background: #fff; border: 1px solid var(--pc-line); border-radius: 14px; padding: 4px; gap: 2px; box-shadow: var(--pc-shadow); }
    .pc-seg button { border: 0; background: transparent; padding: 8px 14px; border-radius: 10px; font-family: inherit; font-size: 13px; font-weight: 700; color: var(--pc-muted); transition: all .2s; display: inline-flex; align-items: center; gap: 7px; }
    .pc-seg button:hover { color: var(--pc-ink); background: var(--pc-soft); }
    .pc-seg button.active { background: var(--pc-deep); color: #fff; box-shadow: 0 6px 14px -6px rgba(44,27,77,.6); }
    .pc-seg .n { font-size: 11px; padding: 1px 7px; border-radius: 99px; background: rgba(0,0,0,.06); }
    .pc-seg button.active .n { background: rgba(255,255,255,.18); }
    .pc-seg button[data-filter="bl"] .n { background: #ffedd5; color: #c2410c; }

    /* =========================================================
       3. CARPETAS (una por operación)
       ========================================================= */
    .pc-folders { display: flex; flex-direction: column; gap: 12px; }
    .pc-folder { background: #fff; border: 1px solid var(--pc-line); border-radius: 20px; overflow: hidden; box-shadow: var(--pc-shadow); position: relative; transition: border-color .25s, box-shadow .25s; animation: pcIn .6s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--i, 0) * 60ms); }
    .pc-folder::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--pc-grad); opacity: 0; transition: opacity .25s; }
    .pc-folder:hover { border-color: #ddd1ec; box-shadow: 0 22px 46px -26px rgba(44,27,77,.35); }
    .pc-folder:hover::before, .pc-folder.is-open::before { opacity: 1; }
    .pc-folder.is-open { border-color: #d2c1ea; box-shadow: 0 26px 60px -30px rgba(109,45,158,.45); }

    .pc-folder-head {
        display: grid; align-items: center; gap: 22px; padding: 20px 22px 20px 26px; cursor: pointer;
        grid-template-columns: minmax(200px, 1.1fr) minmax(220px, 1.4fr) minmax(200px, 1.2fr) auto;
        grid-template-areas: "id route docs act";
    }
    .pc-folder-head:focus-visible { outline: 2px solid var(--pc-brand-2); outline-offset: -2px; border-radius: 20px; }
    .pc-c-id { grid-area: id; min-width: 0; display: flex; align-items: center; gap: 14px; }
    .pc-c-route { grid-area: route; min-width: 0; }
    .pc-c-docs { grid-area: docs; min-width: 0; }
    .pc-c-act { grid-area: act; display: flex; align-items: center; gap: 8px; }

    .pc-folder-ico { position: relative; width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; font-size: 21px; flex-shrink: 0; background: var(--pc-tint); color: var(--pc-brand); transition: transform .3s; }
    .pc-folder:hover .pc-folder-ico { transform: rotate(-5deg) scale(1.04); }
    .pc-folder-ico .badge-n { position: absolute; top: -6px; right: -6px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 99px; background: var(--pc-deep); color: #fff; font-size: 10.5px; font-weight: 800; display: grid; place-items: center; border: 2px solid #fff; }
    .pc-bkg { font-size: 15.5px; font-weight: 600; color: var(--pc-brand); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pc-cont { font-size: 11.5px; color: var(--pc-muted); display: block; margin-top: 2px; }

    .pc-mroute { display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 700; color: var(--pc-ink); min-width: 0; }
    .pc-mroute span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pc-mroute i { color: var(--pc-brand-2); flex-shrink: 0; }

    .pc-pill { display: inline-flex; align-items: center; gap: 7px; padding: 5px 11px; border-radius: 99px; font-size: 10.5px; font-weight: 800; letter-spacing: .3px; white-space: nowrap; border: 1px solid transparent; margin-top: 8px; }
    .pc-pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .pc-pill.active { color: #6d28d9; background: #f5f0ff; border-color: #e4d8fb; }
    .pc-pill.ok { color: var(--pc-ok); background: var(--pc-ok-bg); border-color: var(--pc-ok-line); }
    .pc-pill.warn { color: var(--pc-warn); background: var(--pc-warn-bg); border-color: var(--pc-warn-line); }

    .pc-dots { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; margin-bottom: 6px; }
    .pc-dot { width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; font-size: 12px; background: var(--t-bg); color: var(--t); border: 1px solid var(--t-line); }
    .pc-dot.off { background: var(--pc-soft); color: #cfcadb; border-color: var(--pc-line); }
    .pc-docs-txt { font-size: 11.5px; font-weight: 700; color: var(--pc-muted); }
    .pc-docs-txt b { color: var(--pc-ink); }

    .pc-full-chip { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 10px; font-size: 11.5px; font-weight: 800; color: #fff; background: var(--pc-grad); box-shadow: 0 8px 18px -8px rgba(109,45,158,.7); white-space: nowrap; transition: transform .2s; }
    .pc-full-chip:hover { color: #fff; transform: translateY(-1px); }
    .pc-chev { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: var(--pc-soft); color: var(--pc-muted); transition: transform .35s ease, background .2s, color .2s; }
    .pc-folder:hover .pc-chev { background: var(--pc-tint); color: var(--pc-brand); }
    .pc-folder.is-open .pc-chev { transform: rotate(180deg); background: var(--pc-deep); color: #fff; }

    /* Detalle */
    .pc-vault { border-top: 1px solid var(--pc-line); background: linear-gradient(180deg, #fbf9ff 0%, #fff 100%); padding: 24px 26px 26px; }
    .pc-bl-alert { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 14px 18px; border-radius: 16px; margin-bottom: 18px; background: linear-gradient(120deg, #fffaf0, #fff4e6); border: 1px solid #fde3c0; }
    .pc-bl-alert > i { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: #fff; color: #ea580c; font-size: 17px; flex-shrink: 0; }
    .pc-bl-alert div { flex: 1; min-width: 200px; }
    .pc-bl-alert b { display: block; font-size: 13.5px; color: #7c2d12; }
    .pc-bl-alert span { font-size: 12px; color: #9a3412; }

    .pc-fullset {
        position: relative; overflow: hidden; display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
        padding: 20px 22px; border-radius: 18px; margin-bottom: 18px; color: #fff;
        background: radial-gradient(400px 160px at 100% 0%, rgba(96,165,250,.35), transparent 60%), linear-gradient(135deg, #2c1b4d, #6d2d9e);
        box-shadow: 0 18px 40px -20px rgba(109,45,158,.7);
    }
    .pc-fullset-ico { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; font-size: 24px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.2); flex-shrink: 0; }
    .pc-fullset-txt { flex: 1; min-width: 180px; }
    .pc-fullset-txt b { font-size: 16px; display: block; }
    .pc-fullset-txt span { font-size: 12.5px; color: #e0d7f3; }
    .pc-fullset .pc-btn-light { background: #fff; color: var(--pc-ink); }
    .pc-fullset .pc-btn-light:hover { color: var(--pc-brand); }

    .pc-files { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pc-file {
        display: flex; flex-direction: column; gap: 14px; padding: 16px; border-radius: 16px; background: #fff;
        border: 1px solid var(--pc-line); transition: transform .25s, border-color .25s, box-shadow .25s;
    }
    .pc-file:hover { transform: translateY(-3px); border-color: var(--t-line); box-shadow: 0 16px 30px -18px color-mix(in srgb, var(--t) 45%, transparent); }
    .pc-file-top { display: flex; align-items: flex-start; gap: 12px; }
    .pc-file-ico { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-size: 19px; flex-shrink: 0; background: var(--t-bg); color: var(--t); }
    .pc-file-name { font-size: 13px; font-weight: 800; color: var(--pc-ink); line-height: 1.3; display: block; }
    .pc-file-meta { font-size: 11px; color: var(--pc-muted); display: block; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
    .pc-ext { font-size: 9.5px; font-weight: 800; letter-spacing: .6px; padding: 2px 6px; border-radius: 5px; background: var(--t-bg); color: var(--t); margin-right: 4px; font-family: 'JetBrains Mono', monospace; }
    .pc-file-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: auto; }

    .pc-btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 0; cursor: pointer; padding: 9px 14px; border-radius: 10px; font-weight: 700; font-size: 12px; font-family: inherit; white-space: nowrap; transition: transform .2s, box-shadow .2s, background .2s, color .2s, border-color .2s; }
    .pc-btn-ghost { background: #fff; color: var(--pc-muted); border: 1px solid var(--pc-line); }
    .pc-btn-ghost:hover { color: var(--pc-brand); border-color: #d8c8f0; }
    .pc-btn-dark { background: var(--pc-deep); color: #fff; }
    .pc-btn-dark:hover { background: var(--pc-brand); color: #fff; transform: translateY(-1px); }
    .pc-btn-warn { background: #ea580c; color: #fff; }
    .pc-btn-warn:hover { background: #c2410c; color: #fff; transform: translateY(-1px); }
    .pc-btn-light { padding: 11px 18px; font-size: 13px; }

    .pc-pending { margin-top: 18px; padding-top: 16px; border-top: 1px dashed var(--pc-line); }
    .pc-pending-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .pc-pending-item { display: inline-flex; align-items: center; gap: 7px; padding: 7px 11px; border-radius: 10px; background: var(--pc-soft); border: 1px dashed #dcd6e7; color: var(--pc-muted); font-size: 12px; font-weight: 600; }
    .pc-pending-item i { color: var(--pc-faint); }
    .pc-pending-note { font-size: 11.5px; color: var(--pc-faint); margin-top: 10px; }

    .pc-novault { text-align: center; padding: 26px 10px; color: var(--pc-muted); font-size: 13px; }
    .pc-novault i { font-size: 28px; display: block; margin-bottom: 8px; color: var(--pc-faint); }

    .pc-empty { text-align: center; padding: 64px 20px; background: #fff; border: 1px dashed #d8d2e4; border-radius: 22px; }
    .pc-empty-ico { width: 76px; height: 76px; border-radius: 24px; margin: 0 auto 18px; display: grid; place-items: center; font-size: 34px; color: #fff; background: var(--pc-grad); box-shadow: 0 18px 36px -14px rgba(109,45,158,.6); }
    .pc-empty h5 { font-weight: 800; color: var(--pc-ink); margin-bottom: 6px; }
    .pc-empty p { color: var(--pc-muted); font-size: 14px; margin-bottom: 20px; }
    .pc-empty .pc-btn { padding: 12px 20px; font-size: 13px; }

    /* =========================================================
       4. ANIMACIONES + RESPONSIVE
       ========================================================= */
    .pc-reveal { opacity: 0; transform: translateY(26px); transition: opacity .8s ease, transform .8s cubic-bezier(.2,.8,.2,1); }
    .pc-reveal.in { opacity: 1; transform: none; }
    @@keyframes pcIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @@media (prefers-reduced-motion: reduce) {
        .pc *, .pc *::before, .pc *::after { animation: none !important; transition: none !important; }
        .pc-reveal { opacity: 1; transform: none; }
    }

    @@media (max-width: 1199.98px) {
        .pc-files { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .pc-folder-head { grid-template-columns: minmax(190px, 1fr) minmax(200px, 1.3fr) auto; grid-template-areas: "id route act" "docs docs docs"; row-gap: 12px; }
        .pc-c-docs { padding-top: 12px; border-top: 1px dashed var(--pc-line); display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
        .pc-c-docs .pc-dots { margin-bottom: 0; }
    }
    @@media (max-width: 991.98px) {
        .pc-dhero { grid-template-columns: 1fr; padding: 34px 28px; }
    }
    @@media (max-width: 767.98px) {
        .pc-folder-head { grid-template-columns: 1fr auto; grid-template-areas: "id act" "route route" "docs docs"; padding: 18px; }
        .pc-c-act .pc-full-chip span { display: none; }
        .pc-vault { padding: 16px; }
        .pc-files { grid-template-columns: 1fr; }
        .pc-search { max-width: none; }
        .pc-search kbd { display: none; }
    }
    @@media (max-width: 575.98px) {
        .pc-seg { width: 100%; }
        .pc-seg button { flex: 1; justify-content: center; padding: 8px 10px; }
    }
</style>

<div class="pc">

    <!-- =====================================================
         1. HERO
         ===================================================== -->
    <section class="pc-dhero pc-reveal">
        <div>
            <span class="pc-eyebrow">Documentación · Portal cliente</span>
            <h1>Bóveda <span>documental.</span></h1>
            <p>Accede, revisa y descarga el set documental oficial de tus embarques, siempre en su versión más reciente.</p>
            <div class="pc-dstats">
                <span class="pc-dstat"><i class="bi bi-folder2"></i> <b>@nTodas</b> carpetas</span>
                <span class="pc-dstat"><i class="bi bi-file-earmark-zip"></i> <b>@nFull</b> sets completos</span>
                <span class="pc-dstat"><i class="bi bi-shield-lock"></i> Acceso privado y cifrado</span>
            </div>
        </div>

        <div class="pc-vaultcard">
            <div class="pc-vault-stack" aria-hidden="true">
                <i class="bi bi-file-earmark-fill"></i><i class="bi bi-file-earmark-fill"></i><i class="bi bi-file-earmark-text-fill"></i>
            </div>
            <span class="pc-eyebrow">Documentos disponibles</span>
            <div class="pc-vault-num"><b data-count="@nDocs">@nDocs</b><span>listos para descarga</span></div>
            @if (nBL > 0)
            {
                <a href="#" class="pc-vault-action" data-filter-go="bl">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@nBL @(nBL == 1 ? "borrador de B/L espera" : "borradores de B/L esperan") tu revisión</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            }
            else
            {
                <span class="pc-vault-ok"><i class="bi bi-check-circle-fill"></i> Sin documentos pendientes de tu revisión</span>
            }
        </div>
    </section>

    <!-- =====================================================
         2. LISTADO DE CARPETAS
         ===================================================== -->
    <section class="pc-reveal" id="pcCarpetas">
        <div class="pc-section-head">
            <div>
                <span class="pc-eyebrow">Por operación</span>
                <h2 class="pc-section-title">Mis carpetas <span class="count">@nTodas</span></h2>
            </div>
        </div>

        <div class="pc-toolbar">
            <form method="get" class="pc-search" role="search">
                <i class="bi bi-search"></i>
                <input type="text" id="pcQuick" asp-for="SearchString" placeholder="Booking, contenedor o puerto..." autocomplete="off">
                @if (!string.IsNullOrEmpty(Model.SearchString))
                {
                    <a href="/PortalCliente/Documentos" class="pc-search-clear" title="Limpiar búsqueda"><i class="bi bi-x-circle-fill"></i></a>
                }
                else
                {
                    <kbd>/</kbd>
                }
                <button type="submit">Buscar</button>
            </form>

            @if (nTodas > 0)
            {
                <div class="pc-seg" role="tablist" aria-label="Filtrar carpetas">
                    <button type="button" class="active" data-filter="todas">Todas <span class="n">@nTodas</span></button>
                    @if (nBL > 0)
                    {
                        <button type="button" data-filter="bl">Por revisar <span class="n">@nBL</span></button>
                    }
                    <button type="button" data-filter="full">Set completo <span class="n">@nFull</span></button>
                    <button type="button" data-filter="tramite">En trámite <span class="n">@nTramite</span></button>
                </div>
            }
        </div>

        @if (data.Any())
        {
            <div class="pc-folders">
                @{ int idx = 0; }
                @foreach (var x in data)
                {
                    var op = x.Op;
                    string estado = x.D?.EstadoDocumental ?? "EN TRÁMITE";
                    string estadoCls = x.BlPorRevisar ? "warn" : (estado == "B/L APROBADO" || !string.IsNullOrEmpty(x.FullSet) ? "ok" : "active");
                    string estadoTxt = x.BlPorRevisar ? "B/L por revisar" : estado;
                    bool tieneFull = !string.IsNullOrEmpty(x.FullSet);
                    int nDisp = x.Disponibles.Count + (tieneFull ? 1 : 0);
                    string pol = op.IdPuertoOrigenNavigation?.NombrePuerto ?? "Origen";
                    string pod = op.IdPuertoDestinoNavigation?.NombrePuerto ?? "Destino";

                    var cats = new List<string>();
                    if (x.BlPorRevisar) cats.Add("bl");
                    cats.Add(tieneFull ? "full" : "tramite");
                    string catStr = string.Join(" ", cats);

                    string busqueda = $"{op.NumeroBooking} {op.NumeroContenedor} {pol} {pod}".ToLowerInvariant();

                    <article class="pc-folder" id="folder-@op.Id" data-cat="@catStr" data-search="@busqueda" style="--i:@(idx++);">
                        <div class="pc-folder-head" role="button" tabindex="0" data-bs-toggle="collapse" data-bs-target="#docs-@op.Id" aria-expanded="false" aria-controls="docs-@op.Id">

                            <div class="pc-c-id">
                                <div class="pc-folder-ico">
                                    <i class="bi bi-folder2-open"></i>
                                    @if (nDisp > 0) { <span class="badge-n">@nDisp</span> }
                                </div>
                                <div style="min-width:0;">
                                    <span class="pc-lbl">Booking</span>
                                    <span class="pc-bkg mono">@(op.NumeroBooking ?? "S/N")</span>
                                    <span class="pc-cont mono">@(op.NumeroContenedor ?? "Contenedor por asignar")</span>
                                </div>
                            </div>

                            <div class="pc-c-route">
                                <div class="pc-mroute"><span title="@pol">@pol</span><i class="bi bi-arrow-right"></i><span title="@pod">@pod</span></div>
                                <span class="pc-pill @estadoCls">@estadoTxt</span>
                            </div>

                            <div class="pc-c-docs">
                                <div class="pc-dots">
                                    @foreach (var a in x.Disponibles.Take(7))
                                    {
                                        <span class="pc-dot t-@Tono(a.IconClass)" title="@a.Nombre"><i class="bi @a.IconBi"></i></span>
                                    }
                                    @if (x.Disponibles.Count > 7)
                                    {
                                        <span class="pc-dot off" title="y @(x.Disponibles.Count - 7) más">+@(x.Disponibles.Count - 7)</span>
                                    }
                                    @if (!x.Disponibles.Any())
                                    {
                                        <span class="pc-dot off"><i class="bi bi-hourglass-split"></i></span>
                                    }
                                </div>
                                <span class="pc-docs-txt"><b>@nDisp</b> @(nDisp == 1 ? "documento disponible" : "documentos disponibles")</span>
                            </div>

                            <div class="pc-c-act">
                                @if (tieneFull)
                                {
                                    <a href="@x.FullSet" target="_blank" rel="noopener" class="pc-full-chip" onclick="event.stopPropagation();" title="Descargar Full Set">
                                        <i class="bi bi-download"></i> <span>Full Set</span>
                                    </a>
                                }
                                <span class="pc-chev"><i class="bi bi-chevron-down"></i></span>
                            </div>
                        </div>

                        <div class="collapse pc-collapse" id="docs-@op.Id">
                            <div class="pc-vault">
                                @if (x.BlPorRevisar)
                                {
                                    <div class="pc-bl-alert">
                                        <i class="bi bi-pencil-square"></i>
                                        <div>
                                            <b>Borrador de B/L listo para tu revisión</b>
                                            <span>Apruébalo o solicita cambios para continuar con la emisión.</span>
                                        </div>
                                        <a href="/PortalCliente/AprobarBL/@op.Id" class="pc-btn pc-btn-warn">Revisar borrador <i class="bi bi-arrow-right"></i></a>
                                    </div>
                                }

                                @if (tieneFull)
                                {
                                    <div class="pc-fullset">
                                        <div class="pc-fullset-ico"><i class="bi bi-file-earmark-zip-fill"></i></div>
                                        <div class="pc-fullset-txt">
                                            <b>Full Set documental</b>
                                            <span>El paquete oficial completo del embarque en un solo archivo.</span>
                                        </div>
                                        <a href="@x.FullSet" target="_blank" rel="noopener" class="pc-btn pc-btn-light"><i class="bi bi-cloud-download"></i> Descargar set</a>
                                    </div>
                                }

                                @if (x.Disponibles.Any())
                                {
                                    <div class="pc-files">
                                        @foreach (var a in x.Disponibles)
                                        {
                                            string ext = Extension(a.Ruta);
                                            string fileName = NombreArchivo(a.Ruta);
                                            <div class="pc-file t-@Tono(a.IconClass)">
                                                <div class="pc-file-top">
                                                    <div class="pc-file-ico"><i class="bi @a.IconBi"></i></div>
                                                    <div style="min-width:0;">
                                                        <span class="pc-file-name">@a.Nombre</span>
                                                        <span class="pc-file-meta" title="@fileName"><span class="pc-ext">@ext</span>@(string.IsNullOrEmpty(fileName) ? "Disponible" : fileName)</span>
                                                    </div>
                                                </div>
                                                <div class="pc-file-actions">
                                                    <a href="@a.Ruta" target="_blank" rel="noopener" class="pc-btn pc-btn-ghost"><i class="bi bi-eye"></i> Ver</a>
                                                    <a href="@a.Ruta" download class="pc-btn pc-btn-dark"><i class="bi bi-download"></i> Descargar</a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!tieneFull)
                                {
                                    <div class="pc-novault">
                                        <i class="bi bi-hourglass-split"></i>
                                        Tus documentos se están preparando. Aparecerán aquí apenas sean emitidos.
                                    </div>
                                }

                                @if (x.Pendientes.Any())
                                {
                                    <div class="pc-pending">
                                        <span class="pc-lbl">Aún no emitidos</span>
                                        <div class="pc-pending-list">
                                            @foreach (var p in x.Pendientes)
                                            {
                                                <span class="pc-pending-item"><i class="bi @p.IconBi"></i> @p.Nombre</span>
                                            }
                                        </div>
                                        <div class="pc-pending-note">Algunos documentos pueden no aplicar a tu tipo de carga o destino.</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div id="pcFilterEmpty" class="pc-empty mt-2" hidden>
                <div class="pc-empty-ico"><i class="bi bi-funnel"></i></div>
                <h5>Nada por aquí</h5>
                <p>No hay carpetas que coincidan con este filtro o búsqueda.</p>
            </div>
        }
        else
        {
            <div class="pc-empty">
                <div class="pc-empty-ico"><i class="bi bi-folder2"></i></div>
                @if (!string.IsNullOrEmpty(Model.SearchString))
                {
                    <h5>Sin resultados para "@Model.SearchString"</h5>
                    <p>Revisa el número de booking o contenedor e inténtalo nuevamente.</p>
                    <a href="/PortalCliente/Documentos" class="pc-btn pc-btn-dark"><i class="bi bi-arrow-counterclockwise"></i> Ver todas</a>
                }
                else
                {
                    <h5>Tu bóveda aún está vacía</h5>
                    <p>Los documentos de tus embarques aparecerán aquí a medida que se emitan.</p>
                    <a href="/PortalCliente/Operaciones" class="pc-btn pc-btn-dark"><i class="bi bi-arrow-left"></i> Volver a mis operaciones</a>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // ===== Reveal on scroll =====
            const reveals = document.querySelectorAll('.pc-reveal');
            if ('IntersectionObserver' in window && !reduce) {
                const io = new IntersectionObserver((entries) => {
                    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
                }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
                reveals.forEach(el => io.observe(el));
            } else {
                reveals.forEach(el => el.classList.add('in'));
            }

            // ===== Count-up =====
            document.querySelectorAll('[data-count]').forEach(el => {
                const target = parseFloat(el.dataset.count) || 0;
                if (reduce || target === 0) return;
                const dur = 1100, t0 = performance.now();
                const step = (now) => {
                    const p = Math.min((now - t0) / dur, 1);
                    el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))).toLocaleString('es-CL');
                    if (p < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
            });

            // ===== Estado abierto + teclado =====
            document.querySelectorAll('.pc-collapse').forEach(c => {
                const card = c.closest('.pc-folder');
                const head = card.querySelector('.pc-folder-head');
                c.addEventListener('show.bs.collapse', () => { card.classList.add('is-open'); head.setAttribute('aria-expanded', 'true'); });
                c.addEventListener('hide.bs.collapse', () => { card.classList.remove('is-open'); head.setAttribute('aria-expanded', 'false'); });
            });
            document.querySelectorAll('.pc-folder-head').forEach(h => {
                h.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); h.click(); } });
            });

            // ===== Filtro por estado + búsqueda instantánea =====
            const chips = document.querySelectorAll('.pc-seg [data-filter]');
            const quick = document.getElementById('pcQuick');
            let filtro = 'todas';

            const aplicar = () => {
                const q = (quick?.value || '').trim().toLowerCase();
                let visibles = 0;
                document.querySelectorAll('.pc-folder').forEach(f => {
                    const okCat = filtro === 'todas' || (f.dataset.cat || '').split(' ').includes(filtro);
                    const okQ = !q || (f.dataset.search || '').includes(q);
                    const ok = okCat && okQ;
                    f.style.display = ok ? '' : 'none';
                    if (ok) visibles++;
                });
                const empty = document.getElementById('pcFilterEmpty');
                if (empty) empty.hidden = visibles > 0;
            };

            const setFiltro = (f) => {
                filtro = f;
                chips.forEach(x => x.classList.toggle('active', x.dataset.filter === f));
                aplicar();
            };

            chips.forEach(c => c.addEventListener('click', () => setFiltro(c.dataset.filter)));
            quick?.addEventListener('input', aplicar);

            document.querySelectorAll('[data-filter-go]').forEach(a => a.addEventListener('click', e => {
                e.preventDefault();
                setFiltro(a.dataset.filterGo);
                document.getElementById('pcCarpetas')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }));

            // Atajo "/" para enfocar el buscador
            document.addEventListener('keydown', e => {
                if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
                    e.preventDefault();
                    quick?.focus();
                }
            });

            // ===== Abrir carpeta desde otra vista (#docs-ID) =====
            if (location.hash && location.hash.startsWith('#docs-')) {
                const target = document.querySelector(location.hash);
                if (target && window.bootstrap) {
                    bootstrap.Collapse.getOrCreateInstance(target, { toggle: false }).show();
                    setTimeout(() => target.closest('.pc-folder')?.scrollIntoView({ behavior: 'smooth', block: 'center' }), 250);
                }
            }
        });
    </script>
}
