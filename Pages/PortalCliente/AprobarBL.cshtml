@page "{id:int}"
@model AtilsonCargoSpa.Pages.PortalCliente.AprobarBLModel
@{
    ViewData["Title"] = "Revisión de Borrador B/L";
    Layout = "_LayoutCliente";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --atilson-dark: #0f172a;
        --text-main: #334155;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --bg-light: #f8fafc;
        --atilson-purple: #6d2d9e;
    }
    body { background-color: var(--bg-light); font-family: 'Inter', system-ui, sans-serif; color: var(--text-main); }

    .review-card {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 35px;
        max-width: 700px;
        margin: 0 auto;
        box-shadow: 0 4px 10px rgba(0,0,0,0.03);
    }
    .doc-preview {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--bg-light);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 18px 20px;
        margin-bottom: 25px;
    }
</style>

<div class="container-fluid py-4" style="max-width: 900px;">
    <div class="mb-4 border-bottom pb-3">
        <a asp-page="./Index" class="text-decoration-none text-muted fw-bold" style="font-size: 12px;">
            <i class="bi bi-arrow-left"></i> Volver a Mis Operaciones
        </a>
        <h1 class="mt-3" style="font-size: 22px; font-weight: 900; color: var(--atilson-dark); letter-spacing: -0.5px;">REVISIÓN DE BORRADOR B/L</h1>
        <p class="text-muted small m-0 fw-medium">Booking: <strong>@(Model.Operacion.NumeroBooking ?? "S/N")</strong></p>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" style="font-size: 13px; max-width: 700px; margin: 0 auto 20px;">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <div class="review-card">
        <div class="doc-preview">
            <div class="d-flex align-items-center">
                <i class="bi bi-file-earmark-pdf-fill text-danger me-3" style="font-size: 28px;"></i>
                <div>
                    <span class="d-block fw-bold text-dark" style="font-size: 14px;">Borrador de Bill of Lading (B/L)</span>
                    <span class="text-muted" style="font-size: 11px;">Estado actual: @(Model.Doc?.EstadoDocumental ?? "En trámite")</span>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Doc?.RutaBL))
            {
                <a href="@Model.Doc.RutaBL" target="_blank" class="btn btn-sm btn-dark fw-bold px-3" style="font-size: 11px;"><i class="bi bi-eye me-1"></i> Ver PDF</a>
            }
        </div>

        @if (string.IsNullOrEmpty(Model.Doc?.RutaBL))
        {
            <div class="alert alert-warning" style="font-size: 12px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Aún no se ha adjuntado el borrador. Contacta a tu ejecutivo Atilson si esperabas revisarlo hoy.
            </div>
        }
        else
        {
            <p class="text-muted mb-4" style="font-size: 13px;">Por favor revise el documento adjunto. Si toda la información es correcta, apruébelo para continuar el trámite. Si necesita correcciones, indíquelas a continuación.</p>

            <div class="d-flex gap-2 mb-4">
                <form method="post" asp-page-handler="Aprobar" asp-route-id="@Model.Operacion.Id" style="flex: 1;" id="frmAprobar">
                    <button type="submit" class="btn btn-success fw-bold w-100 py-2" style="font-size: 13px;"><i class="bi bi-check-circle me-2"></i> Aprobar Borrador</button>
                </form>
                <button type="button" class="btn btn-outline-danger fw-bold flex-fill py-2" style="font-size: 13px;" onclick="document.getElementById('panelRechazo').classList.remove('d-none')"><i class="bi bi-x-circle me-2"></i> Solicitar Cambios</button>
            </div>

            <div id="panelRechazo" class="d-none">
                <form method="post" asp-page-handler="Rechazar" asp-route-id="@Model.Operacion.Id">
                    <label class="form-label fw-bold text-muted" style="font-size: 11px; text-transform: uppercase;">Detalle los cambios requeridos</label>
                    <textarea name="comentario" class="form-control mb-3" rows="4" placeholder="Ej: Favor corregir el peso bruto, actualizar la dirección del consignatario..." required></textarea>
                    <button type="submit" class="btn btn-dark fw-bold px-4" style="font-size: 12px;"><i class="bi bi-send me-2"></i> Enviar Solicitud de Cambios</button>
                </form>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('frmAprobar')?.addEventListener('submit', function(e) {
            e.preventDefault();
            Swal.fire({
                title: '¿Confirmar aprobación?',
                text: 'Esta acción notificará a Atilson que el borrador de B/L está listo para continuar.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, aprobar',
                confirmButtonColor: '#16a34a',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) e.target.submit();
            });
        });
    </script>
}