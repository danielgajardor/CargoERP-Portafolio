@page
@model AtilsonCargoSpa.Pages.PortalCliente.IndexModel
@using AtilsonCargoSpa.Models
@using System.Globalization
@functions {
    // Normaliza fechas (soporta DateTime? y DateOnly? según cómo esté scaffoldeado el modelo)
    private static DateTime? AFecha(DateTime? d) => d;
    private static DateTime? AFecha(DateOnly? d) => d?.ToDateTime(TimeOnly.MinValue);

    // % de avance del viaje marítimo entre ETD y ETA
    private static int ProgresoViaje(DateTime? etd, DateTime? eta, DateTime ahora)
    {
        if (!etd.HasValue || !eta.HasValue) return 0;
        if (ahora <= etd.Value) return 0;
        if (ahora >= eta.Value) return 100;
        var total = (eta.Value - etd.Value).TotalHours;
        if (total <= 0) return 100;
        return (int)Math.Round((ahora - etd.Value).TotalHours / total * 100);
    }

    private static bool BlPorAprobar(Operacione op) =>
        op.OperacionesDocumentales != null && op.OperacionesDocumentales.Any(d => d.EstadoDocumental == "BORRADOR ENVIADO");

    // Mismo criterio que AccionesRequeridas del PageModel
    private static bool RequiereAccion(Operacione op) =>
        op.OperacionesDocumentales != null && op.OperacionesDocumentales.Any(d =>
            d.EstadoDocumental == "BORRADOR ENVIADO" ||
            (d.LogSanitario != null && d.LogSanitario.Contains("ENVÍO A CLIENTE") && !d.LogSanitario.Contains("RESPUESTA")));

    // Tokens para el filtro client-side: curso | finalizada | cancelada (+ accion)
    private string Tokens(Operacione op)
    {
        var t = new List<string>();
        bool fin = Model.OperacionCerradaPorRetiro(op) || op.EstadoWorkflow == "Cerrado" || op.EstadoWorkflow == "Finalizado";
        if (fin) t.Add("finalizada");
        else if (op.EstadoWorkflow == "Cancelado") t.Add("cancelada");
        else t.Add("curso");
        if (RequiereAccion(op)) t.Add("accion");
        return string.Join(" ", t);
    }
}
@{
    ViewData["Title"] = "Inicio";
    Layout = "_LayoutCliente";

    var ahora = DateTime.Now;
    var es = new CultureInfo("es-CL");
    var ops = Model.OperacionesCliente ?? new List<Operacione>();

    string nombreCliente = User.Identity?.Name ?? "Cliente";
    if (nombreCliente.Contains("@")) { nombreCliente = nombreCliente.Split('@')[0]; }

    string saludo = ahora.Hour < 12 ? "Buenos días" : (ahora.Hour < 20 ? "Buenas tardes" : "Buenas noches");
    string fechaHoy = ahora.ToString("dddd d 'de' MMMM", es);
    fechaHoy = char.ToUpper(fechaHoy[0]) + fechaHoy.Substring(1);

    var tokens = ops.ToDictionary(o => o.Id, o => Tokens(o));
    int nTodas = ops.Count;
    int nCurso = tokens.Values.Count(v => v.Contains("curso"));
    int nAccion = tokens.Values.Count(v => v.Contains("accion"));
    int nFin = tokens.Values.Count(v => v.Contains("finalizada"));

    var proximo = ops
        .Where(o => tokens[o.Id].Contains("curso"))
        .Select(o => new { Op = o, Etd = AFecha(o.EtdPol), Eta = AFecha(o.EtaPod) })
        .Where(x => x.Eta.HasValue && x.Eta.Value >= ahora.Date)
        .OrderBy(x => x.Eta)
        .FirstOrDefault();

    string resumen = nTodas == 0
        ? "Comienza tu primera operación solicitando una cotización. Nosotros nos encargamos del resto."
        : $"Tienes {nCurso} {(nCurso == 1 ? "embarque en curso" : "embarques en curso")}"
          + (nAccion > 0 ? $" y {nAccion} {(nAccion == 1 ? "acción que requiere" : "acciones que requieren")} tu revisión." : ". Todo está al día.");

    int pctActivos = nTodas == 0 ? 0 : (int)Math.Round(nCurso * 100.0 / nTodas);
    int pctFin = nTodas == 0 ? 0 : (int)Math.Round(nFin * 100.0 / nTodas);

    string shipSvg = "<svg viewBox=\"0 0 24 24\" width=\"1em\" height=\"1em\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 14h18l-2.2 4.4a2 2 0 0 1-1.8 1.1H7a2 2 0 0 1-1.8-1.1z\"/><path d=\"M6 14V9h4v5\"/><path d=\"M10 14v-3h4v3\"/><path d=\"M14 14V7h4v7\"/></svg>";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">

<link rel="stylesheet" href="~/css/portal-cliente.css" asp-append-version="true" />


<form id="antiForgeryFormCliente">@Html.AntiForgeryToken()</form>

<div class="pc">

    <!-- =====================================================
         1. HERO
         ===================================================== -->
    <section class="pc-hero pc-reveal">
        <div id="pcHeroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-pause="false" data-bs-interval="6000" aria-hidden="true">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="https://images.unsplash.com/photo-1494412651409-8963ce7935a7?auto=format&fit=crop&w=1920&q=80" class="pc-hero-img" alt="">
                </div>
                <div class="carousel-item">
                    <img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?auto=format&fit=crop&w=1920&q=80" class="pc-hero-img" alt="">
                </div>
                <div class="carousel-item">
                    <img src="https://images.unsplash.com/photo-1616156027751-fc9a850fdc9b?auto=format&fit=crop&w=1920&q=80" class="pc-hero-img" alt="">
                </div>
            </div>
        </div>

        <div class="pc-hero-body">
            <div>
                <span class="pc-live"><span class="pc-live-dot"></span> Portal en línea · @fechaHoy</span>
                <h1 class="pc-hero-title">@saludo,<br><span>@nombreCliente.</span></h1>
                <p class="pc-hero-sub">@resumen</p>
                <div class="pc-hero-ctas">
                    <a asp-page="./SolicitarCotizacion" class="pc-btn pc-btn-light"><i class="bi bi-calculator"></i> Solicitar cotización</a>
                    <a asp-page="./SolicitarReserva" class="pc-btn pc-btn-glass"><i class="bi bi-calendar-check"></i> Solicitar servicio</a>
                    <a asp-page="./Itinerarios" class="pc-btn pc-btn-glass"><i class="bi bi-calendar2-week"></i> Itinerarios</a>
                </div>
            </div>

            <div class="pc-glass">
                @if (proximo != null)
                {
                    int dias = (int)Math.Ceiling((proximo.Eta!.Value - ahora).TotalDays);
                    int pctProx = ProgresoViaje(proximo.Etd, proximo.Eta, ahora);
                    <div class="pc-glass-head">
                        <span class="pc-eyebrow">Próximo arribo</span>
                        <span class="pc-glass-bkg mono">@(proximo.Op.NumeroBooking ?? "S/N")</span>
                    </div>
                    <div class="pc-countdown">
                        @if (dias <= 0)
                        {
                            <b>Hoy</b>
                        }
                        else
                        {
                            <b>@dias</b><span>@(dias == 1 ? "día restante" : "días restantes")</span>
                        }
                    </div>
                    <div class="pc-glass-route">
                        <span class="t" title="@(proximo.Op.IdPuertoOrigenNavigation?.NombrePuerto)">@(proximo.Op.IdPuertoOrigenNavigation?.NombrePuerto ?? "Origen")</span>
                        <i class="bi bi-arrow-right"></i>
                        <span class="t" title="@(proximo.Op.IdPuertoDestinoNavigation?.NombrePuerto)">@(proximo.Op.IdPuertoDestinoNavigation?.NombrePuerto ?? "Destino")</span>
                    </div>
                    <div class="pc-glass-bar"><div style="width: @pctProx%"></div></div>
                    <div class="pc-glass-foot">
                        <span>@(proximo.Op.Nave ?? "Nave por confirmar")</span>
                        <span class="mono">ETA @proximo.Eta.Value.ToString("dd MMM yyyy", es)</span>
                    </div>
                }
                else
                {
                    <div class="pc-glass-empty">
                        <i class="bi bi-compass"></i>
                        Sin arribos programados por ahora.<br>
                        <span style="font-size:12px; color:#a99fc4;">Cuando tengas embarques en tránsito verás aquí su cuenta regresiva.</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- =====================================================
         2. KPIs
         ===================================================== -->
    <section class="pc-kpis pc-reveal">
        <div class="pc-kpi" style="--k:#6d2d9e;">
            <div class="pc-kpi-top">
                <div class="pc-kpi-ico">@Html.Raw(shipSvg)</div>
                @if (Model.CargasActivas > 0)
                {
                    <span class="pc-trend ok">En tránsito</span>
                }
            </div>
            <div class="pc-kpi-label">Embarques activos</div>
            <div class="pc-kpi-value" data-count="@Model.CargasActivas">@Model.CargasActivas</div>
            <div class="pc-meter"><div data-w="@pctActivos"></div></div>
            <div class="pc-kpi-foot">@pctActivos% de tus operaciones</div>
        </div>

        <div class="pc-kpi" style="--k:#059669;">
            <div class="pc-kpi-top">
                <div class="pc-kpi-ico"><i class="bi bi-patch-check"></i></div>
            </div>
            <div class="pc-kpi-label">Completados (histórico)</div>
            <div class="pc-kpi-value" data-count="@Model.EmbarquesFinalizados">@Model.EmbarquesFinalizados</div>
            <div class="pc-meter"><div data-w="@pctFin"></div></div>
            <div class="pc-kpi-foot">Entregas finalizadas con éxito</div>
        </div>

        <div class="pc-kpi" style="--k:#ea580c;">
            <div class="pc-kpi-top">
                <div class="pc-kpi-ico"><i class="bi bi-file-earmark-check"></i></div>
                @if (Model.AccionesRequeridas > 0)
                {
                    <span class="pc-trend warn">Pendiente</span>
                }
            </div>
            <div class="pc-kpi-label">Acción requerida</div>
            <div class="pc-kpi-value" data-count="@Model.AccionesRequeridas">@Model.AccionesRequeridas</div>
            <div class="pc-kpi-foot">
                @if (Model.AccionesRequeridas > 0)
                {
                    <a href="/PortalCliente/Operaciones?vista=accion">Revisar ahora <i class="bi bi-arrow-right"></i></a>
                }
                else
                {
                    <i class="bi bi-check2-circle text-success"></i> <span>Todo al día</span>
                }
            </div>
        </div>

        <div class="pc-kpi" style="--k:#2563eb;">
            <div class="pc-kpi-top">
                <div class="pc-kpi-ico"><i class="bi bi-wallet2"></i></div>
            </div>
            <div class="pc-kpi-label">Saldo pendiente</div>
            <div class="pc-kpi-value">$<span data-count="@Model.SaldoPendienteTotal.ToString("0", CultureInfo.InvariantCulture)">@Model.SaldoPendienteTotal.ToString("N0", es)</span><small>USD</small></div>
            <div class="pc-kpi-foot">
                <a href="/PortalCliente/Facturas">Ver estado de cuenta <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </section>

    <!-- =====================================================
         3. ALERTA DE ACCIÓN REQUERIDA
         ===================================================== -->
    @if (nAccion > 0)
    {
        <section class="pc-alert pc-reveal">
            <div class="pc-alert-ico"><i class="bi bi-bell-fill"></i></div>
            <div class="pc-alert-txt">
                <b>Necesitamos tu confirmación</b>
                <span>Hay documentos esperando tu revisión para continuar el trámite sin demoras.</span>
            </div>
            <div class="pc-alert-items">
                @foreach (var op in ops.Where(o => tokens[o.Id].Contains("accion")))
                {
                    if (BlPorAprobar(op))
                    {
                        <a href="/PortalCliente/AprobarBL/@op.Id" class="pc-alert-chip"><i class="bi bi-file-earmark-text"></i> <span class="mono">@(op.NumeroBooking ?? "S/N")</span> · Revisar B/L</a>
                    }
                    else
                    {
                        <a href="/PortalCliente/Operaciones?abrir=@op.Id" class="pc-alert-chip"><i class="bi bi-clipboard2-pulse"></i> <span class="mono">@(op.NumeroBooking ?? "S/N")</span> · Ver detalle</a>
                    }
                }
            </div>
        </section>
    }

    <!-- =====================================================
         4. EN CURSO (resumen; la lista completa está en Mis operaciones)
         ===================================================== -->
    @{
        var enCurso = ops
            .Where(o => tokens[o.Id].Contains("curso"))
            .Select(o => new { Op = o, Etd = AFecha(o.EtdPol), Eta = AFecha(o.EtaPod) })
            .OrderBy(x => x.Eta.HasValue ? 0 : 1).ThenBy(x => x.Eta).ThenByDescending(x => x.Op.Id)
            .Take(5)
            .ToList();
    }
    <section class="pc-reveal pc-resumen" id="pcEnCurso">
        <div class="pc-section-head">
            <div>
                <span class="pc-eyebrow">Resumen</span>
                <h2 class="pc-section-title">Embarques en curso <span class="count">@nCurso</span></h2>
            </div>
            <a href="/PortalCliente/Operaciones" class="pc-btn pc-btn-dark pc-resumen-all">Ver todas mis operaciones <i class="bi bi-arrow-right"></i></a>
        </div>

        @if (enCurso.Any())
        {
            <div class="pc-resumen-list">
                @foreach (var x in enCurso)
                {
                    var op = x.Op;
                    int pctR = ProgresoViaje(x.Etd, x.Eta, ahora);
                    bool accionR = tokens[op.Id].Contains("accion");
                    <a class="pc-resumen-row" href="/PortalCliente/Operaciones?abrir=@op.Id">
                        <span class="pc-resumen-bkg mono">@(op.NumeroBooking ?? "Sin booking")</span>
                        <span class="pc-resumen-ruta">
                            <span class="t">@(op.IdPuertoOrigenNavigation?.NombrePuerto ?? "Por definir")</span>
                            <i class="bi bi-arrow-right"></i>
                            <span class="t">@(op.IdPuertoDestinoNavigation?.NombrePuerto ?? "Por definir")</span>
                        </span>
                        <span class="pc-resumen-estado">
                            @(op.EstadoWorkflow ?? "En proceso")
                            @if (accionR)
                            {
                                <span class="pc-resumen-accion">Por revisar</span>
                            }
                        </span>
                        <span class="pc-resumen-eta mono">@(x.Eta.HasValue ? "ETA " + x.Eta.Value.ToString("dd MMM", es) : "ETA por confirmar")</span>
                        <span class="pc-resumen-bar" aria-hidden="true"><span data-w="@pctR"></span></span>
                        <i class="bi bi-chevron-right pc-resumen-go" aria-hidden="true"></i>
                    </a>
                }
            </div>
            @if (nCurso > enCurso.Count)
            {
                <p class="pc-resumen-mas">Y @(nCurso - enCurso.Count) más en <a href="/PortalCliente/Operaciones?vista=curso">Mis operaciones</a>.</p>
            }
        }
        else
        {
            <div class="pc-empty">
                <div class="pc-empty-ico"><i class="bi bi-inboxes"></i></div>
                @if (nTodas == 0)
                {
                    <h5>Aún no tienes operaciones</h5>
                    <p>Solicita tu primera cotización y empieza a importar o exportar con nosotros.</p>
                    <a href="/PortalCliente/SolicitarCotizacion" class="pc-btn pc-btn-grad" style="width:auto; display:inline-flex;"><i class="bi bi-plus-lg"></i> Solicitar cotización</a>
                }
                else
                {
                    <h5>No tienes embarques en curso</h5>
                    <p>Tu historial completo está en Mis operaciones.</p>
                    <a href="/PortalCliente/Operaciones?vista=finalizada" class="pc-btn pc-btn-dark" style="width:auto; display:inline-flex;"><i class="bi bi-clock-history"></i> Ver historial</a>
                }
            </div>
        }
    </section>


    <!-- =====================================================
         5. RUTAS & SERVICIOS
         ===================================================== -->
    <section class="pc-routes pc-reveal">
        <div class="pc-routes-head">
            <div>
                <span class="pc-eyebrow">Explora</span>
                <h3>Rutas destacadas &amp; servicios</h3>
            </div>
            <div class="pc-arrows">
                <button type="button" class="pc-arrow" data-slide="prev" aria-label="Anterior"><i class="bi bi-arrow-left"></i></button>
                <button type="button" class="pc-arrow" data-slide="next" aria-label="Siguiente"><i class="bi bi-arrow-right"></i></button>
            </div>
        </div>

        <div class="pc-slider" id="pcSlider">
            <div class="pc-slider-track">
                <a href="/PortalCliente/SolicitarCotizacion" class="pc-vcard">
                    <div class="pc-vcard-arte" style="--a:#3d2a8c;--b:#140c26"><svg class="pc-arte-ruta" viewBox="0 0 290 200" aria-hidden="true"><path d="M60 120 C 110 20, 190 10, 232 70" /><circle cx="60" cy="120" r="6"/><circle cx="232" cy="70" r="6"/><text x="60" y="146" text-anchor="middle">CL SAI</text><text x="232" y="96" text-anchor="middle">CN SHA</text></svg><i class="bi bi-globe-asia-australia"></i></div>
                    <div class="pc-vcard-ov">
                        <span class="pc-vcard-badge">Importación</span>
                        <h4>Ruta Asia Pacífico</h4>
                        <p>Shanghai, Ningbo, Yantian. <i class="bi bi-arrow-up-right"></i></p>
                    </div>
                </a>
                <a href="/PortalCliente/SolicitarCotizacion" class="pc-vcard">
                    <div class="pc-vcard-arte" style="--a:#443094;--b:#1a1139"><svg class="pc-arte-ruta" viewBox="0 0 290 200" aria-hidden="true"><path d="M70 140 C 90 60, 160 30, 220 60" /><circle cx="70" cy="140" r="6"/><circle cx="220" cy="60" r="6"/><text x="70" y="166" text-anchor="middle">CL VAP</text><text x="220" y="86" text-anchor="middle">NL RTM</text></svg><i class="bi bi-globe-europe-africa"></i></div>
                    <div class="pc-vcard-ov">
                        <span class="pc-vcard-badge">Exportación</span>
                        <h4>Conexión Europea</h4>
                        <p>Rotterdam, Amberes, Hamburgo. <i class="bi bi-arrow-up-right"></i></p>
                    </div>
                </a>
                <a href="/PortalCliente/SolicitarCotizacion" class="pc-vcard">
                    <div class="pc-vcard-arte pc-vcard-arte--icono" style="--a:#2b4c9a;--b:#120d2b"><i class="bi bi-snow2"></i></div>
                    <div class="pc-vcard-ov">
                        <span class="pc-vcard-badge">Servicio especial</span>
                        <h4>Carga refrigerada</h4>
                        <p>Control térmico para perecederos. <i class="bi bi-arrow-up-right"></i></p>
                    </div>
                </a>
                <a href="/PortalCliente/SolicitarCotizacion" class="pc-vcard">
                    <div class="pc-vcard-arte pc-vcard-arte--icono" style="--a:#5b2d8c;--b:#160e2f"><i class="bi bi-file-earmark-check"></i></div>
                    <div class="pc-vcard-ov">
                        <span class="pc-vcard-badge">Servicio especial</span>
                        <h4>Gestión aduanera</h4>
                        <p>Tramitación ágil y sin demoras. <i class="bi bi-arrow-up-right"></i></p>
                    </div>
                </a>
                <a href="/PortalCliente/SolicitarCotizacion" class="pc-vcard-cta">
                    <i class="bi bi-globe-americas"></i>
                    <b>¿Otra ruta en mente?</b>
                    <span>Cotiza cualquier origen y destino. Respondemos en menos de 24 h.</span>
                </a>
            </div>
        </div>
    </section>

    <!-- =====================================================
         6. ACCESOS RÁPIDOS + SOPORTE
         ===================================================== -->
    <section class="pc-bottom pc-reveal">
        <div class="pc-panel">
            <h5 class="pc-panel-title"><i class="bi bi-lightning-charge-fill" style="background:#fffbeb; color:#d97706;"></i> Accesos rápidos</h5>
            <ul class="pc-quick">
                <li>
                    <a href="/PortalCliente/Documentos">
                        <span class="pc-quick-ico" style="background:#ecfdf5; color:#059669;"><i class="bi bi-file-earmark-spreadsheet"></i></span>
                        <span>
                            <span class="pc-quick-main">Descargar matriz en blanco</span>
                            <span class="pc-quick-sub">Formato Excel para llenado masivo</span>
                        </span>
                        <i class="bi bi-chevron-right go"></i>
                    </a>
                </li>
                <li>
                    <a href="/PortalCliente/Facturas">
                        <span class="pc-quick-ico" style="background:#eff6ff; color:#2563eb;"><i class="bi bi-receipt-cutoff"></i></span>
                        <span>
                            <span class="pc-quick-main">Últimas facturas emitidas</span>
                            <span class="pc-quick-sub">Revisa tus saldos del mes actual</span>
                        </span>
                        <i class="bi bi-chevron-right go"></i>
                    </a>
                </li>
                <li>
                    <a href="/PortalCliente/Itinerarios">
                        <span class="pc-quick-ico" style="background:#f5f0ff; color:#6d2d9e;"><i class="bi bi-calendar2-week"></i></span>
                        <span>
                            <span class="pc-quick-main">Itinerarios semanales</span>
                            <span class="pc-quick-sub">Fechas de corte y salidas disponibles</span>
                        </span>
                        <i class="bi bi-chevron-right go"></i>
                    </a>
                </li>
            </ul>
        </div>

        <div class="pc-panel">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="pc-panel-title"><i class="bi bi-headset" style="background:#eff6ff; color:#2563eb;"></i> Soporte operativo</h5>
                <a href="/PortalCliente/Soporte" class="pc-soporte-link">Ver mis consultas <i class="bi bi-arrow-right"></i></a>
            </div>
            <p class="mt-3 mb-4" style="font-size: 13.5px; color: var(--pc-muted);">¿Consultas sobre un embarque en curso? Escríbenos y te respondemos aquí y a tu correo.</p>
            <form method="post" asp-page="/PortalCliente/Soporte" asp-page-handler="Crear">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="pc-field">
                            <label for="pcSopRef">Booking o referencia</label>
                            <input type="text" id="pcSopRef" name="Referencia" class="pc-input mono" maxlength="60" list="pcSopBookings" placeholder="Ej: @(ops.FirstOrDefault()?.NumeroBooking ?? "BK123456")" autocomplete="off">
                            <datalist id="pcSopBookings">@foreach (var o in ops.Take(40)) { <option value="@o.NumeroBooking"></option> }</datalist>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="pc-field">
                            <label for="pcSopTipo">Tipo de consulta</label>
                            <select id="pcSopTipo" name="Tipo" class="pc-input" required>
                                <option value="">Selecciona...</option>
                                @foreach (var t in AtilsonCargoSpa.Models.TicketSoporte.Tipos) { <option value="@t">@t</option> }
                            </select>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="pc-field">
                            <label for="pcSopDetalle">Detalle</label>
                            <textarea id="pcSopDetalle" name="Detalle" class="pc-input" rows="3" maxlength="2000" required placeholder="Cuéntanos qué necesitas..."></textarea>
                        </div>
                    </div>
                    <div class="col-12 mt-3">
                        <button type="submit" class="pc-btn pc-btn-grad">Enviar consulta <i class="bi bi-send"></i></button>
                    </div>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // ===== Reveal on scroll =====
            const reveals = document.querySelectorAll('.pc-reveal');
            if ('IntersectionObserver' in window && !reduce) {
                const io = new IntersectionObserver((entries) => {
                    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
                }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
                reveals.forEach(el => io.observe(el));
            } else {
                reveals.forEach(el => el.classList.add('in'));
            }

            // ===== Count-up KPIs =====
            document.querySelectorAll('[data-count]').forEach(el => {
                const target = parseFloat(el.dataset.count) || 0;
                if (reduce || target === 0) return;
                const dur = 1200, t0 = performance.now();
                const step = (now) => {
                    const p = Math.min((now - t0) / dur, 1);
                    const eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = Math.round(target * eased).toLocaleString('es-CL');
                    if (p < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
            });

            // ===== Barras y barcos (animación de entrada) =====
            requestAnimationFrame(() => setTimeout(() => {
                document.querySelectorAll('[data-w]').forEach(el => el.style.width = el.dataset.w + '%');
                document.querySelectorAll('[data-left]').forEach(el => el.style.left = el.dataset.left + '%');
            }, 150));

            // ===== Slider de rutas =====
            const slider = document.getElementById('pcSlider');
            document.querySelectorAll('[data-slide]').forEach(b => b.addEventListener('click', () => {
                slider.scrollBy({ left: (b.dataset.slide === 'next' ? 1 : -1) * 308, behavior: 'smooth' });
            }));
        });
    </script>

    @if (TempData["BLResultado"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    title: '@Html.Raw(TempData["BLResultado"]?.ToString() == "aprobado" ? "¡Borrador aprobado!" : "Cambios registrados")',
                    text: '@Html.Raw(TempData["BLResultado"]?.ToString() == "aprobado" ? "Hemos notificado a nuestro equipo. Continuaremos con el trámite." : "Hemos registrado tus comentarios. Nuestro equipo revisará el borrador.")',
                    icon: '@(TempData["BLResultado"]?.ToString() == "aprobado" ? "success" : "info")',
                    confirmButtonColor: '#2c1b4d'
                });
            });
        </script>
    }
}
