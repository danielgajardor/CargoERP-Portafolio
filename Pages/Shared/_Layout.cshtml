<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Atilson Cargo ERP</title>
    <script>
        // Densidad de la vista (oct-2026, adaptable desde nov-2026): con el navegador al 100%
        // el ERP se dibuja al 90% en pantallas de notebook/escritorio (como con el zoom del
        // navegador en 90%). En monitores grandes sube (100% / 110%) para que letras y tablas
        // no queden diminutas, y en celular/tablet queda al 100% con el menú plegable.
        // Se recalcula al cambiar el tamaño o al mover la pestaña a otro monitor.
        // Ver wwwroot/js/escala-vista.js.
        (function () {
            var html = document.documentElement;
            function escalaPara(w) { return w < 992 ? 1 : w < 2000 ? 0.9 : w < 2400 ? 1 : 1.1; }
            function aplicar() {
                var z = escalaPara(window.innerWidth);
                if (html.getAttribute('data-escala') === String(z)) return false;
                html.setAttribute('data-escala', String(z));
                html.style.setProperty('--escala', z);
                html.style.zoom = z === 1 ? '' : z;
                return true;
            }
            aplicar();
            var t;
            window.addEventListener('resize', function () {
                clearTimeout(t);
                t = setTimeout(function () { if (aplicar() && window.escalaVistaParchear) window.escalaVistaParchear(); }, 120);
            });
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/traspaso-finanzas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/erp-comun.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
            :root {
                --atilson-dark: #0f172a;
                --atilson-darker: #020617;
                --atilson-accent: #6d2d9e;
                --atilson-accent-light: #9b51e0;
                --dark-text: #1e293b;
                --bg-light: #f8fafc;
                --sidebar-width: 240px; /* Ajustado para lectura completa */
                --sidebar-collapsed-width: 70px;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-light);
                color: var(--dark-text);
                overflow-x: hidden;
            }

            /* SIDEBAR */
            .sidebar {
                display: flex;
                flex-direction: column;
                width: var(--sidebar-width);
                background-color: var(--atilson-dark);
                color: white;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                box-shadow: 4px 0 25px rgba(0,0,0,0.1);
                z-index: 1000;
                transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
                border-right: 1px solid rgba(255,255,255,0.03);
                overflow-x: hidden;
                white-space: nowrap;
            }

            .sidebar-header {
                height: 75px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 18px;
                border-bottom: 1px solid rgba(255,255,255,0.05);
            }

            .logo-atilson {
                height: 34px;
                width: auto;
                max-width: 150px;
                display: block;
            }
            /* Mi perfil (oct-2026): el pie del menú lleva al perfil, con la foto */
            .user-perfil { color: inherit; text-decoration: none; border-radius: 10px; padding: 4px; margin: -4px; transition: background-color .2s; }
            .user-perfil:hover { background: rgba(255,255,255,.06); color: inherit; }
            .user-avatar { position: relative; }
            .user-avatar img { width: 100%; height: 100%; border-radius: inherit; object-fit: cover; }


            .minimal-toggle {
                background: transparent;
                border: none;
                color: rgba(255,255,255,0.5);
                font-size: 24px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: color 0.3s;
            }

                .minimal-toggle:hover {
                    color: var(--atilson-accent-light);
                }

            .sidebar-nav {
                list-style: none;
                padding: 15px 10px;
                margin: 0;
                flex-grow: 1;
                overflow-y: auto;
                scrollbar-width: none;
            }

                .sidebar-nav::-webkit-scrollbar {
                    display: none;
                }

            .nav-link {
                color: rgba(255,255,255,0.65);
                padding: 10px 12px;
                border-radius: 8px;
                font-size: 12.5px;
                font-weight: 600;
                display: flex;
                align-items: center;
                justify-content: flex-start;
                text-decoration: none;
                transition: all 0.2s ease;
                margin-bottom: 4px;
            }

                .nav-link:focus, .nav-link:active {
                    outline: none;
                    box-shadow: none;
                    color: inherit;
                }

                .nav-link i.icon-main {
                    font-size: 17px;
                    margin-right: 12px;
                    min-width: 20px;
                    text-align: center;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    transition: color 0.2s ease;
                }

            .nav-text {
                flex-grow: 1;
                white-space: normal;
                line-height: 1.2;
                display: flex;
                align-items: center;
            }

            .nav-link:hover {
                background-color: rgba(255,255,255,0.05);
                color: white;
            }

            .nav-link.active {
                background-color: rgba(109, 45, 158, 0.2);
                color: var(--atilson-accent-light);
            }

                .nav-link.active i.icon-main, .nav-link:hover i.icon-main {
                    color: var(--atilson-accent-light);
                }

            /* FLECHAS PERFECTAMENTE ALINEADAS Y PEQUEÑAS */
            .nav-link .bi-chevron-down {
                font-size: 8px;
                margin-left: auto;
                margin-right: 4px;
                opacity: 0.5;
                transition: transform 0.3s ease;
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100%;
            }

            .nav-link[aria-expanded="true"] .bi-chevron-down {
                transform: rotate(180deg);
                opacity: 1;
                color: var(--atilson-accent-light);
            }

            /* SUBMENÚS */
            #sidebarMenu .collapse .nav-link,
            #sidebarMenu .collapsing .nav-link {
                padding: 8px 12px 8px 44px;
                font-size: 11.5px;
                background-color: transparent;
                margin-bottom: 2px;
                color: rgba(255,255,255,0.5);
            }

                #sidebarMenu .collapse .nav-link:hover,
                #sidebarMenu .collapsing .nav-link:hover {
                    color: white;
                    background-color: rgba(255,255,255,0.05);
                }

                #sidebarMenu .collapse .nav-link.active {
                    color: var(--atilson-accent-light);
                    background-color: rgba(109, 45, 158, 0.15);
                }

            .sidebar-title {
                font-size: 9.5px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                color: rgba(255,255,255,0.25);
                padding-left: 12px;
                margin-top: 18px !important;
                margin-bottom: 8px !important;
            }

            /* DENSIDAD DE LA VISTA (zoom 0.9): el panel lateral de documentos mide 100vh */
            html[data-escala]:not([data-escala="1"]) .doc-base-panel { height: calc(100vh / var(--escala, 1)) !important; }

            /* USUARIO */
            .sidebar-user-footer {
                padding: 18px 15px;
                border-top: 1px solid rgba(255,255,255,0.05);
                background-color: var(--atilson-darker);
            }

            .user-avatar {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: linear-gradient(135deg, var(--atilson-accent) 0%, #3b1459 100%);
                display: flex;
                justify-content: center;
                align-items: center;
                font-weight: 900;
                color: #fff;
                font-size: 13px;
                margin-right: 12px;
                flex-shrink: 0;
            }

            .btn-logout {
                background: transparent;
                border: 1px solid rgba(255,255,255,0.1);
                color: rgba(255,255,255,0.5);
                padding: 8px;
                width: 100%;
                border-radius: 6px;
                font-size: 10px;
                font-weight: 800;
                text-transform: uppercase;
                margin-top: 12px;
                transition: all 0.2s;
            }

                .btn-logout:hover {
                    background: rgba(239, 68, 68, 0.1);
                    border-color: rgba(239, 68, 68, 0.3);
                    color: #fca5a5;
                }

            /* ÁREA PRINCIPAL */
            .main-content {
                margin-left: var(--sidebar-width);
                min-height: 100vh;
                transition: margin-left 0.3s cubic-bezier(0.25, 1, 0.5, 1);
            }

            /* ==========================================================
                               MODO CONTRAÍDO (PERFECTAMENTE ALINEADO)
                    ========================================================== */
            body.sidebar-collapsed .sidebar {
                width: var(--sidebar-collapsed-width);
            }

            body.sidebar-collapsed .main-content {
                margin-left: var(--sidebar-collapsed-width);
            }

            body.sidebar-collapsed .sidebar-header {
                justify-content: center;
                padding: 0;
            }

            body.sidebar-collapsed .brand-logo-link,
            body.sidebar-collapsed .nav-text,
            body.sidebar-collapsed .sidebar-title,
            body.sidebar-collapsed .user-info,
            body.sidebar-collapsed .btn-logout span,
            body.sidebar-collapsed .bi-chevron-down,
            body.sidebar-collapsed #sidebarMenu .collapse,
            body.sidebar-collapsed #sidebarMenu .collapsing {
                display: none !important;
            }

            body.sidebar-collapsed #sidebarMenu [data-bs-toggle="collapse"] {
                pointer-events: none;
            }

            body.sidebar-collapsed .nav-link {
                justify-content: center;
                padding: 12px 0;
                margin-bottom: 6px;
            }

                body.sidebar-collapsed .nav-link i.icon-main {
                    margin: 0 !important;
                    font-size: 20px;
                    min-width: auto !important;
                }

            body.sidebar-collapsed .sidebar-user-footer {
                padding: 15px 0;
                background: transparent;
                border-top: none;
            }

                body.sidebar-collapsed .sidebar-user-footer .d-flex {
                    justify-content: center !important;
                }

            body.sidebar-collapsed .user-avatar {
                margin-right: 0;
            }

            body.sidebar-collapsed .btn-logout {
                border: none;
                padding: 8px 0;
                margin-top: 0;
            }

                body.sidebar-collapsed .btn-logout i.icon-logout {
                    display: inline-block !important;
                    font-size: 18px;
                    margin: 0;
                    color: rgba(255,255,255,0.4);
                }

                body.sidebar-collapsed .btn-logout:hover i.icon-logout {
                    color: #ef4444;
                }
    </style>
</head>
<body>

    <script>
            if (window.innerWidth >= 992 && localStorage.getItem('sidebar-collapsed-erp') === 'true') {
                document.body.classList.add('sidebar-collapsed');
            }
    </script>

    @{
        var currentUrl = ViewContext.RouteData.Values["page"]?.ToString() ?? "/App/Dashboard";
        string nombreUsuario = User.Identity?.Name ?? "Sistema";
        // Jefaturas (nombres en Helpers/PermisosEquipo.cs) o rol Administrador.
        bool esJefatura = AtilsonCargoSpa.Helpers.PermisosEquipo.EsJefatura(User);
        bool esAdminEquipo = AtilsonCargoSpa.Helpers.PermisosEquipo.EsAdmin(User);
        // Traspaso Ops -> Finanzas (oct-2026): bookings NUEVOS o reabiertos que Finanzas aún no abre.
        int traspasosPendientes = 0;
        if (esJefatura)
        {
            var traspasoSvc = Context.RequestServices.GetService(typeof(AtilsonCargoSpa.Services.TraspasoFinanzasService)) as AtilsonCargoSpa.Services.TraspasoFinanzasService;
            if (traspasoSvc != null) traspasosPendientes = await traspasoSvc.ContarPendientesAsync();
        }
        // Portal (oct-2026): empresas registradas desde el portal que esperan aprobación,
        // y plantas/depósitos que registraron los clientes y Atilson aún no valida.
        int registrosPendientes = 0;
        int plantasPorValidar = 0, depositosPorValidar = 0;
        if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Cliente"))
        {
            var registroSvc = Context.RequestServices.GetService(typeof(AtilsonCargoSpa.Services.RegistroClientesService)) as AtilsonCargoSpa.Services.RegistroClientesService;
            if (registroSvc != null)
            {
                registrosPendientes = await registroSvc.ContarPendientesAsync();
                (plantasPorValidar, depositosPorValidar) = await registroSvc.ContarUbicacionesPorValidarAsync();
            }
        }
        // Equipo Atilson (oct-2026): cuentas del equipo por validar (solo administradores).
        int cuentasEquipoPendientes = 0;
        if (esAdminEquipo)
        {
            var equipoSvc = Context.RequestServices.GetService(typeof(AtilsonCargoSpa.Services.RegistroEquipoService)) as AtilsonCargoSpa.Services.RegistroEquipoService;
            if (equipoSvc != null) cuentasEquipoPendientes = await equipoSvc.ContarPendientesAsync();
        }
        // Mi perfil y Soporte clientes (oct-2026): foto del pie y consultas por responder.
        AtilsonCargoSpa.Services.ResumenPerfil? miPerfil = null;
        int consultasAbiertas = 0;
        if (User.Identity?.IsAuthenticated == true)
        {
            if (Context.RequestServices.GetService(typeof(AtilsonCargoSpa.Services.PerfilUsuarioService)) is AtilsonCargoSpa.Services.PerfilUsuarioService perfilSvc)
                miPerfil = await perfilSvc.ResumenAsync(User);
            if (!User.IsInRole("Cliente") && Context.RequestServices.GetService(typeof(AtilsonCargoSpa.Services.SoporteClientesService)) is AtilsonCargoSpa.Services.SoporteClientesService soporteSvc)
                consultasAbiertas = await soporteSvc.ContarAbiertosAsync();
        }
    }

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <a asp-page="/App/Dashboard" class="brand-logo-link">
                <img src="~/img/marca/atilson-logo-blanco.svg" alt="Atilson" class="logo-atilson me-2" onerror="this.style.display='none'" asp-append-version="true" />
            </a>
            <button id="sidebarToggle" class="minimal-toggle" title="Contraer Menú">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <ul class="sidebar-nav" id="sidebarMenu">

            <li class="nav-item">
                <a class="nav-link @(currentUrl == "/App/Dashboard" || currentUrl == "/Index" ? "active" : "")" asp-page="/App/Dashboard">
                    <i class="bi bi-grid-1x2-fill icon-main"></i> <span class="nav-text">Dashboard</span>
                </a>
            </li>

            <li class="nav-item sidebar-title">Operativa</li>

            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="collapse" href="#menuOperaciones" role="button" aria-expanded="false" aria-controls="menuOperaciones">
                    <i class="bi bi-briefcase-fill icon-main"></i>
                    <span class="nav-text">Operaciones</span>
                    <i class="bi bi-chevron-down"></i>
                </a>
                <div class="collapse" id="menuOperaciones" data-bs-parent="#sidebarMenu">
                    <ul class="nav flex-column">
                        <li><a class="nav-link sub-link" asp-page="/Operaciones/Index">Main Board</a></li>
                        <li><a class="nav-link sub-link" asp-page="/Operaciones/Cotizaciones">Cotizaciones</a></li>
                        <li><a class="nav-link sub-link" asp-page="/Operaciones/Itinerarios">Itinerarios de Naves</a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item sidebar-title">Negocios</li>

                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#menuFinanzas" role="button" aria-expanded="false" aria-controls="menuFinanzas">
                        <i class="bi bi-currency-dollar icon-main"></i>
                        <span class="nav-text">Finanzas</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                                        <div class="collapse" id="menuFinanzas" data-bs-parent="#sidebarMenu">
                        <ul class="nav flex-column">
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/Index">Main Board</a></li>
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/ControlFinanciero">Control Financiero</a></li>
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/Cobranza">Cobranza</a></li>
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/OrdenesCompra">Órdenes de Compra</a></li>
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/Facturacion">Facturación Clientes</a></li>
                        </ul>
                    </div>
                </li>


            @if (esJefatura)
            {
                <li class="nav-item sidebar-title">Negocios</li>

                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#menuFinanzas" role="button" aria-expanded="false" aria-controls="menuFinanzas">
                        <i class="bi bi-currency-dollar icon-main"></i>
                        <span class="nav-text">Finanzas @if (traspasosPendientes > 0) { <span class="nav-badge-traspaso" title="Bookings nuevos o reabiertos por Operaciones">@traspasosPendientes</span> }</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                                        <div class="collapse" id="menuFinanzas" data-bs-parent="#sidebarMenu">
                        <ul class="nav flex-column">
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/Index">Main Board</a></li>
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/ControlFinanciero">Control Financiero @if (traspasosPendientes > 0) { <span class="nav-badge-traspaso" data-traspaso-contador title="Bookings nuevos o reabiertos por Operaciones">@traspasosPendientes</span> }</a></li>
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/Cobranza">Cobranza</a></li>
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/OrdenesCompra">Órdenes de Compra</a></li>
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/Facturacion">Facturación Clientes</a></li>
                            <li><a class="nav-link sub-link" asp-page="/Finanzas/ConsolidadoCliente">Consolidado Cliente</a></li>
                        </ul>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#menuComercial" role="button" aria-expanded="false" aria-controls="menuComercial">
                        <i class="bi bi-tags-fill icon-main"></i>
                        <span class="nav-text">Comercial</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse" id="menuComercial" data-bs-parent="#sidebarMenu">
                        <ul class="nav flex-column">
                            <li><a class="nav-link sub-link" asp-page="/Comercial/Index">Tarifas</a></li>
                            <li><a class="nav-link sub-link" asp-page="/Comercial/AcuerdosOperativos">Acuerdos por Booking</a></li>
                        </ul>
                    </div>
                </li>
            }

            <li class="nav-item sidebar-title">Clientes y equipo</li>

            <li class="nav-item">
                <a class="nav-link @(currentUrl == "/App/Soporte" ? "active" : "")" asp-page="/App/Soporte" title="Soporte clientes">
                    <i class="bi bi-headset icon-main"></i>
                    <span class="nav-text">Soporte clientes @if (consultasAbiertas > 0) { <span class="nav-badge-traspaso" title="Consultas por responder">@consultasAbiertas</span> }</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentUrl == "/App/Directorio" ? "active" : "")" asp-page="/App/Directorio" title="Directorio del equipo">
                    <i class="bi bi-people-fill icon-main"></i>
                    <span class="nav-text">Directorio del equipo</span>
                </a>
            </li>

            <li class="nav-item sidebar-title">Configuración Base</li>

            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="collapse" href="#menuMaestros" role="button" aria-expanded="false" aria-controls="menuMaestros">
                    <i class="bi bi-buildings-fill icon-main"></i>
                    <span class="nav-text">Maestros @if (registrosPendientes + plantasPorValidar + depositosPorValidar + cuentasEquipoPendientes > 0) { <span class="nav-badge-traspaso" title="Registros por revisar">@(registrosPendientes + plantasPorValidar + depositosPorValidar + cuentasEquipoPendientes)</span> }</span>
                    <i class="bi bi-chevron-down"></i>
                </a>
                <div class="collapse" id="menuMaestros" data-bs-parent="#sidebarMenu">
                    <ul class="nav flex-column">
                        <li><a class="nav-link sub-link" asp-page="/App/Clientes/Index">Mis Clientes</a></li>
                        <li><a class="nav-link sub-link" asp-page="/App/Clientes/Solicitudes">Solicitudes de registro @if (registrosPendientes > 0) { <span class="nav-badge-traspaso" title="Empresas esperando aprobación">@registrosPendientes</span> }</a></li>
                        <li><a class="nav-link sub-link" asp-page="/App/Plantas/Index">Plantas @if (plantasPorValidar > 0) { <span class="nav-badge-traspaso" title="Plantas registradas por clientes, por validar">@plantasPorValidar</span> }</a></li>
                        <li><a class="nav-link sub-link" asp-page="/App/Depositos/Index">Depósitos @if (depositosPorValidar > 0) { <span class="nav-badge-traspaso" title="Depósitos registrados por clientes, por validar">@depositosPorValidar</span> }</a></li>
                        <li><a class="nav-link sub-link" asp-page="/App/Proveedores/Index">Proveedores</a></li>
                        <li><a class="nav-link sub-link" asp-page="/App/Agencias/Index">Agencias de aduana</a></li>
                        <li><a class="nav-link sub-link" asp-page="/App/Navieras/Index">Navieras</a></li>
                        <li><a class="nav-link sub-link" asp-page="/App/Puertos/Index">Puertos</a></li>
                        <li><a class="nav-link sub-link" asp-page="/App/Ciudades/Index">Ciudades</a></li>
                        @if (esAdminEquipo)
                        {
                            <li><a class="nav-link sub-link" asp-page="/App/Equipo/Index">Equipo Atilson @if (cuentasEquipoPendientes > 0) { <span class="nav-badge-traspaso" title="Cuentas del equipo por validar">@cuentasEquipoPendientes</span> }</a></li>
                        }
                    </ul>
                </div>
            </li>
        </ul>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-user-footer">
                <a asp-page="/App/Perfil" class="d-flex align-items-center user-perfil" title="Mi perfil">
                    <div class="user-avatar">
                        @if (miPerfil?.FotoUrl != null) { <img src="@miPerfil.FotoUrl" alt="" /> } else { @AtilsonCargoSpa.Services.PerfilUsuarioService.Iniciales(nombreUsuario) }
                    </div>
                    <div class="user-info">
                        <span class="d-block fw-bold text-white text-truncate" style="font-size: 12px; max-width: 120px;">@nombreUsuario</span>
                        <span style="font-size: 9.5px; font-weight: 600; color: var(--atilson-accent-light);">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value · Mi perfil</span>
                    </div>
                </a>
                <form method="post" asp-page="/Logout" title="Cerrar Sesión">
                    <button type="submit" class="btn-logout">
                        <span>Cerrar Sesión</span>
                        <i class="bi bi-box-arrow-right d-none icon-logout"></i>
                    </button>
                </form>
            </div>
        }
    </aside>

    <div class="menu-movil-fondo" id="menuMovilFondo" aria-hidden="true"></div>

    <main class="main-content">
        <div class="barra-movil">
            <button type="button" id="menuMovilAbrir" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebarMenu"><i class="bi bi-list"></i></button>
            <a asp-page="/App/Dashboard" aria-label="Ir al Dashboard"><img src="~/img/marca/atilson-logo-blanco.svg" alt="Atilson" asp-append-version="true" /></a>
            <span class="titulo-movil">@ViewData["Title"]</span>
        </div>
        <div class="contenido-pagina" style="flex-grow: 1; padding: 25px;">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const toggleBtn = document.getElementById('sidebarToggle');
                const body = document.body;

                const esMovil = () => window.innerWidth < 992;
                const menuMovil = abrir => window.menuMovil && window.menuMovil(abrir);

                // 1. Lógica Toggle Principal
                toggleBtn.addEventListener('click', function() {
                    if (esMovil()) { menuMovil(false); return; }
                    body.classList.toggle('sidebar-collapsed');
                    let isCollapsed = body.classList.contains('sidebar-collapsed');
                    localStorage.setItem('sidebar-collapsed-erp', isCollapsed);

                    if (isCollapsed) {
                        document.querySelectorAll('.sidebar-nav .collapse.show').forEach(el => {
                            let bsCollapse = bootstrap.Collapse.getOrCreateInstance(el);
                            bsCollapse.hide();
                        });
                    } else {
                        let activeLink = document.querySelector('.sidebar-nav .collapse .nav-link.active');
                        if (activeLink) {
                            let parentCollapse = activeLink.closest('.collapse');
                            if (parentCollapse) {
                                let bsCollapse = bootstrap.Collapse.getOrCreateInstance(parentCollapse);
                                bsCollapse.show();
                                let parentTrigger = document.querySelector(`[href="#${parentCollapse.id}"]`);
                                if (parentTrigger) parentTrigger.setAttribute('aria-expanded', 'true');
                            }
                        }
                    }
                });

                // 2. CLIC INTELIGENTE CUANDO  ESTÁ CONTRAIDO POR LA VENTANA MODAL
                document.querySelectorAll('.sidebar-nav .nav-link[data-bs-toggle="collapse"]').forEach(toggle => {
                    toggle.addEventListener('click', function(e) {
                        if (document.body.classList.contains('sidebar-collapsed') && !esMovil()) {
                            document.getElementById('sidebarToggle').click();
                        }
                    });
                });

                // 3. Selección Estricta de URL activa
                let currentPath = window.location.pathname.replace(/\/$/, '').replace(/\/Index$/, '');
                if (currentPath === '') currentPath = '/App/Dashboard';

                document.querySelectorAll('.sidebar-nav .nav-link:not([data-bs-toggle="collapse"])').forEach(link => {
                    let href = link.getAttribute('href');
                    if (href && href !== '#' && href.trim() !== '') {
                        let cleanHref = href.replace(/\/$/, '').replace(/\/Index$/, '');

                        if (currentPath === cleanHref) {
                            link.classList.add('active');
                            let parentCollapse = link.closest('.collapse');
                            if (parentCollapse) {
                                let parentTrigger = document.querySelector(`[href="#${parentCollapse.id}"]`);
                                if (parentTrigger) {
                                    parentTrigger.classList.add('active');
                                    parentTrigger.setAttribute('aria-expanded', 'true');
                                }
                                if (!body.classList.contains('sidebar-collapsed')) {
                                    parentCollapse.classList.add('show');
                                }
                            }
                        }
                    }
                });
            });
    </script>
    <partial name="_AvisosFlash" />
    <partial name="_AvisoRegistros" />
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/menu-movil.js" asp-append-version="true"></script>
    <script src="~/js/escala-vista.js" asp-append-version="true"></script>
    <script src="~/js/buscador-selects.js" asp-append-version="true"></script>
</body>
</html>