<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Atilson Portal Clientes</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            :root {
                --atilson-dark: #1e1b4b;
                --atilson-darker: #111827;
                --atilson-accent: #8b5cf6;
                --atilson-accent-light: #a855f7;
                --dark-text: #1e293b;
                --bg-light: #f8fafc;
                --sidebar-width: 240px; /* Ajustado para lectura completa */
                --sidebar-collapsed-width: 70px;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-light);
                color: var(--dark-text);
                overflow-x: hidden;
            }

            /* SIDEBAR CLIENTES */
            .sidebar {
                display: flex;
                flex-direction: column;
                width: var(--sidebar-width);
                background-color: var(--atilson-dark);
                color: white;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                box-shadow: 4px 0 25px rgba(0,0,0,0.1);
                z-index: 1000;
                transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1);
                border-right: 1px solid rgba(255,255,255,0.03);
                overflow-x: hidden;
                white-space: nowrap;
            }

            .sidebar-header {
                height: 75px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 18px;
                border-bottom: 1px solid rgba(255,255,255,0.05);
            }

            .logo-atilson {
                height: 34px;
                width: auto;
                max-width: 150px;
                display: block;
            }

            /* Mi perfil (oct-2026) */
            .user-perfil { color: inherit; text-decoration: none; border-radius: 10px; padding: 4px; margin: -4px; transition: background-color .2s; }
            .user-perfil:hover { background: rgba(255,255,255,.06); color: inherit; }
            .user-avatar img { width: 100%; height: 100%; border-radius: inherit; object-fit: cover; }
            .nav-badge-soporte { display: inline-block; min-width: 18px; padding: 1px 6px; margin-left: 6px; border-radius: 999px; background: #a78bfa; color: #fff; font-size: 10.5px; font-weight: 800; line-height: 16px; text-align: center; }

            .minimal-toggle {
                background: transparent;
                border: none;
                color: rgba(255,255,255,0.5);
                font-size: 24px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: color 0.3s;
            }

                .minimal-toggle:hover {
                    color: var(--atilson-accent-light);
                }

            .sidebar-nav {
                list-style: none;
                padding: 15px 10px;
                margin: 0;
                flex-grow: 1;
                overflow-y: auto;
                scrollbar-width: none;
            }

                .sidebar-nav::-webkit-scrollbar {
                    display: none;
                }

            .nav-link {
                color: rgba(255,255,255,0.65);
                padding: 10px 12px;
                border-radius: 8px;
                font-size: 12.5px;
                font-weight: 600;
                display: flex;
                align-items: center;
                justify-content: flex-start;
                text-decoration: none;
                transition: all 0.2s ease;
                margin-bottom: 4px;
            }

                .nav-link:focus, .nav-link:active {
                    outline: none;
                    box-shadow: none;
                    color: inherit;
                }

                .nav-link i.icon-main {
                    font-size: 17px;
                    margin-right: 12px;
                    min-width: 20px;
                    text-align: center;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    transition: color 0.2s ease;
                }

            .nav-text {
                flex-grow: 1;
                white-space: normal;
                line-height: 1.2;
                display: flex;
                align-items: center;
            }

            .nav-link:hover {
                background-color: rgba(255,255,255,0.05);
                color: white;
            }

            .nav-link.active {
                background-color: rgba(139, 92, 246, 0.2);
                color: var(--atilson-accent-light);
            }

                .nav-link.active i.icon-main, .nav-link:hover i.icon-main {
                    color: var(--atilson-accent-light);
                }

            .nav-link .bi-chevron-down {
                font-size: 8px;
                margin-left: auto;
                margin-right: 4px;
                opacity: 0.5;
                transition: transform 0.3s ease;
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100%;
            }

            .nav-link[aria-expanded="true"] .bi-chevron-down {
                transform: rotate(180deg);
                opacity: 1;
                color: var(--atilson-accent-light);
            }

            /* Submenús */
            #sidebarMenu .collapse .nav-link,
            #sidebarMenu .collapsing .nav-link {
                padding: 8px 12px 8px 44px;
                font-size: 11.5px;
                background-color: transparent;
                margin-bottom: 2px;
                color: rgba(255,255,255,0.5);
            }

                #sidebarMenu .collapse .nav-link:hover,
                #sidebarMenu .collapsing .nav-link:hover {
                    color: white;
                    background-color: rgba(255,255,255,0.05);
                }

                #sidebarMenu .collapse .nav-link.active {
                    color: var(--atilson-accent-light);
                    background-color: rgba(139, 92, 246, 0.15);
                }

            .sidebar-title {
                font-size: 9.5px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                color: rgba(255,255,255,0.25);
                padding-left: 12px;
                margin-top: 18px !important;
                margin-bottom: 8px !important;
            }

            /* Footer de Usuario */
            .sidebar-user-footer {
                padding: 18px 15px;
                border-top: 1px solid rgba(255,255,255,0.05);
                background-color: var(--atilson-darker);
            }

            .user-avatar {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: linear-gradient(135deg, var(--atilson-accent) 0%, #312e81 100%);
                display: flex;
                justify-content: center;
                align-items: center;
                font-weight: 900;
                color: #fff;
                font-size: 13px;
                margin-right: 12px;
                flex-shrink: 0;
            }

            .btn-logout {
                background: transparent;
                border: 1px solid rgba(255,255,255,0.1);
                color: rgba(255,255,255,0.5);
                padding: 8px;
                width: 100%;
                border-radius: 6px;
                font-size: 10px;
                font-weight: 800;
                text-transform: uppercase;
                margin-top: 12px;
                transition: all 0.2s;
                display: flex;
                justify-content: center;
                align-items: center;
            }

                .btn-logout:hover {
                    background: rgba(239, 68, 68, 0.1);
                    border-color: rgba(239, 68, 68, 0.3);
                    color: #fca5a5;
                }

            .main-content {
                margin-left: var(--sidebar-width);
                min-height: 100vh;
                transition: margin-left 0.3s cubic-bezier(0.25, 1, 0.5, 1);
            }

            /* --- MODO CONTRAÍDO --- */
            body.sidebar-collapsed .sidebar {
                width: var(--sidebar-collapsed-width);
            }

            body.sidebar-collapsed .main-content {
                margin-left: var(--sidebar-collapsed-width);
            }

            body.sidebar-collapsed .sidebar-header {
                justify-content: center;
                padding: 0;
            }

            body.sidebar-collapsed .brand-logo-link,
            body.sidebar-collapsed .nav-text,
            body.sidebar-collapsed .sidebar-title,
            body.sidebar-collapsed .user-info,
            body.sidebar-collapsed .btn-logout span,
            body.sidebar-collapsed .bi-chevron-down,
            body.sidebar-collapsed #sidebarMenu .collapse,
            body.sidebar-collapsed #sidebarMenu .collapsing {
                display: none !important;
            }

            body.sidebar-collapsed #sidebarMenu [data-bs-toggle="collapse"] {
                pointer-events: none;
            }

            body.sidebar-collapsed .nav-link {
                justify-content: center;
                padding: 12px 0;
                margin-bottom: 6px;
            }

                body.sidebar-collapsed .nav-link i.icon-main {
                    margin: 0 !important;
                    font-size: 20px;
                    min-width: auto !important;
                }

            body.sidebar-collapsed .sidebar-user-footer {
                padding: 15px 0;
                background: transparent;
                border-top: none;
            }

                body.sidebar-collapsed .sidebar-user-footer .d-flex {
                    justify-content: center !important;
                }

            body.sidebar-collapsed .user-avatar {
                margin-right: 0;
            }

            body.sidebar-collapsed .btn-logout {
                border: none;
                padding: 8px 0;
                margin-top: 0;
            }

                body.sidebar-collapsed .btn-logout i.icon-logout {
                    display: inline-block !important;
                    font-size: 18px;
                    margin: 0;
                    color: rgba(255,255,255,0.4);
                }

                body.sidebar-collapsed .btn-logout:hover i.icon-logout {
                    color: #ef4444;
                }
    </style>
    <link rel="stylesheet" href="~/css/erp-comun.css" asp-append-version="true" />
</head>
<body>

    <script>
            if (window.innerWidth >= 992 && localStorage.getItem('sidebar-collapsed-cliente') === 'true') {
                document.body.classList.add('sidebar-collapsed');
            }
    </script>

    @{
        var currentUrl = ViewContext.RouteData.Values["page"]?.ToString() ?? "/PortalCliente/Index";
        string nombreEmpresa = User.Identity?.Name ?? "Cliente";
        AtilsonCargoSpa.Services.ResumenPerfil? miPerfil = null;
        if (Context.RequestServices.GetService(typeof(AtilsonCargoSpa.Services.PerfilUsuarioService)) is AtilsonCargoSpa.Services.PerfilUsuarioService perfilSvc)
            miPerfil = await perfilSvc.ResumenAsync(User);
        // Soporte (oct-2026): conversaciones con respuestas del equipo que el cliente aún no ve.
        int respuestasSinVer = 0;
        if (int.TryParse(User.FindFirst("IdCliente")?.Value, out int idClienteMenu) && idClienteMenu > 0
            && Context.RequestServices.GetService(typeof(AtilsonCargoSpa.Services.SoporteClientesService)) is AtilsonCargoSpa.Services.SoporteClientesService soporteMenu)
            respuestasSinVer = await soporteMenu.ContarNoLeidasClienteAsync(idClienteMenu);
    }

    <aside class="sidebar">
        <div class="sidebar-header">
            <a asp-page="/PortalCliente/Index" class="brand-logo-link">
                <img src="~/img/marca/atilson-logo-blanco.svg" alt="Atilson" class="logo-atilson me-2" onerror="this.style.display='none'" asp-append-version="true" />
            </a>
            <button id="sidebarToggle" class="minimal-toggle" title="Contraer Menú">
                <i class="bi bi-list"></i>
            </button>
        </div>

        @{
            // Menú del portal (oct-2026): una entrada por pantalla, sin duplicados.
            string Activo(params string[] paginas) => paginas.Any(p => string.Equals(currentUrl, p, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
        }
        <ul class="sidebar-nav" id="sidebarMenu">

            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/Index")" asp-page="/PortalCliente/Index" title="Inicio">
                    <i class="bi bi-house-door-fill icon-main"></i> <span class="nav-text">Inicio</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/Operaciones", "/PortalCliente/AprobarBL")" asp-page="/PortalCliente/Operaciones" title="Mis operaciones">
                    <i class="bi bi-box-seam icon-main"></i> <span class="nav-text">Mis operaciones</span>
                </a>
            </li>

            <li class="nav-item sidebar-title">Solicitudes</li>

            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/SolicitarCotizacion")" asp-page="/PortalCliente/SolicitarCotizacion" title="Solicitar cotización">
                    <i class="bi bi-calculator icon-main"></i> <span class="nav-text">Solicitar cotización</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/MisCotizaciones")" asp-page="/PortalCliente/MisCotizaciones" title="Mis cotizaciones">
                    <i class="bi bi-chat-square-text icon-main"></i> <span class="nav-text">Mis cotizaciones</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/SolicitarReserva")" asp-page="/PortalCliente/SolicitarReserva" title="Solicitar servicio">
                    <i class="bi bi-calendar-check icon-main"></i> <span class="nav-text">Solicitar servicio</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/Itinerarios")" asp-page="/PortalCliente/Itinerarios" title="Itinerarios de naves">
                    <i class="bi bi-calendar2-week icon-main"></i> <span class="nav-text">Itinerarios de naves</span>
                </a>
            </li>

            <li class="nav-item sidebar-title">Mi cuenta</li>

            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/Facturas")" asp-page="/PortalCliente/Facturas" title="Estado de cuenta">
                    <i class="bi bi-cash-coin icon-main"></i> <span class="nav-text">Estado de cuenta</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/Documentos")" asp-page="/PortalCliente/Documentos" title="Matriz y documentos">
                    <i class="bi bi-folder-check icon-main"></i> <span class="nav-text">Matriz y documentos</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/MisUbicaciones")" asp-page="/PortalCliente/MisUbicaciones" title="Mis plantas y depósitos">
                    <i class="bi bi-geo-alt-fill icon-main"></i> <span class="nav-text">Mis plantas y depósitos</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/Soporte")" asp-page="/PortalCliente/Soporte" title="Soporte">
                    <i class="bi bi-headset icon-main"></i> <span class="nav-text">Soporte @if (respuestasSinVer > 0) { <span class="nav-badge-soporte" title="Respuestas nuevas del equipo">@respuestasSinVer</span> }</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @Activo("/PortalCliente/Perfil")" asp-page="/PortalCliente/Perfil" title="Mi perfil">
                    <i class="bi bi-person-circle icon-main"></i> <span class="nav-text">Mi perfil</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-user-footer">
            <a asp-page="/PortalCliente/Perfil" class="d-flex align-items-center user-perfil" title="Mi perfil">
                <div class="user-avatar">
                    @if (miPerfil?.FotoUrl != null) { <img src="@miPerfil.FotoUrl" alt="" /> } else { @AtilsonCargoSpa.Services.PerfilUsuarioService.Iniciales(nombreEmpresa) }
                </div>
                <div class="user-info">
                    <span class="d-block fw-bold text-white text-truncate" style="font-size: 12px; max-width: 120px;">@nombreEmpresa</span>
                    <span style="font-size: 9.5px; font-weight: 600; color: var(--atilson-accent-light);">Mi perfil</span>
                </div>
            </a>
            <form method="post" asp-page="/Logout" title="Cerrar Sesión">
                <button type="submit" class="btn-logout">
                    <span>Cerrar Sesión</span>
                    <i class="bi bi-box-arrow-right d-none icon-logout"></i>
                </button>
            </form>
        </div>
    </aside>

    <div class="menu-movil-fondo" id="menuMovilFondo" aria-hidden="true"></div>

    <main class="main-content">
        <div class="barra-movil">
            <button type="button" id="menuMovilAbrir" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebarMenu"><i class="bi bi-list"></i></button>
            <a asp-page="/PortalCliente/Index" aria-label="Ir al inicio"><img src="~/img/marca/atilson-logo-blanco.svg" alt="Atilson" asp-append-version="true" /></a>
            <span class="titulo-movil">@ViewData["Title"]</span>
        </div>
        <div class="contenido-pagina" style="flex-grow: 1; padding: 25px;">
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const toggleBtn = document.getElementById('sidebarToggle');
                const body = document.body;

                toggleBtn.addEventListener('click', function() {
                    if (window.innerWidth < 992) return;
                    body.classList.toggle('sidebar-collapsed');
                    let isCollapsed = body.classList.contains('sidebar-collapsed');
                    localStorage.setItem('sidebar-collapsed-cliente', isCollapsed);

                    if (isCollapsed) {
                        document.querySelectorAll('.sidebar-nav .collapse.show').forEach(el => {
                            let bsCollapse = bootstrap.Collapse.getOrCreateInstance(el);
                            bsCollapse.hide();
                        });
                    } else {
                        let activeLink = document.querySelector('.sidebar-nav .collapse .nav-link.active');
                        if (activeLink) {
                            let parentCollapse = activeLink.closest('.collapse');
                            if (parentCollapse) {
                                let bsCollapse = bootstrap.Collapse.getOrCreateInstance(parentCollapse);
                                bsCollapse.show();
                                let parentTrigger = document.querySelector(`[href="#${parentCollapse.id}"]`);
                                if (parentTrigger) parentTrigger.setAttribute('aria-expanded', 'true');
                            }
                        }
                    }
                });

                document.querySelectorAll('.sidebar-nav .nav-link[data-bs-toggle="collapse"]').forEach(toggle => {
                    toggle.addEventListener('click', function(e) {
                        if (document.body.classList.contains('sidebar-collapsed') && window.innerWidth >= 992) {
                            document.getElementById('sidebarToggle').click();
                        }
                    });
                });

                let currentPath = window.location.pathname.replace(/\/$/, '').replace(/\/Index$/, '');
                if (currentPath === '') currentPath = '/PortalCliente';

                document.querySelectorAll('.sidebar-nav .nav-link:not([data-bs-toggle="collapse"])').forEach(link => {
                    let href = link.getAttribute('href');
                    if (href && href !== '#' && href.trim() !== '') {
                        let cleanHref = href.replace(/\/$/, '').replace(/\/Index$/, '');
                        if (currentPath === cleanHref) {
                            link.classList.add('active');
                            let parentCollapse = link.closest('.collapse');
                            if (parentCollapse) {
                                let parentTrigger = document.querySelector(`[href="#${parentCollapse.id}"]`);
                                if (parentTrigger) {
                                    parentTrigger.classList.add('active');
                                    parentTrigger.setAttribute('aria-expanded', 'true');
                                }
                                if (!body.classList.contains('sidebar-collapsed')) {
                                    parentCollapse.classList.add('show');
                                }
                            }
                        }
                    }
                });
            });
    </script>

    <partial name="_AvisosFlash" />
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/buscador-selects.js" asp-append-version="true"></script>
    <script src="~/js/menu-movil.js" asp-append-version="true"></script>
</body>
</html>