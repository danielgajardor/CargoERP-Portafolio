@model string
@* Navegación entre las páginas de Finanzas (oct-2026). Model = clave de la página activa. *@
@{
    var items = new[]
    {
        (Clave: "MainBoard", Pagina: "/Finanzas/Index", Icono: "bi-grid-1x2-fill", Texto: "Main Board"),
        (Clave: "ControlFinanciero", Pagina: "/Finanzas/ControlFinanciero", Icono: "bi-sliders", Texto: "Control Financiero"),
        (Clave: "Pagos", Pagina: "/Finanzas/Pagos", Icono: "bi-cash-stack", Texto: "Pagos"),
        (Clave: "Respaldos", Pagina: "/Finanzas/Respaldos", Icono: "bi-archive", Texto: "Respaldos"),
        (Clave: "DatosHistoricos", Pagina: "/Finanzas/DatosHistoricos", Icono: "bi-clock-history", Texto: "Datos Históricos"),
        (Clave: "OrdenesCompra", Pagina: "/Finanzas/OrdenesCompra", Icono: "bi-receipt", Texto: "Órdenes de Compra"),
        (Clave: "Cobranza", Pagina: "/Finanzas/Cobranza", Icono: "bi-wallet2", Texto: "Cobranza"),
        (Clave: "ConsolidadoCliente", Pagina: "/Finanzas/ConsolidadoCliente", Icono: "bi-person-lines-fill", Texto: "Consolidado Cliente")
    };
}
<style>
    .finanzas-nav-shell { width:100%; overflow-x:auto; overflow-y:hidden; padding-bottom:2px; scrollbar-width:thin; }
    .finanzas-nav { width:max-content; min-width:100%; flex-wrap:nowrap; }
    .finanzas-nav .segmented-nav__link { justify-content:center; flex:1 0 auto; padding-left:14px; padding-right:14px; }
    @@media(max-width:1050px){ .finanzas-nav { min-width:max-content; } .finanzas-nav .segmented-nav__link { flex:0 0 auto; } }
</style>
<div class="finanzas-nav-shell mb-4">
    <nav class="workspace-nav segmented-nav finanzas-nav" aria-label="Secciones de Finanzas">
        @foreach (var it in items)
        {
            bool activo = it.Clave == Model;
            <a asp-page="@it.Pagina" class="ws-btn segmented-nav__link @(activo ? "active" : "")" aria-current="@(activo ? "page" : null)"><i class="bi @it.Icono"></i> @it.Texto</a>
        }
    </nav>
</div>
