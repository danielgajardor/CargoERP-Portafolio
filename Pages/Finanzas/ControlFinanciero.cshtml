                                                            <td class="text-center pe-4"><span class="badge-estado @(pagadosIng == txsGrpIng.Count ? "badge-pag" : "badge-pend") shadow-sm m-0">@pagadosIng / @txsGrpIng.Count PAGADO</span></td>
                                                        </tr>
                                                        <tr class="collapse" id="@idGrpIng">
                                                            <td colspan="6" class="p-0 border-0">
                                                                <table class="table table-sm nested-table nested-subtable-u mb-0">
                                                                    <tbody>
                                                                        @foreach (var tx in txsGrpIng)
