@page
@model AtilsonCargoSpa.Pages.Finanzas.ControlFinancieroModel
@using AtilsonCargoSpa.Models
@{
    ViewData["Title"] = "Control Financiero";
}

@functions {
    // ---- Pestaña Resumen por concepto (oct-2026) ----
    // Cada concepto (sin el sufijo de contenedor "(Uxx)") con su ingreso, egreso y
    // diferencia por moneda; agrupado por servicio con subtotales.
    sealed class FilaResumenCf
    {
        public string Grupo { get; init; } = "";
        public string Concepto { get; init; } = "";
        public bool EsExtracosto { get; init; }
        public int Unidades { get; init; }
        public bool Pendiente { get; init; }
        public bool NoFacturable { get; init; }
        public Dictionary<string, decimal> Ingresos { get; init; } = new();
        public Dictionary<string, decimal> Egresos { get; init; } = new();
        public IEnumerable<string> Monedas => Ingresos.Keys.Union(Egresos.Keys).OrderBy(m => m == "CLP" ? 0 : 1);
        public decimal Ing(string m) => Ingresos.TryGetValue(m, out var v) ? v : 0m;
        public decimal Egr(string m) => Egresos.TryGetValue(m, out var v) ? v : 0m;
    }

    static readonly string[] OrdenGruposResumen = { "Marítimo", "Transporte", "Documental", "Gate-Out/In", "Almacenamiento", "Otros" };

    static string GrupoResumen(TransaccionesFinanciera t) =>
        (t.GrupoCobro == "Depósito" || t.GrupoCobro == "Deposito") ? "Gate-Out/In" : (string.IsNullOrWhiteSpace(t.GrupoCobro) ? "Otros" : t.GrupoCobro!);

    static string MonedaResumen(string? m) => string.IsNullOrWhiteSpace(m) ? "CLP" : m.Trim().ToUpperInvariant();

    static string MontoResumen(decimal v, string moneda) =>
        moneda == "CLP" ? "$ " + v.ToString("N0") : moneda + " " + v.ToString("#,##0.##");

    List<FilaResumenCf> FilasResumen(Operacione op)
    {
        return op.TransaccionesFinancieras
            .Select(t => new { Tx = t, Grupo = GrupoResumen(t), Base = ObtenerConceptoBase(t.Concepto) })
            .GroupBy(x => new { x.Grupo, x.Base })
            .Select(g => new FilaResumenCf
            {
                Grupo = g.Key.Grupo,
                Concepto = System.Text.RegularExpressions.Regex.Replace(g.Key.Base ?? "", @"\s*\(EXT-\d+\)", "").Trim(),
                EsExtracosto = System.Text.RegularExpressions.Regex.IsMatch(g.Key.Base ?? "", @"\(EXT-\d+\)"),
                Unidades = g.Select(x => x.Tx.Concepto).Distinct().Count(),
                Pendiente = g.Any(x => EsPendienteReal(x.Tx, op.IdCliente)),
                NoFacturable = g.Any(x => x.Tx.TipoMovimiento == "INGRESO") && g.Where(x => x.Tx.TipoMovimiento == "INGRESO").All(x => x.Tx.EstadoFila == "NO FACTURABLE"),
                Ingresos = g.Where(x => x.Tx.TipoMovimiento == "INGRESO").GroupBy(x => MonedaResumen(x.Tx.Moneda)).ToDictionary(m => m.Key, m => m.Sum(x => x.Tx.MontoNeto)),
                Egresos = g.Where(x => x.Tx.TipoMovimiento == "EGRESO").GroupBy(x => MonedaResumen(x.Tx.Moneda)).ToDictionary(m => m.Key, m => m.Sum(x => x.Tx.MontoNeto))
            })
            .OrderBy(f => Array.IndexOf(OrdenGruposResumen, f.Grupo) >= 0 ? Array.IndexOf(OrdenGruposResumen, f.Grupo) : 99)
            .ThenBy(f => f.EsExtracosto ? 1 : 0)
            .ThenBy(f => f.Concepto)
            .ToList();
    }

    // Diferencia (ingreso - egreso) por moneda de un conjunto de filas.
    static List<(string Moneda, decimal Ing, decimal Egr)> TotalesResumen(IEnumerable<FilaResumenCf> filas)
    {
        var lista = filas.ToList();
        return lista.SelectMany(f => f.Monedas).Distinct().OrderBy(m => m == "CLP" ? 0 : 1)
            .Select(m => (m, lista.Sum(f => f.Ing(m)), lista.Sum(f => f.Egr(m))))
            .ToList();
    }

    static Microsoft.AspNetCore.Html.IHtmlContent CeldaMontos(IEnumerable<(string Moneda, decimal Valor)> valores, bool diferencia = false)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var (m, v) in valores)
        {
            string clase = !diferencia ? "" : (v > 0 ? "cf-res-pos" : (v < 0 ? "cf-res-neg" : "cf-res-cero"));
            sb.Append($"<div class=\"cf-res-monto {clase}\">{System.Net.WebUtility.HtmlEncode(MontoResumen(v, m))}</div>");
        }
        if (sb.Length == 0) sb.Append("<div class=\"cf-res-monto cf-res-cero\">—</div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    // Equivalencia en CLP (oct-2026): USD al dólar observado del día y UF a la UF del día.
    decimal AClp(string? moneda, decimal monto)
    {
        string m = (moneda ?? "CLP").Trim().ToUpperInvariant();
        return m == "USD" ? Math.Round(monto * Model.DolarHoy) : m == "UF" ? Math.Round(monto * Model.UfHoy) : monto;
    }
    bool EsMonedaExtranjera(string? moneda) { string m = (moneda ?? "CLP").Trim().ToUpperInvariant(); return (m == "USD" && Model.DolarHoy > 0) || (m == "UF" && Model.UfHoy > 0); }
    Microsoft.AspNetCore.Html.IHtmlContent EquivClp(string? moneda, decimal monto) =>
        EsMonedaExtranjera(moneda) && monto != 0
            ? new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"cf-equiv\" title=\"Equivalente en CLP: {( (moneda ?? "").ToUpper() == "UF" ? $"UF $ {Model.UfHoy:N2}" : $"dólar observado $ {Model.DolarHoy:N2}")}\">≈ $ {AClp(moneda, monto):N0}</span>")
            : Microsoft.AspNetCore.Html.HtmlString.Empty;

    static string MargenResumen(decimal ing, decimal egr) =>
        ing > 0 ? ((ing - egr) / ing * 100m).ToString("0.#") + "%" : (egr > 0 ? "—" : "");

    // Diccionario de ciudades/localidades recurrentes. Si el texto (Retiro/Planta/
    // Destino) CONTIENE una de estas claves, se descarta todo lo demás (nombre de
    // empresa incluido) y se muestra solo la abreviatura — ej: "MEDLOG SAN ANTONIO"
    // se transforma en "SAI", no en "MEDLOG SAI". Si no hay match, se conserva el
    // texto tal cual (fallback seguro). Agregar aquí nuevas plantas/ciudades según
    // aparezcan.
    static readonly Dictionary<string, string> AbreviaturasUbicacion = new(StringComparer.OrdinalIgnoreCase)
    {
        { "VALPARAÍSO", "VAP" }, { "VALPARAISO", "VAP" },
        { "SAN ANTONIO", "SAI" },
        { "SAN VICENTE", "SVE" },
        { "CORONEL", "COR" },
        { "LIRQUÉN", "LQN" }, { "LIRQUEN", "LQN" },
        { "BUIN", "BUIN" }, { "PAINE", "PAINE" },
        { "MELIPILLA", "MELIPILLA" }, { "CALERA", "CALERA" },
        { "SAN FELIPE", "SAN FELIPE" }, { "ROMERAL", "ROMERAL" }
    };

    string AbreviarUbicacion(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return texto ?? "";
        string tUpper = texto.ToUpper();
        foreach (var kv in AbreviaturasUbicacion.OrderByDescending(k => k.Key.Length))
        {
            if (tUpper.Contains(kv.Key)) return kv.Value;
        }
        return texto.Trim();
    }

                string AbreviarRuta(string? concepto)
    {
        if (string.IsNullOrWhiteSpace(concepto)) return concepto ?? "";
        var match = System.Text.RegularExpressions.Regex.Match(concepto, @"^(.*)\(([^)]+)\)(.*)$");
        if (!match.Success) return concepto;
        string prefijo = match.Groups[1].Value;
        var tramos = match.Groups[2].Value.Split(" - ").Select(t => AbreviarUbicacion(t.Trim()));
        return $"{prefijo}({string.Join(" - ", tramos)}){match.Groups[3].Value}";
    }

    // Conceptos que FinanzasSyncService genera SIEMPRE por contenedor. Si un
    // booking tiene más de uno con el mismo concepto base, se colapsan en una
    // fila resumen "x N" con el detalle real desplegable — nunca se pierde la
    // fila individual (checkbox AGA, N° doc, comprobante siguen por contenedor).
    static readonly string[] PrefijosAgrupables = {
        "Honorarios Agencia de Aduanas",
        "Legalización / Emisión DUS",
        "Gate OUT Contenedor",
        "Gate IN Contenedor",
        "Seguridad de la Carga ISPS",
        "Rebate Marítimo (Naviera)",
        "Rebate Marítimo (Cliente)"
    };

    string ObtenerConceptoBase(string? concepto)
    {
        if (string.IsNullOrWhiteSpace(concepto)) return concepto ?? "";
        return System.Text.RegularExpressions.Regex.Replace(concepto, @"\s*\(U\d+\)", "").Trim();
    }

    bool EsConceptoAgrupable(string? concepto)
    {
        string baseC = ObtenerConceptoBase(concepto);
        return PrefijosAgrupables.Any(p => baseC.StartsWith(p, StringComparison.OrdinalIgnoreCase));
    }

    // Contenedor de una línea "(Uxx)": su número si ya está cargado, si no "2° Contenedor",
    // "3° Contenedor"... (mismo criterio que las pestañas del Detalle). Sin "(Uxx)" es el
    // 1° contenedor del booking.
    int PosicionContenedor(Operacione op, string? concepto)
    {
        var m = System.Text.RegularExpressions.Regex.Match(concepto ?? "", @"\(U(\d+)\)");
        if (!m.Success) return 1;
        int idU = int.Parse(m.Groups[1].Value);
        var unidades = (op.Unidadestecnicas ?? new List<Unidadestecnica>()).OrderBy(u => u.Id).ToList();
        int idx = unidades.FindIndex(u => u.Id == idU);
        return idx < 0 ? 999 : idx + 2;
    }

    string EtiquetaContenedor(Operacione op, string? concepto)
    {
        var m = System.Text.RegularExpressions.Regex.Match(concepto ?? "", @"\(U(\d+)\)");
        if (!m.Success) return AtilsonCargoSpa.Helpers.ContenedorEtiquetaHelper.Etiqueta(op.NumeroContenedor, 1);
        int idU = int.Parse(m.Groups[1].Value);
        var unidades = (op.Unidadestecnicas ?? new List<Unidadestecnica>()).OrderBy(u => u.Id).ToList();
        int idx = unidades.FindIndex(u => u.Id == idU);
        return idx < 0 ? $"Contenedor U{idU}" : AtilsonCargoSpa.Helpers.ContenedorEtiquetaHelper.Etiqueta(unidades[idx].NroContenedor, idx + 2);
    }

    // Proveedor de una fila de Egresos (oct-2026). Se resuelve POR CONTENEDOR: el sufijo
    // "(Uxx)" del concepto indica la unidad; sin sufijo es el contenedor principal. Así,
    // con transportistas o agencias distintos por contenedor, cada fila muestra el suyo
    // (antes todas tomaban los datos del contenedor principal, y las filas agrupadas
    // decían "Varios").
    static int? UnidadDeConcepto(string? concepto)
    {
        var m = System.Text.RegularExpressions.Regex.Match(concepto ?? "", @"\(U(\d+)\)");
        return m.Success ? int.Parse(m.Groups[1].Value) : null;
    }

    string ProveedorEgreso(Operacione op, TransaccionesFinanciera tx, bool esGate)
    {
        string g = (tx.GrupoCobro ?? "").ToUpper();
        int? idU = UnidadDeConcepto(tx.Concepto);
        OperacionesTerrestre? Terr(int? u) => op.OperacionesTerrestres?.FirstOrDefault(x => x.IdUnidadTecnica == u);

        if (g.Contains("DOCUMENTAL") || g.Contains("ADUANA"))
        {
            string? Agencia(OperacionesDocumentale? d) =>
                d == null ? null
                : d.IdAgenciaAduanaNavigation?.NombreAgencia
                  ?? (d.IdAgenciaAduana.HasValue && Model.NombresAgencias.TryGetValue(d.IdAgenciaAduana.Value, out var nomAg) ? nomAg : null)
                  ?? (string.IsNullOrWhiteSpace(d.AgenciaAduana) ? null : d.AgenciaAduana);
            var docs = op.OperacionesDocumentales ?? new List<OperacionesDocumentale>();
            return Agencia(docs.FirstOrDefault(d => d.IdUnidadTecnica == idU))
                ?? Agencia(docs.FirstOrDefault(d => d.IdUnidadTecnica == null))
                ?? docs.Select(Agencia).FirstOrDefault(n => n != null)
                ?? tx.IdProveedorNavigation?.NombreProveedor
                ?? "Por Asignar";
        }
        if (esGate)
        {
            if (op.IdNavieraNavigation?.AplicaTarifaGatePlana == true) return op.IdNavieraNavigation.NombreNaviera ?? "Por Asignar";
            return Terr(idU)?.DepositoRetiro ?? Terr(null)?.DepositoRetiro ?? "Depósito por Asignar";
        }
        if (g.Contains("TERRESTRE") || g.Contains("TRANSPORTE"))
        {
            string? empresa = Terr(idU)?.EmpresaTransporte;
            string? delMaestro = tx.IdProveedorNavigation?.NombreProveedor;
            // Mismo transportista escrito distinto (mayúsculas/espacios): se muestra el nombre del maestro.
            if (!string.IsNullOrWhiteSpace(empresa) && !string.IsNullOrWhiteSpace(delMaestro)
                && string.Equals(empresa.Trim(), delMaestro.Trim(), StringComparison.OrdinalIgnoreCase)) empresa = delMaestro;
            if (string.IsNullOrWhiteSpace(empresa)) empresa = delMaestro;
            if (string.IsNullOrWhiteSpace(empresa) && idU == null) empresa = Terr(null)?.EmpresaTransporte;
            return string.IsNullOrWhiteSpace(empresa) ? "Por Asignar" : empresa!;
        }
        string? nombre = tx.IdProveedorNavigation?.NombreProveedor;
        if (string.IsNullOrWhiteSpace(nombre))
        {
            if (g.Contains("MARÍTIMO") || g.Contains("MARITIMO")) nombre = op.IdNavieraNavigation?.NombreNaviera;
            else if (g.Contains("ALMACENAMIENTO") || g.Contains("BODEGA") || g.Contains("PATIO")) nombre = op.OperacionesAlmacenamientos?.FirstOrDefault()?.IdProveedorNavigation?.NombreProveedor;
        }
        return string.IsNullOrWhiteSpace(nombre) ? "Por Asignar" : nombre!;
    }

    bool TieneSufijoContenedor(string? concepto) => System.Text.RegularExpressions.Regex.IsMatch(concepto ?? "", @"\(U\d+\)");

    static string FmtMonto(string? moneda, decimal monto)
    {
        string m = string.IsNullOrWhiteSpace(moneda) ? "CLP" : moneda.Trim().ToUpperInvariant();
        return (m == "CLP" || m == "$") ? $"$ {monto:N0}" : $"{m} {monto:N2}";
    }

    // IVA en Ingresos (oct-2026): todo va + IVA salvo ISPS, Courier y el DUS (sin IVA);
    // Gate ahora va + IVA. Marítimo siempre + IVA. Si la línea trae IvaExento, manda eso.
    static bool EsIngresoExento(TransaccionesFinanciera t, string categoria)
    {
        string cat = (categoria ?? "").ToUpper();
        if (cat.Contains("MARÍTIMO") || cat.Contains("MARITIMO"))
    return AtilsonCargoSpa.Pages.Finanzas.ControlFinancieroModel.EsMaritimoUsdSinIva(t.Concepto)
        || (EsRebateMaritimo(t) && (t.IvaExento ?? true));
        if (t.IvaExento.HasValue) return t.IvaExento.Value;
        string c = (t.Concepto ?? "").ToUpper();
        return c.Contains("SEGURIDAD") || c.Contains("ISPS") || c.Contains("COURIER") || c.StartsWith("LEGALIZACIÓN / EMISIÓN DUS");
    }

    // Resultado de la verificación AGA para una fila agrupada. Es una CLASE
    // normal (no una tupla con nombres) a propósito: declarar un tipo tupla
    // directamente en código mezclado con HTML de Razor es lo que causaba el
    // RZ1027 persistente — el tokenizer de Razor no es un parser C# completo y
    // se pierde con esa sintaxis en esa zona del archivo. Aquí, dentro de
    // @functions, no hay ese problema.
    class AgaCalcResult
    {
        public decimal ValorComparar { get; set; }
        public bool Exento { get; set; }
        public decimal Tol { get; set; }
        public bool RequiereVerif { get; set; }
        public bool AgaActivado { get; set; }
        public bool AgaCoincide { get; set; }
        public bool AgaIncongruente { get; set; }
        public bool RequiereAceptarDif { get; set; }
    }

    // Orden dentro de la sección Marítimo: primero el flete y la emisión BL, después los
    // demás recargos y al final Late Arrival / Extra Late Arrival y las penalidades
    // (roleo, cancelación / no show), que solo aparecen cuando aplican.
    static int OrdenMaritimo(string? concepto)
{
    string c = (concepto ?? "").ToUpperInvariant();
    if (c.StartsWith("FLETE MARÍTIMO") || c.StartsWith("FLETE MARITIMO")) return 1;
    if (c.Contains("ROLEO")) return 2;
    if (c.Contains("CANCELACI") || c.Contains("NO SHOW")) return 3;
    if (c.Contains("REBATE")) return 4;
    if (c.StartsWith("CORRECCIÓN DE BL N°") || c.StartsWith("CORRECCION DE BL N°")) return 6;
    if (c.Contains("EXTRA LATE") || c.Contains("(ELAR)")) return 91;
    if (c.Contains("LATE ARRIVAL") || c.Contains("(LAR)")) return 90;
    if (c.Contains("BL") && (c.Contains("EMISI") || c.Contains("ORIGINAL") || c.Contains("SEAWAY") || c.Contains("SEA WAYBILL") || c.Contains("TELEX") || c.Contains("EXPRESS") || c.Contains("DESTINO"))) return 5;
    return 50;
}

    AgaCalcResult CalcularAgaGrp(TransaccionesFinanciera t, bool isGate, string categoria)
    {
        // oct-2026: todo lo Marítimo va + IVA (flete, BL, roleo, cancelación, late
        // arrival, rebate...), sin excepciones.
        bool esMarGrp = categoria.ToUpper().Contains("MARÍTIMO") || categoria.ToUpper().Contains("MARITIMO");
        bool exento = (esMarGrp && AtilsonCargoSpa.Pages.Finanzas.ControlFinancieroModel.EsMaritimoUsdSinIva(t.Concepto))
    || ((!esMarGrp || EsRebateMaritimo(t)) && (t.IvaExento ?? categoria.ToUpper().Contains("GATE")));
        int decIva = t.Moneda == "CLP" ? 0 : 2;
        decimal mTotal = exento ? t.MontoNeto : Math.Round(t.MontoNeto * 1.19m, decIva);
        decimal vComp = isGate ? Math.Round(t.MontoNeto * 1.19m, decIva) : mTotal;
        decimal tol = t.Moneda == "CLP" ? 1m : 0.01m;
        bool reqVerif = t.MontoNeto > 0m;
        bool activado = t.ConfirmadoAga && t.ValorAga.HasValue;
        bool coincide = activado && Math.Abs(t.ValorAga!.Value - vComp) <= tol;
        bool incong = activado && !coincide;
        bool reqAceptar = incong && (!t.AceptaDiferenciaPago || string.IsNullOrWhiteSpace(t.NotaDiferenciaAga));
                return new AgaCalcResult
        {
            ValorComparar = vComp,
            Exento = exento && !isGate,
            Tol = tol,
            RequiereVerif = reqVerif,
            AgaActivado = activado,
            AgaCoincide = coincide,
            AgaIncongruente = incong,
            RequiereAceptarDif = reqAceptar
        };
    }

    // Un Ingreso/Egreso en $0 (sin calibrar a mano) es un ajuste REAL pendiente
    // solo si el concepto no está cubierto por la tarifa plana paquetizada del
    // cliente (ej. Promar) — si está cubierto, el $0 es intencional.
    // Rebate Collect (naviera → Atilson y Atilson → cliente): devolución de flete, sin IVA.
    static bool EsRebateMaritimo(TransaccionesFinanciera t) => (t.Concepto ?? "").StartsWith("Rebate Marítimo", StringComparison.OrdinalIgnoreCase);

    // Línea en $0 por acuerdo Collect (Late Arrival, Extra Late, Corrección de BL): no es "Por asignar".
    static bool EsSinCostoAcuerdo(TransaccionesFinanciera t) =>
        t.MontoNeto == 0m && !t.TarifaManual && AtilsonCargoSpa.Helpers.AcuerdoCollectHelper.EsMarcaSinCosto(t.JustificacionManual);

    // Condición de pago y Commodity del booking, en columnas propias (oct-2026).
    // ---- Traspaso Ops -> Finanzas (oct-2026) ----
    static string Enc(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");

    string ClaseTraspaso(Operacione op) =>
        AtilsonCargoSpa.Services.TraspasoFinanzas.EsNuevaParaFinanzas(op) ? "row-traspaso-nuevo"
        : AtilsonCargoSpa.Services.TraspasoFinanzas.EstaReabierta(op) ? "row-traspaso-reab" : "";

    bool TraspasoPendiente(Operacione op) =>
        AtilsonCargoSpa.Services.TraspasoFinanzas.EsNuevaParaFinanzas(op) || AtilsonCargoSpa.Services.TraspasoFinanzas.EsReaperturaSinVer(op);

    Microsoft.AspNetCore.Html.IHtmlContent ChipTraspaso(Operacione op)
    {
        var sb = new System.Text.StringBuilder();
        if (AtilsonCargoSpa.Services.TraspasoFinanzas.EsNuevaParaFinanzas(op))
        {
            string tit = $"Operaciones finalizó la tarea ({op.UsuarioFinalizacionTarea}, {op.FechaFinalizacionTarea:dd/MM/yyyy HH:mm})";
            sb.Append($"<span class=\"tarea-chip tarea-chip--nuevo\" data-traspaso-chip title=\"{Enc(tit)}\"><i class=\"bi bi-stars\"></i> {(op.VecesFinalizadaTarea > 1 ? "Nuevo · actualizada" : "Nuevo")}</span>");
        }
        else if (AtilsonCargoSpa.Services.TraspasoFinanzas.EstaReabierta(op))
        {
            string tit = $"Reabierta por {op.UsuarioReaperturaTarea} el {op.FechaReaperturaTarea:dd/MM/yyyy HH:mm}: {op.MotivoReaperturaTarea}";
            sb.Append($"<span class=\"tarea-chip tarea-chip--reab\" title=\"{Enc(tit)}\"><i class=\"bi bi-arrow-counterclockwise\"></i> Reabierta</span>");
        }
        else if (AtilsonCargoSpa.Services.TraspasoFinanzas.EstaFinalizada(op))
        {
            string tit = $"Finalizada por {op.UsuarioFinalizacionTarea} el {op.FechaFinalizacionTarea:dd/MM/yyyy HH:mm}" + (op.FechaVistoFinanzas.HasValue ? $" · vista por {op.UsuarioVistoFinanzas} el {op.FechaVistoFinanzas:dd/MM HH:mm}" : "");
            sb.Append($"<span class=\"tarea-chip tarea-chip--fin\" title=\"{Enc(tit)}\"><i class=\"bi bi-check2-circle\"></i> Finalizada por Ops</span>");
        }
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    Microsoft.AspNetCore.Html.IHtmlContent BannerTraspaso(Operacione op)
    {
        if (AtilsonCargoSpa.Services.TraspasoFinanzas.EsNuevaParaFinanzas(op))
        {
            var sb = new System.Text.StringBuilder();
            sb.Append("<div class=\"cf-traspaso-banner cf-traspaso-banner--nuevo\"><i class=\"bi bi-flag-fill\"></i><div>");
            sb.Append($"<strong>{(op.VecesFinalizadaTarea > 1 ? "Operaciones volvió a finalizar la tarea" : "Operaciones finalizó la tarea")}</strong> ({Enc(op.UsuarioFinalizacionTarea)}, {op.FechaFinalizacionTarea:dd/MM/yyyy HH:mm}): contenedores embarcados y nave zarpada. Ya puedes revisar costos y cobros.");
            if (op.VecesFinalizadaTarea > 1 && Model.CambiosTraspaso.TryGetValue(op.Id, out var cambios))
            {
                if (cambios.Any())
                {
                    sb.Append("<ul class=\"cf-traspaso-cambios\"><li><strong>Cambios desde la finalización anterior:</strong></li>");
                    foreach (var c in cambios) sb.Append($"<li>{Enc(c)}</li>");
                    sb.Append("</ul>");
                }
                else sb.Append("<div class=\"cf-traspaso-cambios\">Sin cambios en los montos desde la finalización anterior.</div>");
            }
            sb.Append("</div></div>");
            return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
        }
        if (AtilsonCargoSpa.Services.TraspasoFinanzas.EstaReabierta(op))
        {
            return new Microsoft.AspNetCore.Html.HtmlString(
                "<div class=\"cf-traspaso-banner cf-traspaso-banner--reab\"><i class=\"bi bi-arrow-counterclockwise\"></i><div>"
                + $"<strong>Operación reabierta por Operaciones</strong> ({Enc(op.UsuarioReaperturaTarea)}, {op.FechaReaperturaTarea:dd/MM/yyyy HH:mm}). Motivo: {Enc(op.MotivoReaperturaTarea)}. "
                + "Atento a nuevos gastos y cobros; cuando Operaciones vuelva a finalizar, el booking aparecerá como NUEVO con los cambios."
                + (Model.RespaldosReapertura.TryGetValue(op.Id, out var resp)
                    ? $" <a class=\"tf-respaldo-link\" href=\"{Enc(resp.Ruta)}\" target=\"_blank\" rel=\"noopener\" title=\"Respaldo adjunto por Operaciones\"><i class=\"bi bi-paperclip\"></i> {Enc(resp.Nombre)}</a>"
                    : "")
                + "</div></div>");
        }
        return Microsoft.AspNetCore.Html.HtmlString.Empty;
    }

    Microsoft.AspNetCore.Html.IHtmlContent ChipCondicion(Operacione op)
    {
        string cond = AtilsonCargoSpa.Helpers.AcuerdoCollectHelper.TextoCondicionPago(op.CondicionPago);
        if (cond == "") return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-muted\" style=\"font-size:10px;\">—</span>");
        bool collect = AtilsonCargoSpa.Helpers.AcuerdoCollectHelper.EsCollect(op);
        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"cf-chip {(collect ? "cf-chip--collect" : "")}\">{System.Net.WebUtility.HtmlEncode(cond)}</span>");
    }

    Microsoft.AspNetCore.Html.IHtmlContent ChipCommodity(Operacione op)
    {
        if (string.IsNullOrWhiteSpace(op.Commodity)) return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-muted\" style=\"font-size:10px;\">—</span>");
        string c = op.Commodity.Trim().ToUpperInvariant();
        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"cf-chip cf-chip--commodity\" title=\"{System.Net.WebUtility.HtmlEncode(c)}\">{System.Net.WebUtility.HtmlEncode(c)}</span>");
    }

    bool EsPendienteReal(TransaccionesFinanciera t, int idCliente)
    {
        if (t.MontoNeto != 0m || t.TarifaManual) return false;
        // Ingreso que no se le cobra al cliente (responsable Atilson/proveedor/agencia): no está por asignar.
        if (t.EstadoFila == "NO FACTURABLE") return false;
        if (EsSinCostoAcuerdo(t)) return false;
        var gratuitos = Model.TarifasGratuitasPorCliente.TryGetValue(idCliente, out var g) ? g : new List<string>();
        return !AtilsonCargoSpa.Pages.Finanzas.ControlFinancieroModel.ConceptoCubiertoPorTarifaPlana(t.Concepto, gratuitos);
    }
}

