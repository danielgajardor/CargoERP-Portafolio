                                                                                @if (rutasPendGrp.Any())
                                                                                {
                                                                                    <a href="@rutasPendGrp[0]" target="_blank" class="btn btn-dark btn-xs shadow-sm btn-action-col" title="Ver PDF ya subido (falta su N° de factura)">
                                                                                        <i class="bi bi-eye"></i>
                                                                                    </a>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                @if (categoria.ToUpper().Contains("DOCUMENTAL") || txsGrpEgr.Any(t => !string.IsNullOrWhiteSpace(t.NumeroDocumentoOrigen)))
                                                                {
                                                                    var respGrp = txsGrpEgr.Select(t => (t.ProveedorOrigen ?? "") + "|" + (t.NumeroDocumentoOrigen ?? "")).Distinct().ToList();
                                                                    string? mixtoGrp = respGrp.Count > 1 ? $"{txsGrpEgr.Count(t => !string.IsNullOrWhiteSpace(t.NumeroDocumentoOrigen))} de {txsGrpEgr.Count} con respaldo" : null;
                                                                    var rutasOrigGrp = txsGrpEgr.Select(t => t.RutaFacturaOrigen).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();
                                                                        @FacturaIndHtml(idsCsvEgr, reprEgr.ProveedorOrigen, reprEgr.NumeroDocumentoOrigen, mixtoGrp, rutasOrigGrp.Count == 1 ? rutasOrigGrp[0] : null)
                                                                }
                                                                </div>
                                                            </td>
                                                            <td class="text-center align-middle pe-4">
                                                                <div class="d-flex align-items-center justify-content-between gap-2 w-100">
                                                                    <div class="flex-grow-1 text-center">
                                                                        <span class="badge-estado @(pagadosEgr == txsGrpEgr.Count ? "badge-pag" : (pagadosEgr > 0 ? "badge-parcial" : "badge-pend")) shadow-sm m-0" title="@pagadosEgr de @txsGrpEgr.Count contenedores pagados">@(pagadosEgr == txsGrpEgr.Count ? "PAGADO" : (pagadosEgr > 0 ? $"PARCIAL {pagadosEgr}/{txsGrpEgr.Count}" : "PENDIENTE"))</span>
                                                                        @if (algunoRequiereAceptar)
                                                                        {
                                                                            <div class="mt-1" style="max-width:170px; margin:0 auto;">
                                                                                                                                                                <textarea id="notaGrp-@op.Id-@giEgr" class="form-control form-control-sm mb-1" style="font-size:9px; height:38px; resize:none;" placeholder="@placeholderNotaGrpEgr"></textarea>
                                                                                <div class="d-flex align-items-center justify-content-center gap-1">
                                                                                    <input type="checkbox" class="form-check-input m-0" style="width:12px;height:12px;cursor:pointer;" onchange="aceptarDiferenciaGrupo(this, '@idsCsvEgr', 'notaGrp-@op.Id-@giEgr')" />
                                                                                    <label class="text-warning fw-bold mb-0" style="font-size:8px; text-transform:uppercase; letter-spacing:0.3px;">Consciente pago diferencia</label>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                    <div style="width: 28px; flex-shrink: 0;" class="text-end">
                                                                        @if (bloqueadoDuroGrupo)
                                                                        {
                                                                            @* Estado de pago informativo: sin candado en Control Financiero. *@
                                                                        }
                                                                        else if (algunoRequiereAceptar)
                                                                        {
                                                                            <button type="button" class="btn btn-outline-warning btn-xs shadow-sm btn-action-col" style="opacity:0.6; cursor:not-allowed;" disabled title="Diferencia de valor pendiente de justificar"><i class="bi bi-exclamation-triangle-fill"></i></button>
                                                                        }

                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        @* 13-nov: detalle por contenedor de la fila ×N (oculto hasta «Ver por contenedor»). *@
                                                        bool esDocSub = categoria.ToUpper().Contains("DOCUMENTAL");
                                                        var subsEgr = txsGrpEgr.OrderBy(t => PosicionContenedor(op, t.Concepto)).ThenBy(t => t.Id).ToList();
                                                        // Reglas (13-nov): solo los contenedores sin N° se marcan para una factura común; una factura
                                                        // compartida se cambia o quita desde la fila del grupo y su PDF va a todos sus contenedores;
                                                        // el PDF de un contenedor se sube después de su N°; lo pagado queda bloqueado.
                                                        bool hayPendSub = subsEgr.Count(t => !(t.EstadoFila == "PAGADO" || t.EstadoFila == "CONCILIADO") && string.IsNullOrWhiteSpace(t.NumeroDocumento)) > 1;
                                                        string ClaveFact(TransaccionesFinanciera t) => (t.NumeroDocumento ?? "").Trim().ToUpperInvariant();
                                                        foreach (var ts in subsEgr)
                                                        {
                                                            var cs = CalcularAgaGrp(ts, isGateRowEgr, categoria);
                                                            bool pagadoTs = ts.EstadoFila == "PAGADO" || ts.EstadoFila == "CONCILIADO";
                                                            var faltanTs = FaltantesPagoEgreso(op, ts, cs);
                                                            string etqTs = EtiquetaContenedor(op, ts.Concepto);
                                                            string cTs = "C" + PosicionContenedor(op, ts.Concepto);
                                                            bool sinNumTs = string.IsNullOrWhiteSpace(ts.NumeroDocumento);
                                                            var mismaFactTs = sinNumTs ? new List<TransaccionesFinanciera> { ts } : subsEgr.Where(t => ClaveFact(t) == ClaveFact(ts)).ToList();
                                                            bool compartidaTs = mismaFactTs.Count > 1;
                                                            string otrosTs = string.Join(" ", mismaFactTs.Where(t => t.Id != ts.Id).Select(t => "C" + PosicionContenedor(op, t.Concepto)));
                                                            string idsFactTs = string.Join(",", mismaFactTs.Select(t => t.Id));
                                                            <tr class="cf-sub-cont d-none @(pagadoTs ? "cf-sub-pagado" : "")" data-tx="@ts.Id">
                                                                <td class="ps-4 align-middle">
                                                                    @if (!pagadoTs && sinNumTs && hayPendSub)
                                                                    {
                                                                        <label class="cf-sub-sel" title="Marcar para asignarle una misma factura junto con otros contenedores">
                                                                            <input type="checkbox" class="form-check-input m-0 cf-sub-chk" value="@ts.Id" data-sin-num="@(sinNumTs ? "1" : "0")" /><span>@cTs</span>
                                                                        </label>
                                                                    }
                                                                    else { <span class="cf-sub-conector">@cTs</span> }
                                                                </td>
                                                                <td class="align-middle"><span class="badge-contenedor-u ms-0" title="@etqTs">@etqTs</span></td>
                                                                <td></td>
                                                                <td></td>
                                                                <td class="text-end font-monospace align-middle"><span class="text-dark" style="font-weight:600;">@FmtMonto(ts.Moneda, ts.MontoNeto)</span></td>
                                                                <td class="text-end font-monospace align-middle">
                                                                    @if (cs.Exento) { <span class="cf-exento">Exento</span> }
                                                                    else { <span class="text-dark" style="font-weight:700;">@FmtMonto(ts.Moneda, cs.ValorComparar)</span> }
                                                                </td>
                                                                <td class="text-center align-middle">
                                                                    @if (!cs.RequiereVerif || op.EsHistorica) { <span class="text-muted" style="font-size:10px;">—</span> }
                                                                    else if (cs.AgaActivado && cs.AgaCoincide) { <i class="bi bi-check-circle-fill text-success" title="Valor confirmado"></i> }
                                                                    else if (cs.AgaIncongruente) { <i class="bi bi-exclamation-triangle-fill text-warning" title="Valor con diferencia"></i> }
                                                                    else { <i class="bi bi-circle text-muted" title="Valor sin confirmar: se confirma en la fila del grupo"></i> }
                                                                </td>
                                                                <td class="text-end font-monospace align-middle">
                                                                    @if (cs.AgaActivado && ts.ValorAga.HasValue) { <span style="font-size:11px;">@FmtMonto(ts.Moneda, ts.ValorAga.Value)</span> }
                                                                    else { <span class="text-muted" style="font-size:10px;">—</span> }
                                                                </td>
                                                                @if (esDocSub)
                                                                {
                                                                    <td class="align-middle text-center px-2 cf-doc-num">
                                                                        <div class="cf-fact-celda">
                                                                            <div class="cf-fact-linea cf-doc-linea">
                                                                                @if (!string.IsNullOrWhiteSpace(ts.NumeroDocumentoDocumental)) { <span class="fw-bold text-dark text-truncate" style="font-size:10px;" title="@ts.NumeroDocumentoDocumental">@ts.NumeroDocumentoDocumental</span> }
                                                                                else { <span class="text-muted" style="font-size:10px;">—</span> }
                                                                            </div>
                                                                        </div>
                                                                    </td>
                                                                }
                                                                <td class="align-middle px-3 cf-fact-td" colspan="@(esDocSub ? 1 : 2)">
                                                                    <div class="cf-fact-celda">
                                                                        <div class="cf-fact-linea">
                                                                            <div class="cf-fact-campo">
                                                                                @if (sinNumTs)
                                                                                {
                                                                                    <div class="input-group input-group-sm shadow-sm m-0 p-0">
                                                                                        <input type="text" class="form-control text-center" style="font-size: 9px; height: 24px; border-color: #cbd5e1;" placeholder="N° Fact @cTs" maxlength="50"
                                                                                               onkeydown="if (event.key === 'Enter') { event.preventDefault(); this.nextElementSibling.click(); }" />
                                                                                        <button type="button" class="btn btn-outline-primary" style="padding: 0 8px; height: 24px;" title="Guardar el N° de factura solo de este contenedor" onclick="cfSubGuardarDoc(this, @ts.Id)"><i class="bi bi-check2"></i></button>
                                                                                    </div>
                                                                                }
                                                                                else if (compartidaTs || pagadoTs)
                                                                                {
                                                                                    string numTs = ts.NumeroDocumento!.Trim();
                                                                                    <span class="cf-fact-bloq text-truncate" title="@(pagadoTs ? "Pagada: no se puede cambiar" : $"Factura compartida con {otrosTs}: se cambia o quita desde la fila del grupo")">
                                                                                        <i class="bi bi-lock-fill"></i> FACT: @numTs @if (compartidaTs) { <small>con @otrosTs</small> }
                                                                                    </span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    string numTs = ts.NumeroDocumento!.Trim();
                                                                                    <button type="button" class="cf-fact-num text-truncate" data-ids="@ts.Id" data-num="@numTs" data-pagada="0"
                                                                                            title="Factura @numTs de @etqTs · clic para cambiarla o quitarla" onclick="cfFactEditar(this)">FACT: @numTs</button>
                                                                                }
                                                                            </div>
                                                                            <div class="cf-fact-archivo">
                                                                                @if (string.IsNullOrEmpty(ts.RutaFactura))
                                                                                {
                                                                                    if (pagadoTs) { }
                                                                                    else if (sinNumTs)
                                                                                    {
                                                                                        <button type="button" class="btn btn-light border btn-xs text-secondary btn-action-col" disabled title="Primero ingresa el N° de factura de @cTs"><i class="bi bi-upload"></i></button>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <button type="button" class="btn btn-light border btn-xs shadow-sm text-secondary btn-action-col" title="@(compartidaTs ? $"Subir el PDF de la factura {ts.NumeroDocumento} (queda en {cTs} y {otrosTs})" : $"Subir el PDF de la factura de {cTs}")" onclick="this.nextElementSibling.click()"><i class="bi bi-upload"></i></button>
                                                                                        <input type="file" class="d-none" accept=".pdf,.png,.jpg,.jpeg" data-ids="@idsFactTs" onchange="subirFacturaGrupo(this)" />
                                                                                    }
                                                                                }
                                                                                else
                                                                                {
                                                                                    <a href="@ts.RutaFactura" target="_blank" class="btn btn-dark btn-xs shadow-sm btn-action-col" title="Ver PDF de la factura de @cTs"><i class="bi bi-eye"></i></a>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td class="text-center align-middle pe-4">
                                                                    @if (pagadoTs) { <span class="badge-estado badge-pag shadow-sm m-0">PAGADO</span> }
                                                                    else if (faltanTs.Count == 0) { <span class="cf-sub-estado cf-sub-estado--listo" title="Tiene N° de factura, PDF y valor confirmado: ya se puede pagar en Pagos"><i class="bi bi-check2-circle"></i> Listo para pagar</span> }
                                                                    else { <span class="cf-sub-estado cf-sub-estado--falta" title="Lo que falta para poder pagarlo en Pagos">Falta: @string.Join(" · ", faltanTs)</span> }
                                                                </td>
                                                            </tr>
                                                        }
                                                        if (hayPendSub)
                                                        {
                                                            <tr class="cf-sub-cont cf-sub-acciones d-none">
                                                                <td colspan="11">
                                                                    <div class="cf-sub-barra">
                                                                        <span class="cf-sub-barra-txt"><i class="bi bi-check2-square"></i> Una factura para varios contenedores: marca los que cubre (C1, C2…)</span>
                                                                        <input type="text" class="form-control form-control-sm cf-sub-num" placeholder="N° Fact" maxlength="50"
                                                                               onkeydown="if (event.key === 'Enter') { event.preventDefault(); this.parentElement.querySelector('.cf-sub-ok').click(); }" />
                                                                        <label class="btn btn-light border btn-sm cf-sub-pdf mb-0" title="PDF de la factura (opcional; también se puede subir después)">
                                                                            <i class="bi bi-paperclip"></i> <span class="cf-sub-pdf-txt">PDF (opcional)</span>
                                                                            <input type="file" class="d-none cf-sub-archivo" accept=".pdf,.png,.jpg,.jpeg" onchange="this.parentElement.querySelector('.cf-sub-pdf-txt').textContent = this.files[0] ? this.files[0].name : 'PDF (opcional)'" />
                                                                        </label>
                                                                        <button type="button" class="btn btn-dark btn-sm cf-sub-ok" onclick="cfSubAsignar(this)"><i class="bi bi-check2 me-1"></i>Asignar a los marcados</button>
                                                                        <span class="cf-sub-sel-info">Ninguno marcado</span>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                        <div class="p-2 d-flex justify-content-between align-items-center border-top" style="background-color: #f8fafc;">
                                            <button type="button" class="btn btn-outline-dark btn-sm fw-bold px-3 cf-btn-extra" style="font-size: 10px;" disabled="@(op.LockFinanzas ? "disabled" : null)" title="@(op.LockFinanzas ? "Operación liquidada" : "Agregar un costo o cobro que no sale de las tarifas")"
                                                    onclick="abrirConceptoExtra(@op.Id, 'EGRESO', '@op.NumeroBooking')"><i class="bi bi-plus-lg me-1"></i> Agregar concepto</button>
                                            <a href="/Finanzas/SetPagoEgresos/@op.Id" target="_blank" class="btn btn-dark btn-sm fw-bold px-3 shadow-sm" style="font-size: 10px; background-color: #7c2d12;"><i class="bi bi-file-earmark-text me-1"></i> GENERAR LIQUIDACIÓN DE EGRESOS</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ================= PESTAÑA RESUMEN (por concepto, oct-2026) ================= -->
        <div class="tab-pane fade" id="resumen" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-main-grid mb-0">
                    <thead>
                        <tr>
                            <th style="width: 200px;">N° Booking</th>
                            <th>Cliente</th>
                            <th class="text-end" style="width: 220px;">Diferencia (ingreso − egreso)</th>
                            <th style="width: 220px;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var op in Model.Operaciones)
                        {
                            var filasRes = FilasResumen(op);
                            var totalesRes = TotalesResumen(filasRes);
                            bool tieneAjustePendienteRes = op.TransaccionesFinancieras.Any(t => Model.ServicioVisible(GrupoResumen(t)) && EsPendienteReal(t, op.IdCliente));
                            var conceptosPendientesRes = op.TransaccionesFinancieras.Where(t => Model.ServicioVisible(GrupoResumen(t)) && EsPendienteReal(t, op.IdCliente)).Select(t => t.Concepto).Distinct().ToList();
                            bool completoRes = MovimientoCompleto(op);

                            <tr data-bs-toggle="collapse" data-bs-target="#res-CF-@op.Id" class="cursor-pointer main-row row-resumen @(tieneAjustePendienteRes ? "row-alerta-comercial" : "") @(completoRes ? "cf-row-completa" : "") @(op.EsHistorica ? "cf-row-historico" : "")">
                                <td style="vertical-align: middle;">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-chevron-right text-muted me-2" style="font-size: 10px;"></i>
                                        <span style="font-weight: 800; color: @(tieneAjustePendienteRes ? "#dc2626" : "#0f172a");">@op.NumeroBooking</span>@if (op.EsHistorica) { <span class="cf-hist-chip"><i class="bi bi-archive-fill"></i> Histórico</span> }
                                    </div>
                                </td>
                                <td style="vertical-align: middle;">
                                    <span style="font-weight:500; color:#475569; font-size: 12px;">@(op.IdClienteNavigation?.RazonSocial ?? "")</span>
                                </td>
                                <td class="text-end" style="vertical-align: middle;">
                                    @CeldaMontos(totalesRes.Select(t => (t.Moneda, t.Ing - t.Egr)), diferencia: true)
                                    @if (totalesRes.Any(t => EsMonedaExtranjera(t.Moneda)))
                                    {
                                        <span class="cf-equiv">≈ $ @totalesRes.Sum(t => AClp(t.Moneda, t.Ing - t.Egr)).ToString("N0") en CLP</span>
                                    }
                                </td>
                                <td style="vertical-align: middle;">
                                    @if (tieneAjustePendienteRes)
                                    {
                                        <span class="badge-pendiente-comercial d-inline-block" style="margin-left: 0;">Pendiente cierre Acuerdo</span>
                                    }
                                    else if (completoRes)
                                    {
                                        <span class="cf-completo-chip"><i class="bi bi-check2-circle"></i> Completo</span>
                                    }
                                </td>
                            </tr>
                            <tr id="res-CF-@op.Id" class="collapse">
                                <td class="p-0 border-0" colspan="4">
                                    <div class="nested-container">
                                        @if (tieneAjustePendienteRes)
                                        {
                                            <div class="alerta-comercial-banner">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <div>
                                                    <strong>Pendiente cierre Acuerdo.</strong> Comercial aún no define la tarifa para: @string.Join(", ", conceptosPendientesRes)
                                                </div>
                                            </div>
                                        }
                                        <table class="table table-sm nested-table cf-res-tabla mb-0">
                                            <thead>
                                                <tr>
                                                    <th class="ps-4">Concepto</th>
                                                    <th class="text-end">Egreso (costo)</th>
                                                    <th class="text-end">Ingreso (venta)</th>
                                                    <th class="text-end">Diferencia</th>
                                                    <th class="text-end pe-4" style="width: 90px;">Margen</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var grupo in filasRes.GroupBy(f => f.Grupo))
                                                {
                                                    var totGrupo = TotalesResumen(grupo);
                                                    <tr class="cf-res-grupo">
                                                        <td class="ps-4">@grupo.Key <span class="cf-res-cuenta">@grupo.Count() @(grupo.Count() == 1 ? "concepto" : "conceptos")</span></td>
                                                        <td class="text-end">@CeldaMontos(totGrupo.Select(t => (t.Moneda, t.Egr)))</td>
                                                        <td class="text-end">@CeldaMontos(totGrupo.Select(t => (t.Moneda, t.Ing)))</td>
                                                        <td class="text-end">@CeldaMontos(totGrupo.Select(t => (t.Moneda, t.Ing - t.Egr)), diferencia: true)</td>
                                                        <td class="text-end pe-4">@(totGrupo.Count == 1 ? MargenResumen(totGrupo[0].Ing, totGrupo[0].Egr) : "")</td>
                                                    </tr>
                                                    @foreach (var f in grupo)
                                                    {
                                                        var monedas = f.Monedas.ToList();
                                                        <tr class="cf-res-fila">
                                                            <td class="ps-5">
                                                                <span class="cf-res-concepto">@f.Concepto</span>
                                                                @if (f.Unidades > 1)
                                                                {
                                                                    <span class="cf-res-chip" title="Un cargo por contenedor">x @f.Unidades</span>
                                                                }
                                                                @if (f.EsExtracosto)
                                                                {
                                                                    <span class="cf-res-chip cf-res-chip--ext">Extracosto</span>
                                                                }
                                                                @if (f.Pendiente)
                                                                {
                                                                    <span class="cf-res-chip cf-res-chip--pend">Por asignar</span>
                                                                }
                                                                @if (f.NoFacturable)
                                                                {
                                                                    <span class="cf-res-chip" title="El responsable no es el cliente: no se le cobra">No facturable</span>
                                                                }
                                                            </td>
                                                            <td class="text-end">@CeldaMontos(monedas.Select(m => (m, f.Egr(m))))</td>
                                                            <td class="text-end">@CeldaMontos(monedas.Select(m => (m, f.Ing(m))))</td>
                                                            <td class="text-end fw-bold">@CeldaMontos(monedas.Select(m => (m, f.Ing(m) - f.Egr(m))), diferencia: true)</td>
                                                            <td class="text-end pe-4 cf-res-margen">@(monedas.Count == 1 ? MargenResumen(f.Ing(monedas[0]), f.Egr(monedas[0])) : "")</td>
                                                        </tr>
                                                    }
                                                }
                                                @if (!filasRes.Any())
                                                {
                                                    <tr><td colspan="5" class="text-center text-muted py-3" style="font-style: italic; font-size: 11px;">Aún no hay transacciones para este Booking.</td></tr>
                                                }
                                            </tbody>
                                            @if (filasRes.Any())
                                            {
                                                <tfoot>
                                                    <tr class="cf-res-total">
                                                        <td class="ps-4">Total booking</td>
                                                        <td class="text-end">@CeldaMontos(totalesRes.Select(t => (t.Moneda, t.Egr)))</td>
                                                        <td class="text-end">@CeldaMontos(totalesRes.Select(t => (t.Moneda, t.Ing)))</td>
                                                        <td class="text-end">@CeldaMontos(totalesRes.Select(t => (t.Moneda, t.Ing - t.Egr)), diferencia: true)</td>
                                                        <td class="text-end pe-4">@(totalesRes.Count == 1 ? MargenResumen(totalesRes[0].Ing, totalesRes[0].Egr) : "")</td>
                                                    </tr>
                                                    @if (totalesRes.Any(t => EsMonedaExtranjera(t.Moneda)))
                                                    {
                                                        decimal egrClp = totalesRes.Sum(t => AClp(t.Moneda, t.Egr));
                                                        decimal ingClp = totalesRes.Sum(t => AClp(t.Moneda, t.Ing));
                                                        <tr class="cf-res-total cf-res-total--clp">
                                                            <td class="ps-4">Total en CLP <span class="cf-res-cuenta">equivalente</span></td>
                                                            <td class="text-end"><div class="cf-res-monto">$ @egrClp.ToString("N0")</div></td>
                                                            <td class="text-end"><div class="cf-res-monto">$ @ingClp.ToString("N0")</div></td>
                                                            <td class="text-end"><div class="cf-res-monto @(ingClp - egrClp > 0 ? "cf-res-pos" : ingClp - egrClp < 0 ? "cf-res-neg" : "cf-res-cero")">$ @((ingClp - egrClp).ToString("N0"))</div></td>
                                                            <td class="text-end pe-4">@MargenResumen(ingClp, egrClp)</td>
                                                        </tr>
                                                    }
                                                </tfoot>
                                            }
                                        </table>
                                        @if (totalesRes.Any(t => EsMonedaExtranjera(t.Moneda)))
                                        {
                                            <div class="cf-res-nota"><i class="bi bi-info-circle"></i> El total en CLP convierte los montos en moneda extranjera al @(totalesRes.Any(t => t.Moneda == "USD") ? $"dólar observado de hoy ($ {Model.DolarHoy:N2})" : "")@(totalesRes.Any(t => t.Moneda == "USD") && totalesRes.Any(t => t.Moneda == "UF") ? " y a la " : "")@(totalesRes.Any(t => t.Moneda == "UF") ? $"UF de hoy ($ {Model.UfHoy:N2})" : ""). Es una referencia: lo facturado en moneda extranjera se cobra al tipo de cambio de la factura.</div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.TotalPaginas > 1)
