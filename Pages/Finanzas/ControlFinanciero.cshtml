                                                                        <button type="button" class="btn btn-outline-primary" style="padding: 0 8px; height: 24px;" onclick="guardarNumeroDocGrupo(this, '@idsCsvEgr', 'docGrp-@op.Id-@giEgr')"><i class="bi bi-check2"></i></button>
