    .table-main-grid .main-row.cf-row-historico > td { background:#f1f5f9 !important; color:#64748b !important; border-color:#d9e0e8 !important; }
    .table-main-grid .main-row.cf-row-historico:hover > td { background:#e9eef4 !important; }
    .cf-hist-chip { display:inline-flex;align-items:center;gap:3px;margin-left:6px;padding:2px 6px;border-radius:999px;background:#e5e7eb;color:#4b5563;border:1px solid #d1d5db;font-size:8px;font-weight:850;text-transform:uppercase; }
    .cf-completo-chip {
        display:inline-flex; align-items:center; gap:4px; padding:3px 7px; border-radius:999px;
        background:#dcfce7; color:#166534; border:1px solid #bbf7d0;
        font-size:8.5px; font-weight:850; letter-spacing:.03em; text-transform:uppercase;
    }

    /* Filtros: una sola línea visual, campos alineados y responsive. */
    .cf-filter-card {
        background: #fff;
        border: 1px solid var(--atilson-border);
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 14px;
        box-shadow: 0 2px 8px rgba(15,23,42,.04);
    }
    .cf-filter-grid {
        display: grid;
        grid-template-columns: minmax(130px,.9fr) minmax(170px,1.2fr) minmax(150px,1fr) minmax(150px,1fr) minmax(140px,.9fr) minmax(160px,1.1fr) auto auto;
        gap: 9px;
        align-items: end;
    }
    .cf-filter-field label {
        display:block;
        font-size: 8.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .45px;
        color:#64748b;
        margin:0 0 4px 2px;
    }
    .cf-filter-field .form-control,
    .cf-filter-field .form-select {
        height: 34px;
        font-size: 10.5px;
        font-weight: 650;
        border-color:#dbe3ec;
        background:#f8fafc;
    }
    .cf-filter-action { height:34px; min-width:82px; font-size:10px; font-weight:800; }
    .cf-filter-reset { height:34px; width:36px; display:inline-flex;align-items:center;justify-content:center; }
    @@media(max-width: 1250px) {
        .cf-filter-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
        .cf-filter-grid .cf-filter-actions { grid-column: span 3; justify-content:flex-end; }
    }
    @@media(max-width: 760px) {
        .cf-filter-grid { grid-template-columns: 1fr; }
        .cf-filter-grid .cf-filter-actions { grid-column: auto; justify-content:stretch; }
        .cf-filter-actions .btn { flex:1; }
    }
</style>

<div class="container-fluid px-4 py-4 cf-premium fin-modulo">

    <div class="page-header">
        <div class="page-header__title-row">
            <div class="page-header__icon"><i class="bi bi-sliders"></i></div>
            <div>
                <h1>Control Financiero</h1>
                <p class="page-header__subtitle">Trazabilidad de ingresos y costos operacionales.</p>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 shadow-sm mb-4" style="font-size: 12px; font-weight: 700; border-radius: 8px;">
            <i class="bi bi-shield-exclamation fs-5"></i>
            <span>@TempData["ErrorMsg"]</span>
        </div>
    }

    <partial name="/Pages/Finanzas/_FinanzasNav.cshtml" model='"ControlFinanciero"' />
    @if (Model.RebatesLegadosConDocumento > 0)
    {
        <div class="alert alert-warning py-2 small mb-3" role="alert">
            <i class="bi bi-info-circle me-1"></i>
            Se encontraron @Model.RebatesLegadosConDocumento registro(s) de rebate antiguos con documento, pago, ajuste manual o respaldo.
            No se borraron porque requieren revisión contable por Finanzas.
        </div>
    }
    <form method="get" class="cf-filter-card" aria-label="Filtros de Control Financiero">
        <div class="cf-filter-grid">
            <div class="cf-filter-field">
                <label asp-for="FiltroBooking">Booking</label>
                <input asp-for="FiltroBooking" class="form-control" placeholder="Ej: HL-12345" autocomplete="off" />
            </div>
            <div class="cf-filter-field">
                <label asp-for="FiltroClienteId">Cliente</label>
                <select asp-for="FiltroClienteId" class="form-select">
                    <option value="">Todos los clientes</option>
                    @foreach (var cli in Model.FiltroClientes)
                    {
                        <option value="@cli.Id">@cli.RazonSocial</option>
                    }
                </select>
            </div>
            <div class="cf-filter-field">
                <label asp-for="FiltroNavieraId">Naviera</label>
                <select asp-for="FiltroNavieraId" class="form-select">
                    <option value="">Todas las navieras</option>
                    @foreach (var nav in Model.FiltroNavieras)
                    {
                        <option value="@nav.Id">@nav.NombreNaviera</option>
                    }
                </select>
            </div>
            <div class="cf-filter-field">
                <label asp-for="FiltroNave">Nave</label>
                <select asp-for="FiltroNave" class="form-select" data-buscador="si">
                    <option value="">Todas las naves</option>
                    @foreach (var nv in Model.FiltroNaves)
                    {
                        <option value="@nv">@nv</option>
                    }
                </select>
            </div>
            <div class="cf-filter-field">
                <label asp-for="FiltroServicio">Servicio</label>
                <select asp-for="FiltroServicio" class="form-select">
                    <option value="">Todos los servicios</option>
                    <option value="Marítimo">Marítimo</option>
                    <option value="Transporte">Transporte</option>
                    <option value="Documental">Documental</option>
                    <option value="Gate-Out/In">Gate-Out/In</option>
                    <option value="Almacenamiento">Almacenamiento</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>
            <div class="cf-filter-field">
                <label asp-for="FiltroProveedor">Proveedor</label>
                <input asp-for="FiltroProveedor" class="form-control" placeholder="Naviera no: transportista, agencia, bodega…" autocomplete="off" />
            </div>
            <div class="cf-filter-actions d-flex gap-2 align-items-end">
                <button type="submit" class="btn btn-dark cf-filter-action"><i class="bi bi-funnel me-1"></i> Filtrar</button>
                <a asp-page="./ControlFinanciero" class="btn btn-outline-secondary cf-filter-reset" title="Limpiar filtros"><i class="bi bi-x-lg"></i></a>
            </div>
        </div>
    </form>

    <ul class="nav nav-tabs atilson-tabs mb-3" id="finanzasTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="egresos-tab" data-bs-toggle="tab" data-bs-target="#egresos" type="button" role="tab">Egresos</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="ingresos-tab" data-bs-toggle="tab" data-bs-target="#ingresos" type="button" role="tab">Ingresos</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="resumen-tab" data-bs-toggle="tab" data-bs-target="#resumen" type="button" role="tab">Resumen Operacional</button>
        </li>
    </ul>

    <div class="tab-content bg-white" id="finanzasTabsContent">

        <!-- ================= PESTAÑA INGRESOS ================= -->
        <div class="tab-pane fade" id="ingresos" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-main-grid mb-0">
                    <thead>
                        <tr>
                            <th style="width: 200px;">N° Booking</th>
                            <th>Cliente</th>
                            <th style="width: 130px;">Condición</th>
                            <th style="width: 200px;">Commodity</th>
                            <th style="width: 170px;">Estado</th>
                            <th class="text-end" style="width: 110px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var op in Model.Operaciones.Where(o => o.TransaccionesFinancieras.Any(t => t.TipoMovimiento == "INGRESO")))
                        {
                                                        bool tieneAjustePendienteIng = op.TransaccionesFinancieras.Any(t => Model.ServicioVisible(GrupoResumen(t)) && EsPendienteReal(t, op.IdCliente));
                            bool completoIng = MovimientoCompleto(op, "INGRESO");
                            var conceptosPendientesIng = op.TransaccionesFinancieras.Where(t => Model.ServicioVisible(GrupoResumen(t)) && EsPendienteReal(t, op.IdCliente)).Select(t => t.Concepto).Distinct().ToList();
                            <tr data-bs-toggle="collapse" data-bs-target="#ing-CF-@op.Id" data-op-id="@op.Id" data-traspaso-pendiente="@(TraspasoPendiente(op) ? "1" : "0")" class="cursor-pointer main-row row-ingreso @ClaseTraspaso(op) @(tieneAjustePendienteIng ? "row-alerta-comercial" : "") @(completoIng ? "cf-row-completa" : "") @(op.EsHistorica ? "cf-row-historico" : "")">
                                <td style="vertical-align: middle;">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-chevron-right text-muted me-2" style="font-size: 10px;"></i>
                                        <span style="font-weight: 800; color: @(tieneAjustePendienteIng ? "#dc2626" : "#0f172a");">@op.NumeroBooking</span>@if (op.EsHistorica) { <span class="cf-hist-chip"><i class="bi bi-archive-fill"></i> Histórico</span> }
                                    </div>
                                </td>
                                <td style="vertical-align: middle;">
                                    <span style="font-weight:500; color:#475569; font-size: 12px;">@(op.IdClienteNavigation?.RazonSocial ?? "Sin Cliente")</span>
                                </td>
                                <td style="vertical-align: middle;">@ChipCondicion(op)</td>
                                <td style="vertical-align: middle;">@ChipCommodity(op)</td>
                                <td style="vertical-align: middle;">
                                    <div class="cf-traspaso-cell">
                                        @ChipTraspaso(op)
                                        @if (tieneAjustePendienteIng)
                                        {
                                            <span class="badge-pendiente-comercial d-inline-block" style="margin-left: 0;">Pendiente cierre Acuerdo</span>
                                        }
                                        else if (completoIng)
                                        {
                                            <span class="cf-completo-chip"><i class="bi bi-check2-circle"></i> Completo</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end" style="vertical-align: middle;">
                                    <a href="/Finanzas/Edit/@op.Id" class="btn btn-outline-dark btn-xs" onclick="event.stopPropagation();">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                </td>
                            </tr>
                            <tr id="ing-CF-@op.Id" class="collapse">
                                <td class="p-0 border-0" colspan="6">
                                    <div class="nested-container">
                                        @BannerTraspaso(op)
                                        @if (tieneAjustePendienteIng)
                                        {
                                            <div class="alerta-comercial-banner">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <div>
                                                    <strong>Pendiente cierre Acuerdo.</strong> Comercial aún no define la tarifa para: @string.Join(", ", conceptosPendientesIng)
                                                </div>
                                            </div>
                                        }
                                        <form id="form-nc-@op.Id" method="post" asp-page-handler="EmitirNotaCobro" class="d-none">
                                            <input type="hidden" name="operacionId" value="@op.Id" />
                                        </form>

                                        <table class="table table-sm nested-table mb-0">
                                            <thead>
                                                                                                <tr>
                                                    <th class="text-center" style="width: 5%;"><i class="bi bi-check2-square text-muted" title="Seleccionar exentos"></i></th>
                                                    <th class="ps-2">Concepto</th>
                                                    <th class="text-end" style="width: 12%;">Valor Neto</th>
                                                    <th class="text-end" style="width: 10%;">Handling</th>
                                                    <th class="text-end" style="width: 12%;">Valor Original + IVA</th>
                                                    <th class="text-center px-3" colspan="2" style="width: 180px;">N° Doc (Fact. / NC)</th>
                                                    <th class="text-center pe-4" style="width: 160px;">Estado de pago</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    string[] ordenInmutable = { "Marítimo", "Transporte", "Documental", "Gate-Out/In", "Almacenamiento", "Otros" };
                                                    var ingresosTodos = op.TransaccionesFinancieras.Where(t => t.TipoMovimiento == "INGRESO").Select(t => new { Tx = t, Grupo = (t.GrupoCobro == "Depósito" || t.GrupoCobro == "Deposito") ? "Gate-Out/In" : (string.IsNullOrWhiteSpace(t.GrupoCobro) ? "Otros" : t.GrupoCobro) }).ToList();
                                                }
                                                @foreach (var categoria in ordenInmutable.Where(c => Model.ServicioVisible(c)))
                                                {
                                                    var grupo = ingresosTodos.Where(g => g.Grupo == categoria).Select(g => g.Tx).ToList();

                                                    if (categoria == "Documental")
                                                    {
                                                        var dic = new Dictionary<string, int> { { "HONORARIOS", 1 }, { "LEGAL", 2 }, { "EMISIÓN", 2 }, { "ACLARACIÓN", 3 }, { "ROLEO", 4 }, { "CANCELACIÓN", 5 }, { "ORIGEN", 6 }, { "FITOSANITARIO", 7 }, { "SANITARIO", 7 }, { "CAPTURA", 8 }, { "ISPS", 9 }, { "SEGURIDAD", 9 }, { "GATE", 10 }, { "COURRIER NACIONAL", 11 }, { "COURRIER INTERNACIONAL", 12 }, { "CORRECCIÓN", 13 } };
                                                        grupo = grupo.OrderBy(t =>
                                                        {
                                                            var c = (t.Concepto ?? "").ToUpper();
                                                            if (c.Contains("REEMISIÓN") || c.Contains(" R1") || c.Contains(" R2") || c.Contains(" R3"))
                                                            {
                                                                if (c.Contains("ORIGEN")) return 14; if (c.Contains("FITO") || c.Contains("SANI")) return 15; if (c.Contains("CAPTU")) return 16;
                                                            }
                                                            foreach (var kv in dic) if (c.Contains(kv.Key)) return kv.Value;
                                                            return 99;
                                                        }).ToList();
                                                    }
                                                    if (categoria == "Marítimo")
                                                    {
                                                        grupo = grupo.OrderBy(t => OrdenMaritimo(t.Concepto)).ThenBy(t => PosicionContenedor(op, t.Concepto)).ThenBy(t => t.Id).ToList();
                                                    }
                                                    if (!grupo.Any()) continue;

                                                                                                        <tr class="row-group-header">
                                                        <td colspan="@(categoria == "Documental" ? 5 : 8)" class="ps-4" style="color: var(--atilson-slate-900);">
                                                            @{
                                                                string gLabel = categoria;
                                                                string iconCls = gLabel.ToUpper().Contains("MARÍTIMO") ? "bi-water text-primary" : (gLabel.ToUpper().Contains("TRANSPORTE") ? "bi-truck text-success" : (gLabel.ToUpper().Contains("DOCUMENTAL") ? "bi-file-earmark-check text-purple" : (gLabel.ToUpper().Contains("GATE") ? "bi-box-arrow-right text-danger" : (gLabel.ToUpper().Contains("ALMACENAMIENTO") ? "bi-boxes text-warning" : "bi-box text-secondary"))));
                                                            }
                                                            <i class="bi @iconCls me-2 fs-6"></i> @gLabel
                                                        </td>
                                                        @if (categoria == "Documental")
                                                        {
                                                            <td class="cf-doc-sub">N° Documento</td>
                                                            <td class="cf-doc-sub">N° Factura</td>
                                                            <td></td>
                                                        }
                                                    </tr>
                                                                                                        var agrupablesIng = grupo.Where(t => EsConceptoAgrupable(t.Concepto)).GroupBy(t => ObtenerConceptoBase(t.Concepto)).Where(g => g.Count() > 1).ToList();
                                                    var idsAgrupadosIng = agrupablesIng.SelectMany(g => g).Select(t => t.Id).ToHashSet();

                                                    foreach (var tx in grupo.Where(t => !idsAgrupadosIng.Contains(t.Id)))
                                                    {
                                                        string estadoLimpiado = (tx.EstadoFila == "PAGADO" || tx.EstadoFila == "FACTURADO" || tx.EstadoFila == "CONCILIADO") ? "PAGADO" : "PENDIENTE";
                                                        string claseEstado = estadoLimpiado == "PAGADO" ? "badge-pag" : "badge-pend";
                                                        string cUpper = (tx.Concepto ?? "").ToUpper();
                                                        string catUpper = categoria.ToUpper();
                                                                                                                bool isSeguridad = cUpper.Contains("SEGURIDAD") || cUpper.Contains("ISPS");
                                                                                bool isCourier = cUpper.Contains("COURIER");
                        // oct-2026: todo lo Marítimo va + IVA, sin excepciones.
                        bool esMaritimoIng = catUpper.Contains("MARÍTIMO") || catUpper.Contains("MARITIMO");
                        bool esExento = EsIngresoExento(tx, categoria);
                                                        bool esFleteMaritimoIng = esMaritimoIng && cUpper.StartsWith("FLETE MARÍTIMO");
                                                        decimal baseIng = esFleteMaritimoIng ? (tx.MontoNeto + tx.ProfitHandling) : tx.MontoNeto;
                                                        decimal montoTotal = esExento ? baseIng : Math.Round(baseIng * 1.19m, tx.Moneda == "CLP" ? 0 : 2);
                                                        bool isCertificado = catUpper.Contains("DOCUMENTAL") && (cUpper.Contains("FITO") || cUpper.Contains("SANI") || cUpper.Contains("CAPTU") || cUpper.Contains("ORIGEN"));
                                                        string docLabel = "FACT/NC";

                                                        <tr>
                                                            <td class="text-center align-middle">
                                                                @if (isCertificado && string.IsNullOrWhiteSpace(tx.NumeroDocumentoDocumental))
                                                                {
                                                                    <i class="bi bi-x-circle-fill text-danger" title="Incompleto - Bloqueado" style="font-size: 14px;"></i>
                                                                }
                                                                else if (string.IsNullOrWhiteSpace(tx.NumeroDocumento))
                                                                {
                                                                    {
                                                                        <input type="checkbox" name="idsExentos" value="@tx.Id" form="form-nc-@op.Id" class="form-check-input border-secondary shadow-sm" style="cursor: pointer;" />
                                                                    }
                                                                }
                                                            </td>
                                                            <td class="fw-bold text-dark ps-2">
                                                                @{ string conceptoVisIng = TieneSufijoContenedor(tx.Concepto) ? ObtenerConceptoBase(tx.Concepto) : (tx.Concepto ?? ""); }
                                                                <div class="cf-concepto-line">
                                                                    <span class="cf-concepto-texto">@(catUpper.Contains("TRANSPORTE") ? AbreviarRuta(conceptoVisIng) : conceptoVisIng)</span>@ChipExtraordinario(tx)
                                                                    <div class="cf-concepto-etiquetas">
                                                                        @if (TieneSufijoContenedor(tx.Concepto) || (EsLateArrivalExt(tx.Concepto) && (op.Unidadestecnicas?.Count ?? 0) > 0))
                                                                        {
                                                                            <span class="badge-contenedor-u" title="Contenedor de esta línea">@EtiquetaContenedor(op, tx.Concepto)</span>
                                                                        }
                                                                        @if ((op.Unidadestecnicas?.Count ?? 0) > 0)
                                                                        {
                                                                            int nBookingIng = 1 + op.Unidadestecnicas!.Count;
                                                                            bool cobroAgaIng = tx.Concepto == "Honorarios Agencia de Aduanas" || tx.Concepto == "Legalización / Emisión DUS";
                                                                            if ((cobroAgaIng && string.Equals(op.ModalidadCobroAgencia, "GRUPAL", StringComparison.OrdinalIgnoreCase))
                                                                                || (EsCertificadoDocumental(tx.Concepto) && CertPorBooking(op, tx.Concepto)))
                                                                            {
                                                                                <span class="cf-cobro-indicador" title="Un solo cobro al cliente por todo el booking">Por booking · 1 de @nBookingIng</span>
                                                                            }
                                                                            else if (EsCertificadoDocumental(tx.Concepto) || cobroAgaIng)
                                                                            {
                                                                                <span class="cf-cobro-indicador" title="Cobro individual al cliente por contenedor">Por contenedor</span>
                                                                            }
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </td>
                                                                                                                        <td class="text-end font-monospace">
                                                                @if (EsPendienteReal(tx, op.IdCliente))
                                                                {
                                                                    <span class="text-por-asignar">Por asignar</span>
                                                                }
                                                                else if (EsSinCostoAcuerdo(tx))
                                                                {
                                                                    <div class="d-inline-flex align-items-center gap-1 justify-content-end" data-bs-toggle="tooltip" data-bs-placement="left" title="@tx.JustificacionManual" style="cursor: help;">
                                                                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 13px;"></i>
                                                                        <span style="background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 12px;">@(tx.Moneda == "CLP" ? "$" : "USD") 0</span>
                                                                    </div>
                                                                }
                                                                else if (tx.TarifaManual)
                                                                {
                                                                    <div class="d-inline-flex align-items-center gap-1 justify-content-end" data-bs-toggle="tooltip" data-bs-placement="left" title="AJUSTE COMERCIAL: @tx.JustificacionManual" style="cursor: help;">
                                                                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 13px;"></i>
                                                                        <span style="background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 12px;">@FmtMonto(tx.Moneda, tx.MontoNeto)</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {

                                                                    <span class="text-dark" style="font-weight: 600;">@FmtMonto(tx.Moneda, tx.MontoNeto)</span>
                                                                    @EquivClp(tx.Moneda, tx.MontoNeto)
                                                                    @if (tx.EstadoFila == "NO FACTURABLE")
                                                                    {
                                                                        <span class="d-block" style="font-size:9.5px; color:#94a3b8; font-weight:600;" title="El responsable no es el cliente (lo asume Atilson o se descuenta al proveedor/agencia)">No se cobra al cliente</span>
                                                                    }
                                                                    @if (tx.Moneda == "CLP" && tx.MontoOriginalUsd.HasValue && tx.MontoOriginalUsd.Value > 0)
                                                                    {
                                                                                                                                            <span class="d-block" style="font-size:9.5px; color:#94a3b8; font-weight:600;" title="Valor original en USD">(USD @tx.MontoOriginalUsd.Value.ToString("N2"))</span>
                                                                    }
                                                                }
                                                            </td>
                                                            <td class="text-end font-monospace">
                                                                @if (esFleteMaritimoIng)
                                                                {
                                                                    <span style="font-weight: 600; color:#0ea5e9;">@FmtMonto(tx.Moneda, tx.ProfitHandling)</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted fw-bold">-</span>
                                                                }
                                                            </td>
                                                                                                                        <td class="text-end font-monospace">
                                                                @if (EsPendienteReal(tx, op.IdCliente))
                                                                {
                                                                    <span class="text-muted fw-bold">-</span>
                                                                }
                                                                else
                                                                {
                                                                    @* Exentos (ISPS, Courier, DUS, flete marítimo...): no llevan IVA, se indica "Exento". *@
                                                                    @if (esExento)
                                                                    {
                                                                        <span class="cf-exento" title="Concepto exento de IVA: se cobra el valor neto">Exento</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-dark" style="font-weight: 500;">@FmtMonto(tx.Moneda, montoTotal)</span>
                                                                        @EquivClp(tx.Moneda, montoTotal)
                                                                    }
                                                                }
                                                            </td>

                                                            <!-- COLUMNA N° DOC DUAL (MINIMALISTA) INGRESOS -->
                                                            @if (catUpper.Contains("DOCUMENTAL"))
                                                            {
                                                                // Documental (nov-2026): N° del documento (certificado, DUS) en su columna; la factura va en la siguiente.
                                                                bool certDocCol = cUpper.Contains("FITO") || cUpper.Contains("SANI") || cUpper.Contains("CAPTU") || cUpper.Contains("ORIGEN");
                                                                <td class="align-middle text-center px-2 cf-doc-num">
                                                                    @if (!string.IsNullOrWhiteSpace(tx.NumeroDocumentoDocumental)) { <span class="fw-bold text-dark text-truncate d-inline-block" style="font-size:10px; max-width:120px;" title="@tx.NumeroDocumentoDocumental">@tx.NumeroDocumentoDocumental</span> }
                                                                    else if (certDocCol) { <span class="text-danger fw-bold" style="font-size: 11px;">INCOMPLETO</span> }
                                                                    else { <span class="text-muted" style="font-size:10px;">—</span> }
                                                                </td>
                                                            }
                                                            <td class="align-middle px-3" colspan="@(catUpper.Contains("DOCUMENTAL") ? 1 : 2)">
                                                                <div class="d-flex align-items-center justify-content-between gap-2 w-100">
                                                                    <div class="flex-grow-1">
                                                                        @if (string.IsNullOrWhiteSpace(tx.NumeroDocumento))
                                                                        {
                                                                            {
                                                                                <form method="post" asp-page-handler="GuardarNumeroDoc" class="input-group input-group-sm shadow-sm m-0 p-0">
                                                                                    <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                    <input type="text" name="numeroDoc" class="form-control text-center" style="font-size: 9px; height: 24px; border-color: #cbd5e1;" placeholder="N° Fact/NC" required />
                                                                                    <button type="submit" class="btn btn-outline-success" style="padding: 0 8px; height: 24px;"><i class="bi bi-check2"></i></button>
                                                                                </form>
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-success fw-bold text-truncate" style="font-size: 10px;">@docLabel: @tx.NumeroDocumento</span>
                                                                        }
                                                                    </div>

                                                                    <div style="width: 28px; flex-shrink: 0;" class="text-end">
                                                                        @if (!string.IsNullOrEmpty(tx.RutaComprobante))
                                                                        {
                                                                            <a href="@tx.RutaComprobante" target="_blank" class="btn btn-success btn-xs shadow-sm btn-action-col" title="Ver respaldo">
                                                                                <i class="bi bi-eye"></i>
                                                                            </a>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td class="text-center align-middle pe-4">
                                                                <span class="badge-estado @claseEstado shadow-sm m-0">@estadoLimpiado</span>
                                                            </td>
                                                                                                                </tr>
                                                    }

                                                                                                        int giIng = 0;
                                                    foreach (var grpIng in agrupablesIng)
                                                    {
                                                        giIng++;
                                                        var txsGrpIng = grpIng.ToList();
                                                        var reprIng = txsGrpIng.First();
                                                        string conceptoBaseIng = grpIng.Key;
                                                        decimal sumaNetoIng = txsGrpIng.Sum(t => t.MontoNeto);
                                                        decimal sumaOriginalUsdIng = txsGrpIng.Where(t => t.MontoOriginalUsd.HasValue).Sum(t => t.MontoOriginalUsd ?? 0m);
                                                        string monedaIng = reprIng.Moneda;
                                                        txsGrpIng = txsGrpIng.OrderBy(t => PosicionContenedor(op, t.Concepto)).ThenBy(t => t.Id).ToList();
                                                        reprIng = txsGrpIng.First();
                                                        bool grpExentoIng = EsIngresoExento(reprIng, categoria);
                                                        int decGrpIng = monedaIng == "CLP" ? 0 : 2;
                                                        decimal sumaConIvaIng = grpExentoIng ? sumaNetoIng : txsGrpIng.Sum(t => Math.Round(t.MontoNeto * 1.19m, decGrpIng));
                                                        bool mismoValorIng = txsGrpIng.Select(t => t.MontoNeto).Distinct().Count() == 1;
                                                        int docsCargadosIng = txsGrpIng.Count(t => !string.IsNullOrWhiteSpace(t.NumeroDocumento));
                                                        int pagadosIng = txsGrpIng.Count(t => t.EstadoFila == "PAGADO" || t.EstadoFila == "FACTURADO" || t.EstadoFila == "CONCILIADO");
                                                        bool isCertificadoIng = categoria.ToUpper().Contains("DOCUMENTAL") && conceptoBaseIng.ToUpper().Contains("CERTIFICADO");
                                                        string idsCsvIng = string.Join(",", txsGrpIng.Select(t => t.Id));
                                                        string idGrpIng = $"{op.Id}-{2000 + giIng}";
                                                        string placeholderDocGrpIng = $"N° Fact/NC (x{txsGrpIng.Count})";

                                                        <tr class="row-grupo-u" data-cf-grp="ing|@op.Id|@conceptoBaseIng" aria-expanded="false">
                                                            <td class="text-center align-middle">
                                                                @if (!isCertificadoIng)
                                                                {
                                                                    <input type="checkbox" id="chk-grp-ing-@idGrpIng" class="form-check-input border-secondary shadow-sm" style="cursor: pointer;" title="Marcar los @txsGrpIng.Count como exentos para la Nota de Cobro" onchange="sincronizarExentosGrupo(this, '@idsCsvIng', '@op.Id')" />
                                                                    @foreach (var txh in txsGrpIng)
                                                                    {
                                                                        <input type="checkbox" name="idsExentos" value="@txh.Id" form="form-nc-@op.Id" class="d-none" id="chk-exento-hidden-@txh.Id" />
                                                                    }
                                                                }
                                                            </td>
                                                            <td class="fw-bold text-dark ps-2">
                                                                <div class="cf-concepto-line">
                                                                    <span class="cf-concepto-texto">@conceptoBaseIng</span>
                                                                    <div class="cf-concepto-etiquetas">
                                                                        <span class="badge-contador-u cf-grp-click" onclick="cfGrpToggle(this)" title="Ver cada contenedor">x @txsGrpIng.Count</span>
                                                                        <span class="cf-cobro-indicador" title="Una tarifa de cobro por cada contenedor">Por contenedor</span>
                                                                    </div>
                                                                </div>
                                                                @if (mismoValorIng)
                                                                {
                                                                    <span class="d-block text-muted" style="font-size:9.5px; font-weight:500;">Neto: @FmtMonto(monedaIng, reprIng.MontoNeto) x @txsGrpIng.Count = @FmtMonto(monedaIng, sumaNetoIng)</span>
                                                                    <span class="d-block text-muted" style="font-size:9.5px; font-weight:500;">@(grpExentoIng ? "Sin IVA (exento)" : $"+IVA: {FmtMonto(monedaIng, Math.Round(reprIng.MontoNeto * 1.19m, decGrpIng))} x {txsGrpIng.Count} = {FmtMonto(monedaIng, sumaConIvaIng)}")</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="d-block text-muted" style="font-size:9.5px; font-weight:500;">Por contenedor: @string.Join(" · ", txsGrpIng.Select(t => $"{EtiquetaContenedor(op, t.Concepto)} {FmtMonto(t.Moneda, t.MontoNeto)}"))</span>
                                                                    <span class="d-block text-muted" style="font-size:9.5px; font-weight:500;">@(grpExentoIng ? "Sin IVA (exento)" : "+ IVA 19% en cada contenedor")</span>
                                                                }
                                                                <button type="button" class="cf-grp-toggle" onclick="cfGrpToggle(this)" title="Ver o facturar cada contenedor por separado">
                                                                    <i class="bi bi-chevron-right icon-chevron-u"></i><span class="cf-grp-toggle-txt">Ver por contenedor</span>
                                                                    <span class="cf-grp-prog @(docsCargadosIng == txsGrpIng.Count ? "ok" : "")">Fact. @docsCargadosIng/@txsGrpIng.Count</span>
                                                                    <span class="cf-grp-prog @(pagadosIng == txsGrpIng.Count ? "ok" : "")">Pag. @pagadosIng/@txsGrpIng.Count</span>
                                                                </button>
                                                            </td>
                                                                                                                        <td class="text-end font-monospace">
                                                                <span class="text-dark" style="font-weight:600;">@FmtMonto(monedaIng, sumaNetoIng)</span>
                                                                @if (monedaIng == "CLP" && sumaOriginalUsdIng > 0)
                                                                {
                                                                    <span class="d-block" style="font-size:9.5px; color:#94a3b8; font-weight:600;" title="Valor original total en USD">(USD @sumaOriginalUsdIng.ToString("N2"))</span>
                                                                }
                                                            </td>
                                                            <td class="text-end font-monospace"><span class="text-muted fw-bold">-</span></td>
                                                            <td class="text-end font-monospace">
                                                                @if (grpExentoIng)
                                                                {
                                                                    <span class="cf-exento" title="Concepto exento de IVA: se cobra el valor neto">Exento</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-dark" style="font-weight:500;">@FmtMonto(monedaIng, sumaConIvaIng)</span>
                                                                    @EquivClp(monedaIng, sumaConIvaIng)
                                                                }
                                                            </td>
                                                            @if (categoria.ToUpper().Contains("DOCUMENTAL"))
                                                            {
                                                                var numsDocGrp = txsGrpIng.Select(t => t.NumeroDocumentoDocumental).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToList();
                                                                bool certGrp = txsGrpIng.Any(t => { var cu = (t.Concepto ?? "").ToUpper(); return cu.Contains("FITO") || cu.Contains("SANI") || cu.Contains("CAPTU") || cu.Contains("ORIGEN"); });
                                                                int faltanDocGrp = txsGrpIng.Count(t => string.IsNullOrWhiteSpace(t.NumeroDocumentoDocumental));
                                                                <td class="align-middle text-center px-2 cf-doc-num">
                                                                    @if (numsDocGrp.Any()) { <span class="fw-bold text-dark d-block" style="font-size:10px;">@string.Join(" · ", numsDocGrp)</span> }
                                                                    @if (certGrp && faltanDocGrp > 0) { <span class="text-danger fw-bold d-block" style="font-size: 10px;">INCOMPLETO (@faltanDocGrp)</span> }
                                                                    else if (!numsDocGrp.Any()) { <span class="text-muted" style="font-size:10px;">—</span> }
                                                                </td>
                                                            }
                                                            @{
                                                                // 13-nov: cada documento con sus contenedores (si no son todos); el N° del grupo se
                                                                // asigna solo a los contenedores que aún no tienen documento (antes los pisaba todos).
                                                                var factsIng = txsGrpIng.Where(t => !string.IsNullOrWhiteSpace(t.NumeroDocumento))
                                                                    .GroupBy(t => t.NumeroDocumento!.Trim().ToUpperInvariant()).Select(g => g.ToList())
                                                                    .OrderBy(g => g.Min(t => t.Id)).ToList();
                                                                var pendIng = txsGrpIng.Where(t => string.IsNullOrWhiteSpace(t.NumeroDocumento)).ToList();
                                                                string idsPendIng = string.Join(",", pendIng.Select(t => t.Id));
                                                            }
                                                            <td class="align-middle px-3" colspan="@(categoria.ToUpper().Contains("DOCUMENTAL") ? 1 : 2)">
                                                                <div class="cf-fact-celda">
                                                                    @foreach (var fI in factsIng)
                                                                    {
                                                                        <div class="cf-fact-linea">
                                                                            <div class="cf-fact-campo">
                                                                                <span class="text-success fw-bold text-truncate" style="font-size: 10px;">@fI[0].NumeroDocumento!.Trim()</span>
                                                                                @if (fI.Count < txsGrpIng.Count)
                                                                                {
                                                                                    <span class="cf-fact-conts" title="@string.Join(" · ", fI.Select(t => EtiquetaContenedor(op, t.Concepto)))">@string.Join(" ", fI.Select(t => "C" + PosicionContenedor(op, t.Concepto)))</span>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                    @if (pendIng.Any())
                                                                    {
                                                                        <div class="input-group input-group-sm shadow-sm m-0 p-0">
                                                                            <input type="text" id="doc-grp-ing-@idGrpIng" class="form-control text-center" style="font-size: 9px; height: 24px; border-color: #cbd5e1;"
                                                                                   placeholder="@(factsIng.Any() ? $"N° Fact/NC ({pendIng.Count} pend.)" : placeholderDocGrpIng)"
                                                                                   title="Se asigna a los contenedores sin documento. Para uno solo, usa «Ver por contenedor»." />
                                                                            <button type="button" class="btn btn-outline-success" style="padding: 0 8px; height: 24px;" onclick="guardarNumeroDocGrupo(this, '@idsPendIng', 'doc-grp-ing-@idGrpIng')"><i class="bi bi-check2"></i></button>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </td>
                                                            <td class="text-center align-middle pe-4">
                                                                <span class="badge-estado @(pagadosIng == txsGrpIng.Count ? "badge-pag" : (pagadosIng > 0 ? "badge-parcial" : "badge-pend")) shadow-sm m-0" title="@pagadosIng de @txsGrpIng.Count contenedores pagados">@(pagadosIng == txsGrpIng.Count ? "PAGADO" : (pagadosIng > 0 ? $"PARCIAL {pagadosIng}/{txsGrpIng.Count}" : "PENDIENTE"))</span>
                                                                @if (!string.IsNullOrEmpty(reprIng.RutaComprobante))
                                                                {
                                                                    <a href="@reprIng.RutaComprobante" target="_blank" class="btn btn-success btn-xs shadow-sm btn-action-col mt-1" title="Ver Documento (1er contenedor)"><i class="bi bi-eye"></i></a>
                                                                }
                                                            </td>
                                                        </tr>
                                                        foreach (var ts in txsGrpIng)
                                                        {
                                                            bool pagadoTsI = ts.EstadoFila == "PAGADO" || ts.EstadoFila == "FACTURADO" || ts.EstadoFila == "CONCILIADO";
                                                            bool exTsI = EsIngresoExento(ts, categoria);
                                                            string etqTsI = EtiquetaContenedor(op, ts.Concepto);
                                                            string cTsI = "C" + PosicionContenedor(op, ts.Concepto);
                                                            <tr class="cf-sub-cont d-none">
                                                                <td class="text-center align-middle"><span class="cf-sub-conector">@cTsI</span></td>
                                                                <td class="ps-2 align-middle"><span class="badge-contenedor-u ms-0" title="@etqTsI">@etqTsI</span></td>
                                                                <td class="text-end font-monospace align-middle"><span class="text-dark" style="font-weight:600;">@FmtMonto(ts.Moneda, ts.MontoNeto)</span></td>
                                                                <td class="text-end font-monospace align-middle"><span class="text-muted fw-bold">-</span></td>
                                                                <td class="text-end font-monospace align-middle">
                                                                    @if (exTsI) { <span class="cf-exento">Exento</span> }
                                                                    else { <span class="text-dark" style="font-weight:500;">@FmtMonto(ts.Moneda, Math.Round(ts.MontoNeto * 1.19m, ts.Moneda == "CLP" ? 0 : 2))</span> }
                                                                </td>
                                                                @if (categoria.ToUpper().Contains("DOCUMENTAL"))
                                                                {
                                                                    <td class="align-middle text-center px-2 cf-doc-num">
                                                                        @if (!string.IsNullOrWhiteSpace(ts.NumeroDocumentoDocumental)) { <span class="fw-bold text-dark" style="font-size:10px;">@ts.NumeroDocumentoDocumental</span> }
                                                                        else { <span class="text-muted" style="font-size:10px;">—</span> }
                                                                    </td>
                                                                }
                                                                <td class="align-middle px-3" colspan="@(categoria.ToUpper().Contains("DOCUMENTAL") ? 1 : 2)">
                                                                    <div class="d-flex align-items-center justify-content-between gap-2 w-100">
                                                                        <div class="flex-grow-1">
                                                                            @if (string.IsNullOrWhiteSpace(ts.NumeroDocumento))
                                                                            {
                                                                                <div class="input-group input-group-sm shadow-sm m-0 p-0">
                                                                                    <input type="text" class="form-control text-center" style="font-size: 9px; height: 24px; border-color: #cbd5e1;" placeholder="N° Fact/NC @cTsI" maxlength="50"
                                                                                           onkeydown="if (event.key === 'Enter') { event.preventDefault(); this.nextElementSibling.click(); }" />
                                                                                    <button type="button" class="btn btn-outline-success" style="padding: 0 8px; height: 24px;" title="Guardar el N° solo de este contenedor" onclick="cfSubGuardarDoc(this, @ts.Id)"><i class="bi bi-check2"></i></button>
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-success fw-bold text-truncate" style="font-size: 10px;">FACT/NC: @ts.NumeroDocumento</span>
                                                                            }
                                                                        </div>
                                                                        <div style="width: 28px; flex-shrink: 0;" class="text-end">
                                                                            @if (!string.IsNullOrEmpty(ts.RutaComprobante))
                                                                            {
                                                                                <a href="@ts.RutaComprobante" target="_blank" class="btn btn-success btn-xs shadow-sm btn-action-col" title="Ver respaldo de @cTsI"><i class="bi bi-eye"></i></a>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td class="text-center align-middle pe-4"><span class="badge-estado @(pagadoTsI ? "badge-pag" : "badge-pend") shadow-sm m-0">@(pagadoTsI ? "PAGADO" : "PENDIENTE")</span></td>
                                                            </tr>
                                                        }
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                                                                <div class="p-2 d-flex justify-content-between align-items-center border-top" style="background-color: #f8fafc;">
                                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                                <button type="button" class="btn btn-outline-dark btn-sm fw-bold px-3 cf-btn-extra" style="font-size: 10px;" disabled="@(op.LockFinanzas ? "disabled" : null)" title="@(op.LockFinanzas ? "Operación liquidada" : "Agregar un costo o cobro que no sale de las tarifas")"
                                                        onclick="abrirConceptoExtra(@op.Id, 'INGRESO', '@op.NumeroBooking')"><i class="bi bi-plus-lg me-1"></i> Agregar concepto</button>
                                                @if (op.TransaccionesFinancieras.Any(t => t.TipoMovimiento == "INGRESO" && (EsPendienteReal(t, op.IdCliente) || (string.IsNullOrWhiteSpace(t.NumeroDocumentoDocumental) && (t.Concepto.Contains("Origen") || t.Concepto.Contains("Fitosanitario") || t.Concepto.Contains("Sanitario") || t.Concepto.Contains("Captura"))))))
                                                {
                                                    <span class="text-danger fw-bold" style="font-size: 11px;"><i class="bi bi-exclamation-triangle-fill"></i> Existen montos "Por asignar" o Certificados INCOMPLETOS. Operaciones debe cerrar el caso.</span>
                                                }
                                            </div>
                                            <div class="d-flex gap-2">
                                                @if (op.TransaccionesFinancieras.Any(t => t.TipoMovimiento == "INGRESO" && (EsPendienteReal(t, op.IdCliente) || (string.IsNullOrWhiteSpace(t.NumeroDocumentoDocumental) && (t.Concepto.Contains("Origen") || t.Concepto.Contains("Fitosanitario") || t.Concepto.Contains("Sanitario") || t.Concepto.Contains("Captura"))))))
                                                {
                                                    <button class="btn btn-secondary btn-sm fw-bold px-3 shadow-sm" style="font-size: 10px;" disabled title="Existen montos o documentos pendientes"><i class="bi bi-file-earmark-pdf me-1"></i> GENERAR SET DE COBRO</button>
                                                    <button class="btn btn-secondary btn-sm fw-bold px-3 shadow-sm" style="font-size: 10px;" disabled title="Existen montos o documentos pendientes"><i class="bi bi-file-earmark-text text-danger me-1"></i> CONSOLIDAR NOTA DE COBRO ATILSON</button>
                                                }
                                                else
                                                {
                                                    <a href="/Finanzas/SetCobro/@op.Id" target="_blank" class="btn btn-danger btn-sm fw-bold px-3 shadow-sm" style="font-size: 10px;"><i class="bi bi-file-earmark-pdf me-1"></i> GENERAR SET DE COBRO</a>
                                                    <button type="submit" form="form-nc-@op.Id" class="btn btn-dark btn-sm fw-bold px-3 shadow-sm" style="font-size: 10px; background-color: var(--atilson-slate-900);"><i class="bi bi-file-earmark-text text-danger me-1"></i> CONSOLIDAR NOTA DE COBRO ATILSON</button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ================= PESTAÑA EGRESOS ================= -->
        <div class="tab-pane fade show active" id="egresos" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-main-grid mb-0">
                    <thead>
                        <tr>
                            <th style="width: 200px;">N° Booking</th>
                            <th>Cliente</th>
                            <th style="width: 130px;">Condición</th>
                            <th style="width: 200px;">Commodity</th>
                            <th style="width: 170px;">Estado</th>
                            <th class="text-end" style="width: 110px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var op in Model.Operaciones.Where(o => o.TransaccionesFinancieras.Any(t => t.TipoMovimiento == "EGRESO")))
                        {
                                                        bool tieneAjustePendienteEgr = op.TransaccionesFinancieras.Any(t => Model.ServicioVisible(GrupoResumen(t)) && EsPendienteReal(t, op.IdCliente));
                            bool completoEgr = MovimientoCompleto(op, "EGRESO");
                            var conceptosPendientesEgr = op.TransaccionesFinancieras.Where(t => Model.ServicioVisible(GrupoResumen(t)) && EsPendienteReal(t, op.IdCliente)).Select(t => t.Concepto).Distinct().ToList();
                            <tr data-bs-toggle="collapse" data-bs-target="#egr-CF-@op.Id" data-op-id="@op.Id" data-traspaso-pendiente="@(TraspasoPendiente(op) ? "1" : "0")" class="cursor-pointer main-row row-egreso @ClaseTraspaso(op) @(tieneAjustePendienteEgr ? "row-alerta-comercial" : "") @(completoEgr ? "cf-row-completa" : "") @(op.EsHistorica ? "cf-row-historico" : "")">
                                <td style="vertical-align: middle;">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-chevron-right text-muted me-2" style="font-size: 10px;"></i>
                                        <span style="font-weight: 800; color: @(tieneAjustePendienteEgr ? "#dc2626" : "#0f172a");">@op.NumeroBooking</span>@if (op.EsHistorica) { <span class="cf-hist-chip"><i class="bi bi-archive-fill"></i> Histórico</span> }
                                    </div>
                                </td>
                                <td style="vertical-align: middle;">
                                    <span style="font-weight:500; color:#475569; font-size: 12px;">@(op.IdClienteNavigation?.RazonSocial ?? "")</span>
                                </td>
                                <td style="vertical-align: middle;">@ChipCondicion(op)</td>
                                <td style="vertical-align: middle;">@ChipCommodity(op)</td>
                                <td style="vertical-align: middle;">
                                    <div class="cf-traspaso-cell">
                                        @ChipTraspaso(op)
                                        @if (tieneAjustePendienteEgr)
                                        {
                                            <span class="badge-pendiente-comercial d-inline-block" style="margin-left: 0;">Pendiente cierre Acuerdo</span>
                                        }
                                        else if (completoEgr)
                                        {
                                            <span class="cf-completo-chip"><i class="bi bi-check2-circle"></i> Completo</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end" style="vertical-align: middle;">
                                    <a href="/Finanzas/Edit/@op.Id" class="btn btn-outline-dark btn-xs" onclick="event.stopPropagation();"><i class="bi bi-pencil-square"></i> Editar</a>
                                </td>
                            </tr>
                            <tr id="egr-CF-@op.Id" class="collapse">
                                <td class="p-0 border-0" colspan="6">
                                    <div class="nested-container">
                                        @BannerTraspaso(op)
                                        @if (tieneAjustePendienteEgr)
                                        {
                                            <div class="alerta-comercial-banner">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <div>
                                                    <strong>Pendiente cierre Acuerdo.</strong> Comercial aún no define la tarifa para: @string.Join(", ", conceptosPendientesEgr)
                                                </div>
                                            </div>
                                        }
                                        <table class="table table-sm nested-table cf-egr-tabla mb-0">
                                            @* 12-nov: anchos fijos por columna (suman 100 %) para que la tabla no se salga del recuadro
                                               y el concepto no quede comprimido a una letra por línea. *@
                                            <colgroup>
                                                <col style="width:8%" /><col style="width:18%" /><col style="width:6%" /><col style="width:6.5%" />
                                                <col style="width:8%" /><col style="width:8%" /><col style="width:7.5%" /><col style="width:11%" />
                                                <col style="width:6%" /><col style="width:13%" /><col style="width:8%" />
                                            </colgroup>
                                            <thead>
                                                <tr>
                                                    <th class="ps-4">Proveedor</th>
                                                    <th>Concepto</th>
                                                    <th class="text-center" style="width: 8%;">Pagado por</th>
                                                    <th class="text-center" style="width: 8%;">Responsable</th>
                                                    <th class="text-end" style="width: 10%;">Valor Neto</th>
                                                    <th class="text-end" style="width: 10%;">Valor Original + IVA</th>
                                                    <th class="text-center" style="width: 8%;" title="Confirmar el valor en Control Financiero">Confirmación valor</th>
                                                    <th class="text-end" style="width: 14%;">Valor Actualizado IVA Incluido</th>
                                                    <th class="text-center px-3" colspan="2" style="width: 150px;">N° Factura / Documento</th>
                                                    <th class="text-center pe-4" style="width: 140px;">Estado de pago</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    string[] ordenInmutableEgr = { "Marítimo", "Transporte", "Documental", "Gate-Out/In", "Almacenamiento", "Otros" };
                                                    var egresosTodos = op.TransaccionesFinancieras.Where(t => t.TipoMovimiento == "EGRESO").Select(t => new { Tx = t, Grupo = (t.GrupoCobro == "Depósito" || t.GrupoCobro == "Deposito") ? "Gate-Out/In" : (string.IsNullOrWhiteSpace(t.GrupoCobro) ? "Otros" : t.GrupoCobro) }).ToList();
                                                }
                                                @foreach (var categoria in ordenInmutableEgr.Where(c => Model.ServicioVisible(c)))
                                                {
                                                    var grupo = egresosTodos.Where(g => g.Grupo == categoria).Select(g => g.Tx).ToList();

                                                    if (categoria == "Documental")
                                                    {
                                                        var dic = new Dictionary<string, int> { { "HONORARIOS", 1 }, { "LEGAL", 2 }, { "EMISIÓN", 2 }, { "ACLARACIÓN", 3 }, { "ROLEO", 4 }, { "CANCELACIÓN", 5 }, { "ORIGEN", 6 }, { "FITOSANITARIO", 7 }, { "SANITARIO", 7 }, { "CAPTURA", 8 }, { "ISPS", 9 }, { "SEGURIDAD", 9 }, { "GATE", 10 }, { "COURRIER NACIONAL", 11 }, { "COURRIER INTERNACIONAL", 12 }, { "CORRECCIÓN", 13 } };
                                                        grupo = grupo.OrderBy(t =>
                                                        {
                                                            var c = (t.Concepto ?? "").ToUpper();
                                                            if (c.Contains("REEMISIÓN") || c.Contains(" R1") || c.Contains(" R2") || c.Contains(" R3"))
                                                            {
                                                                if (c.Contains("ORIGEN")) return 14; if (c.Contains("FITO") || c.Contains("SANI")) return 15; if (c.Contains("CAPTU")) return 16;
                                                            }
                                                            foreach (var kv in dic) if (c.Contains(kv.Key)) return kv.Value;
                                                            return 99;
                                                        }).ToList();
                                                    }
                                                    if (categoria == "Marítimo")
                                                    {
                                                        grupo = grupo.OrderBy(t => OrdenMaritimo(t.Concepto)).ThenBy(t => PosicionContenedor(op, t.Concepto)).ThenBy(t => t.Id).ToList();
                                                    }
                                                    if (!grupo.Any()) continue;

                                                                                                        <tr class="row-group-header">
                                                        <td colspan="@(categoria == "Documental" ? 8 : 11)" class="ps-4" style="color: var(--atilson-slate-900);">
                                                            @{
                                                                string gLabel = categoria;
                                                                string iconCls = gLabel.ToUpper().Contains("MARÍTIMO") ? "bi-water text-primary" : (gLabel.ToUpper().Contains("TRANSPORTE") ? "bi-truck text-success" : (gLabel.ToUpper().Contains("DOCUMENTAL") ? "bi-file-earmark-check text-purple" : (gLabel.ToUpper().Contains("GATE") ? "bi-box-arrow-right text-danger" : (gLabel.ToUpper().Contains("ALMACENAMIENTO") ? "bi-boxes text-warning" : "bi-box text-secondary"))));
                                                            }
                                                            <i class="bi @iconCls me-2 fs-6"></i> @gLabel
                                                        </td>
                                                        @if (categoria == "Documental")
                                                        {
                                                            <td class="cf-doc-sub">N° Documento</td>
                                                            <td class="cf-doc-sub">N° Factura</td>
                                                            <td></td>
                                                        }
                                                    </tr>
                                                    var agrupablesEgr = grupo.Where(t => EsConceptoAgrupable(t.Concepto)).GroupBy(t => ObtenerConceptoBase(t.Concepto))
.Where(g => g.Count() > 1
&& g.Select(t => t.MontoNeto).Distinct().Count() == 1
&& g.Select(t => ProveedorEgreso(op, t, categoria.ToUpper().Contains("GATE"))).Distinct().Count() == 1
&& !g.Any(t => CalcularAgaGrp(t, categoria.ToUpper().Contains("GATE"), categoria).AgaIncongruente))
.ToList();
                                                    var idsAgrupadosEgr = agrupablesEgr.SelectMany(g => g).Select(t => t.Id).ToHashSet();

                                                    foreach (var tx in grupo.Where(t => !idsAgrupadosEgr.Contains(t.Id)))
                                                    {
                                                        string estadoLimpiado = (tx.EstadoFila == "PAGADO" || tx.EstadoFila == "CONCILIADO") ? "PAGADO" : "PENDIENTE";
                                                        string claseEstado = estadoLimpiado == "PAGADO" ? "badge-pag" : "badge-pend";
                                                        string responsable = (tx.ResponsablePago ?? tx.Responsable ?? "CLIENTE").ToUpper();
                                                        string cUpper = (tx.Concepto ?? "").ToUpper();
                                                        string catUpper = categoria.ToUpper();

                                                        // Gate (la naviera/depósito factura con IVA ya incluido) queda exento de
                                                        // recalcular +IVA en esta columna. Todo lo Marítimo va + IVA desde
                                                        // oct-2026, sin excepciones.
                                                        bool esExentoCategoria = catUpper.Contains("GATE");
                                                        bool esMaritimoEgr = catUpper.Contains("MARÍTIMO") || catUpper.Contains("MARITIMO");
                                                        // nov-2026: en lo Marítimo, el IVA de la tarifa de Comercial (IvaExento).
                                                        bool esExento = esMaritimoEgr
                                                            ? AtilsonCargoSpa.Pages.Finanzas.ControlFinancieroModel.EsMaritimoExento(tx.Concepto, tx.IvaExento)
                                                            : (tx.IvaExento ?? esExentoCategoria);
                                                        decimal montoTotal = esExento ? tx.MontoNeto : Math.Round(tx.MontoNeto * 1.19m, tx.Moneda == "CLP" ? 0 : 2);

                                                        bool isGateRow = catUpper.Contains("GATE");

                                                        // --- CONFIRMACIÓN DEL VALOR (todos los conceptos de Egresos) ---
                                                        // Valor esperado: Gate = neto + IVA; exentos = neto; resto (incluido Marítimo) = neto + IVA
                                                        decimal valorComparar = isGateRow ? Math.Round(tx.MontoNeto * 1.19m, 0) : montoTotal;
                                                        decimal tolAga = tx.Moneda == "CLP" ? 1m : 0.01m;
                                                        bool requiereVerif = tx.MontoNeto > 0m && !op.EsHistorica;
                                                        bool agaTieneValor = tx.ValorAga.HasValue;
                                                        bool agaActivado = tx.ConfirmadoAga && agaTieneValor;
                                                        bool agaCoincide = agaActivado && Math.Abs(tx.ValorAga!.Value - valorComparar) <= tolAga;
                                                        bool agaIncongruente = agaActivado && !agaCoincide;
                                                        bool pagoBloqueadoPorAga = requiereVerif && (!agaActivado || agaIncongruente);
                                                        string fmtMonto = tx.Moneda == "CLP" ? "N0" : "N2";

                                                        string nombreProveedor = ProveedorEgreso(op, tx, isGateRow);

                                                        <tr>
                                                            <td class="fw-bold ps-4" style="color: #475569;">
                                                                @nombreProveedor
                                                                @if (tx.MontoNeto == 0m && !tx.TarifaManual && ((tx.GrupoCobro ?? "").ToUpper().Contains("TRANSPORTE") || (tx.GrupoCobro ?? "").ToUpper().Contains("TERRESTRE")))
                                                                {
                                                                    <button type="button" class="cf-diag-btn d-block" onclick="diagnosticoTransporte(@op.Id, @(UnidadDeConcepto(tx.Concepto)?.ToString() ?? "null"), event)"><i class="bi bi-question-circle"></i> ¿Por qué no hay tarifa?</button>
                                                                }
                                                            </td>
                                                            <td class="fw-bold text-dark">
                                                                @{ string conceptoVisEgr = TieneSufijoContenedor(tx.Concepto) ? ObtenerConceptoBase(tx.Concepto) : (tx.Concepto ?? ""); }
                                                                <div class="cf-concepto-line">
                                                                    <span class="cf-concepto-texto">@(catUpper.Contains("TRANSPORTE") ? AbreviarRuta(conceptoVisEgr) : conceptoVisEgr)</span>@ChipExtraordinario(tx)
                                                                    <div class="cf-concepto-etiquetas">
                                                                        @if (TieneSufijoContenedor(tx.Concepto) || (EsLateArrivalExt(tx.Concepto) && (op.Unidadestecnicas?.Count ?? 0) > 0))
                                                                        {
                                                                            <span class="badge-contenedor-u" title="Contenedor de esta línea">@EtiquetaContenedor(op, tx.Concepto)</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                @if (isGateRow && op.IdNavieraNavigation?.AplicaTarifaGatePlana == true)
                                                                {
                                                                    string movGate = cUpper.Contains("GATE IN") ? "IN" : "OUT";
                                                                    string tcGate = (op.TipoContenedor ?? "").ToUpper();
                                                                    bool rfGate = tcGate.Contains("RF") || tcGate.Contains("REEFER") || op.IdTipoCarga == 2;
                                                                    string tipoGate = rfGate ? "RF" : "DRY";
                                                                    var compsGate = Model.ComponentesGate
                                                                        .Where(c => c.IdNaviera == op.IdNaviera && c.TipoMovimiento == movGate && c.TipoContenedor == tipoGate)
                                                                        .OrderBy(c => c.Componente).ToList();
                                                                    if (compsGate.Any())
                                                                    {
                                                                        var exclGate = (tx.ComponentesGateExcluidos ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                                                                        bool compBloqueado = estadoLimpiado == "PAGADO";
                                                                        <form method="post" asp-page-handler="GuardarComponentesGate" class="mt-1 p-2 border rounded bg-white" style="font-weight:500;">
                                                                            <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                            <input type="hidden" name="todos" value="@string.Join(",", compsGate.Select(c => c.Componente))" />
                                                                            @foreach (var c in compsGate)
                                                                            {
                                                                                <div class="form-check" style="font-size:10px;">
                                                                                    <input class="form-check-input" type="checkbox" name="componentes" value="@c.Componente" id="cg-@tx.Id-@c.Id" @(exclGate.Contains(c.Componente) ? "" : "checked") @(compBloqueado ? "disabled" : "") />
                                                                                    <label class="form-check-label text-uppercase" for="cg-@tx.Id-@c.Id">@c.Componente <span class="text-muted">(@c.Moneda @(c.ValorNeto?.ToString("N0")))</span></label>
                                                                                </div>
                                                                            }
                                                                            @if (!compBloqueado)
                                                                            {
                                                                                <button type="submit" class="btn btn-outline-dark btn-xs mt-1">Aplicar</button>
                                                                            }
                                                                        </form>
                                                                    }
                                                                }
                                                            </td>
                                                            <td class="text-center align-middle">
                                                                @{
                                                                    string pagadoPorTexto = (tx.ResponsablePago ?? "ATILSON").ToUpper();
                                                                    if (isGateRow && pagadoPorTexto == "AGENCIA")
                                                                    {
                                                                        var docGatePago = op.OperacionesDocumentales?.FirstOrDefault();
                                                                        pagadoPorTexto = (docGatePago?.IdAgenciaAduanaNavigation?.NombreAgencia ?? docGatePago?.AgenciaAduana ?? "AGENCIA").ToUpper();
                                                                    }
                                                                }
                                                                <span class="badge-resp-atilson">@pagadoPorTexto</span>
                                                            </td>
                                                            <td class="text-center align-middle">
                                                                @{
                                                                    string respUpper = (tx.Responsable ?? "").ToUpper();
                                                                    string claseResp = respUpper == "CLIENTE" ? "badge-resp-cliente" : (respUpper == "ATILSON" ? "badge-resp-atilson" : "badge bg-warning bg-opacity-10 text-warning border border-warning");
                                                                }
                                                                @if (string.IsNullOrEmpty(tx.Responsable))
                                                                {
                                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger" style="font-size:9px;" title="Bloquea el cierre a Finanzas">SIN DEFINIR</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="@claseResp" style="font-size:9px;">@respUpper</span>
                                                                    @if (respUpper == "PROVEEDOR" || respUpper == "AGENCIA")
                                                                    {
                                                                        <span class="d-block text-warning fw-bold mt-1" style="font-size:8px;">A DESCONTAR</span>
                                                                    }
                                                                }
                                                            </td>
                                                                                                                                                                                    <td class="text-end font-monospace align-middle">
                                                                @if (EsPendienteReal(tx, op.IdCliente))
                                                                {
                                                                    <span class="text-por-asignar">Por asignar</span>
                                                                }
                                                                else if (EsSinCostoAcuerdo(tx))
                                                                {
                                                                    <div class="d-inline-flex align-items-center gap-1 justify-content-end" data-bs-toggle="tooltip" data-bs-placement="left" title="@tx.JustificacionManual" style="cursor: help;">
                                                                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 13px;"></i>
                                                                        <span style="background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 12px;">@(tx.Moneda == "CLP" ? "$" : "USD") 0</span>
                                                                    </div>
                                                                }
                                                                else if (tx.TarifaManual)
                                                                {
                                                                    <div class="d-inline-flex align-items-center gap-1 justify-content-end" data-bs-toggle="tooltip" data-bs-placement="left" title="AJUSTE COMERCIAL: @tx.JustificacionManual" style="cursor: help;">
                                                                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 13px;"></i>
                                                                        <span style="background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 12px;">@FmtMonto(tx.Moneda, tx.MontoNeto)</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    string colorValorNeto = "text-dark";
                                                                    <span class="@colorValorNeto" style="font-weight: 600;">@FmtMonto(tx.Moneda, tx.MontoNeto)</span>
                                                                    @EquivClp(tx.Moneda, tx.MontoNeto)

                                                                    if (tx.Moneda == "CLP" && tx.MontoOriginalUsd.HasValue && tx.MontoOriginalUsd.Value > 0)
                                                                    {
                                                                        <span class="d-block" style="font-size:9.5px; color:#94a3b8; font-weight:600;" title="Valor original en USD">(USD @tx.MontoOriginalUsd.Value.ToString("N2"))</span>
                                                                    }
                                                                }
                                                            </td>
                                                            <!-- VALOR + IVA (valor teórico según base de datos Atilson) -->
                                                            <td class="text-end font-monospace align-middle">
                                                                @if (!requiereVerif)
                                                                {
                                                                    <span class="text-muted fw-bold">-</span>
                                                                }
                                                                else
                                                                {
                                                                    @* Exentos (flete marítimo, roleo, cancelación, rebate...): la factura trae el neto, sin IVA. *@
                                                                    if (esExento && !isGateRow)
                                                                    {
                                                                        <span class="cf-exento" title="Concepto exento de IVA: la factura debe traer el valor neto (@FmtMonto(tx.Moneda, valorComparar))">Exento</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-dark" style="font-weight: 700;">@FmtMonto(tx.Moneda, valorComparar)</span>
                                                                        @EquivClp(tx.Moneda, valorComparar)
                                                                    }
                                                                }
                                                            </td>

                                                            <!-- CONFIRMAR: verificar el monto del contrato/acuerdo en Control Financiero -->
                                                            <td class="text-center align-middle">
                                                                @if (requiereVerif)
                                                                {
                                                                    <form method="post" asp-page-handler="GuardarVerificacionAga" id="form-aga-@tx.Id" class="m-0 p-0 d-inline-block">
                                                                        <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                        <input type="hidden" name="accion" id="accion-aga-@tx.Id" value="confirmar" />
                                                                        <input type="checkbox" class="form-check-input" style="cursor:pointer; width:15px; height:15px;"
                                                                        @(agaCoincide ? "checked" : "") @(estadoLimpiado == "PAGADO" ? "disabled" : "")
                                                                               onchange="toggleConfirmarAga(this, '@tx.Id')"
                                                                               title="Confirmar que el valor corresponde al monto pactado, con IVA si aplica" />
                                                                    </form>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted" style="font-size:10px;">—</span>
                                                                }
                                                            </td>

                                                            <!-- VALOR ACTUALIZADO IVA INCLUIDO: monto informado cuando difiere -->
                                                            <td class="align-middle" style="min-width: 150px;">
                                                                @if (requiereVerif)
                                                                {
                                                                    <form method="post" asp-page-handler="GuardarVerificacionAga" class="m-0 p-0">
                                                                        <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                        <input type="hidden" name="accion" value="discrepancia" />
                                                                        <div class="input-group input-group-sm shadow-sm">
                                                                            <span class="input-group-text bg-light border-secondary p-1" style="font-size:9px;">@tx.Moneda</span>
                                                                            <input type="number" step="@(tx.Moneda == "CLP" ? "1" : "0.01")" id="valAga-@tx.Id" name="valorAga"
                                                                                   class="form-control text-end @(agaIncongruente ? "is-invalid text-danger fw-bold" : "")"
                                                                                   style="font-size:11px; height:26px;"
                                                                                   value="@(agaIncongruente ? tx.ValorAga!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                                                                   data-valor-original="@valorComparar.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                                                   data-tol="@tolAga.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                                                                                                               placeholder=""
                                                                                   oninput="validarValorAga(this, '@tx.Id')"
                                                                            @((agaCoincide || estadoLimpiado == "PAGADO") ? "disabled" : "") />
                                                                            <button type="submit" class="btn btn-outline-dark" style="padding:0 8px;" title="Guardar valor actualizado para confirmar"
                                                                                @((agaCoincide || estadoLimpiado == "PAGADO") ? "disabled" : "")>
                                                                                <i class="bi bi-check2" style="font-size:11px;"></i>
                                                                            </button>
                                                                        </div>
                                                                        <div id="alerta-aga-@tx.Id" class="fw-bold text-danger mt-1" style="font-size:9px; display:@(agaIncongruente ? "block" : "none");">
                                                                            <i class="bi bi-exclamation-triangle-fill"></i> Diferencia con el Valor + IVA.
                                                                        </div>
                                                                    </form>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted" style="font-size:10px;">N/A</span>
                                                                }
                                                            </td>

                                                            <!-- COLUMNA N° DOC DUAL (MINIMALISTA) -->
                                                            @if (catUpper.Contains("DOCUMENTAL"))
                                                            {
                                                                // Documental (nov-2026): N° del documento (certificado, DUS) en su columna; la factura va en la siguiente.
                                                                bool certDocCol = cUpper.Contains("FITO") || cUpper.Contains("SANI") || cUpper.Contains("CAPTU") || cUpper.Contains("ORIGEN");
                                                                <td class="align-middle text-center px-2 cf-doc-num">
                                                                    @* 12-nov: misma forma de dos líneas que la celda de factura, para que el N° del documento quede a la altura del N° Fact. *@
                                                                    <div class="cf-fact-celda">
                                                                        <div class="cf-fact-linea cf-doc-linea">
                                                                            @if (!string.IsNullOrWhiteSpace(tx.NumeroDocumentoDocumental)) { <span class="fw-bold text-dark text-truncate" style="font-size:10px;" title="@tx.NumeroDocumentoDocumental">@tx.NumeroDocumentoDocumental</span> }
                                                                            else if (certDocCol) { <span class="text-danger fw-bold" style="font-size: 10px;">INCOMPLETO</span> }
                                                                            else { <span class="text-muted" style="font-size:10px;">—</span> }
                                                                        </div>
                                                                        <div class="cf-fact-linea cf-doc-linea cf-doc-linea--vacia" aria-hidden="true"></div>
                                                                    </div>
                                                                </td>
                                                            }
                                                            <td class="align-middle px-3 cf-fact-td" colspan="@(catUpper.Contains("DOCUMENTAL") ? 1 : 2)">
                                                                <div class="cf-fact-celda">
                                                                    @{
                                                                        bool isTransporte = catUpper.Contains("TRANSPORTE") || catUpper.Contains("TERRESTRE");
                                                                        bool isFlete = isTransporte && !cUpper.Contains("INTERPLANTA");
                                                                        bool isMaritimo = catUpper.Contains("MARÍTIMO") || catUpper.Contains("MARITIMO");
                                                                        bool isGateOut = catUpper.Contains("GATE");
                                                                        bool isCertificado = catUpper.Contains("DOCUMENTAL") && (cUpper.Contains("FITO") || cUpper.Contains("SANI") || cUpper.Contains("CAPTU") || cUpper.Contains("ORIGEN"));
                                                                        // Documental: el N° del certificado va en su propia columna; aquí, la factura.
                                                                        string placeholderTexto = isMaritimo ? "N° BL" : "N° Fact";
                                                                        string docLabel = isMaritimo ? "BL" : "FACT";
                                                                    }

                                                                        @if (isFlete)
                                                                        {
                                                                        <div class="cf-fact-linea cf-fact-linea--oc"><div class="cf-fact-campo">
                                                                            @if (string.IsNullOrWhiteSpace(tx.NumeroOrdenCompra))
                                                                            {
                                                                                <span class="badge bg-light text-muted border border-secondary shadow-sm text-start" style="font-size: 8px;">OC PENDIENTE</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <a href="/Operaciones/OrdenCompraPdf/@op.Id?oc=@tx.NumeroOrdenCompra" target="_blank" class="badge bg-primary shadow-sm text-start text-decoration-none d-inline-flex align-items-center gap-1" style="font-size: 9px; cursor: pointer;" title="Ver Orden de Compra (PDF)">
                                                                                    <i class="bi bi-receipt"></i> OC-@tx.NumeroOrdenCompra.Replace("OC-", "") <i class="bi bi-eye-fill"></i>
                                                                                </a>
                                                                            }
                                                                        </div><div class="cf-fact-archivo"></div></div>
                                                                        }

                                                                    <div class="cf-fact-linea">
                                                                        <div class="cf-fact-campo">
                                                                        @if (string.IsNullOrWhiteSpace(tx.NumeroDocumento))
                                                                        {
                                                                            if (isGateOut)
                                                                            {
                                                                                <form method="post" asp-page-handler="GuardarNumeroDoc" class="input-group input-group-sm shadow-sm m-0 p-0">
                                                                                    <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                    <div class="input-group-text bg-white border-secondary p-1">
