                                                        string monedaIng = txsGrpIng.First().Moneda;
                                                        bool esExentoIng = categoria.ToUpper().Contains("MARÍTIMO") || categoria.ToUpper().Contains("GATE") || conceptoBaseIng.ToUpper().Contains("ISPS") || conceptoBaseIng.ToUpper().Contains("COURIER") == false && false;
                                                        decimal sumaConIvaIng = (categoria == "Gate-Out/In") ? sumaNetoIng : Math.Round(sumaNetoIng * 1.19m, 0);
                                                        int docsCargadosIng = txsGrpIng.Count(t => !string.IsNullOrWhiteSpace(t.NumeroDocumento));
