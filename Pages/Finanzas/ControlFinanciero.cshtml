@page
@model AtilsonCargoSpa.Pages.Finanzas.ControlFinancieroModel
@using AtilsonCargoSpa.Models
@{
    ViewData["Title"] = "Control Financiero";
}

@functions {
    // Diccionario de ciudades/localidades recurrentes. Si el texto (Retiro/Planta/
    // Destino) CONTIENE una de estas claves, se descarta todo lo demás (nombre de
    // empresa incluido) y se muestra solo la abreviatura — ej: "MEDLOG SAN ANTONIO"
    // se transforma en "SAI", no en "MEDLOG SAI". Si no hay match, se conserva el
    // texto tal cual (fallback seguro). Agregar aquí nuevas plantas/ciudades según
    // aparezcan.
    static readonly Dictionary<string, string> AbreviaturasUbicacion = new(StringComparer.OrdinalIgnoreCase)
    {
        { "VALPARAÍSO", "VAP" }, { "VALPARAISO", "VAP" },
        { "SAN ANTONIO", "SAI" },
        { "SAN VICENTE", "SVE" },
        { "CORONEL", "COR" },
        { "LIRQUÉN", "LQN" }, { "LIRQUEN", "LQN" },
        { "BUIN", "BUIN" }, { "PAINE", "PAINE" },
        { "MELIPILLA", "MELIPILLA" }, { "CALERA", "CALERA" },
        { "SAN FELIPE", "SAN FELIPE" }, { "ROMERAL", "ROMERAL" }
    };

    string AbreviarUbicacion(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return texto ?? "";
        string tUpper = texto.ToUpper();
        foreach (var kv in AbreviaturasUbicacion.OrderByDescending(k => k.Key.Length))
        {
            if (tUpper.Contains(kv.Key)) return kv.Value;
        }
        return texto.Trim();
    }

                string AbreviarRuta(string? concepto)
    {
        if (string.IsNullOrWhiteSpace(concepto)) return concepto ?? "";
        var match = System.Text.RegularExpressions.Regex.Match(concepto, @"^(.*)\(([^)]+)\)(.*)$");
        if (!match.Success) return concepto;
        string prefijo = match.Groups[1].Value;
        var tramos = match.Groups[2].Value.Split(" - ").Select(t => AbreviarUbicacion(t.Trim()));
        return $"{prefijo}({string.Join(" - ", tramos)}){match.Groups[3].Value}";
    }

    // Conceptos que FinanzasSyncService genera SIEMPRE por contenedor. Si un
    // booking tiene más de uno con el mismo concepto base, se colapsan en una
    // fila resumen "x N" con el detalle real desplegable — nunca se pierde la
    // fila individual (checkbox AGA, N° doc, comprobante siguen por contenedor).
    static readonly string[] PrefijosAgrupables = {
        "Honorarios Agencia de Aduanas",
        "Gate OUT Contenedor",
        "Gate IN Contenedor",
        "Seguridad de la Carga ISPS"
    };

    string ObtenerConceptoBase(string? concepto)
    {
        if (string.IsNullOrWhiteSpace(concepto)) return concepto ?? "";
        return System.Text.RegularExpressions.Regex.Replace(concepto, @"\s*\(U\d+\)", "").Trim();
    }

    bool EsConceptoAgrupable(string? concepto)
    {
        string baseC = ObtenerConceptoBase(concepto);
        return PrefijosAgrupables.Any(p => baseC.StartsWith(p, StringComparison.OrdinalIgnoreCase));
    }
}

