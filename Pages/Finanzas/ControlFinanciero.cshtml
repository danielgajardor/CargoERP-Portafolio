                                                                            <input type="file" id="fileGrp-@op.Id-@giEgr" class="d-none" accept=".pdf,.png,.jpg,.jpeg" onchange="if(this.files.length>0) subirComprobanteGrupo(this, '@idsCsvEgr')" />
