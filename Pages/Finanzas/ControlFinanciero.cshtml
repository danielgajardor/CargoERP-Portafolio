                                                            </td>
                                                            <td class="align-middle" style="min-width: 170px;">
                                                                @if (algunoRequiereVerif)
                                                                {
                                                                    <div class="input-group input-group-sm shadow-sm">
                                                                        <span class="input-group-text bg-light border-secondary p-1" style="font-size:9px;">@monedaEgr</span>
                                                                        <input type="number" step="@(monedaEgr == "CLP" ? "1" : "0.01")" id="valAgaGrp-@op.Id-@giEgr"
                                                                               class="form-control text-end @(algunoIncongruente ? "is-invalid text-danger fw-bold" : "")"
                                                                               style="font-size:11px; height:26px;"
                                                                               placeholder="Total factura..."
                                                                               data-ids="@idsCsvEgr" data-count="@txsGrpEgr.Count" data-moneda="@monedaEgr"
                                                                                                                                                              data-valor-original="@sumaValorCompararInv"
                                                                               data-tol="@tolGrupoInv"
                                                                               oninput="validarValorAgaGrupo(this)"
                                                                        @(pagadosEgr == txsGrpEgr.Count ? "disabled" : "") />
                                                                                                                                                <button type="button" class="btn btn-outline-dark" style="padding:0 8px;" title="@tituloGuardarTotalGrp"
                                                                                onclick="guardarDiscrepanciaGrupo(this)"
                                                                        @(pagadosEgr == txsGrpEgr.Count ? "disabled" : "")>
