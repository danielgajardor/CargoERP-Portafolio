                                                                                                        int giIng = 0;
                                                    foreach (var grpIng in agrupablesIng)
                                                    {
                                                        giIng++;
                                                        var txsGrpIng = grpIng.ToList();
                                                        var reprIng = txsGrpIng.First();
                                                        string conceptoBaseIng = grpIng.Key;
                                                        decimal sumaNetoIng = txsGrpIng.Sum(t => t.MontoNeto);
                                                        string monedaIng = reprIng.Moneda;
                                                        txsGrpIng = txsGrpIng.OrderBy(t => PosicionContenedor(op, t.Concepto)).ThenBy(t => t.Id).ToList();
                                                        reprIng = txsGrpIng.First();
                                                        bool grpExentoIng = EsIngresoExento(reprIng, categoria);
                                                        int decGrpIng = monedaIng == "CLP" ? 0 : 2;
                                                        decimal sumaConIvaIng = grpExentoIng ? sumaNetoIng : txsGrpIng.Sum(t => Math.Round(t.MontoNeto * 1.19m, decGrpIng));
                                                        bool mismoValorIng = txsGrpIng.Select(t => t.MontoNeto).Distinct().Count() == 1;
                                                        int docsCargadosIng = txsGrpIng.Count(t => !string.IsNullOrWhiteSpace(t.NumeroDocumento));
