                                                                        @if (algunoRequiereAceptar)
                                                                        {
                                                                            <div class="mt-1" style="max-width:170px; margin:0 auto;">
                                                                                                                                                                <textarea id="notaGrp-@op.Id-@giEgr" class="form-control form-control-sm mb-1" style="font-size:9px; height:38px; resize:none;" placeholder="@placeholderNotaGrpEgr"></textarea>
                                                                                <div class="d-flex align-items-center justify-content-center gap-1">
                                                                                    <input type="checkbox" class="form-check-input m-0" style="width:12px;height:12px;cursor:pointer;" onchange="aceptarDiferenciaGrupo(this, '@idsCsvEgr', 'notaGrp-@op.Id-@giEgr')" />
                                                                                    <label class="text-warning fw-bold mb-0" style="font-size:8px; text-transform:uppercase; letter-spacing:0.3px;">Consciente pago diferencia</label>
