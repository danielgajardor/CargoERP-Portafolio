    <script>
        // ---- Concepto extraordinario y documento de respaldo (nov-2026) ----
        function cfToken() { const t = document.querySelector('input[name="__RequestVerificationToken"]'); return t ? t.value : ''; }
        function cfEsc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
        function cfVolver(idOp) { location.href = '/Finanzas/ControlFinanciero?abrir=' + idOp; }
        function cfIdOpDeFila(el) {
            const det = el && el.closest('tr.collapse');
            const m = det && det.id ? det.id.match(/-CF-(\d+)$/) : null;
            return m ? m[1] : null;
        }

        function abrirConceptoExtra(idOp, tipo, booking) {
            document.getElementById('ceIdOperacion').value = idOp;
            document.getElementById('ceBooking').textContent = 'Booking ' + booking;
            document.getElementById(tipo === 'INGRESO' ? 'ceTipoIng' : 'ceTipoEgr').checked = true;
            ['ceConcepto', 'ceMonto', 'ceDocumentos', 'ceProvOrigen', 'ceNumOrigen', 'ceProveedorTexto', 'ceArchivoDoc', 'ceArchivoOrigen'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('ceProveedor').value = '';
            document.getElementById('ceProveedorTexto').classList.add('d-none');
            document.getElementById('ceError').classList.add('d-none');
            ceAjustarTipo();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalConceptoExtra')).show();
        }
        function ceAjustarTipo() {
            const egreso = document.getElementById('ceTipoEgr').checked;
            document.querySelectorAll('#modalConceptoExtra .ce-solo-egreso').forEach(el => el.classList.toggle('d-none', !egreso));
        }
        document.addEventListener('change', ev => {
            if (ev.target && ev.target.name === 'ceTipo') ceAjustarTipo();
            if (ev.target && ev.target.id === 'ceProveedor') document.getElementById('ceProveedorTexto').classList.toggle('d-none', ev.target.value !== 'otro');
        });

        async function guardarConceptoExtra(confirmar) {
            const err = document.getElementById('ceError');
            const btn = document.getElementById('ceGuardar');
            err.classList.add('d-none');
            const v = id => document.getElementById(id).value.trim();
            const egreso = document.getElementById('ceTipoEgr').checked;
            const fd = new FormData();
            fd.append('idOperacion', v('ceIdOperacion'));
            fd.append('tipo', egreso ? 'EGRESO' : 'INGRESO');
            fd.append('seccion', v('ceSeccion'));
            fd.append('concepto', v('ceConcepto'));
            const prov = v('ceProveedor');
            if (egreso && prov && prov !== 'otro') fd.append('idProveedor', prov);
            if (egreso && prov === 'otro') fd.append('proveedorTexto', v('ceProveedorTexto'));
            fd.append('monto', v('ceMonto'));
            fd.append('moneda', v('ceMoneda'));
            fd.append('iva', v('ceIva'));
            fd.append('documentos', v('ceDocumentos'));
            if (egreso) { fd.append('proveedorOrigen', v('ceProvOrigen')); fd.append('numeroOrigen', v('ceNumOrigen')); }
            const archivoDoc = document.getElementById('ceArchivoDoc').files[0];
            const archivoOrig = egreso ? document.getElementById('ceArchivoOrigen').files[0] : null;
            if (archivoDoc) fd.append('archivoDocumento', archivoDoc);
            if (archivoOrig) fd.append('archivoOrigen', archivoOrig);
            if (confirmar) fd.append('confirmar', 'true');
            btn.disabled = true;
            try {
                const r = await fetch('/Finanzas/ControlFinanciero?handler=AgregarConceptoExtra', { method: 'POST', headers: { 'RequestVerificationToken': cfToken() }, body: fd });
                const d = await r.json();
                if (d.success) { cfVolver(v('ceIdOperacion')); return; }
                if (d.duplicado) {
                    const res = await Swal.fire({
                        icon: 'warning', title: 'Factura de respaldo ya registrada', width: 640,
                        html: '<div style="text-align:left;font-size:12.5px;">Esa factura del proveedor de origen ya figura en:<ul style="margin-top:8px;">' + (d.detalle || []).map(x => '<li>' + cfEsc(x) + '</li>').join('') + '</ul>Puede ser un cobro duplicado del terminal o de la agencia.</div>',
                        showCancelButton: true, confirmButtonText: 'Agregar igual', cancelButtonText: 'Revisar', confirmButtonColor: '#0f172a'
                    });
                    if (res.isConfirmed) return guardarConceptoExtra(true);
                    return;
                }
                err.textContent = d.message || 'No se pudo agregar el concepto.';
                err.classList.remove('d-none');
            } catch (e) {
                err.textContent = 'Fallo de conexión. Inténtalo de nuevo.';
                err.classList.remove('d-none');
            } finally {
                btn.disabled = false;
            }
        }

        async function eliminarConceptoExtra(id, ev) {
            if (ev) { ev.preventDefault(); ev.stopPropagation(); }
            const idOp = cfIdOpDeFila(ev && ev.target);
            const res = await Swal.fire({ icon: 'question', title: '¿Quitar este concepto extraordinario?', text: 'Se elimina la línea del booking.', showCancelButton: true, confirmButtonText: 'Quitar', cancelButtonText: 'Cancelar', confirmButtonColor: '#dc2626' });
            if (!res.isConfirmed) return;
            const fd = new FormData(); fd.append('transaccionId', id);
            const r = await fetch('/Finanzas/ControlFinanciero?handler=EliminarConceptoExtra', { method: 'POST', headers: { 'RequestVerificationToken': cfToken() }, body: fd });
            const d = await r.json();
            if (d.success) { if (idOp) cfVolver(idOp); else location.reload(); }
            else Swal.fire('No se pudo quitar', d.message || '', 'warning');
        }

        // PDF de factura en una fila agrupada ×N: se asigna a los contenedores del grupo que no lo tienen.
        async function subirFacturaGrupo(input) {
            const archivo = input.files[0];
            if (!archivo) return;
            const ids = input.dataset.ids.split(',').filter(Boolean);
            const fd = new FormData();
            fd.append('ids', ids.join(','));
            fd.append('archivoFactura', archivo);
            try {
                const r = await fetch('/Finanzas/ControlFinanciero?handler=SubirFacturaGrupo', { method: 'POST', headers: { 'RequestVerificationToken': cfToken() }, body: fd });
                const d = await r.json();
                if (d.success) cfRecargarDesde(input);
                else { input.value = ''; Swal.fire('No se pudo subir', d.message || '', 'warning'); }
            } catch (e) { input.value = ''; Swal.fire('Error', 'Fallo de conexión.', 'error'); }
        }

        // 13-nov: cambiar o quitar una factura de una fila ×N (solo si no está pagada). Quitarla deja
        // sus contenedores pendientes de factura otra vez, sin tocar los demás.
        async function cfFactEditar(btn) {
            if (btn.dataset.pagada === '1') { Swal.fire('Factura pagada', 'Esta factura ya tiene contenedores pagados: no se puede cambiar.', 'info'); return; }
            const idOp = cfIdOpDeFila(btn);
            const r = await Swal.fire({
                title: 'Factura ' + cfEsc(btn.dataset.num), width: 460, input: 'text', inputValue: btn.dataset.num,
                inputAttributes: { maxlength: 50, style: 'text-transform:uppercase;' },
                html: '<div style="font-size:12.5px;color:#475569;">Corrige el N° o quita la factura de estos contenedores (vuelven a quedar pendientes, con su PDF desvinculado).</div>',
                showCancelButton: true, showDenyButton: true, confirmButtonText: 'Guardar', denyButtonText: 'Quitar factura', cancelButtonText: 'Cancelar',
                confirmButtonColor: '#0f172a', denyButtonColor: '#dc2626',
                preConfirm: v => { if (!v || !v.trim()) { Swal.showValidationMessage('Ingresa el N° de factura.'); return false; } return v.trim(); }
            });
            if (r.isDismissed) return;
            const fd = new FormData();
            fd.append('ids', btn.dataset.ids);
            if (r.isDenied) fd.append('quitar', 'true'); else fd.append('numeroDoc', r.value);
            try {
                const resp = await fetch('/Finanzas/ControlFinanciero?handler=EditarFacturaGrupo', { method: 'POST', headers: { 'RequestVerificationToken': cfToken() }, body: fd });
                const d = await resp.json();
                if (d.success) cfRecargarDesde(btn);
                else Swal.fire('No se pudo guardar', d.message || '', 'warning');
            } catch (e) { Swal.fire('Error', 'Fallo de conexión.', 'error'); }
        }

        // Documento de respaldo del proveedor de origen (factura del terminal detrás de la nota de cobro).
        async function editarRespaldoOrigen(btn) {
            const idOp = cfIdOpDeFila(btn);
            const r = await Swal.fire({
                title: 'Documento de respaldo', width: 520, confirmButtonText: 'Guardar', showCancelButton: true, cancelButtonText: 'Cancelar', confirmButtonColor: '#0f172a',
                html: '<div style="text-align:left;font-size:12.5px;color:#475569;">La agencia cobra con su nota de cobro (N° de la fila). Aquí va la factura original del terminal o proveedor de origen que la respalda. Deja el N° vacío para quitarla.</div>'
                    + '<label style="display:block;text-align:left;font-size:10px;font-weight:800;text-transform:uppercase;color:#6e6a80;margin:14px 0 5px;">Proveedor de origen</label>'
                    + '<input id="swRespProv" class="swal2-input" list="dlProvOrigen" style="margin:0;width:100%;text-transform:uppercase;" maxlength="150" placeholder="Ej: TPS, STI" value="' + cfEsc(btn.dataset.prov) + '">'
                    + '<label style="display:block;text-align:left;font-size:10px;font-weight:800;text-transform:uppercase;color:#6e6a80;margin:12px 0 5px;">N° factura de origen</label>'
                    + '<input id="swRespNum" class="swal2-input" style="margin:0;width:100%;text-transform:uppercase;" maxlength="100" placeholder="Ej: 1234567" value="' + cfEsc(btn.dataset.num) + '">'
                    + '<label style="display:block;text-align:left;font-size:10px;font-weight:800;text-transform:uppercase;color:#6e6a80;margin:12px 0 5px;">Archivo de la factura de origen <span style="text-transform:none;font-weight:500;color:#9a96ab;">PDF o imagen · opcional</span></label>'
                    + '<input id="swRespArchivo" type="file" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg">'
                    + (btn.dataset.ruta ? '<div class="cf-archivo-actual"><i class="bi bi-paperclip"></i> Archivo actual: <a href="' + cfEsc(btn.dataset.ruta) + '" target="_blank">ver</a> · si subes otro, lo reemplaza.</div>' : ''),
                preConfirm: () => {
                    const prov = document.getElementById('swRespProv').value.trim(), num = document.getElementById('swRespNum').value.trim();
                    const archivo = document.getElementById('swRespArchivo').files[0] || null;
                    if (archivo && !num) { Swal.showValidationMessage('Indica el N° de la factura de origen para adjuntar su archivo.'); return false; }
                    if (archivo && archivo.size > 15 * 1024 * 1024) { Swal.showValidationMessage('El archivo supera los 15 MB.'); return false; }
                    return { prov, num, archivo };
                }
            });
            if (!r.isConfirmed) return;
            const enviar = async (confirmar) => {
                const fd = new FormData();
                fd.append('ids', btn.dataset.ids);
                fd.append('proveedorOrigen', r.value.prov);
                fd.append('numeroOrigen', r.value.num);
                if (r.value.archivo) fd.append('archivoOrigen', r.value.archivo);
                if (confirmar) fd.append('confirmar', 'true');
                const x = await fetch('/Finanzas/ControlFinanciero?handler=GuardarRespaldoOrigen', { method: 'POST', headers: { 'RequestVerificationToken': cfToken() }, body: fd });
                return x.json();
            };
            try {
                let d = await enviar(false);
                if (!d.success && d.duplicado) {
                    const q = await Swal.fire({
                        icon: 'warning', title: 'Esa factura ya está registrada', width: 640,
                        html: '<div style="text-align:left;font-size:12.5px;">La factura ' + cfEsc(r.value.prov + ' ' + r.value.num) + ' ya figura como respaldo en:<ul style="margin-top:8px;">' + (d.detalle || []).map(x => '<li>' + cfEsc(x) + '</li>').join('') + '</ul>Revisa si el terminal o la agencia cobraron dos veces antes de guardarla.</div>',
                        showCancelButton: true, confirmButtonText: 'Guardar igual', cancelButtonText: 'Revisar', confirmButtonColor: '#0f172a'
                    });
                    if (!q.isConfirmed) return;
                    d = await enviar(true);
                }
                if (d.success) { if (idOp) cfVolver(idOp); else location.reload(); }
                else Swal.fire('No se pudo guardar', d.message || '', 'warning');
            } catch (e) { Swal.fire('Error', 'Fallo de conexión.', 'error'); }
        }

        // ---- Factura indirecta («N° Fact Ind», 12-nov) ----
        // Segunda línea de la celda de factura en Egresos. «+ Respaldo» (o el «IND: N°» guardado) la
        // convierte en un campo igual al del N° Fact, con su botón de subir el archivo a la derecha.
        // Guarda en el respaldo de origen de la fila (o de todas las del grupo ×N).
        async function cfIndEnviar(ids, prov, num, archivo, confirmar) {
            const fd = new FormData();
            fd.append('ids', ids);
            fd.append('proveedorOrigen', prov || '');
            fd.append('numeroOrigen', num || '');
            if (archivo) fd.append('archivoOrigen', archivo);
            if (confirmar) fd.append('confirmar', 'true');
            const r = await fetch('/Finanzas/ControlFinanciero?handler=GuardarRespaldoOrigen', { method: 'POST', headers: { 'RequestVerificationToken': cfToken() }, body: fd });
            return r.json();
        }

        async function cfIndGuardar(ids, prov, num, archivo, idOp, alFallar) {
            try {
                let d = await cfIndEnviar(ids, prov, num, archivo, false);
                if (!d.success && d.duplicado) {
                    const q = await Swal.fire({
                        icon: 'warning', title: 'Esa factura ya está registrada', width: 640,
                        html: '<div style="text-align:left;font-size:12.5px;">La factura indirecta ' + cfEsc(num) + ' ya figura en:<ul style="margin-top:8px;">' + (d.detalle || []).map(x => '<li>' + cfEsc(x) + '</li>').join('') + '</ul>Revisa si el terminal o la agencia cobraron dos veces antes de guardarla.</div>',
                        showCancelButton: true, confirmButtonText: 'Guardar igual', cancelButtonText: 'Revisar', confirmButtonColor: '#0f172a'
                    });
                    if (!q.isConfirmed) { if (alFallar) alFallar(); return; }
                    d = await cfIndEnviar(ids, prov, num, archivo, true);
                }
                if (d.success) { if (idOp) cfVolver(idOp); else location.reload(); return; }
                if (alFallar) alFallar();
                Swal.fire('No se pudo guardar', d.message || '', 'warning');
            } catch (e) {
                if (alFallar) alFallar();
                Swal.fire('Error', 'Fallo de conexión.', 'error');
            }
        }

        function cfIndAbrir(btn) {
            const linea = btn.closest('.cf-ind');
            if (!linea || linea.classList.contains('cf-ind--editando')) return;
            const campo = linea.querySelector('.cf-fact-campo'), archivo = linea.querySelector('.cf-fact-archivo');
            const ids = btn.dataset.ids, prov = btn.dataset.prov || '', previo = btn.dataset.num || '';
            const idOp = cfIdOpDeFila(btn);
            const htmlCampo = campo.innerHTML, htmlArchivo = archivo.innerHTML;
            const restaurar = () => { campo.innerHTML = htmlCampo; archivo.innerHTML = htmlArchivo; linea.classList.remove('cf-ind--editando'); };
            linea.classList.add('cf-ind--editando');

            campo.innerHTML = '<div class="input-group input-group-sm shadow-sm m-0 p-0 cf-ind-form">'
                + '<input type="text" class="form-control" maxlength="100" placeholder="N° Fact Ind" autocomplete="off" value="' + cfEsc(previo) + '" title="N° de la factura indirecta (la original del terminal o proveedor de origen)">'
                + '<button type="button" class="btn btn-outline-primary" title="Guardar"><i class="bi bi-check2"></i></button></div>';
            // Si ya tenía archivo se sigue viendo; el botón de subir lo agrega o lo reemplaza.
            const ver = archivo.querySelector('a.cf-ind-ver');
            archivo.innerHTML = (ver ? ver.outerHTML : '')
                + '<button type="button" class="btn btn-light border btn-xs shadow-sm text-secondary btn-action-col cf-ind-subir" title="Subir el archivo de la factura indirecta"><i class="bi bi-upload"></i></button>'
                + '<input type="file" class="d-none" accept=".pdf,.png,.jpg,.jpeg">';

            const input = campo.querySelector('input'), ok = campo.querySelector('button');
            const subir = archivo.querySelector('.cf-ind-subir'), file = archivo.querySelector('input[type=file]');
            let pendiente = null;

            const guardar = async () => {
                const num = input.value.trim();
                if (!num) {
                    if (!previo) { if (pendiente) { input.focus(); input.classList.add('is-invalid'); return; } restaurar(); return; }
                    const q = await Swal.fire({ icon: 'question', title: '¿Quitar la factura indirecta?', text: 'Se borra el N° ' + previo + ' de esta fila.', showCancelButton: true, confirmButtonText: 'Quitar', cancelButtonText: 'Cancelar', confirmButtonColor: '#dc2626' });
                    if (!q.isConfirmed) { input.value = previo; return; }
                }
                if (num && num.toUpperCase() === previo.toUpperCase() && !pendiente) { restaurar(); return; }
                input.disabled = ok.disabled = subir.disabled = true;
                await cfIndGuardar(ids, prov, num, pendiente, idOp, () => { input.disabled = ok.disabled = subir.disabled = false; });
            };

            ok.addEventListener('click', guardar);
            input.addEventListener('input', () => input.classList.remove('is-invalid'));
            input.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); guardar(); }
                else if (e.key === 'Escape') { e.preventDefault(); restaurar(); }
            });
            subir.addEventListener('click', () => file.click());
            file.addEventListener('change', () => {
                const f = file.files[0];
                if (!f) return;
                if (f.size > 15 * 1024 * 1024) { file.value = ''; Swal.fire('Archivo muy grande', 'El archivo supera los 15 MB.', 'warning'); return; }
                pendiente = f;
                subir.classList.remove('btn-light', 'text-secondary');
                subir.classList.add('btn-outline-primary');
                subir.title = 'Archivo listo: ' + f.name + ' (se sube al guardar)';
                subir.innerHTML = '<i class="bi bi-paperclip"></i>';
                if (input.value.trim()) guardar();
                else { input.classList.add('is-invalid'); input.focus(); }
            });
            input.focus();
            input.select();
        }

        // Archivo de una factura indirecta ya guardada (botón de subir junto a «IND: N°»).
        async function cfIndSubir(input) {
            const f = input.files[0];
            if (!f) return;
            if (f.size > 15 * 1024 * 1024) { input.value = ''; Swal.fire('Archivo muy grande', 'El archivo supera los 15 MB.', 'warning'); return; }
            const idOp = cfIdOpDeFila(input);
            try {
                // El N° ya se revisó al guardarlo; aquí solo se adjunta su archivo.
                const d = await cfIndEnviar(input.dataset.ids, input.dataset.prov, input.dataset.num, f, true);
                if (d.success) { if (idOp) cfVolver(idOp); else location.reload(); }
                else { input.value = ''; Swal.fire('No se pudo subir', d.message || '', 'warning'); }
            } catch (e) { input.value = ''; Swal.fire('Error', 'Fallo de conexión.', 'error'); }
        }
    </script>
}
