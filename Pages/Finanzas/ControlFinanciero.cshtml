        </div>
    </div>

    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 shadow-sm mb-4" style="font-size: 12px; font-weight: 700; border-radius: 8px;">
