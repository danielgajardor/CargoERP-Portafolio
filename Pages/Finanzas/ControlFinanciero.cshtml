                                                        <tr class="collapse" id="@idGrpEgr">
                                                            <td colspan="10" class="p-0 border-0">
                                                                <table class="table table-sm nested-table nested-subtable-u mb-0">
                                                                    <tbody>
                                                                        @foreach (var tx in txsGrpEgr)
                                                                        {
                                                                            string estadoLimpiado = (tx.EstadoFila == "PAGADO" || tx.EstadoFila == "CONCILIADO") ? "PAGADO" : "PENDIENTE";
                                                                            string claseEstado = estadoLimpiado == "PAGADO" ? "badge-pag" : "badge-pend";
                                                                            string responsable = (tx.ResponsablePago ?? tx.Responsable ?? "CLIENTE").ToUpper();
                                                                            string cUpper = (tx.Concepto ?? "").ToUpper();
                                                                            string catUpper = categoria.ToUpper();
                                                                            bool esExentoCategoria = catUpper.Contains("MARÍTIMO") || catUpper.Contains("MARITIMO") || catUpper.Contains("GATE");
                                                                            bool esExento = tx.IvaExento ?? esExentoCategoria;
                                                                            decimal montoTotal = esExento ? tx.MontoNeto : Math.Round(tx.MontoNeto * 1.19m, 0);
                                                                            bool isGateRow = catUpper.Contains("GATE");
                                                                            decimal valorComparar = isGateRow ? Math.Round(tx.MontoNeto * 1.19m, 0) : montoTotal;
                                                                            decimal tolAga = tx.Moneda == "CLP" ? 1m : 0.01m;
                                                                            bool requiereVerif = tx.MontoNeto > 0m;
                                                                            bool agaTieneValor = tx.ValorAga.HasValue;
                                                                            bool agaActivado = tx.ConfirmadoAga && agaTieneValor;
                                                                            bool agaCoincide = agaActivado && Math.Abs(tx.ValorAga!.Value - valorComparar) <= tolAga;
                                                                            bool agaIncongruente = agaActivado && !agaCoincide;
                                                                            string fmtMonto = tx.Moneda == "CLP" ? "N0" : "N2";

                                                                            string gKey = (tx.GrupoCobro ?? "").ToUpper();
                                                                            string nombreProveedor = tx.IdProveedorNavigation?.NombreProveedor;

                                                                            if (gKey.Contains("DOCUMENTAL") || gKey.Contains("ADUANA"))
                                                                            {
                                                                                var docSub = op.OperacionesDocumentales?.FirstOrDefault();
                                                                                nombreProveedor = docSub?.IdAgenciaAduanaNavigation?.NombreAgencia ?? docSub?.AgenciaAduana;
                                                                            }
                                                                            else if (isGateRow)
                                                                            {
                                                                                if (op.IdNavieraNavigation?.AplicaTarifaGatePlana == true)
                                                                                {
                                                                                    nombreProveedor = op.IdNavieraNavigation.NombreNaviera;
                                                                                }
                                                                                else
                                                                                {
                                                                                    var terrGateSub = op.OperacionesTerrestres?.FirstOrDefault(x => x.IdUnidadTecnica == null);
                                                                                    nombreProveedor = terrGateSub?.DepositoRetiro ?? "Depósito por Asignar";
                                                                                }
                                                                            }
                                                                            else if (string.IsNullOrWhiteSpace(nombreProveedor))
                                                                            {
                                                                                if (gKey.Contains("MARÍTIMO") || gKey.Contains("MARITIMO")) nombreProveedor = op.IdNavieraNavigation?.NombreNaviera;
                                                                                else if (gKey.Contains("TERRESTRE") || gKey.Contains("TRANSPORTE")) nombreProveedor = op.OperacionesTerrestres?.FirstOrDefault(x => x.IdUnidadTecnica == null)?.EmpresaTransporte;
                                                                                else if (gKey.Contains("ALMACENAMIENTO") || gKey.Contains("BODEGA") || gKey.Contains("PATIO")) nombreProveedor = op.OperacionesAlmacenamientos?.FirstOrDefault()?.IdProveedorNavigation?.NombreProveedor;
                                                                            }
                                                                            if (string.IsNullOrWhiteSpace(nombreProveedor)) { nombreProveedor = "Por Asignar"; }

                                                                            bool bloqueadoDuroPorFaltaAga = requiereVerif && !agaActivado;
                                                                            bool requiereAceptarDiferencia = agaIncongruente && (!tx.AceptaDiferenciaPago || string.IsNullOrWhiteSpace(tx.NotaDiferenciaAga));

                                                                            <tr>
                                                                                <td class="fw-bold ps-4" style="color: #475569;">@nombreProveedor</td>
                                                                                <td class="fw-bold text-dark">
                                                                                    @(catUpper.Contains("TRANSPORTE") ? AbreviarRuta(tx.Concepto) : tx.Concepto)
                                                                                    @if (isGateRow && op.IdNavieraNavigation?.AplicaTarifaGatePlana == true)
                                                                                    {
                                                                                        string movGate = cUpper.Contains("GATE IN") ? "IN" : "OUT";
                                                                                        string tcGate = (op.TipoContenedor ?? "").ToUpper();
                                                                                        bool rfGate = tcGate.Contains("RF") || tcGate.Contains("REEFER") || op.IdTipoCarga == 2;
                                                                                        string tipoGate = rfGate ? "RF" : "DRY";
                                                                                        var compsGate = Model.ComponentesGate
                                                                                            .Where(c => c.IdNaviera == op.IdNaviera && c.TipoMovimiento == movGate && c.TipoContenedor == tipoGate)
                                                                                            .OrderBy(c => c.Componente).ToList();
                                                                                        if (compsGate.Any())
                                                                                        {
                                                                                            var exclGate = (tx.ComponentesGateExcluidos ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                                                                                            bool compBloqueado = estadoLimpiado == "PAGADO";
                                                                                            <form method="post" asp-page-handler="GuardarComponentesGate" class="mt-1 p-2 border rounded bg-white" style="font-weight:500;">
                                                                                                <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                                <input type="hidden" name="todos" value="@string.Join(",", compsGate.Select(c => c.Componente))" />
                                                                                                @foreach (var c in compsGate)
                                                                                                {
                                                                                                    <div class="form-check" style="font-size:10px;">
                                                                                                        <input class="form-check-input" type="checkbox" name="componentes" value="@c.Componente" id="cg-@tx.Id-@c.Id" @(exclGate.Contains(c.Componente) ? "" : "checked") @(compBloqueado ? "disabled" : "") />
                                                                                                        <label class="form-check-label text-uppercase" for="cg-@tx.Id-@c.Id">@c.Componente <span class="text-muted">(@c.Moneda @(c.ValorNeto?.ToString("N0")))</span></label>
                                                                                                    </div>
                                                                                                }
                                                                                                @if (!compBloqueado)
                                                                                                {
                                                                                                    <button type="submit" class="btn btn-outline-dark btn-xs mt-1">Aplicar</button>
                                                                                                }
                                                                                            </form>
                                                                                        }
                                                                                    }
                                                                                </td>
                                                                                <td class="text-center align-middle">
                                                                                    @{
                                                                                        string pagadoPorTexto = (tx.ResponsablePago ?? "ATILSON").ToUpper();
                                                                                        if (isGateRow && pagadoPorTexto == "AGENCIA")
                                                                                        {
                                                                                            var docGatePago = op.OperacionesDocumentales?.FirstOrDefault();
                                                                                            pagadoPorTexto = (docGatePago?.IdAgenciaAduanaNavigation?.NombreAgencia ?? docGatePago?.AgenciaAduana ?? "AGENCIA").ToUpper();
                                                                                        }
                                                                                    }
                                                                                    <span class="badge-resp-atilson">@pagadoPorTexto</span>
                                                                                </td>
                                                                                <td class="text-center align-middle">
                                                                                    @{
                                                                                        string respUpper = (tx.Responsable ?? "").ToUpper();
                                                                                        string claseResp = respUpper == "CLIENTE" ? "badge-resp-cliente" : (respUpper == "ATILSON" ? "badge-resp-atilson" : "badge bg-warning bg-opacity-10 text-warning border border-warning");
                                                                                    }
                                                                                    @if (string.IsNullOrEmpty(tx.Responsable))
                                                                                    {
                                                                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger" style="font-size:9px;" title="Bloquea el cierre a Finanzas">SIN DEFINIR</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="@claseResp" style="font-size:9px;">@respUpper</span>
                                                                                        @if (respUpper == "PROVEEDOR" || respUpper == "AGENCIA")
                                                                                        {
                                                                                            <span class="d-block text-warning fw-bold mt-1" style="font-size:8px;">A DESCONTAR</span>
                                                                                        }
                                                                                    }
                                                                                </td>
                                                                                <td class="text-end font-monospace align-middle">
                                                                                    @if (tx.MontoNeto == 0m && !tx.TarifaManual)
                                                                                    {
                                                                                        <span class="text-por-asignar">Por asignar</span>
                                                                                    }
                                                                                    else if (tx.TarifaManual)
                                                                                    {
                                                                                        <div class="d-inline-flex align-items-center gap-1 justify-content-end" data-bs-toggle="tooltip" data-bs-placement="left" title="AJUSTE COMERCIAL: @tx.JustificacionManual" style="cursor: help;">
                                                                                            <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 13px;"></i>
                                                                                            <span style="background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 12px;">@(tx.Moneda == "CLP" ? "$" : "USD") @tx.MontoNeto.ToString("N0")</span>
                                                                                        </div>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-dark" style="font-weight: 600;">@(tx.Moneda == "CLP" ? "$" : "USD") @tx.MontoNeto.ToString("N0")</span>
                                                                                        @if (tx.MontoOriginalUsd.HasValue && tx.MontoOriginalUsd.Value > 0)
                                                                                        {
                                                                                            <span class="d-block" style="font-size:9.5px; color:#94a3b8; font-weight:600;">(USD @tx.MontoOriginalUsd.Value.ToString("N2"))</span>
                                                                                        }
                                                                                    }
                                                                                </td>
                                                                                <td class="text-end font-monospace align-middle">
                                                                                    @if (!requiereVerif)
                                                                                    {
                                                                                        <span class="text-muted fw-bold">-</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-dark" style="font-weight: 700;">@(tx.Moneda == "CLP" ? "$" : "USD") @valorComparar.ToString(fmtMonto)</span>
                                                                                    }
                                                                                </td>
                                                                                <td class="text-center align-middle">
                                                                                    @if (requiereVerif)
                                                                                    {
                                                                                        <form method="post" asp-page-handler="GuardarVerificacionAga" id="form-aga-@tx.Id" class="m-0 p-0 d-inline-block">
                                                                                            <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                            <input type="hidden" name="accion" id="accion-aga-@tx.Id" value="confirmar" />
                                                                                            <input type="checkbox" class="form-check-input" style="cursor:pointer; width:15px; height:15px;"
                                                                                            @(agaCoincide ? "checked" : "") @(estadoLimpiado == "PAGADO" ? "disabled" : "")
                                                                                                   onchange="toggleConfirmarAga(this, '@tx.Id')"
                                                                                                   title="Marcar si el valor de la factura AGA coincide con el Valor + IVA" />
                                                                                        </form>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-muted" style="font-size:10px;">—</span>
                                                                                    }
                                                                                </td>
                                                                                <td class="align-middle" style="min-width: 150px;">
                                                                                    @if (requiereVerif)
                                                                                    {
                                                                                        <form method="post" asp-page-handler="GuardarVerificacionAga" class="m-0 p-0">
                                                                                            <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                            <input type="hidden" name="accion" value="discrepancia" />
                                                                                            <div class="input-group input-group-sm shadow-sm">
                                                                                                <span class="input-group-text bg-light border-secondary p-1" style="font-size:9px;">@tx.Moneda</span>
                                                                                                <input type="number" step="@(tx.Moneda == "CLP" ? "1" : "0.01")" id="valAga-@tx.Id" name="valorAga"
                                                                                                       class="form-control text-end @(agaIncongruente ? "is-invalid text-danger fw-bold" : "")"
                                                                                                       style="font-size:11px; height:26px;"
                                                                                                       value="@(agaIncongruente ? tx.ValorAga!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                                                                                       data-valor-original="@valorComparar.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                                                                       data-tol="@tolAga.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                                                       placeholder=""
                                                                                                       oninput="validarValorAga(this, '@tx.Id')"
                                                                                                @((agaCoincide || estadoLimpiado == "PAGADO") ? "disabled" : "") />
                                                                                                <button type="submit" class="btn btn-outline-dark" style="padding:0 8px;" title="Guardar valor de la factura AGA"
                                                                                                    @((agaCoincide || estadoLimpiado == "PAGADO") ? "disabled" : "")>
                                                                                                    <i class="bi bi-check2" style="font-size:11px;"></i>
                                                                                                </button>
                                                                                            </div>
                                                                                            <div id="alerta-aga-@tx.Id" class="fw-bold text-danger mt-1" style="font-size:9px; display:@(agaIncongruente ? "block" : "none");">
                                                                                                <i class="bi bi-exclamation-triangle-fill"></i> Diferencia con el Valor + IVA.
                                                                                            </div>
                                                                                        </form>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-muted" style="font-size:10px;">N/A</span>
                                                                                    }
                                                                                </td>
                                                                                <td class="align-middle px-3">
                                                                                    <div class="d-flex align-items-center justify-content-between gap-2 w-100">
                                                                                        @{
                                                                                            bool isTransporte = catUpper.Contains("TRANSPORTE") || catUpper.Contains("TERRESTRE");
                                                                                            bool isFlete = isTransporte && !cUpper.Contains("INTERPLANTA");
                                                                                            bool isMaritimo = catUpper.Contains("MARÍTIMO") || catUpper.Contains("MARITIMO");
                                                                                            bool isGateOut = catUpper.Contains("GATE");
                                                                                            bool isCertificado = catUpper.Contains("DOCUMENTAL") && (cUpper.Contains("FITO") || cUpper.Contains("SANI") || cUpper.Contains("CAPTU") || cUpper.Contains("ORIGEN"));
                                                                                            string placeholderTexto = isMaritimo ? "N° BL" : (isCertificado ? "N° Cert" : "N° Fact");
                                                                                            string docLabel = isMaritimo ? "BL" : (isCertificado ? "CERT" : "FACT");
                                                                                        }
                                                                                        <div class="flex-grow-1 d-flex flex-column gap-1">
                                                                                            @if (isFlete)
                                                                                            {
                                                                                                @if (string.IsNullOrWhiteSpace(tx.NumeroOrdenCompra))
                                                                                                {
                                                                                                    <span class="badge bg-light text-muted border border-secondary shadow-sm text-start" style="font-size: 8px;">OC PENDIENTE</span>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <a href="/Operaciones/OrdenCompraPdf/@op.Id?oc=@tx.NumeroOrdenCompra" target="_blank" class="badge bg-primary shadow-sm text-start text-decoration-none d-inline-flex align-items-center gap-1" style="font-size: 9px; cursor: pointer;" title="Ver Orden de Compra (PDF)">
                                                                                                        <i class="bi bi-receipt"></i> OC-@tx.NumeroOrdenCompra.Replace("OC-", "") <i class="bi bi-eye-fill"></i>
                                                                                                    </a>
                                                                                                }
                                                                                            }
                                                                                            @if (string.IsNullOrWhiteSpace(tx.NumeroDocumento))
                                                                                            {
                                                                                                if (isCertificado)
                                                                                                {
                                                                                                    <span class="text-danger fw-bold" style="font-size: 11px;">INCOMPLETO</span>
                                                                                                }
                                                                                                else if (isGateOut)
                                                                                                {
                                                                                                    <form method="post" asp-page-handler="GuardarNumeroDoc" class="input-group input-group-sm shadow-sm m-0 p-0">
                                                                                                        <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                                        <div class="input-group-text bg-white border-secondary p-1">
                                                                                                            <input type="checkbox" class="form-check-input m-0" style="cursor:pointer; width:12px; height:12px;" onchange="document.getElementById('doc-gate-egr-@tx.Id').disabled = !this.checked; document.getElementById('btn-gate-egr-@tx.Id').disabled = !this.checked;" />
                                                                                                        </div>
                                                                                                        <input type="text" id="doc-gate-egr-@tx.Id" name="numeroDoc" class="form-control text-center border-secondary" style="font-size: 9px; padding: 2px; height:24px;" placeholder="N° Fact" required disabled />
                                                                                                        <button type="submit" id="btn-gate-egr-@tx.Id" class="btn btn-outline-primary" style="padding: 0 6px; height:24px;" disabled><i class="bi bi-check2"></i></button>
                                                                                                    </form>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <form method="post" asp-page-handler="GuardarNumeroDoc" class="input-group input-group-sm shadow-sm m-0 p-0">
                                                                                                        <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                                        <input type="text" name="numeroDoc" class="form-control text-center" style="font-size: 9px; height: 24px; border-color: #cbd5e1;" placeholder="@placeholderTexto" required />
                                                                                                        <button type="submit" class="btn btn-outline-primary" style="padding: 0 8px; height: 24px;"><i class="bi bi-check2"></i></button>
                                                                                                    </form>
                                                                                                }
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <span class="text-primary fw-bold text-truncate" style="font-size: 10px;">@docLabel: @tx.NumeroDocumento</span>
                                                                                            }
                                                                                        </div>
                                                                                        <div style="width: 28px; flex-shrink: 0;" class="text-end">
                                                                                            @if (string.IsNullOrEmpty(tx.RutaFactura))
                                                                                            {
                                                                                                <form method="post" asp-page-handler="SubirFactura" enctype="multipart/form-data" class="m-0 p-0">
                                                                                                    <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                                    <button type="button" class="btn btn-light border btn-xs shadow-sm text-secondary btn-action-col" title="Subir PDF de Factura" onclick="document.getElementById('file-fact-@tx.Id').click()">
                                                                                                        <i class="bi bi-upload"></i>
                                                                                                    </button>
                                                                                                    <input type="file" id="file-fact-@tx.Id" name="archivoFactura" class="d-none" accept=".pdf,.png,.jpg,.jpeg" onchange="if(this.files.length > 0) this.form.submit();" />
                                                                                                </form>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <a href="@tx.RutaFactura" target="_blank" class="btn btn-dark btn-xs shadow-sm btn-action-col" title="Ver PDF de Factura">
                                                                                                    <i class="bi bi-eye"></i>
                                                                                                </a>
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                                                                                </td>
                                                                                <td class="text-center align-middle pe-4">
                                                                                    <div class="d-flex align-items-center justify-content-between gap-2 w-100">
                                                                                        <div class="flex-grow-1 text-center">
                                                                                            <span class="badge-estado @claseEstado shadow-sm m-0">@estadoLimpiado</span>
                                                                                            @if (requiereAceptarDiferencia)
                                                                                            {
                                                                                                <form method="post" asp-page-handler="GuardarAceptaDiferencia" class="mt-1" style="max-width:170px; margin:0 auto;">
                                                                                                    <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                                    <textarea name="notaDiferenciaAga" id="nota-difaga-@tx.Id" class="form-control form-control-sm mb-1" style="font-size:9px; height:38px; resize:none;" placeholder="Motivo de la diferencia..."></textarea>
                                                                                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                                                                                        <input type="checkbox" name="aceptaDiferencia" value="true" class="form-check-input m-0" style="width:12px;height:12px;cursor:pointer;" onchange="confirmarDiferenciaAga(this, '@tx.Id')" />
                                                                                                        <label class="text-warning fw-bold mb-0" style="font-size:8px; text-transform:uppercase; letter-spacing:0.3px;">Consciente pago diferencia</label>
                                                                                                    </div>
                                                                                                </form>
                                                                                            }
                                                                                            else if (agaIncongruente && tx.AceptaDiferenciaPago && !string.IsNullOrWhiteSpace(tx.NotaDiferenciaAga))
                                                                                            {
                                                                                                <div class="text-warning fw-bold mt-1" style="font-size:8px; text-transform:uppercase; letter-spacing:0.3px; cursor:help;" data-bs-toggle="tooltip" data-bs-placement="left" title="@tx.NotaDiferenciaAga">
                                                                                                    <i class="bi bi-chat-left-text-fill"></i> Diferencia justificada
                                                                                                </div>
                                                                                            }
                                                                                        </div>
                                                                                        <div style="width: 28px; flex-shrink: 0;" class="text-end">
                                                                                            @if (bloqueadoDuroPorFaltaAga)
                                                                                            {
                                                                                                <button type="button" class="btn btn-outline-secondary btn-xs shadow-sm btn-action-col" style="opacity:0.5; cursor:not-allowed;" disabled title="Confirma el valor o registra la discrepancia de la factura AGA antes de pagar">
                                                                                                    <i class="bi bi-lock-fill"></i>
                                                                                                </button>
                                                                                            }
                                                                                            else if (requiereAceptarDiferencia)
                                                                                            {
                                                                                                <button type="button" class="btn btn-outline-warning btn-xs shadow-sm btn-action-col" style="opacity:0.6; cursor:not-allowed;" disabled title="Marca la casilla para habilitar la subida">
                                                                                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                                                                                </button>
                                                                                            }
                                                                                            else if (estadoLimpiado == "PENDIENTE")
                                                                                            {
                                                                                                <form method="post" asp-page-handler="SubirComprobante" enctype="multipart/form-data" class="m-0 p-0">
                                                                                                    <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                                    <button type="button" class="btn btn-outline-success btn-xs shadow-sm btn-action-col" title="Subir Respaldo de Pago" onclick="document.getElementById('file-egr-@tx.Id').click()">
                                                                                                        <i class="bi bi-currency-dollar"></i>
                                                                                                    </button>
                                                                                                    <input type="file" id="file-egr-@tx.Id" name="archivoRespaldo" class="d-none" accept=".pdf,.png,.jpg,.jpeg" onchange="if(this.files.length > 0) this.form.submit();" />
                                                                                                </form>
                                                                                            }
                                                                                            else if (!string.IsNullOrEmpty(tx.RutaComprobante))
                                                                                            {
                                                                                                <a href="@tx.RutaComprobante" target="_blank" class="btn btn-success btn-xs shadow-sm btn-action-col" title="Ver Respaldo">
                                                                                                    <i class="bi bi-eye"></i>
                                                                                                </a>
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                        <div class="p-2 d-flex justify-content-end align-items-center border-top" style="background-color: #f8fafc;">
                                            <a href="/Finanzas/SetPagoEgresos/@op.Id" target="_blank" class="btn btn-dark btn-sm fw-bold px-3 shadow-sm" style="font-size: 10px; background-color: #7c2d12;"><i class="bi bi-file-earmark-text me-1"></i> GENERAR LIQUIDACIÓN DE EGRESOS</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ================= PESTAÑA RESUMEN ================= -->
        <div class="tab-pane fade" id="resumen" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-main-grid mb-0">
                    <thead>
    <tr>
        <th style="width: 200px;">N° Booking</th>
        <th>Cliente</th>
        <th style="width: 220px;">Estado</th>
    </tr>
</thead>
                    <tbody>
                        @foreach (var op in Model.Operaciones)
                        {
                            string[] ordenInmutable = { "Marítimo", "Transporte", "Documental", "Gate-Out/In", "Almacenamiento", "Otros" };

                            var resumenConceptos = op.TransaccionesFinancieras
                                .Select(t => new { Tx = t, GrupoNormalizado = (t.GrupoCobro == "Depósito" || t.GrupoCobro == "Deposito") ? "Gate-Out/In" : (string.IsNullOrWhiteSpace(t.GrupoCobro) ? "Otros" : t.GrupoCobro) })
                                .GroupBy(t => new { t.GrupoNormalizado, t.Tx.Moneda })
                                .Select(g => new
                                {
                                    Concepto = g.Key.GrupoNormalizado,
                                    Moneda = g.Key.Moneda,
                                    Ingreso = g.Where(x => x.Tx.TipoMovimiento == "INGRESO").Sum(x => x.Tx.MontoNeto),
                                    Egreso = g.Where(x => x.Tx.TipoMovimiento == "EGRESO").Sum(x => x.Tx.MontoNeto),
                                    Rentabilidad = g.Where(x => x.Tx.TipoMovimiento == "INGRESO").Sum(x => x.Tx.MontoNeto) - g.Where(x => x.Tx.TipoMovimiento == "EGRESO").Sum(x => x.Tx.MontoNeto)
                                })
                                                                .OrderBy(r => Array.IndexOf(ordenInmutable, r.Concepto) >= 0 ? Array.IndexOf(ordenInmutable, r.Concepto) : 99)
                                .ToList();

                            bool tieneAjustePendienteRes = op.TransaccionesFinancieras.Any(t => t.MontoNeto == 0m && !t.TarifaManual);
                            var conceptosPendientesRes = op.TransaccionesFinancieras.Where(t => t.MontoNeto == 0m && !t.TarifaManual).Select(t => t.Concepto).Distinct().ToList();

                            <tr data-bs-toggle="collapse" data-bs-target="#res-CF-@op.Id" class="cursor-pointer main-row row-resumen @(tieneAjustePendienteRes ? "row-alerta-comercial" : "")">
    <td style="vertical-align: middle;">
        <div class="d-flex align-items-center">
            <i class="bi bi-chevron-right text-muted me-2" style="font-size: 10px;"></i>
            <span style="font-weight: 800; color: @(tieneAjustePendienteRes ? "#dc2626" : "#0f172a");">@op.NumeroBooking</span>
        </div>
    </td>
    <td style="vertical-align: middle;">
        <span style="font-weight:500; color:#475569; font-size: 12px;">@(op.IdClienteNavigation?.RazonSocial ?? "")</span>
    </td>
    <td style="vertical-align: middle;">
        @if (tieneAjustePendienteRes)
        {
            <span class="badge-pendiente-comercial d-inline-block" style="margin-left: 0;">Pendiente cierre Acuerdo</span>
        }
    </td>
</tr>
                            <tr id="res-CF-@op.Id" class="collapse">
    <td class="p-0 border-0" colspan="3">
                                    <div class="nested-container">
                                        @if (tieneAjustePendienteRes)
                                        {
                                            <div class="alerta-comercial-banner">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <div>
                                                    <strong>Pendiente cierre Acuerdo.</strong> Comercial aún no define la tarifa para: @string.Join(", ", conceptosPendientesRes)
                                                </div>
                                            </div>
                                        }
                                        <table class="table table-sm nested-table mb-0">
                                            <thead>
                                                <tr>
                                                    <th class="ps-4">Concepto Operativo</th>
                                                    <th class="text-end">Ingreso</th>
                                                    <th class="text-end">Egreso</th>
                                                    <th class="text-end pe-4">Rentabilidad</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var linea in resumenConceptos)
                                                {
                                                    string simbolo = linea.Moneda == "CLP" ? "$" : "USD";
                                                    string colorProfit = linea.Rentabilidad > 0 ? "text-success" : (linea.Rentabilidad < 0 ? "text-danger" : "text-dark");
                                                    <tr>
                                                        <td class="fw-bold text-dark ps-4">
                                                            @linea.Concepto
                                                            <span class="ms-1" style="font-size:9px; color: #94a3b8; font-weight: normal;">(@linea.Moneda)</span>
                                                        </td>
                                                        <td class="text-end font-monospace" style="color: #64748b;">@simbolo @linea.Ingreso.ToString("N0")</td>
                                                        <td class="text-end font-monospace" style="color: #64748b;">@simbolo @linea.Egreso.ToString("N0")</td>
                                                        <td class="text-end font-monospace fw-bold @colorProfit pe-4">@simbolo @linea.Rentabilidad.ToString("N0")</td>
                                                    </tr>
                                                }
                                                @if (!resumenConceptos.Any())
                                                {
                                                    <tr><td colspan="4" class="text-center text-muted py-3" style="font-style: italic; font-size: 11px;">Aún no hay transacciones para este Booking.</td></tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        // ==========================================
        // CONTROL GATE-OUT/IN: Valor AGA vs Valor Original
        // ==========================================
               // Checkbox "Confirmar": marca o desmarca la verificación y guarda de inmediato
        function toggleConfirmarAga(checkbox, txId) {
            document.getElementById('accion-aga-' + txId).value = checkbox.checked ? 'confirmar' : 'desconfirmar';
            checkbox.closest('form').requestSubmit();
        }

        // Aviso en vivo mientras se escribe el valor de la factura AGA
        function validarValorAga(input, txId) {
            const alerta = document.getElementById('alerta-aga-' + txId);
            if (!alerta) return;
            const original = parseFloat(input.getAttribute('data-valor-original'));
            const tol = parseFloat(input.getAttribute('data-tol')) || 0;
            const valor = parseFloat(input.value);

            if (input.value.trim() === '' || isNaN(valor)) {
                alerta.style.display = 'none';
                input.classList.remove('is-invalid', 'is-valid');
                return;
            }
            if (Math.abs(valor - original) > tol) {
                alerta.style.display = 'block';
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
            } else {
                alerta.style.display = 'none';
                input.classList.remove('is-invalid');
                input.classList.add('is-valid');
            }
        }

        function confirmarDiferenciaAga(checkbox, txId) {
            const nota = document.getElementById('nota-difaga-' + txId);
            if (checkbox.checked && (!nota || !nota.value.trim())) {
                alert('Debes explicar el motivo de la diferencia antes de confirmar.');
                checkbox.checked = false;
                if (nota) nota.focus();
                return;
            }
            checkbox.closest('form').requestSubmit();
        }

        
    </script>
}