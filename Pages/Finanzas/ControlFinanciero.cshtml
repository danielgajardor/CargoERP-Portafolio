    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function diagnosticoTransporte(idOp, idUnidad, ev) {
            if (ev) { ev.preventDefault(); ev.stopPropagation(); }
            var url = '/Finanzas/ControlFinanciero?handler=DiagnosticoTransporte&idOperacion=' + idOp + (idUnidad !== null ? '&idUnidad=' + idUnidad : '');
            fetch(url).then(function (r) { return r.json(); }).then(function (d) {
                var esc = function (s) { return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
                var html = '<div style="text-align:left;font-size:12.5px;line-height:1.55;">' + (d.lineas || []).map(function (l) { return '<div style="margin-bottom:4px;">' + esc(l) + '</div>'; }).join('') + '</div>';
                Swal.fire({
                    icon: d.ok ? 'info' : 'warning', title: d.ok ? 'Tarifa encontrada' : 'Sin tarifa de transporte', html: html, width: 640,
                    confirmButtonColor: '#0f172a', confirmButtonText: d.ok ? 'Aplicar tarifa' : 'Entendido', showCancelButton: d.ok, cancelButtonText: 'Cerrar'
                }).then(function (r) {
                    if (!d.ok || !r.isConfirmed) return;
                    var tk = document.querySelector('input[name="__RequestVerificationToken"]');
                    var fd = new FormData(); fd.append('idOperacion', idOp); if (tk) fd.append('__RequestVerificationToken', tk.value);
                    fetch('/Finanzas/ControlFinanciero?handler=RecalcularOperacion', { method: 'POST', body: fd, headers: tk ? { 'RequestVerificationToken': tk.value } : {} })
                        .then(function (x) { return x.json(); })
                        .then(function () { location.href = '/Finanzas/ControlFinanciero?abrir=' + idOp; })
                        .catch(function () { Swal.fire('Error', 'No se pudo recalcular.', 'error'); });
                });
            }).catch(function () { Swal.fire('Error', 'No se pudo revisar la tarifa.', 'error'); });
        }
    </script>
