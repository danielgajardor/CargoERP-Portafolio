        </div>

        <!-- ================= PESTAÑA RESUMEN (por concepto, oct-2026) ================= -->
        <div class="tab-pane fade" id="resumen" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-main-grid mb-0">
                    <thead>
                        <tr>
                            <th style="width: 200px;">N° Booking</th>
                            <th>Cliente</th>
                            <th class="text-end" style="width: 220px;">Diferencia (ingreso − egreso)</th>
                            <th style="width: 220px;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var op in Model.Operaciones)
                        {
                            var filasRes = FilasResumen(op);
                            var totalesRes = TotalesResumen(filasRes);
                            bool tieneAjustePendienteRes = op.TransaccionesFinancieras.Any(t => EsPendienteReal(t, op.IdCliente));
                            var conceptosPendientesRes = op.TransaccionesFinancieras.Where(t => EsPendienteReal(t, op.IdCliente)).Select(t => t.Concepto).Distinct().ToList();

                            <tr data-bs-toggle="collapse" data-bs-target="#res-CF-@op.Id" class="cursor-pointer main-row row-resumen @(tieneAjustePendienteRes ? "row-alerta-comercial" : "")">
                                <td style="vertical-align: middle;">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-chevron-right text-muted me-2" style="font-size: 10px;"></i>
                                        <span style="font-weight: 800; color: @(tieneAjustePendienteRes ? "#dc2626" : "#0f172a");">@op.NumeroBooking</span>
                                    </div>
                                </td>
                                <td style="vertical-align: middle;">
                                    <span style="font-weight:500; color:#475569; font-size: 12px;">@(op.IdClienteNavigation?.RazonSocial ?? "")</span>
                                </td>
                                <td class="text-end" style="vertical-align: middle;">
                                    @CeldaMontos(totalesRes.Select(t => (t.Moneda, t.Ing - t.Egr)), diferencia: true)
                                    @if (totalesRes.Any(t => EsMonedaExtranjera(t.Moneda)))
                                    {
                                        <span class="cf-equiv">≈ $ @totalesRes.Sum(t => AClp(t.Moneda, t.Ing - t.Egr)).ToString("N0") en CLP</span>
                                    }
                                </td>
                                <td style="vertical-align: middle;">
                                    @if (tieneAjustePendienteRes)
                                    {
                                        <span class="badge-pendiente-comercial d-inline-block" style="margin-left: 0;">Pendiente cierre Acuerdo</span>
                                    }
                                </td>
                            </tr>
                            <tr id="res-CF-@op.Id" class="collapse">
                                <td class="p-0 border-0" colspan="4">
                                    <div class="nested-container">
                                        @if (tieneAjustePendienteRes)
                                        {
                                            <div class="alerta-comercial-banner">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <div>
                                                    <strong>Pendiente cierre Acuerdo.</strong> Comercial aún no define la tarifa para: @string.Join(", ", conceptosPendientesRes)
                                                </div>
                                            </div>
                                        }
                                        <table class="table table-sm nested-table cf-res-tabla mb-0">
                                            <thead>
                                                <tr>
                                                    <th class="ps-4">Concepto</th>
                                                    <th class="text-end">Egreso (costo)</th>
                                                    <th class="text-end">Ingreso (venta)</th>
                                                    <th class="text-end">Diferencia</th>
                                                    <th class="text-end pe-4" style="width: 90px;">Margen</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var grupo in filasRes.GroupBy(f => f.Grupo))
                                                {
                                                    var totGrupo = TotalesResumen(grupo);
                                                    <tr class="cf-res-grupo">
                                                        <td class="ps-4">@grupo.Key <span class="cf-res-cuenta">@grupo.Count() @(grupo.Count() == 1 ? "concepto" : "conceptos")</span></td>
                                                        <td class="text-end">@CeldaMontos(totGrupo.Select(t => (t.Moneda, t.Egr)))</td>
                                                        <td class="text-end">@CeldaMontos(totGrupo.Select(t => (t.Moneda, t.Ing)))</td>
                                                        <td class="text-end">@CeldaMontos(totGrupo.Select(t => (t.Moneda, t.Ing - t.Egr)), diferencia: true)</td>
                                                        <td class="text-end pe-4">@(totGrupo.Count == 1 ? MargenResumen(totGrupo[0].Ing, totGrupo[0].Egr) : "")</td>
                                                    </tr>
                                                    @foreach (var f in grupo)
                                                    {
                                                        var monedas = f.Monedas.ToList();
                                                        <tr class="cf-res-fila">
                                                            <td class="ps-5">
                                                                <span class="cf-res-concepto">@f.Concepto</span>
                                                                @if (f.Unidades > 1)
                                                                {
                                                                    <span class="cf-res-chip" title="Un cargo por contenedor">x @f.Unidades</span>
                                                                }
                                                                @if (f.EsExtracosto)
                                                                {
                                                                    <span class="cf-res-chip cf-res-chip--ext">Extracosto</span>
                                                                }
                                                                @if (f.Pendiente)
                                                                {
                                                                    <span class="cf-res-chip cf-res-chip--pend">Por asignar</span>
                                                                }
                                                                @if (f.NoFacturable)
                                                                {
                                                                    <span class="cf-res-chip" title="El responsable no es el cliente: no se le cobra">No facturable</span>
                                                                }
                                                            </td>
                                                            <td class="text-end">@CeldaMontos(monedas.Select(m => (m, f.Egr(m))))</td>
                                                            <td class="text-end">@CeldaMontos(monedas.Select(m => (m, f.Ing(m))))</td>
                                                            <td class="text-end fw-bold">@CeldaMontos(monedas.Select(m => (m, f.Ing(m) - f.Egr(m))), diferencia: true)</td>
                                                            <td class="text-end pe-4 cf-res-margen">@(monedas.Count == 1 ? MargenResumen(f.Ing(monedas[0]), f.Egr(monedas[0])) : "")</td>
                                                        </tr>
                                                    }
                                                }
                                                @if (!filasRes.Any())
                                                {
                                                    <tr><td colspan="5" class="text-center text-muted py-3" style="font-style: italic; font-size: 11px;">Aún no hay transacciones para este Booking.</td></tr>
                                                }
                                            </tbody>
                                            @if (filasRes.Any())
                                            {
                                                <tfoot>
                                                    <tr class="cf-res-total">
                                                        <td class="ps-4">Total booking</td>
                                                        <td class="text-end">@CeldaMontos(totalesRes.Select(t => (t.Moneda, t.Egr)))</td>
                                                        <td class="text-end">@CeldaMontos(totalesRes.Select(t => (t.Moneda, t.Ing)))</td>
                                                        <td class="text-end">@CeldaMontos(totalesRes.Select(t => (t.Moneda, t.Ing - t.Egr)), diferencia: true)</td>
                                                        <td class="text-end pe-4">@(totalesRes.Count == 1 ? MargenResumen(totalesRes[0].Ing, totalesRes[0].Egr) : "")</td>
                                                    </tr>
                                                    @if (totalesRes.Any(t => EsMonedaExtranjera(t.Moneda)))
                                                    {
                                                        decimal egrClp = totalesRes.Sum(t => AClp(t.Moneda, t.Egr));
                                                        decimal ingClp = totalesRes.Sum(t => AClp(t.Moneda, t.Ing));
                                                        <tr class="cf-res-total cf-res-total--clp">
                                                            <td class="ps-4">Total en CLP <span class="cf-res-cuenta">equivalente</span></td>
                                                            <td class="text-end"><div class="cf-res-monto">$ @egrClp.ToString("N0")</div></td>
                                                            <td class="text-end"><div class="cf-res-monto">$ @ingClp.ToString("N0")</div></td>
                                                            <td class="text-end"><div class="cf-res-monto @(ingClp - egrClp > 0 ? "cf-res-pos" : ingClp - egrClp < 0 ? "cf-res-neg" : "cf-res-cero")">$ @((ingClp - egrClp).ToString("N0"))</div></td>
                                                            <td class="text-end pe-4">@MargenResumen(ingClp, egrClp)</td>
                                                        </tr>
                                                    }
                                                </tfoot>
                                            }
                                        </table>
                                        @if (totalesRes.Any(t => EsMonedaExtranjera(t.Moneda)))
                                        {
                                            <div class="cf-res-nota"><i class="bi bi-info-circle"></i> El total en CLP convierte los montos en moneda extranjera al @(totalesRes.Any(t => t.Moneda == "USD") ? $"dólar observado de hoy ($ {Model.DolarHoy:N2})" : "")@(totalesRes.Any(t => t.Moneda == "USD") && totalesRes.Any(t => t.Moneda == "UF") ? " y a la " : "")@(totalesRes.Any(t => t.Moneda == "UF") ? $"UF de hoy ($ {Model.UfHoy:N2})" : ""). Es una referencia: lo facturado en moneda extranjera se cobra al tipo de cambio de la factura.</div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        // ==========================================
        // CONTROL GATE-OUT/IN: Valor AGA vs Valor Original
        // ==========================================
               // Checkbox "Confirmar": marca o desmarca la verificación y guarda de inmediato
        function toggleConfirmarAga(checkbox, txId) {
            document.getElementById('accion-aga-' + txId).value = checkbox.checked ? 'confirmar' : 'desconfirmar';
            checkbox.closest('form').requestSubmit();
        }

        // Aviso en vivo mientras se escribe el valor de la factura AGA
        function validarValorAga(input, txId) {
            const alerta = document.getElementById('alerta-aga-' + txId);
            if (!alerta) return;
            const original = parseFloat(input.getAttribute('data-valor-original'));
            const tol = parseFloat(input.getAttribute('data-tol')) || 0;
            const valor = parseFloat(input.value);

            if (input.value.trim() === '' || isNaN(valor)) {
                alerta.style.display = 'none';
                input.classList.remove('is-invalid', 'is-valid');
                return;
            }
            if (Math.abs(valor - original) > tol) {
                alerta.style.display = 'block';
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
            } else {
                alerta.style.display = 'none';
                input.classList.remove('is-invalid');
                input.classList.add('is-valid');
            }
        }

                function confirmarDiferenciaAga(checkbox, txId) {
            const nota = document.getElementById('nota-difaga-' + txId);
            if (checkbox.checked && (!nota || !nota.value.trim())) {
                alert('Debes explicar el motivo de la diferencia antes de confirmar.');
                checkbox.checked = false;
                if (nota) nota.focus();
                return;
            }
            checkbox.closest('form').requestSubmit();
        }

        // ==========================================
        // FILAS AGRUPADAS "x N" — el valor que se confirma/discrepa es el
        // TOTAL de la factura (ej: AGA factura 3 Gate juntos en una línea);
        // ese total se reparte en partes iguales entre los N registros reales.
        // ==========================================
        const antiForgeryToken = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

        function validarValorAgaGrupo(input) {
            const alerta = input.closest('td').querySelector('.text-danger.mt-1');
            const original = parseFloat(input.getAttribute('data-valor-original'));
            const tol = parseFloat(input.getAttribute('data-tol')) || 0;
            const valor = parseFloat(input.value);
            if (input.value.trim() === '' || isNaN(valor)) {
                if (alerta) alerta.style.display = 'none';
                input.classList.remove('is-invalid');
                return;
            }
            const difiere = Math.abs(valor - original) > tol;
            if (alerta) alerta.style.display = difiere ? 'block' : 'none';
            input.classList.toggle('is-invalid', difiere);
        }

        async function confirmarAgaGrupo(checkbox, idsCsv) {
            checkbox.disabled = true;
            const ids = idsCsv.split(',');
            try {
                await Promise.all(ids.map(id => {
                    const fd = new FormData();
                    fd.append('transaccionId', id);
                    fd.append('accion', 'confirmar');
                    return fetch('?handler=GuardarVerificacionAga', { method: 'POST', headers: { 'RequestVerificationToken': antiForgeryToken() }, body: fd });
                }));
                window.location.reload();
            } catch (e) {
                alert('No se pudo confirmar para el grupo completo.');
                checkbox.disabled = false;
            }
        }

        async function guardarDiscrepanciaGrupo(btn) {
            const input = btn.closest('.input-group').querySelector('input[type="number"]');
            const total = parseFloat(input.value);
            if (isNaN(total) || total <= 0) { input.focus(); return; }
            const ids = input.getAttribute('data-ids').split(',');
            const count = parseInt(input.getAttribute('data-count'));
            const decimals = input.getAttribute('data-moneda') === 'CLP' ? 0 : 2;
            const porUnidad = Math.round((total / count) * Math.pow(10, decimals)) / Math.pow(10, decimals);
            btn.disabled = true;
            try {
                await Promise.all(ids.map(id => {
                    const fd = new FormData();
                    fd.append('transaccionId', id);
                    fd.append('accion', 'discrepancia');
                    fd.append('valorAga', porUnidad);
                    return fetch('?handler=GuardarVerificacionAga', { method: 'POST', headers: { 'RequestVerificationToken': antiForgeryToken() }, body: fd });
                }));
                window.location.reload();
            } catch (e) {
                alert('No se pudo guardar el total para el grupo completo.');
                btn.disabled = false;
            }
        }

        async function aceptarDiferenciaGrupo(checkbox, idsCsv, notaId) {
            const nota = document.getElementById(notaId);
            if (checkbox.checked && (!nota || !nota.value.trim())) {
                alert('Debes explicar el motivo de la diferencia antes de confirmar.');
                checkbox.checked = false;
                if (nota) nota.focus();
                return;
            }
            checkbox.disabled = true;
            const ids = idsCsv.split(',');
            try {
                await Promise.all(ids.map(id => {
                    const fd = new FormData();
                    fd.append('transaccionId', id);
                    fd.append('aceptaDiferencia', checkbox.checked);
                    fd.append('notaDiferenciaAga', nota.value.trim());
                    return fetch('?handler=GuardarAceptaDiferencia', { method: 'POST', headers: { 'RequestVerificationToken': antiForgeryToken() }, body: fd });
                }));
                window.location.reload();
            } catch (e) {
                alert('No se pudo guardar la justificación para el grupo completo.');
                checkbox.disabled = false;
            }
        }

        async function guardarNumeroDocGrupo(btn, idsCsv, inputId) {
            const input = document.getElementById(inputId);
            const valor = input ? input.value.trim() : '';
            if (!valor) { input?.focus(); return; }
            btn.disabled = true;
            const ids = idsCsv.split(',');
            try {
                await Promise.all(ids.map(id => {
                    const fd = new FormData();
                    fd.append('transaccionId', id);
                    fd.append('numeroDoc', valor);
                    return fetch('?handler=GuardarNumeroDoc', { method: 'POST', headers: { 'RequestVerificationToken': antiForgeryToken() }, body: fd });
                }));
                window.location.reload();
            } catch (e) {
                alert('No se pudo guardar el N° de documento para el grupo completo.');
                btn.disabled = false;
            }
        }

        async function subirComprobanteGrupo(fileInput, idsCsv) {
            const file = fileInput.files[0];
            if (!file) return;
            const ids = idsCsv.split(',');
            fileInput.disabled = true;
            try {
                await Promise.all(ids.map(id => {
                    const fd = new FormData();
                    fd.append('transaccionId', id);
                    fd.append('archivoRespaldo', file);
                    fd.append('archivoFactura', file);
                    return fetch('?handler=SubirComprobante', { method: 'POST', headers: { 'RequestVerificationToken': antiForgeryToken() }, body: fd });
                }));
                window.location.reload();
            } catch (e) {
                alert('No se pudo subir el respaldo para el grupo completo.');
                fileInput.disabled = false;
            }
        }

        function sincronizarExentosGrupo(masterCheckbox, idsCsv, opId) {
            idsCsv.split(',').forEach(id => {
                const hidden = document.getElementById('chk-exento-hidden-' + id);
                if (hidden) hidden.checked = masterCheckbox.checked;
            });
        }

        // ==========================================
        // SINCRONIZAR EXPANDIR/COLAPSAR ENTRE PESTAÑAS
        // Egresos/Ingresos/Resumen son la misma Operación vista de tres
        // formas distintas, pero cada pestaña filtra sus propias filas, así
        // que cada una tiene su propia fila colapsable (#ing-CF-id, #egr-CF-id,
        // #res-CF-id) en vez de compartir una sola. Un Booking no
        // necesariamente aparece en las tres (ej. una operación sin egresos
        // no tiene fila en Egresos), por eso cada sincronización chequea que
        // la fila destino exista antes de tocarla.
        // ==========================================
        (function () {
            var PESTANAS_CF = ['ing', 'egr', 'res'];
            function datosFilaCF(id) {
                var m = /^(ing|egr|res)-CF-(\d+)$/.exec(id || '');
                return m ? { prefijo: m[1], opId: m[2] } : null;
            }
            // Evita el bucle: abrir la fila de una pestaña abre las de las otras, y cada una
            // volvía a disparar este mismo evento ("Maximum call stack size exceeded").
            var sincronizandoCF = false;
            function sincronizarFilaCF(evento, mostrar) {
                if (sincronizandoCF) return;
                var info = datosFilaCF(evento.target.id);
                if (!info || !window.bootstrap) return;
                sincronizandoCF = true;
                try {
                    PESTANAS_CF.forEach(function (prefijo) {
                        if (prefijo === info.prefijo) return;
                        var destino = document.getElementById(prefijo + '-CF-' + info.opId);
                        if (!destino) return;
                        var instancia = bootstrap.Collapse.getOrCreateInstance(destino, { toggle: false });
                        if (mostrar) instancia.show(); else instancia.hide();
                    });
                } finally {
                    sincronizandoCF = false;
                }
            }
            document.addEventListener('show.bs.collapse', function (e) { sincronizarFilaCF(e, true); });
            document.addEventListener('hide.bs.collapse', function (e) { sincronizarFilaCF(e, false); });
        })();
    </script>
    <script>
        // Traspaso Ops -> Finanzas (oct-2026): al desplegar un booking NUEVO o REABIERTO
        // se marca como visto; ?abrir=ID (desde el Main Board) lo despliega al cargar.
        (function () {
            function token() { var el = document.querySelector('input[name="__RequestVerificationToken"]'); return el ? el.value : ''; }
            function marcarVisto(idOp) {
                var filas = document.querySelectorAll('tr.main-row[data-op-id="' + idOp + '"][data-traspaso-pendiente="1"]');
                if (!filas.length) return;
                filas.forEach(function (f) { f.setAttribute('data-traspaso-pendiente', '0'); });
                var fd = new FormData(); fd.append('id', idOp); fd.append('__RequestVerificationToken', token());
                fetch('/Finanzas/ControlFinanciero?handler=MarcarVistoTraspaso', { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token() } })
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d.success) return;
                        filas.forEach(function (f) {
                            f.classList.remove('row-traspaso-nuevo');
                            var chip = f.querySelector('[data-traspaso-chip]');
                            if (chip) { chip.className = 'tarea-chip tarea-chip--visto'; chip.innerHTML = '<i class="bi bi-eye"></i> Visto'; }
                        });
                        var badge = document.querySelector('[data-traspaso-contador]');
                        if (badge) {
                            var n = Math.max(0, (parseInt(badge.textContent, 10) || 0) - 1);
                            if (n === 0) badge.remove(); else badge.textContent = n;
                        }
                    }).catch(function () { filas.forEach(function (f) { f.setAttribute('data-traspaso-pendiente', '1'); }); });
            }
            document.addEventListener('show.bs.collapse', function (e) {
                var m = /^(?:ing|egr)-CF-(\d+)$/.exec(e.target.id || '');
                if (m) marcarVisto(m[1]);
            });
            document.addEventListener('DOMContentLoaded', function () {
                var abrir = @(Model.Abrir?.ToString() ?? "null");
                if (!abrir) return;
                var det = document.getElementById('egr-CF-' + abrir) || document.getElementById('ing-CF-' + abrir);
                if (!det) return;
                if (det.id.indexOf('ing-') === 0) {
                    var tab = document.getElementById('ingresos-tab');
                    if (tab) bootstrap.Tab.getOrCreateInstance(tab).show();
                }
                bootstrap.Collapse.getOrCreateInstance(det, { toggle: false }).show();
                var fila = document.querySelector('tr.main-row[data-bs-target="#' + det.id + '"]');
                if (fila) setTimeout(function () { fila.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 250);
            });
        })();
    </script>
