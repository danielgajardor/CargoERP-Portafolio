                                                                }
                                                            </td>
                                                            <td class="text-center align-middle"><span class="badge-resp-atilson">@((reprEgr.ResponsablePago ?? "ATILSON").ToUpper())</span></td>
                                                            <td class="text-center align-middle"><span class="badge-resp-cliente">@((reprEgr.Responsable ?? "CLIENTE").ToUpper())</span></td>
                                                            <td class="text-end font-monospace align-middle"><span class="text-dark" style="font-weight: 600;">@FmtMonto(monedaEgr, sumaNetoEgr)</span>@EquivClp(monedaEgr, sumaNetoEgr)</td>
                                                            <td class="text-end font-monospace align-middle">
                                                                @if (calcs.All(c => c.Exento))
                                                                {
                                                                    <span class="cf-exento" title="Concepto exento de IVA: la factura debe traer el valor neto (@FmtMonto(monedaEgr, sumaValorComparar))">Exento</span>
