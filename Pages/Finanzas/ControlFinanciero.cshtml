                                                        bool isCertificadoIng = categoria.ToUpper().Contains("DOCUMENTAL") && conceptoBaseIng.ToUpper().Contains("CERTIFICADO");
                                                        string idsCsvIng = string.Join(",", txsGrpIng.Select(t => t.Id));
                                                        string idGrpIng = $"{op.Id}-{2000 + giIng}";
                                                        string placeholderDocGrpIng = $"N° Fact/NC (x{txsGrpIng.Count})";

                                                        <tr class="row-grupo-u">
                                                            <td class="text-center align-middle">
                                                                @if (!isCertificadoIng)
                                                                {
                                                                    <input type="checkbox" id="chk-grp-ing-@idGrpIng" class="form-check-input border-secondary shadow-sm" style="cursor: pointer;" title="Marcar los @txsGrpIng.Count como exentos para la Nota de Cobro" onchange="sincronizarExentosGrupo(this, '@idsCsvIng', '@op.Id')" />
                                                                    @foreach (var txh in txsGrpIng)
                                                                    {
                                                                        <input type="checkbox" name="idsExentos" value="@txh.Id" form="form-nc-@op.Id" class="d-none" id="chk-exento-hidden-@txh.Id" />
                                                                    }
                                                                }
                                                            </td>
                                                            <td class="fw-bold text-dark ps-2">
                                                                @conceptoBaseIng <span class="badge-contador-u">x @txsGrpIng.Count</span>
                                                                @if (mismoValorIng)
                                                                {
                                                                    <span class="d-block text-muted" style="font-size:9.5px; font-weight:500;">Neto: @FmtMonto(monedaIng, reprIng.MontoNeto) x @txsGrpIng.Count = @FmtMonto(monedaIng, sumaNetoIng)</span>
                                                                    <span class="d-block text-muted" style="font-size:9.5px; font-weight:500;">@(grpExentoIng ? "Sin IVA (exento)" : $"+IVA: {FmtMonto(monedaIng, Math.Round(reprIng.MontoNeto * 1.19m, decGrpIng))} x {txsGrpIng.Count} = {FmtMonto(monedaIng, sumaConIvaIng)}")</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="d-block text-muted" style="font-size:9.5px; font-weight:500;">Por contenedor: @string.Join(" · ", txsGrpIng.Select(t => $"{EtiquetaContenedor(op, t.Concepto)} {FmtMonto(t.Moneda, t.MontoNeto)}"))</span>
                                                                    <span class="d-block text-muted" style="font-size:9.5px; font-weight:500;">@(grpExentoIng ? "Sin IVA (exento)" : "+ IVA 19% en cada contenedor")</span>
                                                                }
                                                            </td>
                                                                                                                        <td class="text-end font-monospace"><span class="text-dark" style="font-weight:600;">@FmtMonto(monedaIng, sumaNetoIng)</span></td>
                                                            <td class="text-end font-monospace"><span class="text-muted fw-bold">-</span></td>
                                                            <td class="text-end font-monospace">
                                                                @if (grpExentoIng)
                                                                {
                                                                    <span class="cf-exento" title="Concepto exento de IVA: se cobra el valor neto">Exento</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-dark" style="font-weight:500;">@FmtMonto(monedaIng, sumaConIvaIng)</span>
                                                                    @EquivClp(monedaIng, sumaConIvaIng)
                                                                }
                                                            </td>
                                                            <td class="align-middle px-3">
                                                                @if (docsCargadosIng == txsGrpIng.Count)
                                                                {
                                                                    <span class="text-success fw-bold text-truncate" style="font-size: 10px;">@reprIng.NumeroDocumento</span>
                                                                }
                                                                else
                                                                {
                                                                    <div class="input-group input-group-sm shadow-sm m-0 p-0">
                                                                        <input type="text" id="doc-grp-ing-@idGrpIng" class="form-control text-center" style="font-size: 9px; height: 24px; border-color: #cbd5e1;" placeholder="@placeholderDocGrpIng" />
                                                                        <button type="button" class="btn btn-outline-success" style="padding: 0 8px; height: 24px;" onclick="guardarNumeroDocGrupo(this, '@idsCsvIng', 'doc-grp-ing-@idGrpIng')"><i class="bi bi-check2"></i></button>
                                                                    </div>
                                                                }
                                                            </td>
                                                            <td class="text-center align-middle pe-4">
                                                                <span class="badge-estado @(pagadosIng == txsGrpIng.Count ? "badge-pag" : "badge-pend") shadow-sm m-0">@(pagadosIng == txsGrpIng.Count ? "PAGADO" : "PENDIENTE")</span>
                                                                @if (pagadosIng < txsGrpIng.Count)
                                                                {
                                                                    <button type="button" class="btn btn-light border btn-xs shadow-sm text-secondary btn-action-col mt-1" title="Subir factura para los @txsGrpIng.Count a la vez" onclick="document.getElementById('file-grp-ing-@idGrpIng').click()"><i class="bi bi-upload"></i></button>
                                                                    <input type="file" id="file-grp-ing-@idGrpIng" class="d-none" accept=".pdf,.png,.jpg,.jpeg" onchange="if(this.files.length>0) subirComprobanteGrupo(this, '@idsCsvIng')" />
                                                                }
                                                                else if (!string.IsNullOrEmpty(reprIng.RutaComprobante))
                                                                {
                                                                    <a href="@reprIng.RutaComprobante" target="_blank" class="btn btn-success btn-xs shadow-sm btn-action-col mt-1" title="Ver Documento (1er contenedor)"><i class="bi bi-eye"></i></a>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                                                                <div class="p-2 d-flex justify-content-between align-items-center border-top" style="background-color: #f8fafc;">
                                            <div>
                                                @if (op.TransaccionesFinancieras.Any(t => t.TipoMovimiento == "INGRESO" && (EsPendienteReal(t, op.IdCliente) || (string.IsNullOrWhiteSpace(t.NumeroDocumento) && (t.Concepto.Contains("Origen") || t.Concepto.Contains("Fitosanitario") || t.Concepto.Contains("Sanitario") || t.Concepto.Contains("Captura"))))))
                                                {
                                                    <span class="text-danger fw-bold" style="font-size: 11px;"><i class="bi bi-exclamation-triangle-fill"></i> Existen montos "Por asignar" o Certificados INCOMPLETOS. Operaciones debe cerrar el caso.</span>
                                                }
                                            </div>
                                            <div class="d-flex gap-2">
                                                @if (op.TransaccionesFinancieras.Any(t => t.TipoMovimiento == "INGRESO" && (EsPendienteReal(t, op.IdCliente) || (string.IsNullOrWhiteSpace(t.NumeroDocumento) && (t.Concepto.Contains("Origen") || t.Concepto.Contains("Fitosanitario") || t.Concepto.Contains("Sanitario") || t.Concepto.Contains("Captura"))))))
                                                {
                                                    <button class="btn btn-secondary btn-sm fw-bold px-3 shadow-sm" style="font-size: 10px;" disabled title="Existen montos o documentos pendientes"><i class="bi bi-file-earmark-pdf me-1"></i> GENERAR SET DE COBRO</button>
                                                    <button class="btn btn-secondary btn-sm fw-bold px-3 shadow-sm" style="font-size: 10px;" disabled title="Existen montos o documentos pendientes"><i class="bi bi-file-earmark-text text-danger me-1"></i> CONSOLIDAR NOTA DE COBRO ATILSON</button>
                                                }
                                                else
                                                {
                                                    <a href="/Finanzas/SetCobro/@op.Id" target="_blank" class="btn btn-danger btn-sm fw-bold px-3 shadow-sm" style="font-size: 10px;"><i class="bi bi-file-earmark-pdf me-1"></i> GENERAR SET DE COBRO</a>
                                                    <button type="submit" form="form-nc-@op.Id" class="btn btn-dark btn-sm fw-bold px-3 shadow-sm" style="font-size: 10px; background-color: var(--atilson-slate-900);"><i class="bi bi-file-earmark-text text-danger me-1"></i> CONSOLIDAR NOTA DE COBRO ATILSON</button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ================= PESTAÑA EGRESOS ================= -->
        <div class="tab-pane fade show active" id="egresos" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-main-grid mb-0">
                    <thead>
                        <tr>
                            <th style="width: 200px;">N° Booking</th>
                            <th>Cliente</th>
                            <th style="width: 130px;">Condición</th>
                            <th style="width: 200px;">Commodity</th>
                            <th style="width: 170px;">Estado</th>
                            <th class="text-end" style="width: 110px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var op in Model.Operaciones.Where(o => o.TransaccionesFinancieras.Any(t => t.TipoMovimiento == "EGRESO")))
                        {
                                                        bool tieneAjustePendienteEgr = op.TransaccionesFinancieras.Any(t => EsPendienteReal(t, op.IdCliente));
                            var conceptosPendientesEgr = op.TransaccionesFinancieras.Where(t => EsPendienteReal(t, op.IdCliente)).Select(t => t.Concepto).Distinct().ToList();
                            <tr data-bs-toggle="collapse" data-bs-target="#egr-CF-@op.Id" data-op-id="@op.Id" data-traspaso-pendiente="@(TraspasoPendiente(op) ? "1" : "0")" class="cursor-pointer main-row row-egreso @ClaseTraspaso(op) @(tieneAjustePendienteEgr ? "row-alerta-comercial" : "")">
                                <td style="vertical-align: middle;">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-chevron-right text-muted me-2" style="font-size: 10px;"></i>
                                        <span style="font-weight: 800; color: @(tieneAjustePendienteEgr ? "#dc2626" : "#0f172a");">@op.NumeroBooking</span>
                                    </div>
                                </td>
                                <td style="vertical-align: middle;">
                                    <span style="font-weight:500; color:#475569; font-size: 12px;">@(op.IdClienteNavigation?.RazonSocial ?? "")</span>
                                </td>
                                <td style="vertical-align: middle;">@ChipCondicion(op)</td>
                                <td style="vertical-align: middle;">@ChipCommodity(op)</td>
                                <td style="vertical-align: middle;">
                                    <div class="cf-traspaso-cell">
                                        @ChipTraspaso(op)
                                        @if (tieneAjustePendienteEgr)
                                        {
                                            <span class="badge-pendiente-comercial d-inline-block" style="margin-left: 0;">Pendiente cierre Acuerdo</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end" style="vertical-align: middle;">
                                    <a href="/Finanzas/Edit/@op.Id" class="btn btn-outline-dark btn-xs" onclick="event.stopPropagation();"><i class="bi bi-pencil-square"></i> Editar</a>
                                </td>
                            </tr>
                            <tr id="egr-CF-@op.Id" class="collapse">
                                <td class="p-0 border-0" colspan="6">
                                    <div class="nested-container">
                                        @BannerTraspaso(op)
                                        @if (tieneAjustePendienteEgr)
                                        {
                                            <div class="alerta-comercial-banner">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                                <div>
                                                    <strong>Pendiente cierre Acuerdo.</strong> Comercial aún no define la tarifa para: @string.Join(", ", conceptosPendientesEgr)
                                                </div>
                                            </div>
                                        }
                                        <table class="table table-sm nested-table mb-0">
                                                                                                                                    <thead>
                                                <tr>
                                                    <th class="ps-4">Proveedor</th>
                                                    <th>Concepto</th>
                                                    <th class="text-center" style="width: 8%;">Pagado por</th>
                                                    <th class="text-center" style="width: 8%;">Responsable</th>
                                                    <th class="text-end" style="width: 10%;">Valor Neto</th>
                                                    <th class="text-end" style="width: 10%;">Valor Original + IVA</th>
                                                    <th class="text-center" style="width: 8%;">Confirmación valor contrato</th>
                                                    <th class="text-end" style="width: 14%;">Valor Actualizado IVA Incluido</th>
                                                    <th class="text-center px-3" style="width: 150px;">N° Doc (Carga Factura)</th>
                                                    <th class="text-center pe-4" style="width: 140px;">Respaldo de Pago</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    string[] ordenInmutableEgr = { "Marítimo", "Transporte", "Documental", "Gate-Out/In", "Almacenamiento", "Otros" };
                                                    var egresosTodos = op.TransaccionesFinancieras.Where(t => t.TipoMovimiento == "EGRESO").Select(t => new { Tx = t, Grupo = (t.GrupoCobro == "Depósito" || t.GrupoCobro == "Deposito") ? "Gate-Out/In" : (string.IsNullOrWhiteSpace(t.GrupoCobro) ? "Otros" : t.GrupoCobro) }).ToList();
                                                }
                                                @foreach (var categoria in ordenInmutableEgr)
                                                {
                                                    var grupo = egresosTodos.Where(g => g.Grupo == categoria).Select(g => g.Tx).ToList();

                                                    if (categoria == "Documental")
                                                    {
                                                        var dic = new Dictionary<string, int> { { "HONORARIOS", 1 }, { "LEGAL", 2 }, { "EMISIÓN", 2 }, { "ACLARACIÓN", 3 }, { "ROLEO", 4 }, { "CANCELACIÓN", 5 }, { "ORIGEN", 6 }, { "FITOSANITARIO", 7 }, { "SANITARIO", 7 }, { "CAPTURA", 8 }, { "ISPS", 9 }, { "SEGURIDAD", 9 }, { "GATE", 10 }, { "COURRIER NACIONAL", 11 }, { "COURRIER INTERNACIONAL", 12 }, { "CORRECCIÓN", 13 } };
                                                        grupo = grupo.OrderBy(t =>
                                                        {
                                                            var c = (t.Concepto ?? "").ToUpper();
                                                            if (c.Contains("REEMISIÓN") || c.Contains(" R1") || c.Contains(" R2") || c.Contains(" R3"))
                                                            {
                                                                if (c.Contains("ORIGEN")) return 14; if (c.Contains("FITO") || c.Contains("SANI")) return 15; if (c.Contains("CAPTU")) return 16;
                                                            }
                                                            foreach (var kv in dic) if (c.Contains(kv.Key)) return kv.Value;
                                                            return 99;
                                                        }).ToList();
                                                    }
                                                    if (categoria == "Marítimo")
                                                    {
                                                        grupo = grupo.OrderBy(t => OrdenMaritimo(t.Concepto)).ThenBy(t => t.Id).ToList();
                                                    }
                                                    if (!grupo.Any()) continue;

                                                                                                        <tr class="row-group-header">
                                                        <td colspan="10" class="ps-4" style="color: var(--atilson-slate-900);">
                                                            @{
                                                                string gLabel = categoria;
                                                                string iconCls = gLabel.ToUpper().Contains("MARÍTIMO") ? "bi-water text-primary" : (gLabel.ToUpper().Contains("TRANSPORTE") ? "bi-truck text-success" : (gLabel.ToUpper().Contains("DOCUMENTAL") ? "bi-file-earmark-check text-purple" : (gLabel.ToUpper().Contains("GATE") ? "bi-box-arrow-right text-danger" : (gLabel.ToUpper().Contains("ALMACENAMIENTO") ? "bi-boxes text-warning" : "bi-box text-secondary"))));
                                                            }
                                                            <i class="bi @iconCls me-2 fs-6"></i> @gLabel
                                                        </td>
                                                    </tr>
                                                    var agrupablesEgr = grupo.Where(t => EsConceptoAgrupable(t.Concepto)).GroupBy(t => ObtenerConceptoBase(t.Concepto))
.Where(g => g.Count() > 1
&& g.Select(t => t.MontoNeto).Distinct().Count() == 1
&& g.Select(t => ProveedorEgreso(op, t, categoria.ToUpper().Contains("GATE"))).Distinct().Count() == 1
&& !g.Any(t => CalcularAgaGrp(t, categoria.ToUpper().Contains("GATE"), categoria).AgaIncongruente))
.ToList();
                                                    var idsAgrupadosEgr = agrupablesEgr.SelectMany(g => g).Select(t => t.Id).ToHashSet();

                                                    foreach (var tx in grupo.Where(t => !idsAgrupadosEgr.Contains(t.Id)))
                                                    {
                                                        string estadoLimpiado = (tx.EstadoFila == "PAGADO" || tx.EstadoFila == "CONCILIADO") ? "PAGADO" : "PENDIENTE";
                                                        string claseEstado = estadoLimpiado == "PAGADO" ? "badge-pag" : "badge-pend";
                                                        string responsable = (tx.ResponsablePago ?? tx.Responsable ?? "CLIENTE").ToUpper();
                                                        string cUpper = (tx.Concepto ?? "").ToUpper();
                                                        string catUpper = categoria.ToUpper();

                                                        // Gate (la naviera/depósito factura con IVA ya incluido) queda exento de
                                                        // recalcular +IVA en esta columna. Todo lo Marítimo va + IVA desde
                                                        // oct-2026, sin excepciones.
                                                        bool esExentoCategoria = catUpper.Contains("GATE");
                                                        bool esMaritimoEgr = catUpper.Contains("MARÍTIMO") || catUpper.Contains("MARITIMO");
                                                        bool esExento = (esMaritimoEgr && AtilsonCargoSpa.Pages.Finanzas.ControlFinancieroModel.EsMaritimoUsdSinIva(tx.Concepto))
    || ((!esMaritimoEgr || EsRebateMaritimo(tx)) && (tx.IvaExento ?? esExentoCategoria));
                                                        decimal montoTotal = esExento ? tx.MontoNeto : Math.Round(tx.MontoNeto * 1.19m, tx.Moneda == "CLP" ? 0 : 2);

                                                        bool isGateRow = catUpper.Contains("GATE");

                                                        // --- VERIFICACIÓN CONTRA FACTURA AGA (todos los conceptos de Egresos) ---
                                                        // Valor esperado: Gate = neto + IVA; exentos = neto; resto (incluido Marítimo) = neto + IVA
                                                        decimal valorComparar = isGateRow ? Math.Round(tx.MontoNeto * 1.19m, 0) : montoTotal;
                                                        decimal tolAga = tx.Moneda == "CLP" ? 1m : 0.01m;
                                                        bool requiereVerif = tx.MontoNeto > 0m;
                                                        bool agaTieneValor = tx.ValorAga.HasValue;
                                                        bool agaActivado = tx.ConfirmadoAga && agaTieneValor;
                                                        bool agaCoincide = agaActivado && Math.Abs(tx.ValorAga!.Value - valorComparar) <= tolAga;
                                                        bool agaIncongruente = agaActivado && !agaCoincide;
                                                        bool pagoBloqueadoPorAga = requiereVerif && (!agaActivado || agaIncongruente);
                                                        string fmtMonto = tx.Moneda == "CLP" ? "N0" : "N2";

                                                        string nombreProveedor = ProveedorEgreso(op, tx, isGateRow);

                                                        <tr>
                                                            <td class="fw-bold ps-4" style="color: #475569;">
                                                                @nombreProveedor
                                                                @if (tx.MontoNeto == 0m && !tx.TarifaManual && ((tx.GrupoCobro ?? "").ToUpper().Contains("TRANSPORTE") || (tx.GrupoCobro ?? "").ToUpper().Contains("TERRESTRE")))
                                                                {
                                                                    <button type="button" class="cf-diag-btn d-block" onclick="diagnosticoTransporte(@op.Id, @(UnidadDeConcepto(tx.Concepto)?.ToString() ?? "null"), event)"><i class="bi bi-question-circle"></i> ¿Por qué no hay tarifa?</button>
                                                                }
                                                            </td>
                                                            <td class="fw-bold text-dark">
                                                                @{ string conceptoVisEgr = TieneSufijoContenedor(tx.Concepto) ? ObtenerConceptoBase(tx.Concepto) : (tx.Concepto ?? ""); }
                                                                @(catUpper.Contains("TRANSPORTE") ? AbreviarRuta(conceptoVisEgr) : conceptoVisEgr)
                                                                @if (TieneSufijoContenedor(tx.Concepto))
                                                                {
                                                                    <span class="badge-contenedor-u" title="Contenedor de esta línea">@EtiquetaContenedor(op, tx.Concepto)</span>
                                                                }
                                                                @if (isGateRow && op.IdNavieraNavigation?.AplicaTarifaGatePlana == true)
                                                                {
                                                                    string movGate = cUpper.Contains("GATE IN") ? "IN" : "OUT";
                                                                    string tcGate = (op.TipoContenedor ?? "").ToUpper();
                                                                    bool rfGate = tcGate.Contains("RF") || tcGate.Contains("REEFER") || op.IdTipoCarga == 2;
                                                                    string tipoGate = rfGate ? "RF" : "DRY";
                                                                    var compsGate = Model.ComponentesGate
                                                                        .Where(c => c.IdNaviera == op.IdNaviera && c.TipoMovimiento == movGate && c.TipoContenedor == tipoGate)
                                                                        .OrderBy(c => c.Componente).ToList();
                                                                    if (compsGate.Any())
                                                                    {
                                                                        var exclGate = (tx.ComponentesGateExcluidos ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                                                                        bool compBloqueado = estadoLimpiado == "PAGADO";
                                                                        <form method="post" asp-page-handler="GuardarComponentesGate" class="mt-1 p-2 border rounded bg-white" style="font-weight:500;">
                                                                            <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                            <input type="hidden" name="todos" value="@string.Join(",", compsGate.Select(c => c.Componente))" />
                                                                            @foreach (var c in compsGate)
                                                                            {
                                                                                <div class="form-check" style="font-size:10px;">
                                                                                    <input class="form-check-input" type="checkbox" name="componentes" value="@c.Componente" id="cg-@tx.Id-@c.Id" @(exclGate.Contains(c.Componente) ? "" : "checked") @(compBloqueado ? "disabled" : "") />
                                                                                    <label class="form-check-label text-uppercase" for="cg-@tx.Id-@c.Id">@c.Componente <span class="text-muted">(@c.Moneda @(c.ValorNeto?.ToString("N0")))</span></label>
                                                                                </div>
                                                                            }
                                                                            @if (!compBloqueado)
                                                                            {
                                                                                <button type="submit" class="btn btn-outline-dark btn-xs mt-1">Aplicar</button>
                                                                            }
                                                                        </form>
                                                                    }
                                                                }
                                                            </td>
                                                            <td class="text-center align-middle">
                                                                @{
                                                                    string pagadoPorTexto = (tx.ResponsablePago ?? "ATILSON").ToUpper();
                                                                    if (isGateRow && pagadoPorTexto == "AGENCIA")
                                                                    {
                                                                        var docGatePago = op.OperacionesDocumentales?.FirstOrDefault();
                                                                        pagadoPorTexto = (docGatePago?.IdAgenciaAduanaNavigation?.NombreAgencia ?? docGatePago?.AgenciaAduana ?? "AGENCIA").ToUpper();
                                                                    }
                                                                }
                                                                <span class="badge-resp-atilson">@pagadoPorTexto</span>
                                                            </td>
                                                            <td class="text-center align-middle">
                                                                @{
                                                                    string respUpper = (tx.Responsable ?? "").ToUpper();
                                                                    string claseResp = respUpper == "CLIENTE" ? "badge-resp-cliente" : (respUpper == "ATILSON" ? "badge-resp-atilson" : "badge bg-warning bg-opacity-10 text-warning border border-warning");
                                                                }
                                                                @if (string.IsNullOrEmpty(tx.Responsable))
                                                                {
                                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger" style="font-size:9px;" title="Bloquea el cierre a Finanzas">SIN DEFINIR</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="@claseResp" style="font-size:9px;">@respUpper</span>
                                                                    @if (respUpper == "PROVEEDOR" || respUpper == "AGENCIA")
                                                                    {
                                                                        <span class="d-block text-warning fw-bold mt-1" style="font-size:8px;">A DESCONTAR</span>
                                                                    }
                                                                }
                                                            </td>
                                                                                                                                                                                    <td class="text-end font-monospace align-middle">
                                                                @if (EsPendienteReal(tx, op.IdCliente))
                                                                {
                                                                    <span class="text-por-asignar">Por asignar</span>
                                                                }
                                                                else if (EsSinCostoAcuerdo(tx))
                                                                {
                                                                    <div class="d-inline-flex align-items-center gap-1 justify-content-end" data-bs-toggle="tooltip" data-bs-placement="left" title="@tx.JustificacionManual" style="cursor: help;">
                                                                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 13px;"></i>
                                                                        <span style="background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 12px;">@(tx.Moneda == "CLP" ? "$" : "USD") 0</span>
                                                                    </div>
                                                                }
                                                                else if (tx.TarifaManual)
                                                                {
                                                                    <div class="d-inline-flex align-items-center gap-1 justify-content-end" data-bs-toggle="tooltip" data-bs-placement="left" title="AJUSTE COMERCIAL: @tx.JustificacionManual" style="cursor: help;">
                                                                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 13px;"></i>
                                                                        <span style="background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-size: 12px;">@FmtMonto(tx.Moneda, tx.MontoNeto)</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    string colorValorNeto = "text-dark";
                                                                    <span class="@colorValorNeto" style="font-weight: 600;">@FmtMonto(tx.Moneda, tx.MontoNeto)</span>
                                                                    @EquivClp(tx.Moneda, tx.MontoNeto)

                                                                    if (tx.MontoOriginalUsd.HasValue && tx.MontoOriginalUsd.Value > 0)
                                                                    {
                                                                        <span class="d-block" style="font-size:9.5px; color:#94a3b8; font-weight:600;" title="Convertido a CLP con el tipo de cambio guardado en esta línea">(USD @tx.MontoOriginalUsd.Value.ToString("N2")@(tx.TipoCambio > 0 ? " × $ " + tx.TipoCambio.Value.ToString("N2") : ""))</span>
                                                                    }
                                                                }
                                                            </td>
                                                            <!-- VALOR + IVA (valor teórico según base de datos Atilson) -->
                                                            <td class="text-end font-monospace align-middle">
                                                                @if (!requiereVerif)
                                                                {
                                                                    <span class="text-muted fw-bold">-</span>
                                                                }
                                                                else
                                                                {
                                                                    @* Exentos (flete marítimo, roleo, cancelación, rebate...): la factura trae el neto, sin IVA. *@
                                                                    if (esExento && !isGateRow)
                                                                    {
                                                                        <span class="cf-exento" title="Concepto exento de IVA: la factura debe traer el valor neto (@FmtMonto(tx.Moneda, valorComparar))">Exento</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-dark" style="font-weight: 700;">@FmtMonto(tx.Moneda, valorComparar)</span>
                                                                        @EquivClp(tx.Moneda, valorComparar)
                                                                    }
                                                                }
                                                            </td>

                                                            <!-- CONFIRMAR: la factura AGA trae exactamente el Valor + IVA -->
                                                            <td class="text-center align-middle">
                                                                @if (requiereVerif)
                                                                {
                                                                    <form method="post" asp-page-handler="GuardarVerificacionAga" id="form-aga-@tx.Id" class="m-0 p-0 d-inline-block">
                                                                        <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                        <input type="hidden" name="accion" id="accion-aga-@tx.Id" value="confirmar" />
                                                                        <input type="checkbox" class="form-check-input" style="cursor:pointer; width:15px; height:15px;"
                                                                        @(agaCoincide ? "checked" : "") @(estadoLimpiado == "PAGADO" ? "disabled" : "")
                                                                               onchange="toggleConfirmarAga(this, '@tx.Id')"
                                                                               title="Marcar si el valor de la factura AGA coincide con el Valor + IVA" />
                                                                    </form>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted" style="font-size:10px;">—</span>
                                                                }
                                                            </td>

                                                            <!-- VALOR ACTUALIZADO IVA INCLUIDO: monto bruto de la factura recibida cuando difiere -->
                                                            <td class="align-middle" style="min-width: 150px;">
                                                                @if (requiereVerif)
                                                                {
                                                                    <form method="post" asp-page-handler="GuardarVerificacionAga" class="m-0 p-0">
                                                                        <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                        <input type="hidden" name="accion" value="discrepancia" />
                                                                        <div class="input-group input-group-sm shadow-sm">
                                                                            <span class="input-group-text bg-light border-secondary p-1" style="font-size:9px;">@tx.Moneda</span>
                                                                            <input type="number" step="@(tx.Moneda == "CLP" ? "1" : "0.01")" id="valAga-@tx.Id" name="valorAga"
                                                                                   class="form-control text-end @(agaIncongruente ? "is-invalid text-danger fw-bold" : "")"
                                                                                   style="font-size:11px; height:26px;"
                                                                                   value="@(agaIncongruente ? tx.ValorAga!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                                                                   data-valor-original="@valorComparar.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                                                   data-tol="@tolAga.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                                                                                                                               placeholder=""
                                                                                   oninput="validarValorAga(this, '@tx.Id')"
                                                                            @((agaCoincide || estadoLimpiado == "PAGADO") ? "disabled" : "") />
                                                                            <button type="submit" class="btn btn-outline-dark" style="padding:0 8px;" title="Guardar valor de la factura AGA"
                                                                                @((agaCoincide || estadoLimpiado == "PAGADO") ? "disabled" : "")>
                                                                                <i class="bi bi-check2" style="font-size:11px;"></i>
                                                                            </button>
                                                                        </div>
                                                                        <div id="alerta-aga-@tx.Id" class="fw-bold text-danger mt-1" style="font-size:9px; display:@(agaIncongruente ? "block" : "none");">
                                                                            <i class="bi bi-exclamation-triangle-fill"></i> Diferencia con el Valor + IVA.
                                                                        </div>
                                                                    </form>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted" style="font-size:10px;">N/A</span>
                                                                }
                                                            </td>

                                                            <!-- COLUMNA N° DOC DUAL (MINIMALISTA) -->
                                                            <td class="align-middle px-3">
                                                                <div class="d-flex align-items-center justify-content-between gap-2 w-100">
                                                                    @{
                                                                        bool isTransporte = catUpper.Contains("TRANSPORTE") || catUpper.Contains("TERRESTRE");
                                                                        bool isFlete = isTransporte && !cUpper.Contains("INTERPLANTA");
                                                                        bool isMaritimo = catUpper.Contains("MARÍTIMO") || catUpper.Contains("MARITIMO");
                                                                        bool isGateOut = catUpper.Contains("GATE");
                                                                        bool isCertificado = catUpper.Contains("DOCUMENTAL") && (cUpper.Contains("FITO") || cUpper.Contains("SANI") || cUpper.Contains("CAPTU") || cUpper.Contains("ORIGEN"));
                                                                        string placeholderTexto = isMaritimo ? "N° BL" : (isCertificado ? "N° Cert" : "N° Fact");
                                                                        string docLabel = isMaritimo ? "BL" : (isCertificado ? "CERT" : "FACT");
                                                                    }

                                                                    <div class="flex-grow-1 d-flex flex-column gap-1">
                                                                        @if (isFlete)
                                                                        {
                                                                            @if (string.IsNullOrWhiteSpace(tx.NumeroOrdenCompra))
                                                                            {
                                                                                <span class="badge bg-light text-muted border border-secondary shadow-sm text-start" style="font-size: 8px;">OC PENDIENTE</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <a href="/Operaciones/OrdenCompraPdf/@op.Id?oc=@tx.NumeroOrdenCompra" target="_blank" class="badge bg-primary shadow-sm text-start text-decoration-none d-inline-flex align-items-center gap-1" style="font-size: 9px; cursor: pointer;" title="Ver Orden de Compra (PDF)">
                                                                                    <i class="bi bi-receipt"></i> OC-@tx.NumeroOrdenCompra.Replace("OC-", "") <i class="bi bi-eye-fill"></i>
                                                                                </a>
                                                                            }
                                                                        }

                                                                        @if (string.IsNullOrWhiteSpace(tx.NumeroDocumento))
                                                                        {
                                                                            if (isCertificado)
                                                                            {
                                                                                <span class="text-danger fw-bold" style="font-size: 11px;">INCOMPLETO</span>
                                                                            }
                                                                            else if (isGateOut)
                                                                            {
                                                                                <form method="post" asp-page-handler="GuardarNumeroDoc" class="input-group input-group-sm shadow-sm m-0 p-0">
                                                                                    <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                    <div class="input-group-text bg-white border-secondary p-1">
                                                                                        <input type="checkbox" class="form-check-input m-0" style="cursor:pointer; width:12px; height:12px;" onchange="document.getElementById('doc-gate-egr-@tx.Id').disabled = !this.checked; document.getElementById('btn-gate-egr-@tx.Id').disabled = !this.checked;" />
                                                                                    </div>
                                                                                    <input type="text" id="doc-gate-egr-@tx.Id" name="numeroDoc" class="form-control text-center border-secondary" style="font-size: 9px; padding: 2px; height:24px;" placeholder="N° Fact" required disabled />
                                                                                    <button type="submit" id="btn-gate-egr-@tx.Id" class="btn btn-outline-primary" style="padding: 0 6px; height:24px;" disabled><i class="bi bi-check2"></i></button>
                                                                                </form>
                                                                            }
                                                                            else
                                                                            {
                                                                                <form method="post" asp-page-handler="GuardarNumeroDoc" class="input-group input-group-sm shadow-sm m-0 p-0">
                                                                                    <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                    <input type="text" name="numeroDoc" class="form-control text-center" style="font-size: 9px; height: 24px; border-color: #cbd5e1;" placeholder="@placeholderTexto" required />
                                                                                    <button type="submit" class="btn btn-outline-primary" style="padding: 0 8px; height: 24px;"><i class="bi bi-check2"></i></button>
                                                                                </form>
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-primary fw-bold text-truncate" style="font-size: 10px;">@docLabel: @tx.NumeroDocumento</span>
                                                                        }
                                                                    </div>

                                                                    <!-- Botón Subir Factura (Fijo a la derecha para alinear) -->
                                                                    <div style="width: 28px; flex-shrink: 0;" class="text-end">
                                                                        @if (string.IsNullOrEmpty(tx.RutaFactura))
                                                                        {
                                                                            <form method="post" asp-page-handler="SubirFactura" enctype="multipart/form-data" class="m-0 p-0">
                                                                                <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                <button type="button" class="btn btn-light border btn-xs shadow-sm text-secondary btn-action-col" title="Subir PDF de Factura" onclick="document.getElementById('file-fact-@tx.Id').click()">
                                                                                    <i class="bi bi-upload"></i>
                                                                                </button>
                                                                                <input type="file" id="file-fact-@tx.Id" name="archivoFactura" class="d-none" accept=".pdf,.png,.jpg,.jpeg" onchange="if(this.files.length > 0) this.form.submit();" />
                                                                            </form>
                                                                        }
                                                                        else
                                                                        {
                                                                            <a href="@tx.RutaFactura" target="_blank" class="btn btn-dark btn-xs shadow-sm btn-action-col" title="Ver PDF de Factura">
                                                                                <i class="bi bi-eye"></i>
                                                                            </a>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </td>
                                                           
                                                            @{
                                                                bool bloqueadoDuroPorFaltaAga = requiereVerif && !agaActivado;
                                                                // Si quedó marcada como aceptada desde antes de existir la nota obligatoria
                                                                // (AceptaDiferenciaPago=true pero sin NotaDiferenciaAga), se trata como no
                                                                // aceptada todavía: se vuelve a pedir la justificación.
                                                                bool requiereAceptarDiferencia = agaIncongruente && (!tx.AceptaDiferenciaPago || string.IsNullOrWhiteSpace(tx.NotaDiferenciaAga));
}
<td class="text-center align-middle pe-4">
    <div class="d-flex align-items-center justify-content-between gap-2 w-100">
        <div class="flex-grow-1 text-center">
            <span class="badge-estado @claseEstado shadow-sm m-0">@estadoLimpiado</span>
                                                                        @if (requiereAceptarDiferencia)
                                                                        {
                                                                            <form method="post" asp-page-handler="GuardarAceptaDiferencia" class="mt-1" style="max-width:170px; margin:0 auto;">
                                                                                <input type="hidden" name="transaccionId" value="@tx.Id" />
                                                                                <textarea name="notaDiferenciaAga" id="nota-difaga-@tx.Id" class="form-control form-control-sm mb-1" style="font-size:9px; height:38px; resize:none;" placeholder="Motivo de la diferencia..."></textarea>
                                                                                <div class="d-flex align-items-center justify-content-center gap-1">
                                                                                    <input type="checkbox" name="aceptaDiferencia" value="true" class="form-check-input m-0" style="width:12px;height:12px;cursor:pointer;" onchange="confirmarDiferenciaAga(this, '@tx.Id')" />
                                                                                    <label class="text-warning fw-bold mb-0" style="font-size:8px; text-transform:uppercase; letter-spacing:0.3px;">Consciente pago diferencia</label>
                                                                                </div>
                                                                            </form>
                                                                        }
                                                                        else if (agaIncongruente && tx.AceptaDiferenciaPago && !string.IsNullOrWhiteSpace(tx.NotaDiferenciaAga))
                                                                        {
                                                                            <div class="text-warning fw-bold mt-1" style="font-size:8px; text-transform:uppercase; letter-spacing:0.3px; cursor:help;" data-bs-toggle="tooltip" data-bs-placement="left" title="@tx.NotaDiferenciaAga">
                                                                                <i class="bi bi-chat-left-text-fill"></i> Diferencia justificada
                                                                            </div>
                                                                        }
        </div>
        <div style="width: 28px; flex-shrink: 0;" class="text-end">
            @if (bloqueadoDuroPorFaltaAga)
            {
