@page
@model AtilsonCargoSpa.Pages.Finanzas.ConsolidadoClienteModel
@{
    ViewData["Title"] = "Consolidado por Cliente";
}

<div class="container-fluid px-4 py-4">
    <partial name="/Pages/Finanzas/_FinanzasNav.cshtml" model='"ConsolidadoCliente"' />
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="font-size: 24px; font-weight: 900; color: #0f172a; margin: 0;">CONSOLIDADO POR CLIENTE</h1>
            <p class="text-muted small m-0 fw-medium mt-1">Resumen de ingresos y egresos a través de varias operaciones, en un rango de fechas.</p>
        </div>
        <a href="/Finanzas/Index" class="btn btn-outline-secondary btn-sm fw-bold px-3"><i class="bi bi-arrow-left me-1"></i> Volver a Finanzas</a>
    </div>

    <form method="get" class="d-flex align-items-end gap-3 bg-white border rounded p-3 mb-4 shadow-sm">
        <div>
            <label class="form-label fw-bold" style="font-size: 11px; text-transform: uppercase; color: #64748b;">Cliente</label>
            <select name="IdCliente" asp-items="Model.ListaClientes" class="form-select form-select-sm" style="min-width: 260px;">
                <option value="">-- Seleccionar Cliente --</option>
            </select>
        </div>
        <div>
            <label class="form-label fw-bold" style="font-size: 11px; text-transform: uppercase; color: #64748b;">Desde</label>
            <input type="date" name="Desde" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div>
            <label class="form-label fw-bold" style="font-size: 11px; text-transform: uppercase; color: #64748b;">Hasta</label>
            <input type="date" name="Hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <button type="submit" class="btn btn-dark btn-sm fw-bold px-4"><i class="bi bi-search me-1"></i> Buscar</button>
    </form>

    @if (Model.Resultado != null)
    {
        <div class="d-flex justify-content-end gap-2 mb-3">
            <a href="?handler=ExportarExcel&idCliente=@Model.IdCliente&desde=@Model.Desde?.ToString("yyyy-MM-dd")&hasta=@Model.Hasta?.ToString("yyyy-MM-dd")" class="btn btn-outline-success btn-sm fw-bold px-3 shadow-sm"><i class="bi bi-file-earmark-excel-fill me-2"></i> Excel</a>
            <a href="?handler=ExportarPdf&idCliente=@Model.IdCliente&desde=@Model.Desde?.ToString("yyyy-MM-dd")&hasta=@Model.Hasta?.ToString("yyyy-MM-dd")" class="btn btn-dark btn-sm fw-bold px-4 shadow-sm"><i class="bi bi-file-earmark-pdf-fill me-2"></i> Descargar PDF</a>
        </div>

        <div class="bg-white border rounded shadow-sm overflow-hidden">
            <div class="px-4 py-3 border-bottom bg-light">
                <span class="fw-bold" style="font-size: 13px;">@Model.Resultado.ClienteNombre</span>
                <span class="text-muted ms-2" style="font-size: 11px;">@Model.Resultado.Desde.ToString("dd/MM/yyyy") — @Model.Resultado.Hasta.ToString("dd/MM/yyyy")</span>
            </div>
            <table class="table table-sm mb-0" style="font-size: 12px;">
                <thead class="bg-light">
                    <tr style="font-size: 10px; text-transform: uppercase; color: #64748b;">
                        <th class="ps-4">Booking</th>
                        <th>Fecha</th>
                        <th class="text-end">Ingreso USD</th>
                        <th class="text-end">Ingreso CLP</th>
                        <th class="text-end">Egreso USD</th>
                        <th class="text-end">Egreso CLP</th>
                        <th class="text-end pe-4">Rentabilidad CLP</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Resultado.Operaciones.Any())
                    {
                        foreach (var o in Model.Resultado.Operaciones)
                        {
                            decimal rent = o.IngresoClp - o.EgresoClp;
                            <tr>
                                <td class="ps-4 fw-bold">@o.NumeroBooking</td>
                                <td class="text-muted">@(o.Fecha?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-end font-monospace">@(o.IngresoUsd > 0 ? $"USD {o.IngresoUsd:N2}" : "-")</td>
                                <td class="text-end font-monospace">@(o.IngresoClp > 0 ? $"$ {o.IngresoClp:N0}" : "-")</td>
                                <td class="text-end font-monospace text-danger">@(o.EgresoUsd > 0 ? $"USD {o.EgresoUsd:N2}" : "-")</td>
                                <td class="text-end font-monospace text-danger">@(o.EgresoClp > 0 ? $"$ {o.EgresoClp:N0}" : "-")</td>
                                <td class="text-end pe-4 font-monospace fw-bold" style="color: @(rent >= 0 ? "#16a34a" : "#dc2626");">$ @rent.ToString("N0")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay operaciones en este período.</td></tr>
                    }
                </tbody>
                <tfoot class="bg-light fw-bold">
                    <tr style="font-size: 12px;">
                        <td class="ps-4" colspan="2">TOTALES</td>
                        <td class="text-end font-monospace">USD @Model.Resultado.TotalIngresoUsd.ToString("N2")</td>
                        <td class="text-end font-monospace">$ @Model.Resultado.TotalIngresoClp.ToString("N0")</td>
                        <td class="text-end font-monospace text-danger">USD @Model.Resultado.TotalEgresoUsd.ToString("N2")</td>
                        <td class="text-end font-monospace text-danger">$ @Model.Resultado.TotalEgresoClp.ToString("N0")</td>
                        <td class="text-end pe-4 font-monospace">$ @((Model.Resultado.TotalIngresoClp - Model.Resultado.TotalEgresoClp).ToString("N0"))</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>