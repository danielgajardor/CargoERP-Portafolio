@page "{id:int}"
@model AtilsonCargoSpa.Pages.Finanzas.SetPagoEgresosModel
@{
    ViewData["Title"] = $"Liquidación de Egresos — BKG {Model.Operacion.NumeroBooking}";
    Layout = "_Layout";
}

<style>
    :root {
        --atilson-dark: #0f172a;
        --color-accent: #b91c1c;
        --border-soft: #cbd5e1;
        --bg-light: #f8fafc;
    }
    body { background-color: #f1f5f9; font-family: 'Inter', sans-serif; color: #1e293b; }
    .sheet-container { max-width: 900px; margin: 30px auto; background: #ffffff; padding: 45px 55px; border-radius: 4px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); border: 1px solid var(--border-soft); }
    .brand-title { font-size: 22px; font-weight: 900; color: var(--atilson-dark); letter-spacing: -0.5px; line-height: 1; }
    .brand-subtitle { font-size: 10px; font-weight: 700; color: #64748b; letter-spacing: 1px; text-transform: uppercase; margin-top: 4px; }
    .doc-badge { font-size: 12px; font-weight: 800; text-transform: uppercase; color: var(--color-accent); letter-spacing: 0.8px; border-bottom: 2px solid var(--color-accent); padding-bottom: 4px; display: inline-block; }
    .grid-info { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; background: var(--bg-light); border: 1px solid var(--border-soft); padding: 15px; border-radius: 4px; margin-bottom: 25px; }
    .info-item .lbl { font-size: 9px; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
    .info-item .val { font-size: 12px; font-weight: 700; color: #0f172a; margin-top: 2px; }
    .section-title { font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--atilson-dark); border-bottom: 1px solid var(--border-soft); padding-bottom: 6px; margin-top: 25px; margin-bottom: 12px; letter-spacing: 0.5px; }
    .table-custom { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    .table-custom th { background-color: #f8fafc; color: #475569; font-size: 9px; font-weight: 800; text-transform: uppercase; padding: 10px 12px; border: 1px solid var(--border-soft); text-align: left; }
    .table-custom td { padding: 10px 12px; font-size: 11px; font-weight: 600; border: 1px solid var(--border-soft); vertical-align: middle; }
    .totals-card { background: var(--atilson-dark); color: #ffffff; padding: 18px 22px; border-radius: 6px; display: flex; flex-direction: column; gap: 15px; margin-top: 25px; box-shadow: 0 4px 10px rgba(15, 23, 42, 0.15); }
</style>

<div class="mx-auto mt-3 d-flex justify-content-between align-items-center" style="max-width: 900px;">
    <a href="/Finanzas/ControlFinanciero" class="btn btn-outline-secondary btn-sm fw-bold px-3" style="font-size: 11px;"><i class="bi bi-arrow-left me-1"></i> Volver a Control Financiero</a>
    <div class="d-flex gap-2">
        <a href="?handler=ExportarExcel&id=@Model.Operacion.Id" class="btn btn-outline-success btn-sm fw-bold px-3 shadow-sm" style="font-size: 12px;"><i class="bi bi-file-earmark-excel-fill me-2"></i> Excel</a>
        <a href="?handler=ExportarPdf&id=@Model.Operacion.Id" class="btn btn-dark btn-sm fw-bold px-4 shadow-sm" style="background-color: var(--color-accent); border: none; font-size: 12px;"><i class="bi bi-file-earmark-pdf-fill me-2"></i> Descargar PDF</a>
    </div>
</div>

<div class="sheet-container">
    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
        <div>
            <div class="brand-title">ATILSON</div>
            <div class="brand-subtitle">Global Logistics Solutions</div>
        </div>
        <div class="text-end">
            <div class="doc-badge">LIQUIDACIÓN DE EGRESOS / ORDEN DE PAGO</div>
            <div class="fw-bold mt-1 font-monospace" style="font-size: 14px; color: var(--atilson-dark);">BKG: @Model.Operacion.NumeroBooking</div>
            <div class="text-muted" style="font-size: 10px;">Fecha Emisión: @DateTime.Now.ToString("dd-MM-yyyy")</div>
        </div>
    </div>

    <div class="grid-info">
        <div class="info-item"><div class="lbl">Cliente Asociado</div><div class="val text-uppercase">@(Model.Operacion.IdClienteNavigation?.RazonSocial ?? "S/N")</div></div>
        <div class="info-item"><div class="lbl">Naviera Asignada</div><div class="val text-uppercase">@(Model.Operacion.IdNavieraNavigation?.NombreNaviera ?? "N/A")</div></div>
        <div class="info-item"><div class="lbl">Condición</div><div class="val">@((Model.Operacion.CondicionPago == 1 || Model.Operacion.CondicionPago == 2) ? "PREPAID" : "COLLECT")</div></div>
        <div class="info-item"><div class="lbl">Contenedor / Equipo</div><div class="val font-monospace">@(Model.Operacion.NumeroContenedor ?? "Por asignar")</div></div>
        <div class="info-item"><div class="lbl">Sello de Seguridad</div><div class="val font-monospace">@(Model.Operacion.NumeroSello ?? "Por asignar")</div></div>
        <div class="info-item"><div class="lbl">Planta / Origen Carga</div><div class="val text-uppercase">@(Model.Operacion.OperacionesTerrestres?.FirstOrDefault()?.PlantaCarga ?? "Terminal Portuario")</div></div>
    </div>

    <div class="section-title">1. Detalle de Costos y Servicios Base</div>
    <table class="table-custom">
        <thead>
            <tr>
                <th style="width: 24%;">Concepto</th>
                <th style="width: 22%;">Proveedor / Beneficiario</th>
                <th style="width: 20%;" class="text-center">Documento</th>
                <th style="width: 12%;" class="text-center">Estado</th>
                <th style="width: 8%;" class="text-center">Mon.</th>
                <th style="width: 14%;" class="text-end">Monto Neto</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.CostosBase.Any())
            {
                foreach (var item in Model.CostosBase)
                {
                    bool pagado = item.Tx.EstadoFila == "PAGADO" || item.Tx.EstadoFila == "CONCILIADO";
                    <tr>
                        <td class="fw-bold">@item.Tx.Concepto</td>
                        <td class="text-uppercase">@item.Contraparte</td>
                        <td class="text-center font-monospace text-muted">@(string.IsNullOrEmpty(item.Tx.NumeroDocumento) ? "POR EMITIR" : item.Tx.NumeroDocumento)</td>
                        <td class="text-center" style="color: @(pagado ? "#059669" : "#dc2626"); font-size: 10px; font-weight: 800;">@(pagado ? "PAGADO" : "PENDIENTE")</td>
                        <td class="text-center">@item.Tx.Moneda</td>
                        <td class="text-end font-monospace">@(item.Tx.Moneda == "USD" ? $"USD {item.Tx.MontoNeto:N2}" : $"$ {item.Tx.MontoNeto:N0}")</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center text-muted py-3">No hay costos base registrados.</td></tr>
            }
        </tbody>
    </table>

    <div class="section-title">2. Desviaciones y Extracostos (a pagar)</div>
    <table class="table-custom">
        <thead>
            <tr>
                <th style="width: 24%;">Concepto</th>
                <th style="width: 22%;">Proveedor / Beneficiario</th>
                <th style="width: 20%;" class="text-center">Documento</th>
                <th style="width: 12%;" class="text-center">Estado</th>
                <th style="width: 8%;" class="text-center">Mon.</th>
                <th style="width: 14%;" class="text-end">Monto Neto</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ExtracostosPago.Any())
            {
                foreach (var item in Model.ExtracostosPago)
                {
                    bool pagado = item.Tx.EstadoFila == "PAGADO" || item.Tx.EstadoFila == "CONCILIADO";
                    <tr>
                        <td class="fw-bold">@item.Tx.Concepto</td>
                        <td class="text-uppercase">@item.Contraparte</td>
                        <td class="text-center font-monospace text-muted">@(string.IsNullOrEmpty(item.Tx.NumeroDocumento) ? "POR EMITIR" : item.Tx.NumeroDocumento)</td>
                        <td class="text-center" style="color: @(pagado ? "#059669" : "#dc2626"); font-size: 10px; font-weight: 800;">@(pagado ? "PAGADO" : "PENDIENTE")</td>
                        <td class="text-center">@item.Tx.Moneda</td>
                        <td class="text-end font-monospace text-danger">@(item.Tx.Moneda == "USD" ? $"USD {item.Tx.MontoNeto:N2}" : $"$ {item.Tx.MontoNeto:N0}")</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center text-muted py-3">No se registran extracostos a pagar.</td></tr>
            }
        </tbody>
    </table>

    <div class="row g-3 mt-2 justify-content-end">
        <div class="col-6">
            <div class="totals-card">
                @if (Model.GranTotalUSD > 0)
                {
                    <div class="w-100">
                        <div class="d-flex justify-content-between mb-1" style="font-size: 10px; color: #cbd5e1;"><span>TOTAL A PAGAR USD:</span><span class="font-monospace">USD $@Model.GranTotalUSD.ToString("N2")</span></div>
                        <div class="d-flex justify-content-between mb-2" style="font-size: 10px; color: #94a3b8;"><span>PAGADO:</span><span class="font-monospace">USD $@Model.TotalPagadoUSD.ToString("N2")</span></div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color: rgba(255,255,255,0.15) !important;">
                            <span class="fw-bold" style="font-size: 11px; letter-spacing: 1px; color: #f8fafc;">SALDO PENDIENTE USD:</span>
                            <span class="font-monospace fw-bold fs-5" style="color: @(Model.SaldoPendienteUSD > 0 ? "#f87171" : "#34d399");">USD $@Model.SaldoPendienteUSD.ToString("N2")</span>
                        </div>
                    </div>
                }
                @if (Model.GranTotalCLP > 0)
                {
                    <div class="w-100 pt-2 @(Model.GranTotalUSD > 0 ? "border-top" : "")" style="border-color: rgba(255,255,255,0.05) !important;">
                        <div class="d-flex justify-content-between mb-1" style="font-size: 10px; color: #cbd5e1;"><span>TOTAL A PAGAR CLP:</span><span class="font-monospace">CLP $@Model.GranTotalCLP.ToString("N0")</span></div>
                        <div class="d-flex justify-content-between mb-2" style="font-size: 10px; color: #94a3b8;"><span>PAGADO:</span><span class="font-monospace">CLP $@Model.TotalPagadoCLP.ToString("N0")</span></div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color: rgba(255,255,255,0.15) !important;">
                            <span class="fw-bold" style="font-size: 11px; letter-spacing: 1px; color: #f8fafc;">SALDO PENDIENTE CLP:</span>
                            <span class="font-monospace fw-bold fs-6" style="color: @(Model.SaldoPendienteCLP > 0 ? "#f87171" : "#34d399");">CLP $@Model.SaldoPendienteCLP.ToString("N0")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="text-center text-muted mt-4 pt-3 border-top" style="font-size: 9px;">
        Documento generado automáticamente por el Módulo Financiero de Atilson Cargo SpA.
    </div>
</div>