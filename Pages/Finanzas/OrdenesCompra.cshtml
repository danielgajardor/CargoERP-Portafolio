@page
@model AtilsonCargoSpa.Pages.Finanzas.OrdenesCompraModel
@using AtilsonCargoSpa.Models
@{
    ViewData["Title"] = "Órdenes de Compra (OC)";
}

<style>
    /* VARIABLES CORPORATIVAS ATILSON */
    :root {
        --atilson-slate-900: #0f172a;
        --atilson-slate-500: #64748b;
        --atilson-bg-soft: #f8fafc;
        --atilson-border: #e2e8f0;
    }

    body {
        background-color: #f8fafc;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    /* MENU DE NAVEGACIÓN PRINCIPAL */
    .workspace-nav {
        display: flex;
        gap: 2px;
        background: #ffffff;
        padding: 6px;
        border-radius: 8px;
        border: 1px solid var(--atilson-border);
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }

    .ws-btn {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 10px 20px;
        border-radius: 6px;
        color: var(--atilson-slate-500);
        text-decoration: none;
        transition: all 0.2s;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .ws-btn:hover {
            background: var(--atilson-bg-soft);
            color: var(--atilson-slate-900);
        }

        .ws-btn.active {
            background: var(--atilson-slate-900);
            color: #ffffff;
            box-shadow: 0 2px 5px rgba(15, 23, 42, 0.15);
        }

    /* GRILLA PRINCIPAL TIPO EXCEL */
    .fin-table-wrapper {
        background: #ffffff;
        border-radius: 8px;
        border: 1px solid var(--atilson-border);
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        overflow: hidden;
    }

    .table-main-grid {
        margin-bottom: 0;
        width: 100%;
    }

        .table-main-grid > thead > tr > th {
            font-size: 10px;
            text-transform: uppercase;
            color: var(--atilson-slate-500);
            font-weight: 700;
            background-color: #f1f5f9;
            border-bottom: 2px solid #cbd5e1;
            padding: 12px 20px;
            letter-spacing: 0.5px;
        }

        .table-main-grid > tbody > tr.main-row > td {
            padding: 14px 20px;
            font-size: 13px;
            border-bottom: 1px solid var(--atilson-border);
            background-color: #ffffff;
            vertical-align: middle;
        }

        .table-main-grid > tbody > tr.main-row:hover > td {
            background-color: var(--atilson-bg-soft);
        }

    .row-egreso > td:first-child {
        border-left: 3px solid #f59e0b;
    }

    /* GRILLA ANIDADA (DETALLE DE LA OC) */
    .nested-container {
        padding: 0;
        background-color: var(--atilson-bg-soft);
        border-bottom: 2px solid var(--atilson-border);
    }

    .nested-table {
        background-color: transparent;
        border: none;
        margin: 0;
    }

        .nested-table thead th {
            background-color: #e2e8f0;
            font-size: 9px;
            text-transform: uppercase;
            color: var(--atilson-slate-900);
            font-weight: 800;
            padding: 8px 20px;
            border-bottom: 1px solid #cbd5e1;
        }

        .nested-table tbody td {
            padding: 8px 20px;
            font-size: 11.5px;
            border-bottom: 1px solid var(--atilson-border);
            color: #334155;
            vertical-align: middle;
        }

    /* SEPARADOR DE TRANSPORTISTA */
    .row-group-header td {
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0 !important;
        padding: 12px 20px 4px 20px !important;
        color: var(--atilson-slate-900);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
    }

    /* BOTONES */
    .btn-oc-pdf {
        font-size: 10px;
        font-weight: 800;
        padding: 6px 14px;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background-color: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

        .btn-oc-pdf:hover {
            background-color: #2563eb;
            color: white;
            border-color: #2563eb;
        }
</style>
<link rel="stylesheet" href="~/css/ordenes-compra-premium.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/finanzas-modulo.css" asp-append-version="true" />

<div class="container-fluid px-4 py-4 oc-premium fin-modulo">

    <div class="page-header">
        <div class="page-header__title-row">
            <div class="page-header__icon"><i class="bi bi-receipt"></i></div>
            <div>
                <h1>Órdenes de Compra</h1>
                <p class="page-header__subtitle">Generación de respaldos para pago de proveedores terrestres y extracostos.</p>
            </div>
        </div>
    </div>

    <!-- MENÚ UNIFICADO -->
    <partial name="/Pages/Finanzas/_FinanzasNav.cshtml" model='"OrdenesCompra"' />

    <!-- GRILLA PRINCIPAL -->
    <div class="fin-table-wrapper">
        <div class="px-4 py-3 border-bottom d-flex justify-content-between align-items-center bg-white">
            <h6 class="m-0 fw-bold text-dark" style="font-size: 13px;"><i class="bi bi-truck me-2 text-warning"></i> OPERACIONES CON COSTOS TERRESTRES</h6>
            <form method="get" class="input-group input-group-sm shadow-sm" style="width: 300px;">
                <button type="submit" class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></button>
                <input type="text" asp-for="SearchString" class="form-control border-start-0 bg-light" placeholder="Booking, cliente, proveedor u OC..." style="font-size: 12px; font-weight: 600;">
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-main-grid">
                <thead>
                    <tr>
                        <th class="ps-4">Operación (Booking) / Cliente</th>
                        <th>Ruta Inland (Referencial)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var op in Model.ListaOrdenes)
                    {
                        var txTerrestres = op.TransaccionesFinancieras.Where(t =>
                            t.TipoMovimiento == "EGRESO" && t.GrupoCobro != null &&
                            (t.GrupoCobro.ToUpper().Contains("TERRESTRE") || t.GrupoCobro.ToUpper().Contains("TRANSPORTE") || t.GrupoCobro.ToUpper().Contains("EXTRACOSTO"))).ToList();

                        if (!txTerrestres.Any()) continue;

                        var terr = op.OperacionesTerrestres?.FirstOrDefault();

                        <tr data-bs-toggle="collapse" data-bs-target="#oc-@op.Id" class="cursor-pointer main-row row-egreso">
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-chevron-right text-muted me-3" style="font-size: 10px;"></i>
                                    <span style="font-weight: 800; color: #0f172a; font-size: 14px;">@op.NumeroBooking</span>
                                    <span class="text-muted mx-2">|</span>
                                    <span style="font-weight:500; color:#475569; font-size: 12px;">@(op.IdClienteNavigation?.RazonSocial ?? "Sin Cliente")</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-column text-muted" style="font-size: 11px;">
                                    <span class="text-truncate text-uppercase fw-bold">
                                        <i class="bi bi-geo-alt-fill me-1 text-danger"></i>
                                        @(terr?.DepositoRetiro ?? "Retiro")
                                        <i class="bi bi-arrow-right mx-1 text-muted"></i>
                                        @(terr?.PlantaCarga ?? "Planta")
                                        <i class="bi bi-arrow-right mx-1 text-muted"></i>
                                        @(terr?.PuertoEntrega ?? "Puerto")
                                    </span>
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <span class="badge bg-light text-dark border px-2 py-1"><i class="bi bi-list-ul"></i> Ver Detalle</span>
                            </td>
                        </tr>

                        <tr id="oc-@op.Id" class="collapse">
                            <td colspan="3" class="p-0 border-0">
                                <div class="nested-container">
                                    <table class="table table-sm nested-table">
                                        <thead>
                                            <tr>
                                                <th class="ps-4">Concepto Terrestre</th>
                                                <th class="text-end">Monto Neto</th>
                                                <th class="text-end">IVA (19%)</th>
                                                <th class="text-end">Total a Pagar</th>
                                                <th class="text-center pe-4">Documento (OC)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var gruposProv = txTerrestres
                                                    .GroupBy(t => new
                                                    {
                                                        Proveedor = Model.ResolverProveedor(op, t),
                                                        Moneda = string.IsNullOrWhiteSpace(t.Moneda) ? "CLP" : t.Moneda.ToUpperInvariant()
                                                    })
                                                    .OrderBy(g => g.Key.Proveedor)
                                                    .ThenBy(g => g.Key.Moneda);
                                            }

                                            @foreach (var prov in gruposProv)
                                            {
                                                decimal sumNeto = prov.Sum(x => x.MontoNeto);
                                                decimal sumIva = prov.Sum(x => x.IvaExento == true ? 0m : System.Math.Round(x.MontoNeto * 0.19m, x.Moneda == "CLP" ? 0 : 2));
                                                decimal sumTotal = sumNeto + sumIva;
                                                string simbolo = prov.Key.Moneda == "CLP" ? "$" : prov.Key.Moneda;

                                                <tr class="row-group-header">
                                                    <td colspan="5" class="ps-4"><i class="bi bi-truck text-warning me-2"></i> @prov.Key.Proveedor <span class="badge bg-light text-dark border ms-2">@prov.Key.Moneda</span></td>
                                                </tr>

                                                foreach (var tx in prov)
                                                {
                                                    decimal ivaItem = tx.IvaExento == true ? 0m : System.Math.Round(tx.MontoNeto * 0.19m, tx.Moneda == "CLP" ? 0 : 2);
                                                    decimal totalItem = tx.MontoNeto + ivaItem;

                                                    <tr>
                                                        <td class="fw-bold text-dark ps-4">@tx.Concepto</td>
                                                        <td class="text-end font-monospace text-muted">@(tx.Moneda == "CLP" ? "$" : tx.Moneda) @tx.MontoNeto.ToString(tx.Moneda == "CLP" ? "N0" : "N2")</td>
                                                        <td class="text-end font-monospace text-muted">@(tx.Moneda == "CLP" ? "$" : tx.Moneda) @ivaItem.ToString(tx.Moneda == "CLP" ? "N0" : "N2")</td>
                                                        <td class="text-end font-monospace fw-bold text-dark">@(tx.Moneda == "CLP" ? "$" : tx.Moneda) @totalItem.ToString(tx.Moneda == "CLP" ? "N0" : "N2")</td>
                                                        <td class="text-center pe-4"></td>
                                                    </tr>
                                                }

                                                                                                // --- FILA TOTALIZADORA Y GENERADOR DE OC ---
                                                // Obtenemos los IDs y verificamos si ya existe un N° de OC
                                                string txIds = string.Join(",", prov.Select(x => x.Id));
                                                var ocsGrupo = prov.Where(x => !string.IsNullOrWhiteSpace(x.NumeroOrdenCompra)).Select(x => x.NumeroOrdenCompra!).Distinct().ToList();
                                                string? ocActual = ocsGrupo.Count == 1 && prov.All(x => x.NumeroOrdenCompra == ocsGrupo[0]) ? ocsGrupo[0] : null;
                                                bool ocParcialOInconsistente = ocsGrupo.Any() && ocActual == null;
                                                // Bloqueo: no se puede emitir OC si el valor del flete terrestre aún
                                                // está "Por asignar" (Comercial no ha cerrado la tarifa). Se excluyen
                                                // los ajustes manuales de Comercial (TarifaManual), que sí son un
                                                // valor definitivo aunque provengan de una calibración.
                                                bool tieneValorPendiente = prov.Any(x => x.MontoNeto == 0m && !x.TarifaManual);

                                                <tr style="background-color: #f1f5f9; border-top: 2px solid #cbd5e1;">
                                                    <td class="ps-4 fw-black text-dark" style="font-size: 10px;">TOTAL PROVEEDOR</td>
                                                    <td class="text-end font-monospace fw-bold" style="color: #475569;">@simbolo @sumNeto.ToString(prov.Key.Moneda == "CLP" ? "N0" : "N2")</td>
                                                    <td class="text-end font-monospace fw-bold" style="color: #475569;">@simbolo @sumIva.ToString(prov.Key.Moneda == "CLP" ? "N0" : "N2")</td>
                                                    <td class="text-end font-monospace fw-black" style="color: #dc2626; font-size: 13px;">@simbolo @sumTotal.ToString(prov.Key.Moneda == "CLP" ? "N0" : "N2")</td>
                                                    <!-- Reemplaza la celda del formulario en la fila totalizadora con esto: -->
                                                                                                        <td class="text-center pe-4">
                                                        @if (ocParcialOInconsistente)
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-2" title="Hay conceptos de este grupo con OC y otros sin OC. Revisa el historial antes de generar otra.">
                                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> OC INCONSISTENTE
                                                            </span>
                                                        }
                                                        else if (string.IsNullOrWhiteSpace(ocActual) && tieneValorPendiente)
                                                        {
                                                            <!-- BLOQUEADO: falta el valor de transporte (Comercial no ha cerrado tarifa) -->
                                                            <button type="button" class="btn btn-outline-secondary shadow-sm d-flex align-items-center justify-content-center w-100" style="height: 26px; padding: 0 10px; font-size: 10px; font-weight: 800; border-width: 2px; opacity: 0.6; cursor: not-allowed;" disabled title="No se puede generar la OC: falta el valor de transporte. Comercial debe cerrar la tarifa primero.">
                                                                <i class="bi bi-lock-fill me-1"></i> VALOR PENDIENTE
                                                            </button>
                                                        }
                                                        else if (string.IsNullOrWhiteSpace(ocActual))
                                                        {
                                                            <!-- NO HAY OC: Botón de auto-generación -->
                                                            <form method="post" asp-page-handler="AsignarOC" class="d-flex align-items-center justify-content-end m-0 p-0">
                                                                <input type="hidden" name="transaccionesIds" value="@txIds" />
                                                                <button type="submit" class="btn btn-outline-success shadow-sm d-flex align-items-center justify-content-center w-100" style="height: 26px; padding: 0 10px; font-size: 10px; font-weight: 800; border-width: 2px;" title="Generar OC Automática">
                                                                    <i class="bi bi-magic me-1"></i> GENERAR OC
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <!-- YA HAY OC: Mostrar botón de PDF -->
                                                            <div class="d-flex align-items-center justify-content-end gap-2">
                                                                <span class="badge bg-dark shadow-sm" style="font-size: 10px; padding: 6px 10px; letter-spacing: 0.5px;">@ocActual</span>
                                                                <a href="/Operaciones/OrdenCompraPdf/@op.Id?oc=@ocActual" target="_blank" class="btn-oc-pdf shadow-sm">
                                                                    <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                                                                </a>
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.ListaOrdenes.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3 opacity-25"></i>
                                <span class="fw-bold fs-6">Sin requerimientos logísticos</span><br />
                                <span style="font-size: 12px;">No hay viajes terrestres asignados.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <span class="text-muted" style="font-size:10.5px;font-weight:700;">@Model.TotalOperaciones bookings · página @Model.Pagina de @Model.TotalPaginas</span>
            <nav aria-label="Paginación Órdenes de Compra">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="./OrdenesCompra" asp-route-Pagina="@(Model.Pagina - 1)" asp-route-SearchString="@Model.SearchString"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">@Model.Pagina / @Model.TotalPaginas</span></li>
                    <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-page="./OrdenesCompra" asp-route-Pagina="@(Model.Pagina + 1)" asp-route-SearchString="@Model.SearchString"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>